//@version=6
indicator("keylevel-candles", overlay=true, max_labels_count=500)

// ============================================================================
// PURPOSE
// Companion to `intraday/orb/breakout.pine`. That script decides WHERE the
// levels are and whether a setup scores. This one answers the question a
// discretionary check actually needs at the moment of the test:
//
//   the candle is AT the level -- does its shape say the level gets breached,
//   or does it say the attempt was not good enough?
//
// Every event carries a tooltip naming the candle type, the level, the volume
// and the reading, so the mark is self-explanatory on the chart.
//
// Derived from repo32's "Candlestick Patterns Identified" (MPL-2.0), reduced
// from 15 chart-wide patterns to 3 level-relative verdicts.
//
// Levels mirror breakout.pine:661
//   array.from("ORH","ORM","ORL","IBH","IBM","IBL","PVAH","PPOC","PVAL","PDH","PDL")
// The P prefix marks previous-session levels. Without it PVAH/PPOC/PVAL read
// identically to TradingView's Session Volume Profile, which plots TODAY's
// VAH/POC/VAL -- two sets of lines, same three names, different prices.
// ORB / IB / PD are computed here; VAH/POC/VAL are manual inputs, the same
// option breakout.pine offers.
//
// THE VERDICTS
//   BREAK  the level gives way. Conviction close through it: big body, small
//          wick into the level, volume behind it. Or an engulfing that closes
//          beyond. These are the candles that precede acceptance.
//   FAKE   the level holds and the attempt fails. Price traded through and got
//          pushed back: rejection wick into the level, or a close back inside
//          after the previous bar closed beyond it.
//   WEAK   the test was inconclusive. Doji / small body / no volume at the
//          level -- not enough force to breach, not yet a rejection either.
//
// WHAT WAS DROPPED AND WHY
//   Harami, Piercing, Kicker, Morning/Evening Star, Belt Hold - either
//   ambiguous at a level, strictly weaker than Engulfing, gap-dependent, or
//   confirming too late to matter. Hammer / Shooting Star / Hanging Man /
//   Inverted Hammer are one geometry with four names; what decides the meaning
//   is which side of the LEVEL the wick probed, so they fold into FAKE.
// ============================================================================

// ── Inputs ───────────────────────────────────────────────────────────────
grpLvl = "Key Levels"
orMinutes  = input.int(15, "Opening Range (minutes)", minval=1, group=grpLvl)
ibMinutes  = input.int(60, "Initial Balance (minutes)", minval=1, group=grpLvl)
usePD      = input.bool(true,  "Previous Day H/L", group=grpLvl)
useOR      = input.bool(true,  "Opening Range H/L", group=grpLvl)
useIB      = input.bool(true,  "Initial Balance H/L", group=grpLvl)
useMids    = input.bool(false, "Include ORM / IBM midpoints", group=grpLvl,
     tooltip="Off by default. Midpoints roughly double the level count, and with eleven levels on a 5-min chart price is within touching distance of something almost permanently, which is what buried the useful marks in noise.")
useVP      = input.bool(false, "Prev-day Volume Profile (manual)", group=grpLvl,
     tooltip="Read VAH/POC/VAL off TradingView's Session Volume Profile for the PREVIOUS day, the same way breakout.pine's manual mode expects them.")
vahIn      = input.float(0.0, "PVAH (prev VAH)", group=grpLvl)
pocIn      = input.float(0.0, "PPOC (prev POC)", group=grpLvl)
valIn      = input.float(0.0, "PVAL (prev VAL)", group=grpLvl)

grpShape = "Candle Thresholds"
volLen     = input.int(20, "Volume Average Length", minval=1, group=grpShape)
minRvol    = input.float(1.5, "BREAK min RVOL", minval=0, step=0.1, group=grpShape,
     tooltip="Mirrors breakout.pine's klBreakMinRvol. Below roughly 1.5x average a break bar is a stop hunt; above it, order flow is arriving. FAKE is deliberately NOT volume-gated — a rejection on thin volume is still a rejection.")
bodyMinPct = input.float(55.0, "BREAK min body %", minval=1, maxval=100, step=5, group=grpShape)
oppWickMax = input.float(30.0, "BREAK max wick into level %", minval=1, maxval=100, step=5, group=grpShape,
     tooltip="A genuine breach does not leave a long wick on the side it broke through. That wick is the level pushing back.")
wickMinPct = input.float(45.0, "FAKE min rejection wick %", minval=1, maxval=100, step=5, group=grpShape)
lvlCooldown = input.int(0, "Bars between verdicts on the same level", minval=0, group=grpShape,
     tooltip="0 = judge every interacting candle. Raise to thin out repeats while price grinds along a level.")

grpVis = "Display"
showBreak  = input.bool(true, "Show BREAK", group=grpVis)
showFake   = input.bool(true, "Show FAKE", group=grpVis)
showLevels = input.bool(false, "Plot Levels", group=grpVis,
     tooltip="Off by default. breakout.pine already draws AND tags these levels; plotting them here a second time adds a set of lines with no tag on them, which is exactly the 'what level is that line' problem. Turn on only when running this script without breakout.pine.")
lblSize    = input.string(size.normal, "Label Size", options=[size.tiny, size.small, size.normal], group=grpVis,
     tooltip="Labels accept a series size, unlike plotshape whose size must be a compile-time constant.")
showLvlTable = input.bool(true, "Show Level Coverage Table", group=grpVis,
     tooltip="Every level currently in play, its price, and how many BREAK / FAKE verdicts it produced today. Use it to confirm a level is actually being tested rather than assuming it is.")
rowOffAtr  = input.float(2.0, "Label Row Offset (x ATR)", minval=0.5, step=0.5, group=grpVis,
     tooltip="All marks sit on one horizontal row this far below the session low, so they line up and stay clear of the candles instead of scattering across the price pane.")
// One colour for BREAK and one for FAKE made the arrow the only thing carrying
// direction, which is unreadable at tiny size. Four verdicts, four colours.
brkUpCol   = input.color(#00E676, "BREAK up  (B up)",   group=grpVis)
brkDnCol   = input.color(#FF1744, "BREAK down (B dn)",  group=grpVis)
fakeUpCol  = input.color(#FF9100, "FAKE up   (F up)",   group=grpVis,
     tooltip="Amber: an upside break that failed. Bearish implication — the level held as resistance.")
fakeDnCol  = input.color(#00B0FF, "FAKE down (F dn)",   group=grpVis,
     tooltip="Blue: a downside break that failed. Bullish implication — the level held as support.")

// ── Session-anchored levels ──────────────────────────────────────────────
float volMA = ta.sma(volume, volLen)
float rvol  = volMA > 0 ? volume / volMA : 0.0
float atr14 = ta.atr(14)

var int   sessStart = na
var float orH = na
var float orL = na
var float ibH = na
var float ibL = na

bool newSess = session.isfirstbar_regular

// One horizontal row for every mark. Anchored under the session low and only
// ever pushed lower, so the marks line up instead of scattering over the
// candles at each event's own price.
var float rowY = na

// Per-level verdict counts for the coverage table, reset each session.
var map<string, int> brkCnt = map.new<string, int>()
var map<string, int> fkCnt  = map.new<string, int>()
var map<string, int> lastAt = map.new<string, int>()

if newSess
    sessStart := time
    orH := high
    orL := low
    ibH := high
    ibL := low
    rowY := low - nz(atr14, high - low) * rowOffAtr
    map.clear(brkCnt)
    map.clear(fkCnt)
    map.clear(lastAt)

if not na(rowY)
    rowY := math.min(rowY, low - nz(atr14, high - low) * rowOffAtr)

float minsIn = na(sessStart) ? na : (time - sessStart) / 60000.0

if not newSess and not na(minsIn)
    if minsIn < orMinutes
        orH := math.max(nz(orH, high), high)
        orL := math.min(nz(orL, low), low)
    if minsIn < ibMinutes
        ibH := math.max(nz(ibH, high), high)
        ibL := math.min(nz(ibL, low), low)

// A range cannot be broken while it is still being built. Until the window
// closes, orH/ibH move with price, so every bar inside the window "touches"
// them and the level is meaningless.
bool orReady = not na(minsIn) and minsIn >= orMinutes
bool ibReady = not na(minsIn) and minsIn >= ibMinutes

float orM = orReady ? (orH + orL) / 2 : na
float ibM = ibReady ? (ibH + ibL) / 2 : na

// lookahead_on against an already-closed daily bar is the standard
// non-repainting previous-day idiom: [1] is yesterday, which is final.
float pdh = request.security(syminfo.tickerid, "D", high[1], lookahead=barmerge.lookahead_on)
float pdl = request.security(syminfo.tickerid, "D", low[1],  lookahead=barmerge.lookahead_on)

// ── Level table ──────────────────────────────────────────────────────────
var array<string> lvlName = array.new<string>()
var array<float>  lvlVal  = array.new<float>()

array.clear(lvlName)
array.clear(lvlVal)

f_add(string _n, float _v, bool _on) =>
    if _on and not na(_v) and _v > 0
        array.push(lvlName, _n)
        array.push(lvlVal, _v)

f_add("ORH", orReady ? orH : na, useOR)
f_add("ORL", orReady ? orL : na, useOR)
f_add("ORM", orM, useOR and useMids)
f_add("IBH", ibReady ? ibH : na, useIB)
f_add("IBL", ibReady ? ibL : na, useIB)
f_add("IBM", ibM, useIB and useMids)
f_add("PVAH", vahIn, useVP)
f_add("PPOC", pocIn, useVP)
f_add("PVAL", valIn, useVP)
f_add("PDH", pdh, usePD)
f_add("PDL", pdl, usePD)

// The level under test is one the bar actually TRADED THROUGH, not merely one
// it came near. "Within 0.25 x ATR of the nearest level" was true on almost
// every bar once eleven levels were on the chart, which is what produced a
// wall of marks. Of the levels the bar pierced, take the one its close settled
// nearest — that is the level the bar is making a statement about.
string testName = ""
float  testLvl  = na
float  testGap  = na

if array.size(lvlVal) > 0
    for i = 0 to array.size(lvlVal) - 1
        float v = array.get(lvlVal, i)
        if high >= v and low <= v
            float g = math.abs(close - v)
            if na(testGap) or g < testGap
                testGap  := g
                testLvl  := v
                testName := array.get(lvlName, i)

bool atLevel = not na(testLvl)

// ── Candle geometry ──────────────────────────────────────────────────────
float rng    = high - low
float bodyV  = math.abs(close - open)
float bodyP  = rng > 0 ? bodyV / rng * 100 : 0.0
float upWkP  = rng > 0 ? (high - math.max(open, close)) / rng * 100 : 0.0
float dnWkP  = rng > 0 ? (math.min(open, close) - low)  / rng * 100 : 0.0

bool bullBar = close > open
bool bearBar = close < open
bool volOK   = rvol >= minRvol

float prevBody = math.abs(close[1] - open[1])
bool bullEngulf = bullBar and open[1] > close[1] and close >= open[1] and open <= close[1] and bodyV > prevBody
bool bearEngulf = bearBar and close[1] > open[1] and close <= open[1] and open >= close[1] and bodyV > prevBody

// `testLvl` is a level the bar pierced, and every level in the table is fixed
// for the rest of the session once formed — so comparing close[1] against it
// is sound. The previous build compared close[1] against whichever level was
// nearest on THIS bar, which was frequently a different level entirely.


// ── Verdicts ─────────────────────────────────────────────────────────────
// Every candle that pierces a level gets exactly one verdict. Quality used to
// GATE the verdict, so an interacting candle without conviction produced no
// mark at all and the level test simply vanished from the chart. Quality is
// now an attribute (strong / unconfirmed), not an entry condition.
//
// The taxonomy is positional and therefore exhaustive — where the previous
// close sat versus where this one closed:
//   from below -> closed above   B▲  broke up
//   from above -> closed below   B▼  broke down
//   from above -> closed above   F▼  dipped below intrabar, level held as support
//   from below -> closed below   F▲  poked above intrabar, level held as resistance
// Cases 3 and 4 necessarily involve an intrabar probe, because the bar pierced
// the level to be considered at all.
bool cAbove = atLevel and close   >= testLvl
bool pAbove = atLevel and close[1] >= testLvl

bool breakUp = atLevel and not pAbove and cAbove
bool breakDn = atLevel and pAbove and not cAbove
bool fakeDn  = atLevel and pAbove and cAbove
bool fakeUp  = atLevel and not pAbove and not cAbove

// Conviction. Shown as opacity and named in the tooltip; never suppresses.
bool strongUp   = volOK and ((bodyP >= bodyMinPct and upWkP <= oppWickMax) or bullEngulf)
bool strongDn   = volOK and ((bodyP >= bodyMinPct and dnWkP <= oppWickMax) or bearEngulf)
bool strongBrk  = breakUp ? strongUp : breakDn ? strongDn : false
bool strongFake = fakeUp ? (upWkP >= wickMinPct) : fakeDn ? (dnWkP >= wickMinPct) : false

// Optional thinning while price grinds along one level (0 = keep everything).
bool lvlReady = not atLevel ? false : (na(map.get(lastAt, testName)) or bar_index - nz(map.get(lastAt, testName), 0) >= lvlCooldown)
breakUp := breakUp and lvlReady
breakDn := breakDn and lvlReady
fakeUp  := fakeUp  and lvlReady
fakeDn  := fakeDn  and lvlReady

// ── Rendering ────────────────────────────────────────────────────────────
// Three short lines: what the candle did, then what it means. No jargon.
f_tip(string _head, string _did, string _means) =>
    _head + " " + testName + " " + str.tostring(testLvl, format.mintick) + "\n" + _did + "\n" + _means

if barstate.isconfirmed and showBreak and (breakUp or breakDn)
    bool up = breakUp
    string did = (strongBrk ? "Big body closed " : "Closed ") + (up ? "above" : "below") + " it on " + str.tostring(rvol, "#.#") + "x volume."
    string means = strongBrk ? "Level gave way. Expect follow-through " + (up ? "up" : "down") + "." : "Closed through but without conviction - unconfirmed, wait for the next bar."
    map.put(brkCnt, testName, nz(map.get(brkCnt, testName), 0) + 1)
    map.put(lastAt, testName, bar_index)
    color bc = color.new(up ? brkUpCol : brkDnCol, strongBrk ? 0 : 55)
    label.new(bar_index, rowY, text=up ? "B▲" : "B▼", style=label.style_label_up, yloc=yloc.price,
         color=bc, textcolor=color.black, size=lblSize,
         tooltip=f_tip("BREAK", did, means))

if barstate.isconfirmed and showFake and (fakeUp or fakeDn)
    bool up = fakeUp
    string did = (up ? "Price poked above it and closed back below" : "Price poked below it and closed back above") + (strongFake ? " on a long rejection wick." : ".")
    string means = "Level held. Do not chase the " + (up ? "break up" : "break down") + "."
    map.put(fkCnt, testName, nz(map.get(fkCnt, testName), 0) + 1)
    map.put(lastAt, testName, bar_index)
    color fc2 = color.new(up ? fakeUpCol : fakeDnCol, strongFake ? 0 : 55)
    label.new(bar_index, rowY, text=up ? "F▲" : "F▼", style=label.style_label_up, yloc=yloc.price,
         color=fc2, textcolor=color.black, size=lblSize,
         tooltip=f_tip("FAKE", did, means))

// Coverage table: which levels are actually in play and what they produced.
// The logic tests all eleven identically, but a level that is toggled off, or
// a VP level left at its 0.0 default, is silently never tested -- which reads
// on the chart exactly like "it does not work for that level".
var table lt = table.new(position.bottom_right, 4, 13,
     bgcolor=color.new(color.black, 70), border_width=1, border_color=color.gray)

if showLvlTable and barstate.islast
    table.cell(lt, 0, 0, "Level", text_color=color.white, text_size=size.tiny, bgcolor=color.new(color.gray, 60))
    table.cell(lt, 1, 0, "Price", text_color=color.white, text_size=size.tiny, bgcolor=color.new(color.gray, 60))
    table.cell(lt, 2, 0, "B",     text_color=color.white, text_size=size.tiny, bgcolor=color.new(color.gray, 60))
    table.cell(lt, 3, 0, "F",     text_color=color.white, text_size=size.tiny, bgcolor=color.new(color.gray, 60))

    int n = array.size(lvlVal)
    for r = 1 to 12
        if r <= n
            string nm = array.get(lvlName, r - 1)
            float  vv = array.get(lvlVal, r - 1)
            int    bc = nz(map.get(brkCnt, nm), 0)
            int    fc = nz(map.get(fkCnt, nm), 0)
            table.cell(lt, 0, r, nm, text_color=color.gray, text_size=size.tiny)
            table.cell(lt, 1, r, str.tostring(vv, format.mintick), text_color=color.gray, text_size=size.tiny)
            table.cell(lt, 2, r, bc > 0 ? str.tostring(bc) : "-", text_color = bc > 0 ? brkUpCol : color.gray, text_size=size.tiny)
            table.cell(lt, 3, r, fc > 0 ? str.tostring(fc) : "-", text_color = fc > 0 ? fakeUpCol : color.gray, text_size=size.tiny)
        else if r == n + 1 and not useVP
            table.cell(lt, 0, r, "PVAH/PPOC/PVAL", text_color=color.orange, text_size=size.tiny)
            table.cell(lt, 1, r, "off", text_color=color.orange, text_size=size.tiny)
            table.cell(lt, 2, r, "", text_color=color.gray, text_size=size.tiny)
            table.cell(lt, 3, r, "", text_color=color.gray, text_size=size.tiny)
        else
            table.cell(lt, 0, r, "", text_size=size.tiny)
            table.cell(lt, 1, r, "", text_size=size.tiny)
            table.cell(lt, 2, r, "", text_size=size.tiny)
            table.cell(lt, 3, r, "", text_size=size.tiny)

plot(showLevels and useOR and orReady ? orH : na, "ORH", color=color.new(color.gray, 40), style=plot.style_linebr)
plot(showLevels and useOR and orReady ? orL : na, "ORL", color=color.new(color.gray, 40), style=plot.style_linebr)
plot(showLevels and useIB and ibReady ? ibH : na, "IBH", color=color.new(#FFEB3B, 55), style=plot.style_linebr)
plot(showLevels and useIB and ibReady ? ibL : na, "IBL", color=color.new(#FFEB3B, 55), style=plot.style_linebr)
plot(showLevels and usePD ? pdh : na, "PDH", color=color.new(#90A4AE, 40), style=plot.style_linebr)
plot(showLevels and usePD ? pdl : na, "PDL", color=color.new(#90A4AE, 40), style=plot.style_linebr)

// ── Alerts ───────────────────────────────────────────────────────────────
alertcondition(breakUp, "Valid Breakout Up",   "Key level BREACHED up - conviction close through the level on volume")
alertcondition(breakDn, "Valid Breakout Down", "Key level BREACHED down - conviction close through the level on volume")
alertcondition(fakeUp,  "Fakeout Up",          "Key level HELD - upside breach rejected, fakeout risk")
alertcondition(fakeDn,  "Fakeout Down",        "Key level HELD - downside breach rejected, fakeout risk")

if barstate.isconfirmed and (breakUp or breakDn or fakeUp or fakeDn)
    string verdict = breakUp or breakDn ? "break" : "fake"
    string dir = breakUp or fakeDn ? "up" : "down"
    alert('{"symbol":"' + syminfo.tickerid + '","verdict":"' + verdict + '","direction":"' + dir +
         '","level":"' + testName + '","levelPrice":' + str.tostring(nz(testLvl), "#.##") +
         ',"bodyPct":' + str.tostring(nz(bodyP), "#") + ',"rvol":' + str.tostring(nz(rvol), "#.##") +
         ',"time":"' + str.format_time(time, "yyyy-MM-dd HH:mm", "Asia/Kolkata") + '"}',
         alert.freq_once_per_bar_close)
