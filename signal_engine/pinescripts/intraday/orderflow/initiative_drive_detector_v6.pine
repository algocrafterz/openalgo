//@version=6
indicator("Initiative Drive Detector v6", overlay=true, max_labels_count=500, max_bars_back=500)

// ============================================================================
// PURPOSE
// Flags expansion candles that show INITIATIVE participation — an aggressor
// lifting offers / hitting bids hard enough to move price away from value —
// as opposed to RESPONSIVE activity that fades an extreme.
//
// This script does NOT confirm order flow. Treat every flag as a prompt to
// open the footprint chart and check for:
//   - Stacked imbalances in the direction of the flag
//   - Absorption at the opposite extreme (would invalidate the candidate)
//   - Delta agreeing with price direction
// Convention: BID = left = sellers, ASK = right = buyers (fixed, regardless
// of candle colour).
//
// Designed for trending instruments on any timeframe. In a balanced/rotational
// regime an "expansion" candle is usually just noise, which is what the ADX
// regime gate exists to suppress.
// ============================================================================

// ── Inputs ───────────────────────────────────────────────────────────────
grpRange   = "Range & Volatility"
atrLen     = input.int(14, "ATR Length", minval=1, group=grpRange)
atrMult    = input.float(1.15, "ATR Multiplier", step=0.05, minval=0.1, group=grpRange)

grpVol     = "Volume"
volLen     = input.int(20, "Volume SMA Length", minval=1, group=grpVol)
rvolMin    = input.float(1.50, "Minimum RVOL", step=0.1, minval=0.1, group=grpVol)

grpBody    = "Body / Close Location"
bodyMinPct = input.float(65.0, "Minimum Body %", step=5, minval=1, maxval=100, group=grpBody)
closeZonePct = input.float(25.0, "Close-Within-Extreme Zone %", step=5, minval=1, maxval=100, group=grpBody,
     tooltip="Bull candidate requires close within this % of the high; bear candidate within this % of the low. This doubles as the opposing-wick cap: closing in the top 25% means the upper wick is at most 25% of range.")

grpTrend   = "Trend Regime"
emaLen     = input.int(9, "EMA Length", minval=1, group=grpTrend)
adxLen     = input.int(14, "ADX / DI Length", minval=1, group=grpTrend)
adxMin     = input.float(20.0, "Minimum ADX", step=1, minval=0, group=grpTrend,
     tooltip="Trend-regime filter. Initiative drives are only meaningful when the instrument is actually trending; in balance, an expansion bar is usually rotation that mean-reverts.")

grpBreak   = "Breakout"
lookback   = input.int(3, "Breakout Lookback", minval=1, group=grpBreak)

grpFilter  = "Signal Filtering"
scoreMin      = input.int(6, "Minimum Score (of 8)", minval=1, maxval=8, group=grpFilter)
cooldownBars  = input.int(4, "Minimum Bars Between Signals", minval=0, group=grpFilter)
requireGate   = input.bool(true, "Require Directional Close (recommended)", group=grpFilter,
     tooltip="Candle must close in the signal direction AND near that extreme. Without this, the direction-neutral criteria (ATR, RVOL, body size) let an upthrust or a bear-trap bar score a signal for the wrong side.")
requireTrend  = input.bool(true, "Require Trend Regime (ADX)", group=grpFilter)
skipOpenBars  = input.int(2, "Skip First N Bars of Session", minval=0, group=grpFilter,
     tooltip="The opening bars carry an auction-driven volume spike, so RVOL is inflated and nearly every open looks like an initiative drive.")
useSession    = input.bool(true, "Restrict to NSE Cash Session (09:15-15:30 IST)", group=grpFilter)
sessionString = input.session("0915-1530", "Session", group=grpFilter)

grpVis     = "Display"
showMarkers = input.bool(true, "Show Markers (sleek triangles)", group=grpVis)
showLabels  = input.bool(false, "Show Score Labels", group=grpVis,
     tooltip="Off by default — the triangle marker carries the signal without covering price action. Turn on when you want the score inline.")
showBg      = input.bool(true, "Tint Signal Bar Background", group=grpVis)
showBarCol  = input.bool(false, "Recolour Signal Candle", group=grpVis,
     tooltip="Off by default. Recolouring overwrites the real candle colour, which you still need when reading the bar against the footprint.")
showTable   = input.bool(true, "Show Score Table", group=grpVis)

// ── Calculations ─────────────────────────────────────────────────────────
float atr = ta.atr(atrLen)

float barRange = high - low
float body     = math.abs(close - open)
float bodyPct  = barRange > 0 ? body / barRange * 100 : 0.0

float volMA = ta.sma(volume, volLen)
float rvol  = volMA > 0 ? volume / volMA : 0.0

float ema     = ta.ema(close, emaLen)
float vwapVal = ta.vwap(close)

[diPlus, diMinus, adxVal] = ta.dmi(adxLen, adxLen)

bool inSession = not useSession or not na(time(timeframe.period, sessionString, "Asia/Kolkata"))

// Bars elapsed in the current session, used to skip the opening auction.
var int barsIntoSession = 0
barsIntoSession := session.isfirstbar ? 1 : barsIntoSession + 1
bool pastOpen = barsIntoSession > skipOpenBars

// ── Core Conditions ──────────────────────────────────────────────────────
// Expansion. `range > avgRange` used to sit alongside this as a separate
// criterion, but "range beats its own 5-bar average" and "range beats
// ATR x 1.15" measure the same property, so volatility was scoring twice
// while participation and structure scored once each.
bool atrPass  = barRange >= atr * atrMult
bool rvolPass = rvol >= rvolMin

bool bodyPass = bodyPct >= bodyMinPct
// Direction-aware body: an expansion candle only counts toward a side if it
// actually closed in that direction. bodyPct alone is |close-open|, so a large
// DOWN candle would otherwise score a bull body point.
bool bullBody = bodyPass and close > open
bool bearBody = bodyPass and close < open

// Close location doubles as the opposing-wick cap.
bool bullClose = close >= high - barRange * (closeZonePct / 100)
bool bearClose = close <= low  + barRange * (closeZonePct / 100)

bool bullTrend = close > ema and ema > ema[1]
bool bearTrend = close < ema and ema < ema[1]

bool bullVWAP = close > vwapVal
bool bearVWAP = close < vwapVal

// Breakout is measured on the CLOSE, not the intrabar extreme. `high > highest`
// is satisfied by an upthrust that pokes through the level and then gets sold
// back — the textbook responsive/absorption bar this script exists to filter
// out. Requiring the close beyond the level means the auction actually held
// the new territory into the bar close.
bool bullBreak = close > ta.highest(high[1], lookback)
bool bearBreak = close < ta.lowest(low[1], lookback)

// Trend regime. An expansion bar inside balance is rotation, not initiative.
// ADX measures trend STRENGTH only, so on its own it was another free point for
// both sides. +DI/-DI supplies the direction, which makes this criterion agree
// with the signal instead of subsidising it.
bool trendStrong = adxVal >= adxMin
bool bullRegime  = trendStrong and diPlus > diMinus
bool bearRegime  = trendStrong and diMinus > diPlus

// ── Score ────────────────────────────────────────────────────────────────
int bullScore = (atrPass ? 1 : 0) + (rvolPass ? 1 : 0) + (bullBody ? 1 : 0) + (bullClose ? 1 : 0) +
     (bullBreak ? 1 : 0) + (bullTrend ? 1 : 0) + (bullVWAP ? 1 : 0) + (bullRegime ? 1 : 0)

int bearScore = (atrPass ? 1 : 0) + (rvolPass ? 1 : 0) + (bearBody ? 1 : 0) + (bearClose ? 1 : 0) +
     (bearBreak ? 1 : 0) + (bearTrend ? 1 : 0) + (bearVWAP ? 1 : 0) + (bearRegime ? 1 : 0)

// ── Gates ────────────────────────────────────────────────────────────────
// Several criteria (ATR, RVOL, body size, ADX) are direction-neutral, so they
// were free points for BOTH sides. An upthrust -- spikes up, takes out the
// 3-bar high, closes on its low inside an uptrend -- collected enough of them
// to fire a BULL signal. That bar is the opposite of initiative buying: it is
// exactly the absorption the header tells you to go check the footprint for.
// Direction is therefore a prerequisite, not a score component.
bool bullGate = not requireGate or (bullBody and bullClose)
bool bearGate = not requireGate or (bearBody and bearClose)

bool bullRegimeGate = not requireTrend or bullRegime
bool bearRegimeGate = not requireTrend or bearRegime

// ATR/RVOL are unreliable until their lookbacks are filled.
bool warmedUp = bar_index >= math.max(atrLen, volLen, adxLen, lookback)

bool context = inSession and warmedUp and pastOpen

bool bullQualifies = bullScore >= scoreMin and bullGate and bullRegimeGate and context
bool bearQualifies = bearScore >= scoreMin and bearGate and bearRegimeGate and context

// A single bar cannot be both initiative buying and initiative selling. If both
// sides qualify the bar is ambiguous, so emit neither rather than firing two
// contradictory alerts off the same candle.
bool bothQualify   = bullQualifies and bearQualifies
bool bullCandidate = bullQualifies and not bothQualify
bool bearCandidate = bearQualifies and not bothQualify

// ── First Expansion Only, Confirmed Bar ─────────────────────────────────
bool bullRaw = bullCandidate and not bullCandidate[1] and barstate.isconfirmed
bool bearRaw = bearCandidate and not bearCandidate[1] and barstate.isconfirmed

// ── Cooldown Filter ──────────────────────────────────────────────────────
var int lastBullBar = na
var int lastBearBar = na

bool bullSignal = false
bool bearSignal = false

if bullRaw
    if na(lastBullBar) or (bar_index - lastBullBar >= cooldownBars)
        bullSignal := true
        lastBullBar := bar_index

if bearRaw
    if na(lastBearBar) or (bar_index - lastBearBar >= cooldownBars)
        bearSignal := true
        lastBearBar := bar_index

// ── Visuals ──────────────────────────────────────────────────────────────
// Sleek by default: a tiny triangle off the bar, and an optional faint tint.
// Nothing is drawn over the candle body or wicks.
color bullCol = color.new(color.teal, 0)
color bearCol = color.new(color.red, 0)

plotshape(showMarkers and bullSignal, title="Bull Initiative Drive", style=shape.triangleup,
     location=location.belowbar, color=bullCol, size=size.tiny)
plotshape(showMarkers and bearSignal, title="Bear Initiative Drive", style=shape.triangledown,
     location=location.abovebar, color=bearCol, size=size.tiny)

barcolor(showBarCol and bullSignal ? color.lime : showBarCol and bearSignal ? color.red : na)
bgcolor(showBg and bullSignal ? color.new(color.teal, 92) : showBg and bearSignal ? color.new(color.red, 92) : na)

// Optional compact score label. `location=` is not a label.new parameter --
// labels position with yloc -- and the style constants are label.style_label_up
// / label.style_label_down. Both were wrong, so the script did not compile.
if showLabels and bullSignal
    label.new(bar_index, low, text=str.tostring(bullScore), style=label.style_label_up,
         yloc=yloc.belowbar, color=color.new(color.teal, 20), textcolor=color.white, size=size.tiny,
         tooltip="Bull initiative candidate " + str.tostring(bullScore) +
         "/8\nVerify on footprint: ask-side stacking, no absorption at the high")

if showLabels and bearSignal
    label.new(bar_index, high, text=str.tostring(bearScore), style=label.style_label_down,
         yloc=yloc.abovebar, color=color.new(color.red, 20), textcolor=color.white, size=size.tiny,
         tooltip="Bear initiative candidate " + str.tostring(bearScore) +
         "/8\nVerify on footprint: bid-side stacking, no absorption at the low")

// ── Score Breakdown Table (last bar) ────────────────────────────────────
var table scoreTable = table.new(position.top_right, 2, 10,
     bgcolor=color.new(color.black, 70), border_width=1, border_color=color.gray)

f_head(_row, _a, _b) =>
    table.cell(scoreTable, 0, _row, _a, text_color=color.white, text_size=size.small, bgcolor=color.new(color.gray, 60))
    table.cell(scoreTable, 1, _row, _b, text_color=color.white, text_size=size.small, bgcolor=color.new(color.gray, 60))

f_neutral(_row, _label, _pass) =>
    table.cell(scoreTable, 0, _row, _label, text_color=color.gray, text_size=size.small)
    table.cell(scoreTable, 1, _row, _pass ? "PASS" : "-",
         text_color = _pass ? color.lime : color.gray, text_size=size.small)

f_dir(_row, _label, _bull, _bear) =>
    table.cell(scoreTable, 0, _row, _label, text_color=color.gray, text_size=size.small)
    table.cell(scoreTable, 1, _row, _bull ? "BULL" : _bear ? "BEAR" : "-",
         text_color = _bull ? color.lime : _bear ? color.red : color.gray, text_size=size.small)

if showTable and barstate.islast
    f_head(0, "Criteria", "Side")
    f_neutral(1, "Range >= ATR x mult", atrPass)
    f_neutral(2, "RVOL >= min", rvolPass)
    f_dir(3, "Body % (directional)", bullBody, bearBody)
    f_dir(4, "Close in extreme zone", bullClose, bearClose)
    f_dir(5, "Close beyond N-bar level", bullBreak, bearBreak)
    f_dir(6, "EMA trend align", bullTrend, bearTrend)
    f_dir(7, "VWAP side", bullVWAP, bearVWAP)
    f_dir(8, "ADX >= min (+DI/-DI)", bullRegime, bearRegime)
    f_head(9, "Score  Bull / Bear", str.tostring(bullScore) + " / " + str.tostring(bearScore))

// ── Alerts ───────────────────────────────────────────────────────────────
alertcondition(bullSignal, "Bull Initiative Drive", "Bullish Initiative Drive candidate - verify on footprint (ask-side stacking, no absorption)")
alertcondition(bearSignal, "Bear Initiative Drive", "Bearish Initiative Drive candidate - verify on footprint (bid-side stacking, no absorption)")

if bullSignal
    alert('{"symbol":"' + syminfo.tickerid + '","direction":"bull","score":' + str.tostring(bullScore) +
         ',"adx":' + str.tostring(nz(adxVal), "#.##") + ',"rvol":' + str.tostring(nz(rvol), "#.##") +
         ',"time":"' + str.format_time(time, "yyyy-MM-dd HH:mm", "Asia/Kolkata") + '"}', alert.freq_once_per_bar_close)

if bearSignal
    alert('{"symbol":"' + syminfo.tickerid + '","direction":"bear","score":' + str.tostring(bearScore) +
         ',"adx":' + str.tostring(nz(adxVal), "#.##") + ',"rvol":' + str.tostring(nz(rvol), "#.##") +
         ',"time":"' + str.format_time(time, "yyyy-MM-dd HH:mm", "Asia/Kolkata") + '"}', alert.freq_once_per_bar_close)
