//@version=6
indicator("Initiative Drive Detector v6", overlay=true, max_labels_count=500, max_bars_back=500)

// ============================================================================
// PURPOSE
// Marks INITIATIVE DRIVE candles: an aggressor lifting offers / hitting bids
// hard enough to move price away from value, as opposed to RESPONSIVE activity
// that fades an extreme.
//
// This script does NOT confirm order flow. Every mark is a prompt to open the
// footprint and check for stacked imbalances in the direction of the flag,
// absorption at the opposite extreme (which invalidates it), and delta
// agreeing with price.
//
// GATES vs SCORE  (this split is the whole design)
// A previous build scored eight criteria and fired at 5/8, with expansion as
// just one of the eight. That let a SMALL candle qualify on
// rvol + body% + close + ema + vwap, because body% is measured against the
// bar's own range -- a doji-sized bar with a 90% body passed it. Small bars
// were being marked as drives, which is the opposite of what the term means.
//
// So the four properties that DEFINE an initiative drive are now hard gates,
// all of which must pass:
//   1. Body expansion  - body beats the median body of recent bars. This is
//                        the "visibly large candle" test, in absolute terms.
//   2. Range expansion - range beats the median range. Median, not ATR: ATR is
//                        a mean, so one gap-open drive lifts it for the whole
//                        window and locks out every expansion behind it.
//   3. Directional body- closes in the signal's direction, body a majority of
//                        the range.
//   4. Close at extreme- little or no wick against the direction. A drive that
//                        gets pushed back off its extreme was not a drive.
//
// The remaining five criteria only RANK the context; they never create a
// signal on their own.
// ============================================================================

// ── Inputs ───────────────────────────────────────────────────────────────
grpDrive   = "Drive Definition (hard gates)"
lenBase    = input.int(20, "Baseline Length", minval=2, group=grpDrive,
     tooltip="How many bars form the median body / median range the candle is measured against.")
bodyExpMult = input.float(1.5, "Body > median body x", step=0.1, minval=0.5, group=grpDrive,
     tooltip="The absolute size test. Body % alone is relative to the bar's own range, so a tiny bar with a 90% body passes it -- this is the gate that stops small candles being called drives.")
rangeExpMult = input.float(1.15, "Range > median range x", step=0.05, minval=0.5, group=grpDrive)
bodyMinPct = input.float(60.0, "Body % of range", step=5, minval=1, maxval=100, group=grpDrive)
closeZonePct = input.float(30.0, "Close within % of extreme", step=5, minval=1, maxval=100, group=grpDrive,
     tooltip="Doubles as the opposing-wick cap: closing in the top 30% means the upper wick is at most 30% of range.")

grpCtx     = "Context Score"
volLen     = input.int(20, "Volume SMA Length", minval=1, group=grpCtx)
rvolMin    = input.float(1.30, "Minimum RVOL", step=0.1, minval=0.1, group=grpCtx)
emaLen     = input.int(9, "EMA Length", minval=1, group=grpCtx)
adxLen     = input.int(14, "ADX / DI Length", minval=1, group=grpCtx)
adxMin     = input.float(20.0, "Minimum ADX", step=1, minval=0, group=grpCtx)
lookback   = input.int(3, "Breakout Lookback", minval=1, group=grpCtx)
scoreMin   = input.int(3, "Minimum Score (of 5)", minval=0, maxval=5, group=grpCtx,
     tooltip="Applied AFTER the four gates. Gates decide whether the candle is a drive at all; the score only ranks how favourable the context is.")

grpFilter  = "Filtering"
cooldownBars  = input.int(0, "Minimum Bars Between Signals", minval=0, group=grpFilter)
firstOnly     = input.bool(false, "First Bar of a Run Only", group=grpFilter)
requireTrend  = input.bool(false, "Require Trend Regime (ADX)", group=grpFilter)
skipOpenBars  = input.int(0, "Skip First N Bars of Session", minval=0, group=grpFilter)
useSession    = input.bool(true, "Restrict to NSE Cash Session (09:15-15:30 IST)", group=grpFilter)
sessionString = input.session("0915-1530", "Session", group=grpFilter)

grpVis     = "Display"
showMarkers = input.bool(true, "Show ID Labels", group=grpVis)
showBg      = input.bool(true, "Tint Signal Bar Background", group=grpVis)
showBarCol  = input.bool(false, "Recolour Signal Candle", group=grpVis)
showTable   = input.bool(true, "Show Score Table", group=grpVis)
// NOTE: plotshape's `size` is a *const string*. An input.string is "input
// string" and the compiler rejects it, so marker size is fixed here.
bullMarkCol = input.color(color.new(color.lime, 0), "Bull ID Label", group=grpVis)
bearMarkCol = input.color(color.new(color.red, 0), "Bear ID Label", group=grpVis)

// ── Calculations ─────────────────────────────────────────────────────────
float barRange = high - low
float bodyV    = math.abs(close - open)
float bodyPct  = barRange > 0 ? bodyV / barRange * 100 : 0.0

float medRange = ta.median(barRange, lenBase)
float medBody  = ta.median(bodyV, lenBase)

float volMA = ta.sma(volume, volLen)
float rvol  = volMA > 0 ? volume / volMA : 0.0

float ema     = ta.ema(close, emaLen)
float vwapVal = ta.vwap(close)

[diPlus, diMinus, adxVal] = ta.dmi(adxLen, adxLen)

bool inSession = not useSession or not na(time(timeframe.period, sessionString, "Asia/Kolkata"))

var int barsIntoSession = 0
barsIntoSession := session.isfirstbar ? 1 : barsIntoSession + 1
bool pastOpen = barsIntoSession > skipOpenBars

// ── GATE 1+2: expansion (absolute size, not relative to self) ────────────
bool bodyExp  = not na(medBody)  and medBody  > 0 and bodyV    >= medBody  * bodyExpMult
bool rangeExp = not na(medRange) and medRange > 0 and barRange >= medRange * rangeExpMult

// ── GATE 3: directional body ─────────────────────────────────────────────
bool bodyPass = bodyPct >= bodyMinPct
bool bullBody = bodyPass and close > open
bool bearBody = bodyPass and close < open

// ── GATE 4: close at the extreme (opposing-wick cap) ─────────────────────
bool bullClose = close >= high - barRange * (closeZonePct / 100)
bool bearClose = close <= low  + barRange * (closeZonePct / 100)

// A candle is a drive only if all four hold.
bool bullDrive = bodyExp and rangeExp and bullBody and bullClose
bool bearDrive = bodyExp and rangeExp and bearBody and bearClose

// ── Context score (ranking only, never creates a signal) ─────────────────
bool rvolPass = rvol >= rvolMin

bool bullTrend = close > ema and ema > ema[1]
bool bearTrend = close < ema and ema < ema[1]

bool bullVWAP = close > vwapVal
bool bearVWAP = close < vwapVal

// Breakout on the CLOSE, not the intrabar extreme: `high > highest` is
// satisfied by an upthrust that pokes through and gets sold back, which is the
// absorption bar this script exists to filter out.
bool bullBreak = close > ta.highest(high[1], lookback)
bool bearBreak = close < ta.lowest(low[1], lookback)

// ADX measures trend STRENGTH only, so on its own it was a free point for both
// sides. +DI/-DI supplies the direction.
bool trendStrong = adxVal >= adxMin
bool bullRegime  = trendStrong and diPlus > diMinus
bool bearRegime  = trendStrong and diMinus > diPlus

int bullScore = (rvolPass ? 1 : 0) + (bullBreak ? 1 : 0) + (bullTrend ? 1 : 0) + (bullVWAP ? 1 : 0) + (bullRegime ? 1 : 0)
int bearScore = (rvolPass ? 1 : 0) + (bearBreak ? 1 : 0) + (bearTrend ? 1 : 0) + (bearVWAP ? 1 : 0) + (bearRegime ? 1 : 0)

// ── Qualification ────────────────────────────────────────────────────────
bool bullRegimeGate = not requireTrend or bullRegime
bool bearRegimeGate = not requireTrend or bearRegime

bool warmedUp = bar_index >= math.max(lenBase, volLen, adxLen, lookback)
bool context  = inSession and warmedUp and pastOpen

bool bullQualifies = bullDrive and bullScore >= scoreMin and bullRegimeGate and context
bool bearQualifies = bearDrive and bearScore >= scoreMin and bearRegimeGate and context

// The gates are mutually exclusive (close > open vs close < open), so this can
// only fire if the gates are disabled in a future edit. Kept as a guard.
bool bothQualify   = bullQualifies and bearQualifies
bool bullCandidate = bullQualifies and not bothQualify
bool bearCandidate = bearQualifies and not bothQualify

bool bullRaw = bullCandidate and (not firstOnly or not bullCandidate[1]) and barstate.isconfirmed
bool bearRaw = bearCandidate and (not firstOnly or not bearCandidate[1]) and barstate.isconfirmed

// ── Cooldown ─────────────────────────────────────────────────────────────
var int lastBullBar = na
var int lastBearBar = na

bool bullSignal = false
bool bearSignal = false

if bullRaw
    if na(lastBullBar) or (bar_index - lastBullBar >= cooldownBars)
        bullSignal := true
        lastBullBar := bar_index

if bearRaw
    if na(lastBearBar) or (bar_index - lastBearBar >= cooldownBars)
        bearSignal := true
        lastBearBar := bar_index

// ── Visuals ──────────────────────────────────────────────────────────────
plotshape(showMarkers and bullSignal, title="Bull Initiative Drive", style=shape.labelup,
     location=location.belowbar, color=bullMarkCol, text="ID", textcolor=color.black, size=size.small)
plotshape(showMarkers and bearSignal, title="Bear Initiative Drive", style=shape.labeldown,
     location=location.abovebar, color=bearMarkCol, text="ID", textcolor=color.white, size=size.small)

barcolor(showBarCol and bullSignal ? color.lime : showBarCol and bearSignal ? color.red : na)
bgcolor(showBg and bullSignal ? color.new(bullMarkCol, 88) : showBg and bearSignal ? color.new(bearMarkCol, 88) : na)

// ── Score Table ──────────────────────────────────────────────────────────
var table t = table.new(position.top_right, 2, 12,
     bgcolor=color.new(color.black, 70), border_width=1, border_color=color.gray)

f_head(_row, _a, _b) =>
    table.cell(t, 0, _row, _a, text_color=color.white, text_size=size.small, bgcolor=color.new(color.gray, 60))
    table.cell(t, 1, _row, _b, text_color=color.white, text_size=size.small, bgcolor=color.new(color.gray, 60))

f_neutral(_row, _label, _pass) =>
    table.cell(t, 0, _row, _label, text_color=color.gray, text_size=size.small)
    table.cell(t, 1, _row, _pass ? "PASS" : "-", text_color = _pass ? color.lime : color.gray, text_size=size.small)

f_dir(_row, _label, _bull, _bear) =>
    table.cell(t, 0, _row, _label, text_color=color.gray, text_size=size.small)
    table.cell(t, 1, _row, _bull ? "BULL" : _bear ? "BEAR" : "-",
         text_color = _bull ? color.lime : _bear ? color.red : color.gray, text_size=size.small)

if showTable and barstate.islast
    f_head(0, "GATES (all required)", "Side")
    f_neutral(1, "Body > median body x",  bodyExp)
    f_neutral(2, "Range > median range x", rangeExp)
    f_dir(3, "Body % of range", bullBody, bearBody)
    f_dir(4, "Close at extreme", bullClose, bearClose)
    f_head(5, "CONTEXT (ranking)", "Side")
    f_neutral(6, "RVOL >= min", rvolPass)
    f_dir(7, "Close beyond N-bar level", bullBreak, bearBreak)
    f_dir(8, "EMA trend align", bullTrend, bearTrend)
    f_dir(9, "VWAP side", bullVWAP, bearVWAP)
    f_dir(10, "ADX >= min (+DI/-DI)", bullRegime, bearRegime)
    f_head(11, "Drive?  Score", (bullDrive ? "BULL " : bearDrive ? "BEAR " : "no ") + str.tostring(bullDrive ? bullScore : bearDrive ? bearScore : 0) + "/5")

// ── Alerts ───────────────────────────────────────────────────────────────
alertcondition(bullSignal, "Bull Initiative Drive", "Bullish Initiative Drive - verify on footprint (ask-side stacking, no absorption)")
alertcondition(bearSignal, "Bear Initiative Drive", "Bearish Initiative Drive - verify on footprint (bid-side stacking, no absorption)")

if bullSignal or bearSignal
    string dir = bullSignal ? "bull" : "bear"
    int sc = bullSignal ? bullScore : bearScore
    alert('{"symbol":"' + syminfo.tickerid + '","direction":"' + dir + '","score":' + str.tostring(sc) +
         ',"bodyX":' + str.tostring(medBody > 0 ? bodyV / medBody : 0, "#.##") +
         ',"rvol":' + str.tostring(nz(rvol), "#.##") +
         ',"adx":' + str.tostring(nz(adxVal), "#.##") +
         ',"time":"' + str.format_time(time, "yyyy-MM-dd HH:mm", "Asia/Kolkata") + '"}', alert.freq_once_per_bar_close)
