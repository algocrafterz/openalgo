//@version=6
// Adapted for Indian Stock Market (NSE/BSE) - Based on Luxy BIG beautiful Dynamic ORB - v5
strategy("intraday-orb", shorttitle="", overlay=true,
     default_qty_type=strategy.percent_of_equity, default_qty_value=10,
     initial_capital=100000, currency=currency.INR, commission_type=strategy.commission.percent,
     commission_value=0.06, slippage=2, calc_on_every_tick=false,
     process_orders_on_close=false, max_labels_count=500, max_lines_count=500, max_boxes_count=300)


// ====================================== DISCLAIMER & INFO =========================================
//
// DISCLAIMER: This indicator is for educational and informational purposes only.
// It does not constitute financial advice. Trading involves substantial risk of loss.
// Past performance does not guarantee future results. Always do your own research.
//
// DESCRIPTION:
// Dynamic Opening Range Breakout (ORB) indicator with multi-stage ranges (5/15/30/60 min).
// Identifies breakouts, retests, and failed breaks with advanced filtering options.
// Includes position sizing, risk management, and higher timeframe bias analysis.
//
// FEATURES:
// • Multi-stage ORB levels (5, 15, 30, 60 minutes)
// • Breakout and retest detection with cycle counting
// • Volume, trend, and HTF bias filters
// • Position sizing with risk management
// • Target/stop-loss visualization
// • Real-time dashboard with trade parameters
//
// BEST PRACTICES:
// • Recommended for liquid stocks with >1M daily volume
// • Best on 5-minute charts during regular trading hours
// • Paper trade first to understand the signals
// • Use with proper risk management (1-2% risk per trade)
// • Combine with overall market analysis
//
// LIMITATIONS:
// • May produce dangerous signals in choppy/ranging markets
// • Requires clean data feed for accurate ORB calculation
// • Not suitable for all market conditions
// • Performance varies by instrument and timeframe
//
// CREDITS:
// • Based on Opening Range Breakout concepts by Mark Fisher
// • Enhanced with modern technical analysis techniques
// • Original implementation by OrenLuxy
//

// =========================================== TYPE DEFINITIONS ======================================

type ORBData
    string name
    int    minutes
    float  high
    float  low
    float  mid
    float  orbRange
    bool   isEnabled
    bool   isBuilding
    bool   isComplete
    int    completionBar
    bool   breakoutUp
    bool   breakoutDown
    int    breakoutBar
    float  breakoutLevel
    int    cyclesUp
    int    cyclesDown
    box    orbBox
    line   highLine
    line   lowLine
    line   midLine
    label  edgeLabel
    color  orbColor
    int    lineWidth
    string lineStyle

// ================================================ GROUPS ===========================================

grp_colors   = "🎨 ORB COLORS ▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬"
grp_session  = "⏰ SESSION SETTINGS ▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬"
grp_breakout = "⚡ BREAKOUT DETECTION ▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬"
grp_targets  = "🎯 TARGETS & RISK ▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬"
grp_lines    = "📍 TP/SL LINES ▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬"
grp_volume   = "📊 VOLUME FILTER ▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬"
grp_trend    = "📈 TREND FILTER ▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬"
grp_dash     = "📊 DASHBOARD ▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬"
grp_htf      = "📈 HIGHER TIMEFRAME ▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬"
grp_index    = "📊 INDEX DIRECTION FILTER ▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬"
grp_smart    = "🧠 SMART ENTRY FILTERS ▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬"
grp_nrfilter = "🔻 NR FILTER (Crabel) ▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬"
grp_god      = "⚡ GOD MODE (breakout quality) ▬▬▬▬▬▬▬▬▬▬"
grp_vp       = "📐 VOLUME PROFILE (VAH/POC/VAL) ▬▬▬▬▬▬▬▬▬"
grp_keylevel = "🔑 KEY-LEVEL TRIGGERS ▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬"
grp_score    = "🧮 KEY-LEVEL SCORING ▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬"

// ============================================ CONSTANTS ============================================

LABEL_OFFSET_ATR_MULTIPLIER = 0.8  // 0.8× ATR distance from high/low
LABEL_OFFSET_BARS = 2              // Bars ahead for edge labels (keeps them visible)

MAX_BARS_FAILED_BREAK = 5  // Maximum bars to consider a retest as "failed break" instead of committed breakout

// Key-level tag placement. ORB edge labels sit at LABEL_OFFSET_BARS (2), so key-level
// tags start further right to stop "IBH 2329.0" printing through the "ORB15" badge when
// the two levels coincide. STEP is how far a colliding tag is pushed — roughly the width
// of a "VAH 2289.25" string. MIN_GAP throttles signal TEXT (arrows are never throttled).
KL_TAG_OFFSET_BARS = 6
KL_TAG_STEP_BARS   = 11
KL_LABEL_MIN_GAP   = 6
showEdgeLabels = false
labelFormat = "Detailed"
labelSize = "Small"
showBG = true
fillTransparency = 95
enableORB15Signals = true
orb15LineColor = #FF9800
showMidLine = true

sessionMode = "Auto-Detect"
customSession = "0915-1530"


entryCutoffHour = input.int(11, "Entry Cutoff Hour", minval=9, maxval=15, group=grp_session, inline="cutoff", tooltip="Stop taking new entries after this hour\n\nRECOMMENDED: 11:00 AM for Indian market\n\nWHY:\n• ORB momentum strongest 09:45-10:30\n• 10:30-11:00 still catches valid late breakouts\n• Entries after 11:00 show lower win rates\n• Avoids weak momentum / choppy midday signals\n\nOPTIONS:\n• 11 (+ 0 min): Default - balances signal capture vs quality\n• 10 (+ 30 min): Aggressive filter based on Q1 2026 data\n• 12: Too late (not recommended)")
entryCutoffMinute = input.int(45, "Minute", minval=0, maxval=59, group=grp_session, inline="cutoff", tooltip="Minutes past the hour for cutoff\n\nEXAMPLE: Hour=11, Minute=0 = 11:00 AM cutoff")

timeExitHour = input.int(15, "Time Exit Hour", minval=12, maxval=15, group=grp_session, inline="timeexit", tooltip="Force exit open positions at this hour\n\nRECOMMENDED: 15:00 (3 PM) for Indian market\n\nWHY:\n• Gives trades 4.5 hours from 10:30 entry to hit TP\n• Exits before broker auto square-off at 15:10-15:20\n• Avoids auto square-off penalty charges (Rs 20-50/order)\n\nOPTIONS:\n• 14: Conservative (exit early, may cut winners short)\n• 15: Balanced — avoids broker charges\n• 15 (+05 min): Risky — too close to auto square-off")
timeExitMinute = input.int(0, "Minute", minval=0, maxval=59, group=grp_session, inline="timeexit", tooltip="Minutes past the hour for time exit\n\nSet to 0 (15:00) to exit before broker auto square-off at 15:10")


string tradingSession = "0915-1530:23456"  // Default: NSE/BSE hours, Mon-Fri (India)
string sessionTimezone = "Asia/Kolkata"  // Default: Indian Standard Time
var int sessionStartHour = na
var int sessionStartMinute = na
var int sessionEndHour = na
var int sessionEndMinute = na
bool useElectronicFullDay = false  // Track if E-mini futures using Electronic Full Day mode (24hr from 9:30-9:30)

if sessionMode == "Auto-Detect"
    // NSE/BSE only: the native session is always correct here, and TradingView handles
    // its hours, timezone and holidays. The upstream asset-type tree (futures/crypto/
    // forex/extended-hours) resolved to this same empty string on every Indian-equity
    // path, so it was dead weight against the compiled-token budget.
    tradingSession := ""

else if sessionMode == "Custom"
    if str.contains(customSession, ":")
        tradingSession := customSession
    else
        tradingSession := customSession + ":23456"

// Only parse session string if it's not empty (native session uses empty string)
if tradingSession != ""
    string sessionTimeOnly = str.contains(tradingSession, ":") ? str.split(tradingSession, ":").get(0) : tradingSession
    array<string> sessionParts = str.split(sessionTimeOnly, "-")

    if array.size(sessionParts) == 2
        string startTime = array.get(sessionParts, 0)
        string endTime = array.get(sessionParts, 1)

        if str.length(startTime) == 4
            sessionStartHour := int(str.tonumber(str.substring(startTime, 0, 2)))
            sessionStartMinute := int(str.tonumber(str.substring(startTime, 2, 4)))

        if str.length(endTime) == 4
            sessionEndHour := int(str.tonumber(str.substring(endTime, 0, 2)))
            sessionEndMinute := int(str.tonumber(str.substring(endTime, 2, 4)))

// ========================================================================================
// E-MINI FUTURES GLOBAL OVERRIDE (DISABLED FOR INDIAN MARKET)
// ========================================================================================
// Not applicable for Indian stock market (NSE/BSE)
// Indian market uses fixed session: 0915-1530 IST (Asia/Kolkata)
// ========================================================================================

// ========================================================================================

enableBreakout = input.bool(false, "ORB breakout entries", inline = "Show", group=grp_breakout, tooltip="Let the OPENING RANGE fire its own entries.\n\nOFF (default): ORB is demoted to a LEVEL. ORB high/low/mid are still drawn and still count toward key-level confluence — they simply do not trigger trades of their own. The session's single entry slot is then always available to the key-level engine, so an early ORB break can no longer consume it before a better IB or value-area setup appears.\n\nON: classic behaviour — ORB competes for the slot first-come-first-served.")
showBreakLabels = input.bool(true, "Show Breakout Labels", group=grp_breakout, inline = "Show", tooltip="Detect and label breakouts above ORB High or below ORB Low\n\nON: Shows breakout labels when price exits ORB range\nOFF: Only displays ORB levels without signals\n\nBreakouts detected on CLOSE (no repaint)")
enableRetest = true
signalMode = "Track Cycles"
maxCycles = 6
breakoutBuffer = input.float(0.5, "Breakout Buffer (%)", minval=0, maxval=5, step=0.1, group=grp_breakout, inline="buffer", tooltip="Extra distance required beyond ORB level for breakout\n\nPREVENTS: False breakouts from tiny penetrations\n\nHOW IT WORKS:\n• UP: Price must close ABOVE (ORB High + buffer%)\n• DOWN: Price must close BELOW (ORB Low - buffer%)\n\nRECOMMENDATIONS:\n• 0.0% = Exact level (sensitive, more signals)\n• 0.1% = Tiny buffer (recommended)\n• 0.3% = Moderate filter\n• 0.5%+ = Conservative (fewer signals)\n\nHigher = fewer but stronger breakouts")
retestBuffer = 0.0
minRetestDistancePct = 0.5
minBarsOutside = 2
minPullbackPct = 0.3

enableVolumeFilter = input.bool(true, "Enable Volume Filter", group=grp_volume, inline="enable", tooltip="Require volume confirmation for breakout signals\n\nWHY: High volume breakouts are more reliable\nWHAT: Compares current volume to moving average\n\nON: Only shows breakouts with sufficient volume\nOFF: Shows all breakouts regardless of volume\n\nRECOMMENDED: ON for stocks, OFF for crypto")
volBaseDays    = input.int(14, "| Baseline days", minval=2, maxval=30, group=grp_volume, inline="enable", tooltip="How many PREVIOUS sessions form the volume baseline.\n\nEach bar is compared against the same slot of the session on these prior days, so the reading is time-of-day normalised: a 09:20 bar is measured against 09:20 bars, not against a rolling window that is mostly yesterday's close.\n\n14 = matches the Zarattini/Barbon/Aziz (SFI 2024) relative-volume definition, which that study found did almost all the work in ORB selection across 7,000+ stocks\n7  = the BreakingTrade cheat sheet's Volume Factor window; faster to adapt, noisier\n\nNeeds at least 3 prior sessions loaded before it reads; it does NOT wait for the full window. Until then the volume filter passes everything rather than blocking (fail-open).")
volumeMultiplier = input.float(1.2, "Min Volume ×", minval=0.5, step=0.1, group=grp_volume, inline="mult", tooltip="Minimum volume multiplier required for breakout\n\nCURRENT VOLUME must be ≥ (Volume MA × Multiplier)\n\nEXAMPLE: Volume MA = 1M shares, Multiplier = 1.2\n• Breakout with 1.3M volume = Valid\n• Breakout with 1.0M volume = Rejected\n\nRECOMMENDATIONS:\n• 1.0x = Any above-average volume\n• 1.2x = Balanced for Indian stocks (recommended)\n• 1.5x = Moderate requirement\n• 2.0x+ = Very selective\n\nHigher = fewer but higher-quality signals")
strongVolumeMultiplier = input.float(1.8, "Strong ×", minval=1.0, step=0.1, group=grp_volume, inline="mult", tooltip="Strong volume override threshold\n\nSPECIAL RULE: If volume exceeds this multiplier:\n→ SKIPS retest wait, enters immediately\n\nRATIONALE: Strong volume = institutional activity, no need to wait\n\nEXAMPLE: Volume MA = 1M, Strong = 1.8×\n• Breakout with 2M volume → Enters immediately without waiting for retest\n\nRECOMMENDATIONS:\n• 1.8× = More entries (recommended) ⭐\n• 2.0× = Balanced\n• 2.5× = More selective\n\nMUST BE ≥ Min Volume Multiplier")

// Trend Filter
enableTrendFilter = input.bool(true, "Enable Trend Filter", group=grp_trend, inline = "FILTER", tooltip="Only show breakouts that align with broader trend\n\nWHY: Trend-aligned breakouts have higher success rate\nWHAT: Checks if price is above/below trend indicator\n\nRULES:\n• UP breakout: Only if price ABOVE trend\n• DOWN breakout: Only if price BELOW trend\n\nON: Filters against-trend breakouts\nOFF: Shows all breakouts\n\nRECOMMENDED: ON for conservative trading")
trendMode = input.string("VWAP", "| Trend Mode",inline = "FILTER", options=["VWAP", "EMA", "Custom EMA", "SuperTrend", "VWAP+EMA", "VWAP+SuperTrend"], group=grp_trend, tooltip="Method to determine trend direction\n\nVWAP (Volume-Weighted Average Price):\n• Accounts for volume in price calculation\n• Good for: Intraday trading\n• Above VWAP = Bullish, Below = Bearish\n\nEMA (12-period):\n• Fast exponential moving average\n• Responsive to recent price action\n• Good for: Quick trends\n\nCUSTOM EMA:\n• Your own EMA period\n• Longer = Smoother trend\n• Good for: Swing trading (50-200 period)\n\nSUPERTREND:\n• ATR-based trailing stop\n• Clear trend direction\n• Good for: Strong trends\n\nVWAP+EMA:\n• BOTH must agree\n• More conservative\n• Fewer but higher quality signals\n\nVWAP+SUPERTREND:\n• BOTH must agree\n• Most conservative\n• Best signal quality")

customEmaLength = 50
supertrendPeriod = 10
supertrendMult = 3.0

// ========================================= TARGETS & RISK MANAGEMENT ================================
enableTargets = input.bool(true, "Enable Targets & Stop-Loss", group=grp_targets, tooltip="Calculate and display profit targets (TP) and stop-loss (SL)\n\nWHEN ENABLED:\n• Shows TP/SL lines on chart during breakout\n• Displays values in dashboard\n• Calculates Risk/Reward ratio\n\nWHEN DISABLED:\n• Only shows ORB levels\n• No trade management\n\nRECOMMENDED: ON for active trading")

showTP1 = true
showTP1_5 = true
showTP2 = true
showTP3 = true

// Exit quantity percentages per TP level — included in TP HIT alerts as ExitQtyPct field.
// Signal engine reads ExitQtyPct directly; no tp_levels config needed in signal engine.
// 50 = exit 50% of current open position at this TP level.
// 100 = exit 100% of remaining position (full close).
tp1ExitQtyPct   = input.int(50,  "TP1 Exit %",   minval=0, maxval=100, group=grp_targets, inline="exitpct", tooltip="% of open position to exit at TP1\n\n50 = partial exit (bank half, hold rest for TP1.5)\n100 = full exit at TP1 (original behavior)\n\nData: 72.3% of TP1 trades also reach TP1.5 — 50% partial exit captures both wins.")
tp1_5ExitQtyPct = input.int(100, "TP1.5 Exit %", minval=0, maxval=100, group=grp_targets, inline="exitpct", tooltip="% of remaining open position to exit at TP1.5\n\n100 = exit remaining position fully\n\nTP2/TP3 also default to 100 (exit whatever remains).")

// Adaptive R:R - Auto-switch to TP2 when trending
enableAdaptiveRR = false
adxThreshold = 25
adxLength = 14

stopMode = input.string("ATR", "Stop Method", options=["ATR", "ORB %", "Swing", "Safer", "Scaled ATR", "% Based", "Smart Adaptive"], group=grp_targets, inline="tgt", tooltip="How to calculate Stop Loss placement\n\n🆕 ATR-BASED VOLATILITY SYSTEM:\n\nSMART ADAPTIVE (Recommended) ⭐:\n• Adjusts to ACTUAL volatility (not price)\n• ATR < 1.5% = Tight stop (0.7× ATR)\n• ATR 1.5-3% = Normal stop (1.0× ATR)\n• ATR > 3% = Wide stop (1.5× ATR)\n• Perfect for: ALL assets automatically\n\nSCALED ATR:\n• Dynamic multiplier based on volatility %\n• Very volatile (>5% ATR): 2.5× ATR\n• High volatility (3-5%): 2.0× ATR\n• Normal (1.5-3%): 1.5× ATR\n• Low (<1.5%): 1.2× ATR\n• Good for: Mixed portfolios\n\nATR:\n• Standard ATR with volatility adjustment\n• Multiplier adjusts to market conditions\n• Formula: SL = Entry ± (ATR × Multiplier × VolAdjust)\n• Good for: Traditional traders\n\n% BASED:\n• Fixed percentage from entry\n• You set the % (e.g., 1.0%)\n• Simple and consistent\n• Good for: Beginners\n\n────────────────────────\n\n🔥 NEW VOLATILITY PROTECTION:\n\nALL METHODS NOW USE ATR-BASED MINIMUMS:\n• Crypto: Min 1.0× ATR (wider for volatility)\n• Forex: Min 0.3× ATR (tighter for stability)\n• Stocks: Min 0.5-1.5× ATR (based on volatility)\n\nABSOLUTE MINIMUMS:\n• Crypto: 1.0% of price\n• Forex: 0.2% of price\n• Stocks: 0.3% of price\n\n────────────────────────\n\nORB %:\n• Fixed percentage beyond ORB level\n• Simple and predictable\n• Formula: SL = ORB_Level ± (ORB_Range × %)\n• Good for: ORB-focused trading\n\nSWING:\n• Placed at recent swing high/low\n• Technical support/resistance\n• Respects chart structure\n• May be far from entry\n• Good for: Technical traders\n\nSAFER:\n• Widest stop of all methods\n• Lowest chance of stop-out\n• Largest potential loss\n• Good for: Risk-averse traders")
atrLength = input.int(14, "ATR", minval=5, maxval=50, group=grp_targets, inline="atr2", tooltip="ATR calculation period\n\nATR = Average True Range = How much price moves\n\nSHORTER = More reactive to recent volatility\nLONGER = Smoother, stable average\n\nRECOMMENDATIONS:\n• 7-10: Day trading, responsive\n• 14: Standard, balanced (recommended) ⭐\n• 20-30: Swing trading, smooth\n\nUSED FOR: ATR-based targets and stops")
atrMultiplier = input.float(2.0, "×", minval=0.5, maxval=3, step=0.1, group=grp_targets, inline="atr2", tooltip="ATR multiplier for stop-loss distance\n\nSL = Entry ± (ATR × Multiplier)\n\nLOWER = Tighter stop, less risk, more stop-outs\nHIGHER = Wider stop, more risk, fewer stop-outs\n\nRECOMMENDATIONS:\n• 1.0×: Tight stop (aggressive)\n• 1.5×: Balanced (recommended) ⭐\n• 2.0×: Loose stop (conservative)\n• 2.5×+: Very loose (volatile stocks)\n\nONLY AFFECTS: ATR stop method")
percentBasedStop = 1.0
stopOrbFraction = 20
swingBars = 3
showTPSLLines = true
freezeOnEOD = true

// ============================================ DASHBOARD ============================================
showDashboard = input.bool(true, "Show Info Panel", group=grp_dash, inline="theme")
dashTheme = "Dark"
dashPos = input.string("Bottom Left", "Position", options=["Top Left", "Top Right", "Bottom Left", "Bottom Right", "Middle Right"], group=grp_dash, inline="pos", tooltip="Dashboard placement on chart\n\nTOP LEFT: Good for price action top-right\nTOP RIGHT: Good for price action top-left\nBOTTOM LEFT: Classic placement (recommended) ⭐\nBOTTOM RIGHT: Avoid volume bars\nMIDDLE RIGHT: Floating position\n\nChoose based on where price usually is")
dashMode = input.string("Focus", "Detail", options=["Focus", "Full"], group=grp_dash, tooltip="FOCUS (default) — the verdict line plus the handful of readings that produced it. Built for a live session where trades are placed automatically: you need to know what the system is doing and why, not re-derive the decision yourself.\n\nFULL — every legacy ORB row as well: stage, range, volatility, the individual filter pass/fail lines, all level prices, position sizing. Use it when auditing why something did or did not fire.")
dashSize = input.string("Auto", "Text Size", options=["Auto", "Small", "Normal", "Large"], group=grp_dash, inline="pos", tooltip="Text size inside dashboard\n\nAUTO: Adapts to chart zoom (recommended) ⭐\nSMALL: Compact, more screen space\nNORMAL: Readable\nLARGE: Presentations, poor eyesight")
showStage = dashMode == "Full"
showRange = dashMode == "Full"
showStatus = dashMode == "Full"
showVol = dashMode == "Full"
showTrend = dashMode == "Full"
showRisk = dashMode == "Full"
showVolatilityMeter = dashMode == "Full"

enablePosSizing = true
riskMode = "% of Account"
fixedRisk = 200
accountSize = input.float(10000, "Account INR", minval=1000, group=grp_dash, inline="acct", tooltip="Total trading account size in INR\n\nUSED FOR: Calculating risk percentage\n\nEXAMPLE: Account = INR 10,000, Risk = 2%\n• Risk per trade = INR 200\n\nUPDATE THIS:\n• When account grows/shrinks significantly\n• For accurate position sizing\n• Monthly review recommended")
riskPct = input.float(1.0, "Risk %", minval=0.1, maxval=5, step=0.1, group=grp_dash, inline="acct", tooltip="Percentage of account to risk per trade\n\nONLY USED when Risk Mode = % of Account\n\nRISK LEVELS:\n• 0.5-1%: Conservative\n• 1-2%: Balanced (recommended) ⭐\n• 2-3%: Aggressive\n• 3%+: Very aggressive, not recommended\n\nEXAMPLE: Account = INR 10,000, Risk = 2%\n• Risk per trade = INR 200\n• Entry: 100, Stop: 98 (2 risk per share)\n• Position: 100 shares\n\nRECOMMENDED: 1-2% for most traders")
enablePosLimit = false
maxPositionPct = 100.0

// ======================================= HIGHER TIMEFRAME FILTER ===================================
enableHTF = input.bool(true, "Check Daily Trend", group=grp_htf, tooltip="Check higher timeframe trend before taking breakouts\n\nWHY: Breakouts WITH higher timeframe trend have higher success rate\n\nWHAT IT DOES:\n• Checks daily/4H/weekly trend\n• Shows warning if breakout against trend\n• Displays HTF bias in dashboard\n\nDOES NOT BLOCK signals - only warns you\n\nON: Shows HTF context (recommended for swing traders)\nOFF: Focuses only on intraday ORB")
htfTF = input.string("D", "Timeframe", options=["15", "30", "60", "120", "240", "D", "W", "M"], group=grp_htf, inline="htf", tooltip="Higher timeframe to analyze for trend\n\nRECOMMENDED OPTIONS:\n• 15/30/60 min: For 1-5 min charts\n• 240 (4H): For 15-60 min charts\n• D (Daily): For intraday trading ⭐\n• W (Weekly): For swing trading\n• M (Monthly): For position trading\n\nRULE: HTF should be 4-10× your chart timeframe\n\nEXAMPLES:\n• 5min chart → Use 30/60/D\n• 15min chart → Use 60/240/D\n• 1H chart → Use 240/D/W")
htfMethod = "Price vs MA"
htfEMA = 20
htfMinStrength = 2.0
blockCounterTrend = input.bool(true, "Block Counter-Trend", group=grp_htf, inline="htf3", tooltip="BLOCK entries that go against the HTF (daily) trend\n\nWHEN ENABLED:\n• LONG entries blocked when HTF is bearish\n• SHORT entries blocked when HTF is bullish\n• Significantly reduces losing trades\n\nWHEN DISABLED:\n• Shows warning only (original behavior)\n• Entries allowed against HTF trend\n\nRECOMMENDED: ON - Today's losses were all counter-trend trades")

// ======================================= INDEX DIRECTION FILTER ==================================
enableIndexFilter = input.bool(true, "Enable Index Filter", group=grp_index, inline="idx1", tooltip="Filter trades based on broad market (NIFTY 50) direction\n\nWHY: 60-80% of intraday stock movement correlates with NIFTY direction\nBlocking counter-index entries significantly reduces false breakouts\n\nIntegrates into 'both against' blocking logic:\n- Entry blocked only when MULTIPLE filters oppose the direction\n\nON: Check NIFTY direction before entry\nOFF: Ignore market direction")
indexSymbol = input.string("NSE:NIFTY", "Index Symbol", group=grp_index, inline="idx1", tooltip="Reference index for direction filter\n\nRECOMMENDED:\n• NSE:NIFTY - Best for most Indian stocks (default)\n• NSE:BANKNIFTY - Banking/finance stocks\n\nNIFTY 50 correlates with 60-80% of all NSE stocks on intraday basis\nEven non-NIFTY stocks follow broad market direction")
indexFilterMethod = "Price vs VWAP"
indexEMALength = 20

// ======================================= SMART ENTRY FILTERS =====================================
// These filters help avoid exhaustion moves in gap stocks

enableGapFilter = input.bool(true, "Enable Gap Filter", group=grp_smart, inline="gap1", tooltip="Filter trades based on opening gap size\n\nLarge gaps (>2%) often fade/reverse\nSmall gaps (<1%) more likely to continue\n\nON: Skip entries on large gap days\nOFF: Trade all gaps")
maxGapPercent = input.float(2.5, "Max Gap %", minval=0.5, maxval=5.0, step=0.5, group=grp_smart, inline="gap1", tooltip="Maximum gap size to allow trading\n\nGaps larger than this will be skipped\n\nRECOMMENDED:\n2.0-2.5% for volatile Indian stocks")

enableORBRangeFilter = input.bool(true, "Enable ORB Range Filter", group=grp_smart, inline="orbrange1", tooltip="Filter based on ORB range width\n\nWide ORB = momentum already spent in range formation\nNarrow ORB = consolidation, better breakout potential\n\nON: Skip wide ORB ranges\nOFF: Trade all ranges")
minORBRangePercent = input.float(0.4, "Min ORB Range %", minval=0.0, maxval=2.0, step=0.1, group=grp_smart, inline="orbrange1", tooltip="Minimum ORB range as % of price\n\nIf ORB range < this %, skip the trade\n\nToo narrow ORB = choppy, no clear range\n\nRECOMMENDED: 0.4% to allow more setups")
maxORBRangePercent = input.float(3.5, "Max %", minval=0.5, maxval=10.0, step=0.25, group=grp_smart, inline="orbrange1", tooltip="Maximum ORB range as % of price\n\nIf ORB High-Low > this %, skip the trade\n\nRECOMMENDED: 3.5% for volatile Indian stocks")

enableRetestEntry = false
retestEntryBuffer = 0.6
retestEntryTimeout = 20
consolidationBars = 2
consolidationZonePercent = 1.2

enableMinEntryTime = input.bool(true, "Enable Min Entry Time", group=grp_smart, inline="mintime", tooltip="Don't enter trades before this time\n\nLets initial gap volatility settle\nBreakouts after 9:45 are more reliable\n\nON: Wait for minimum time\nOFF: Enter anytime after ORB forms")
minEntryHour = input.int(9, "Hour", minval=9, maxval=12, group=grp_smart, inline="mintime")
minEntryMinute = input.int(45, "Min", minval=0, maxval=59, group=grp_smart, inline="mintime", tooltip="Minimum time before taking entries\n\nRECOMMENDED: 9:45 AM\nLets first 30 min volatility settle")

// ====================== NR FILTER (Toby Crabel narrow-range pre-filter) =====================
// Daily-timeframe regime filter: trade only when yesterday's range was the narrowest
// of the last N trading days. Academic research and Crabel's "Day Trading with Short
// Term Price Patterns" show ORB breakouts after a narrow-range day have ~70-75% follow-
// through vs 55-60% baseline. NR7 fires on roughly 14% of days per stock — intentionally rare.
//
// Two modes:
//   Prefer  — track NR state for visual / future scoring; do NOT block any entries.
//             Default-on shape lets you measure NR-day WR uplift without hurting density.
//   Require — block entries when yesterday was NOT NR. Strict; cuts daily trade count by ~85%.
//
// Default enableNRFilter=false: turning the input on with mode=Prefer is a pure no-op for
// trade execution (so backtests with feature on/off must produce identical results).
enableNRFilter = input.bool(false, "Enable NR Filter", group=grp_nrfilter, inline="nr1", tooltip="Toby Crabel narrow-range pre-filter\n\nTrade only after a narrow-range day\n\nWHY:\n• ORB breakouts after NR days have ~70-75% follow-through\n• Baseline (no NR filter): ~55-60%\n• Identifies coiled-spring setups\n\nFires on ~14% of days per stock (NR7 default)\n\nDEFAULT: OFF — turn on after Strategy-Tester validates NR uplift")
nrLookback = 7
nrMode = "Prefer"

// ============================================ GOD MODE =============================================
// Ported from the upstream Luxy indicator. Grades the ORB breakout itself 0-100 (A+..D),
// widens the breakout buffer on volatile tickers, and flags chop days. Distinct from the
// key-level score below: that one grades VA/PD/IB setups, this one grades the ORB break.
// Rebuilt on this file's existing state (cachedVolBaseline, cachedHTF*, klATRDaily, todayOpen,
// prevDayClose, sessionBreakouts*) rather than re-deriving it — no new request.security.
godModeEnabled = input.bool(true, "Enable GOD MODE", group=grp_god, tooltip="Breakout-quality layer for the ORB signal\n\nADDS:\n• Adaptive breakout buffer scaled by ATR\n• Chop-Day Guard after repeated failed breaks\n\nThe 0-100 quality score was REMOVED: it appeared only in label text and dashboard cells, never in a breakout or entry condition, so it changed no trade while costing ~90% of this layer's tokens. The two remaining pieces both affect trade selection.\n\nOFF = classic behaviour, exactly as before.")
godAdaptiveBuffer = true
godChopGuard = true

// ================================= KEY-LEVEL BREAKOUT (VP / PD / IB) ===============================
// ORB is one key level among several. This section adds the other levels a breakout
// trader watches — previous-session Value Area (VAH/POC/VAL), Previous Day High/Low,
// and the Initial Balance (09:15-10:15) — as ADDITIONAL, independently toggleable
// breakout triggers that run through the same entry/SL/TP/alert pipeline as ORB.
//
// SAFETY POSTURE: alert-only by default. `enableKeyLevelExecution` is OFF, so these
// setups draw arrows, score, and fire a decision-packet alert but never call
// strategy.entry. With every toggle at its default, backtest results are identical
// to orb.pine — that inertness is the regression gate for this whole feature.
//
// Merged from pinescripts/intraday/volume-profile/volume-profile-decision-assist.pine

// ─── Value Area source ──────────────────────────────────────────────────────
// AUTO   — reconstruct the previous session's profile from 1-min data inside this
//          script. Self-contained but approximate; tune ticksPerRow to match TV.
// MANUAL — type the three numbers off TradingView's native Session Volume Profile.
//          Exact, ~30s each morning. Pine cannot read another indicator's values.
klAutoProfile  = input.bool(true, "Auto-reconstruct profile", group=grp_vp, inline="src", tooltip="Where VAH/POC/VAL come from\n\nON (Auto):\n• Builds the previous session's volume-at-price histogram from 1-min data\n• No dependency on any other indicator\n• APPROXIMATE — tune 'Ticks per row' to match TradingView\n\nOFF (Manual):\n• Uses the Manual VAH/POC/VAL inputs below\n• Read them off TradingView's native Session Volume Profile (previous day)\n• Exact, but needs ~30 seconds of typing each morning\n\nUse Manual whenever exact levels matter.")
klTicksPerRow  = 5
klValueAreaPct = 70
klManualVAH    = 0.0
klManualPOC    = 0.0
klManualVAL    = 0.0

// ─── Trigger families ───────────────────────────────────────────────────────
enableKeyLevels    = input.bool(true, "Enable Key-Level Engine", group=grp_keylevel, tooltip="Master switch for the whole key-level layer\n\nOFF: no levels resolved, no profile accumulation, no scoring,\nno drawing, no key-level alerts. The script behaves exactly\nlike the original ORB strategy.\n\nON: levels are computed, drawn and scored. Whether they can\nOPEN A TRADE is controlled separately by 'Execute key-level\nsetups' below (default OFF).")
enableVAAcceptance = input.bool(true, "| incl. VA acceptance", group=grp_keylevel, inline="fam1b", tooltip="Allow plain VALUE-AREA ACCEPTANCE (VAH-ACC / VAL-ACC) to fire.\n\nOFF by default, and recommended OFF for live trading. Acceptance is the weakest family in the model: no retest, no rejection structure, just two closes beyond the level. It was the family firing at exactly 7/7 before the confluence double-count was fixed.\n\nVA REJECTION and VA RETEST are unaffected — they keep firing whenever Value-Area triggers are on.")
enableVATriggers   = input.bool(true, "| VAH / VAL setups", group=grp_keylevel, inline="fam1", tooltip="Value-Area setups from the volume-profile model\n\n• VAH rejection      — poke above VAH, close back inside → SHORT\n• VAL rejection      — poke below VAL, close back inside → LONG\n• VAH acceptance     — two consecutive closes above VAH   → LONG\n• VAL breakdown      — two consecutive closes below VAL   → SHORT\n• VAH/VAL retest     — break, pull back, hold the level")
enablePDTriggers   = input.bool(true, "| PDH / PDL setups", group=grp_keylevel, inline="fam1", tooltip="Previous Day High / Low breakout + retest\n\nPDH/PDL are the most widely watched intraday levels.\nA clean break with volume tends to run; a failed break\nreverses hard.")
enableIBTriggers   = input.bool(true, "| IBH / IBL setups", group=grp_keylevel, inline="fam2", tooltip="Initial Balance (09:15-10:15) High / Low breakout + retest\n\nIB extension is the classic Market Profile trend-day tell.\nBreaking IB after 10:15 on expanding volume is a strong\ncontinuation signal.")
klIBSession        = input.session("0915-1015", "| IB window", group=grp_keylevel, inline="fam2", tooltip="Initial Balance window (IST)\n\nMarket Profile defines IB as the first hour of trade.\nFor NSE that is 09:15-10:15.")
klRetestMaxBars    = input.int(6, "Retest window (bars)", minval=1, maxval=30, group=grp_keylevel, inline="tune", tooltip="How many bars after a level break a pullback still counts as a retest\n\nSHORTER = only immediate retests qualify\nLONGER  = late pullbacks still count, more signals\n\nRECOMMENDED: 6 bars")
klCooldownBars     = input.int(3, "| Cooldown", minval=0, maxval=50, group=grp_keylevel, inline="tune", tooltip="Minimum bars between two key-level alerts\n\nPrevents a single level from spamming alerts while price\nchops around it.\n\n0 = no cooldown")
enableKeyLevelExecution = input.bool(true, "⚠ Execute key-level setups", group=grp_keylevel, tooltip="Let key-level setups OPEN REAL TRADES\n\nOFF (default) ⭐:\n• Setups draw arrows, score, and fire alerts\n• strategy.entry is NEVER called for them\n• Backtest is identical to the plain ORB strategy\n• Use this to observe and validate first\n\nON:\n• A qualifying key-level setup enters through the SAME\n  pipeline as an ORB breakout (next-bar fill, same SL/TP,\n  same Telegram entry alert)\n• Still bound by the one-trade-per-session cap and the\n  entry cutoff time\n\nTurn this on only after the Strategy Tester and live alert\nlog confirm the setups are worth trading.")

// ─── Scoring ────────────────────────────────────────────────────────────────
klScoreThreshold = input.int(7, "Alert score threshold", minval=1, maxval=20, group=grp_score, tooltip="Minimum weighted score for a key-level setup to fire\n\nSCORE COMPONENTS:\n+2  major level interaction\n+1  per confluent structural level (max +3)\n+2  two or more confluent levels\n+2  breakout-and-retest structure\n+1  VWAP aligned with direction\n+1  EMA9 aligned + sloping with direction\n+1/+2 RVOL at min / strong threshold\n+1  strong candle close (CLV)\n+1  session volume factor at or above Min Volume ×\n\nLOWER = more signals, more noise\nHIGHER = rare, high-conviction only\n\nRECOMMENDED: 7")
// RVOL tiers reuse volumeMultiplier / strongVolumeMultiplier from the VOLUME FILTER
// group — one definition of "strong volume" for the whole script, not two.
klClvLongMin     = 0.65
klClvShortMax    = 0.35
klAccMinRvol     = input.float(1.5, "Acceptance min RVOL", minval=0, maxval=10, step=0.1, group=grp_score, tooltip="Extra volume bar that ACCEPTANCE setups (VAH-ACC / VAL-ACC) must clear, on top of the normal volume filter.\n\nThe model doc requires RVOL >= 1.5 for every entry, and acceptance is the family that most needs it: its whole thesis is that price is HOLDING beyond value with participation behind it. Two closes past a level on thin volume is drift, not acceptance.\n\nRejection and retest setups are unaffected — their thesis is absorption, which does not require expansion.\n\n0 = no extra requirement.")
klConfAtrMult    = input.float(0.25, "Confluence band (× ATR)", minval=0.01, maxval=2, step=0.05, group=grp_score, tooltip="Two levels within this many ATRs are treated as confluent\n\nAlso used as the retest tolerance band.\n\nTIGHTER = fewer confluence hits, stricter retests\nWIDER   = more confluence hits, looser retests\n\nRECOMMENDED: 0.25 × ATR")
klSlBufferMult   = input.float(0.35, "SL buffer (× ATR beyond level)", minval=0, maxval=2, step=0.05, group=grp_score, tooltip="How far beyond the triggering level the stop sits\n\nA level-based stop goes just past the level that was defended,\nplus this ATR cushion to survive normal noise and stop hunts.\n\nUsed only for key-level setups. ORB entries keep their own\nstop-loss mode from the TARGETS & RISK group.")
klT1PadMult      = input.float(0.15, "T1 pad (× ATR short of level)", minval=0, maxval=2, step=0.05, group=grp_score, tooltip="How far IN FRONT of the next structural level the first target sits\n\nThe level itself is where every other trader's limit orders rest, so price\nfrequently stalls a few ticks short of it and reverses. Parking T1 inside\nthat queue trades a little reward for a materially better fill rate.\n\n0 = target exactly at the level (old behaviour)\n0.15 = recommended\n\nIf the pad would put T1 inside the noise around entry, T1 reports '-'\ninstead: that setup has no room to a structural target.")
klMaxChaseATR    = input.float(1.0, "Max chase from level (× ATR)", minval=0, maxval=5, step=0.25, group=grp_score, tooltip="Refuse a setup whose confirming bar has already closed this far beyond the level.\n\nA retest is supposed to be entered NEAR the level it defended. If confirmation only arrives once price has run a full ATR past it, the good part of the move is gone and the stop — still measured from the level — is now much further away, so the R:R quietly collapses.\n\nThis does not improve the fill; it declines the ones that are already bad.\n\n1.0 = recommended\n0 = disabled")
klMinHeadroomR   = input.float(1.0, "Min headroom (R to ADR projection)", minval=0, maxval=10, step=0.25, group=grp_score, tooltip="Refuse a setup that has no room left to run.\n\nProjects where the day would top out if its range expanded to a normal ADR (day low + ADR for a long), measures the distance from entry to there, and divides by the trade's own risk. 2.0 means \"two times my stop distance of room remains\".\n\nThis is the objective form of \"do not buy a breakout after the move is done\" -- the single most common way a technically valid signal still loses.\n\nADR is an AVERAGE, and a genuine trend day blows straight through the projection, so the default is deliberately permissive.\n\n1.0 = must have at least its own risk in room (recommended)\n1.5-2.0 = stricter, skips late entries\n0 = disabled")
enableAfternoonWindow = input.bool(true, "Second entry window (PM)", group=grp_session, inline="pm", tooltip="Reopen entries for the afternoon volatility wave.\n\nThe cheat sheet's session map puts a distinct pickup at J-K (13:45-14:45) — the European open feeding through. It is a different regime from the morning: far less runway to the 15:00 time exit, so a target is reached quickly or not at all.\n\nAfternoon entries carry an EXTRA requirement the morning does not: session volume factor at or above the Min Volume × threshold. The PM thesis is entirely volume-driven — without the wave there is no edge, only a thin tape.\n\nOFF = morning window only.")
pmStartHour = input.int(13, "PM from", minval=9, maxval=15, group=grp_session, inline="pm2", tooltip="Start of the afternoon entry window (IST). 13:45 is where the J-K pickup actually begins.")
pmStartMinute = input.int(0, ":", minval=0, maxval=59, group=grp_session, inline="pm2")
pmEndHour = input.int(14, "to", minval=9, maxval=15, group=grp_session, inline="pm3", tooltip="End of the afternoon entry window (IST).\n\nKept clear of the 15:00 time exit: an entry at 14:15 still has 45 minutes to work; one at 14:45 has 15 and is a coin flip.")
pmEndMinute = input.int(30, ":", minval=0, maxval=59, group=grp_session, inline="pm3")
pmMinSessionVF = input.float(0.8, "PM needs session VF ≥", minval=0, maxval=5, step=0.1, group=grp_session, inline="pm4", tooltip="Minimum SESSION volume factor for the afternoon window to open at all.\n\nThis is a CUMULATIVE session reading, not a per-bar one, so it lives on a different scale: the cheat sheet's own bands put 0.8-1.2 at \"normal\". Requiring the per-bar 1.2x here (as this first shipped) demanded a genuinely heavy DAY and kept the window shut on roughly four sessions in five.\n\n0.8 = skip only dead tape (recommended)\n1.0 = at least an average day\n0 = clock only, no volume condition\n\nThe per-bar volume filter still applies at the trigger, so this is a floor on the day, not a substitute for confirmation.")
klRequireHTFClose = input.bool(true, "Require HTF close confirmation", group=grp_score, inline="htfc", tooltip="Demand a CLOSED higher-timeframe bar on the correct side of the level before a key-level setup can fire.\n\nWHY: a 5-min close beyond a level is cheap to fake -- most liquidity sweeps complete and reverse inside a single 15-min bar. A closed 15-min bar on the far side is materially harder to fake, and published breakout research is consistent that lower-timeframe breaks carry a higher false-break rate.\n\nThe test follows trade DIRECTION, so it works for every family:\n\u2022 long  setups need HTF close ABOVE the level\n\u2022 short setups need HTF close BELOW the level\nA VAH rejection short therefore needs the HTF close back under VAH -- which is exactly the rejection thesis.\n\nCOST: up to one HTF bar of lag on entry, because this reads the LAST CLOSED bar (non-repainting). Setups printing RVOL at or above the Strong \u00d7 threshold bypass the wait.\n\nOFF = previous behaviour (chart-timeframe close only).")
klConfirmTF       = input.timeframe("15", "| timeframe", group=grp_score, inline="htfc", tooltip="Higher timeframe used for the close confirmation above.\n\n15 = recommended for a 5-min chart: one confirmation bar per three chart bars\n30/60 = stricter, materially more lag\n\nMust be HIGHER than the chart timeframe or the test is meaningless.")

// ─── Key-level display ──────────────────────────────────────────────────────
klShowVA        = true
klShowSecondary = true
klShowTags      = true
klTagMaxATR     = 6.0
klShowSignals   = input.bool(true,  "Show key-level signal arrows",  group=grp_keylevel, tooltip="Green up / red down triangle when a key-level setup fires, with a compact\n'CODE score RVOL' tag offset from the candle.\n\nORB breakouts keep their own labels from the BREAKOUT DETECTION group.")

// ============================================= ALERTS ==============================================
bool enableAlerts = true

// Telegram Configuration
grp_telegram = "Telegram Alerts"
telegram_chat_id = input.string("-1003518225740", "Telegram Chat ID", group=grp_telegram, tooltip="Your Telegram channel/group chat ID\n\nHOW TO GET:\n1. Add @userinfobot to your channel\n2. Forward any message to the bot\n3. Copy the chat ID (starts with -)")
sendTestAlert = input.bool(false, "Send Test Alert", group=grp_telegram, tooltip="Enable to send a test alert message.\n\nSTEPS:\n1. Enable this option\n2. Create alert: 'Any alert() function call'\n3. Webhook: https://api.telegram.org/bot<TOKEN>/sendMessage\n4. Alert triggers on last bar\n5. Disable after testing")
testAlertType = input.string("Entry", "Test Alert Type", options=["Entry", "Exit", "Both"], group=grp_telegram, tooltip="Type of test alert to send")

// ========================================= INPUT VALIDATION ========================================
if breakoutBuffer < 0 or breakoutBuffer > 5
    runtime.error("❌ Breakout Buffer must be between 0-5%. Current value: " + str.tostring(breakoutBuffer))
if minRetestDistancePct < 0.5
    runtime.error("❌ Min Retest Distance too low. Must be >= 0.5% to prevent false signals. Current: " + str.tostring(minRetestDistancePct))
if minBarsOutside < 1
    runtime.error("❌ Min Bars Outside must be >= 1. Current: " + str.tostring(minBarsOutside))
if maxCycles < 1 or maxCycles > 10
    runtime.error("❌ Max Cycles must be between 1-10. Current: " + str.tostring(maxCycles))
if enableVolumeFilter
    if volumeMultiplier < 0.5
        runtime.error("❌ Volume Multiplier too low. Must be >= 0.5x. Current: " + str.tostring(volumeMultiplier))
    if strongVolumeMultiplier < volumeMultiplier
        runtime.error("❌ Strong Volume Multiplier must be >= Min Volume Multiplier. Strong: " + str.tostring(strongVolumeMultiplier) + ", Min: " + str.tostring(volumeMultiplier))
    if volBaseDays < 2
        runtime.error("❌ Volume baseline days must be >= 2. Current: " + str.tostring(volBaseDays))
if enableTargets
    if atrLength < 5 or atrLength > 50
        runtime.error("❌ ATR Length must be between 5-50. Current: " + str.tostring(atrLength))
    if atrMultiplier < 0.5 or atrMultiplier > 5
        runtime.error("❌ ATR Multiplier must be between 0.5-5. Current: " + str.tostring(atrMultiplier))
    if stopOrbFraction < 10 or stopOrbFraction > 100
        runtime.error("❌ ORB Stop % must be between 10-100%. Current: " + str.tostring(stopOrbFraction))
    if swingBars < 1 or swingBars > 20
        runtime.error("❌ Swing Bars must be between 1-20. Current: " + str.tostring(swingBars))
if enablePosSizing
    if riskMode == "$ Amount" and fixedRisk < 10
        runtime.error("❌ Fixed Risk too low. Must be >= INR 100. Current: INR " + str.tostring(fixedRisk))
    if riskMode == "% of Account"
        if riskPct < 0.1 or riskPct > 10
            runtime.error("❌ Risk % must be between 0.1-10%. Current: " + str.tostring(riskPct) + "%")
        if accountSize < 100
            runtime.error("❌ Account Size too low. Must be >= INR 10000. Current: INR " + str.tostring(accountSize))
if fillTransparency < 0 or fillTransparency > 100
    runtime.error("❌ Fill Transparency must be between 0-100%. Current: " + str.tostring(fillTransparency))
if enableHTF
    if htfEMA < 5 or htfEMA > 200
        runtime.error("❌ HTF EMA period must be between 5-200. Current: " + str.tostring(htfEMA))
if enableTrendFilter
    if customEmaLength < 1 or customEmaLength > 500
        runtime.error("❌ Custom EMA Length must be between 1-500. Current: " + str.tostring(customEmaLength))

    if supertrendPeriod < 1 or supertrendPeriod > 50
        runtime.error("❌ SuperTrend Period must be between 1-50. Current: " + str.tostring(supertrendPeriod))

    if supertrendMult < 0.1 or supertrendMult > 10
        runtime.error("❌ SuperTrend Multiplier must be between 0.1-10. Current: " + str.tostring(supertrendMult))
// TP validation removed - allowing all TPs to be disabled while keeping ORB functionality

// ========================================= SESSION DETECTION =======================================
// Fix for crypto session handling - credit to Crucialblockchain (Reddit credit: u/Crucialblockchain)
// Issue: Crypto was always inSession=true, ignoring custom session times (e.g., London 08:00-16:30)
// Solution: Check if 24/7 mode first, otherwise respect session hours

// Detect if using native session (empty tradingSession string)
bool useNativeSession = tradingSession == ""

// 24/7 market detection: crypto with native session OR explicit 24/7 string
bool is24_7Market = false  // NSE equities only; crypto 24/7 handling removed

inSession = false
if useNativeSession
    // Use TradingView's native session detection (no session parameter)
    // This automatically handles timezone conversions!
    inSession := not na(time(timeframe.period))
else
    // Use custom session string (Extended Hours, timezone modes, Custom mode) with timezone support
    if syminfo.type == "stock" or syminfo.type == "fund" or syminfo.type == "index" or syminfo.type == "dr" or syminfo.type == "etf" or syminfo.type == "futures"
        inSession := not na(time(timeframe.period, tradingSession, sessionTimezone))
    else if syminfo.type == "crypto"
        if is24_7Market
            inSession := true  // 24/7 trading - always in session
        else
            inSession := not na(time(timeframe.period, tradingSession, sessionTimezone))  // Respect custom session hours
    else if syminfo.type == "forex"
        inSession := not na(time(timeframe.period, tradingSession, sessionTimezone))
    else
        inSession := not na(time(timeframe.period, tradingSession, sessionTimezone))

// ============================================== VARIABLES ==========================================
var label labH = na
var label labL = na
var color cachedLineColor = na
var float lastLabelH = na
var float lastLabelL = na
var string cachedStageName = na
var bool hadSessionToday = false
var bool hadBreakUp = false
var bool hadBreakDown = false
var int breakUpBar = na
var int breakDownBar = na
var bool shownBreakUpLabel = false
var bool shownBreakDownLabel = false
var bool everHadBreakUp = false
var bool everHadBreakDown = false
var float breakoutEntryPrice = na

// Diagnostic: why breakout was not registered (for dashboard "No Trade" reason)
var bool priceCrossedUp = false      // Price crossed ORB high + buffer
var bool priceCrossedDown = false    // Price crossed ORB low - buffer
var bool volumeBlockedUp = false     // Crossed up but volume insufficient
var bool volumeBlockedDown = false   // Crossed down but volume insufficient
var bool trendBlockedUp = false      // Crossed up but 2+ filters opposed
var bool trendBlockedDown = false    // Crossed down but 2+ filters opposed

// Store filter values AT breakout attempt time (for accurate dashboard display)
var float attemptVolRatio = na       // Volume ratio when breakout was attempted
var bool attemptVolOK = false        // Was volume sufficient at attempt time?
var bool attemptTrendOK = false      // Was trend aligned at attempt time?
var int attemptFiltersAgainst = 0    // How many directional filters opposed?
var string attemptDirection = ""     // "UP" or "DOWN"
var bool attemptTrendAligned = false // Intraday trend aligned at attempt?
var bool attemptHTFAligned = false   // HTF bias aligned at attempt?
var bool attemptIdxAligned = false   // Index direction aligned at attempt?
var string attemptTrendLabel = ""   // Trend bias text at attempt time
var string attemptHTFLabel = ""     // HTF bias text at attempt time
var string attemptIdxLabel = ""     // Index bias text at attempt time

var int cyclesUp = 0
var int cyclesDown = 0

var int retestCyclesUp = 0
var int retestCyclesDown = 0

var int sessionBreakoutsUp = 0
var int sessionBreakoutsDown = 0
var int sessionRetestsUp = 0
var int sessionRetestsDown = 0



// Trade management alert triggers
bool alertEntryTriggered = false
bool alertSLTriggered = false
bool alertTP1Triggered = false
bool alertTP2Triggered = false

var int barsOutsideAfterBreakUp = 0
