//@version=6
// Adapted for Indian Stock Market (NSE/BSE) - Based on Luxy BIG beautiful Dynamic ORB - v5
strategy("intraday-orb", shorttitle="", overlay=true,
     default_qty_type=strategy.percent_of_equity, default_qty_value=10,
     initial_capital=100000, currency=currency.INR, commission_type=strategy.commission.percent,
     commission_value=0.06, slippage=2, calc_on_every_tick=false,
     process_orders_on_close=false, max_labels_count=500, max_lines_count=500, max_boxes_count=300)


// ====================================== DISCLAIMER & INFO =========================================
//
// DISCLAIMER: This indicator is for educational and informational purposes only.
// It does not constitute financial advice. Trading involves substantial risk of loss.
// Past performance does not guarantee future results. Always do your own research.
//
// DESCRIPTION:
// Dynamic Opening Range Breakout (ORB) indicator with multi-stage ranges (5/15/30/60 min).
// Identifies breakouts, retests, and failed breaks with advanced filtering options.
// Includes position sizing, risk management, and higher timeframe bias analysis.
//
// FEATURES:
// • Multi-stage ORB levels (5, 15, 30, 60 minutes)
// • Breakout and retest detection with cycle counting
// • Volume, trend, and HTF bias filters
// • Position sizing with risk management
// • Target/stop-loss visualization
// • Real-time dashboard with trade parameters
//
// BEST PRACTICES:
// • Recommended for liquid stocks with >1M daily volume
// • Best on 5-minute charts during regular trading hours
// • Paper trade first to understand the signals
// • Use with proper risk management (1-2% risk per trade)
// • Combine with overall market analysis
//
// LIMITATIONS:
// • May produce dangerous signals in choppy/ranging markets
// • Requires clean data feed for accurate ORB calculation
// • Not suitable for all market conditions
// • Performance varies by instrument and timeframe
//
// CREDITS:
// • Based on Opening Range Breakout concepts by Mark Fisher
// • Enhanced with modern technical analysis techniques
// • Original implementation by OrenLuxy
//

// =========================================== TYPE DEFINITIONS ======================================

type ORBData
    string name
    int    minutes
    float  high
    float  low
    float  mid
    float  orbRange
    bool   isEnabled
    bool   isBuilding
    bool   isComplete
    int    completionBar
    bool   breakoutUp
    bool   breakoutDown
    int    breakoutBar
    float  breakoutLevel
    int    cyclesUp
    int    cyclesDown
    box    orbBox
    line   highLine
    line   lowLine
    line   midLine
    label  edgeLabel
    color  orbColor
    int    lineWidth
    string lineStyle

// ================================================ GROUPS ===========================================

grp_colors   = "🎨 ORB COLORS ▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬"
grp_session  = "⏰ SESSION SETTINGS ▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬"
grp_breakout = "⚡ BREAKOUT DETECTION ▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬"
grp_targets  = "🎯 TARGETS & RISK ▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬"
grp_FVG      = "↩️ FVG FILTER ▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬"
grp_lines    = "📍 TP/SL LINES ▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬"
grp_pullback = "↩️ PULLBACK FILTER ▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬"
grp_volume   = "📊 VOLUME FILTER ▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬"
grp_trend    = "📈 TREND FILTER ▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬"
grp_dash     = "📊 DASHBOARD ▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬"
grp_htf      = "📈 HIGHER TIMEFRAME ▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬"
grp_index    = "📊 INDEX DIRECTION FILTER ▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬"
grp_smart    = "🧠 SMART ENTRY FILTERS ▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬"
grp_nrfilter = "🔻 NR FILTER (Crabel) ▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬"
grp_god      = "⚡ GOD MODE (breakout quality) ▬▬▬▬▬▬▬▬▬▬"
grp_vp       = "📐 VOLUME PROFILE (VAH/POC/VAL) ▬▬▬▬▬▬▬▬▬"
grp_keylevel = "🔑 KEY-LEVEL TRIGGERS ▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬"
grp_score    = "🧮 KEY-LEVEL SCORING ▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬"

// ============================================ CONSTANTS ============================================

LABEL_OFFSET_ATR_MULTIPLIER = 0.8  // 0.8× ATR distance from high/low
LABEL_OFFSET_BARS = 2              // Bars ahead for edge labels (keeps them visible)

MAX_BARS_FAILED_BREAK = 5  // Maximum bars to consider a retest as "failed break" instead of committed breakout

// Key-level tag placement. ORB edge labels sit at LABEL_OFFSET_BARS (2), so key-level
// tags start further right to stop "IBH 2329.0" printing through the "ORB15" badge when
// the two levels coincide. STEP is how far a colliding tag is pushed — roughly the width
// of a "VAH 2289.25" string. MIN_GAP throttles signal TEXT (arrows are never throttled).
KL_TAG_OFFSET_BARS = 6
KL_TAG_STEP_BARS   = 11
KL_LABEL_MIN_GAP   = 6
showEdgeLabels = input.bool(false, "Show Edge Labels", inline = "core", group=grp_colors)
labelFormat = input.string("Detailed", "Label Format", options=["Simple", "Detailed"], group=grp_colors, inline="core1")
labelSize = input.string("Small", "All Label Size", inline = "core1", options=["Tiny", "Small", "Normal", "Large", "Huge"], group=grp_colors, tooltip="Display ORB stage labels at the edge of price levels\n\nShows which ORB period is active (5min/15min/30min/60min)\nLabels follow price as chart scrolls\n\nON = Labels visible\nOFF = Clean chart\n\nVisual size for ALL labels (breakout, retest, failed)\n\nTINY: Minimal space, cluttered on small screens\nSMALL: Clean and readable (recommended)\nNORMAL: Good for presentations\nLARGE: High visibility\nHUGE: Maximum visibility\n\nLabel text format for ALL labels (TP/SL and Breakouts)\n\nSIMPLE:\n• Minimal text\n• TP/SL: 'ENTRY', 'TP1', 'SL'\n• Breakout: '🔼 BREAKOUT UP #1'\n• Clean and compact\n• Good for: Small screens, many lines\n\nDETAILED:\n• Full info with context\n• TP/SL: 'ENTRY: $150.50', 'TP1: $152.20 +1.1%'\n• Breakout: 'ORB15 | #1 | Vol: 2.3x'\n• Shows prices, percentages, ORB stage, volume\n• Good for: Analysis, larger screens (recommended) ⭐\n\nAFTER HIT:\n• TP: '✅ TP1: $152.20'\n• SL: '❌ SL: $148.50'")
showBG = input.bool(true, "Show Background", inline="BG", group=grp_colors)
fillTransparency = input.int(95, "  | Transparency", inline="BG", minval=0, maxval=100, step=5, group=grp_colors, tooltip="Background fill transparency for ORB range\n\n0 = Fully opaque (solid color)\n50 = Semi-transparent\n95 = Nearly invisible (recommended)\n100 = Completely invisible")
enableORB15Signals = input.bool(true, "Enable ORB15", group=grp_colors, inline="5-15")
orb15LineColor = input.color(#FF9800, "", inline = "5-15",group=grp_colors)
showMidLine = input.bool(true, "Mid-Range Line", group=grp_colors, tooltip="Display a thin line at the midpoint between ORB High and Low\n\nUSEFUL FOR:\n• Visual center reference\n• Mean reversion trading\n• Support/resistance level\n• Range symmetry analysis\n\nThe line uses the same color as the ORB boundaries but thinner\n\nON = Midpoint line visible\nOFF = Only High/Low lines")

sessionMode = input.string("Auto-Detect", "Session Mode", options=["Auto-Detect", "Custom"], group=grp_session, tooltip="Define trading session for ORB calculation\n\n🎯 AUTO-DETECT (Recommended):\n• TradingView automatically detects symbol's native hours\n• Stocks: Exchange hours (NYSE 9:30-16:00, LSE 8:00-16:30, etc.)\n• E-mini Futures: See 'Futures Trading Hours' setting below\n• Crypto: 24/7\n• Forex: Native forex session\n• Works perfectly for 99% of cases!\n\n⚙️ CUSTOM:\n• Define your own session hours manually\n• Use format: HHMM-HHMM (e.g., '0930-1600')\n• Set in 'Custom Session Hours' below\n• Timezone: Chart timezone\n\n💡 TIP: Auto-Detect handles timezone/DST automatically!\nIf ORB appears 1 hour off, check chart timezone:\nRight-click chart → Settings → Symbol → Timezone")
customSession = input.session("0915-1530", "Custom Session Hours", group=grp_session, tooltip="Custom trading session definition\n\nONLY ACTIVE when Session Mode = Custom\n\nFORMAT: HHMM-HHMM (24-hour)\n\nEXAMPLES:\n• 0915-1530 = NSE/BSE regular hours (India)\n• 0930-1600 = NYSE regular hours\n• 0000-2359 = Full 24 hours\n\nTIMEZONE: Chart timezone")


entryCutoffHour = input.int(11, "Entry Cutoff Hour", minval=9, maxval=15, group=grp_session, inline="cutoff", tooltip="Stop taking new entries after this hour\n\nRECOMMENDED: 11:00 AM for Indian market\n\nWHY:\n• ORB momentum strongest 09:45-10:30\n• 10:30-11:00 still catches valid late breakouts\n• Entries after 11:00 show lower win rates\n• Avoids weak momentum / choppy midday signals\n\nOPTIONS:\n• 11 (+ 0 min): Default - balances signal capture vs quality\n• 10 (+ 30 min): Aggressive filter based on Q1 2026 data\n• 12: Too late (not recommended)")
entryCutoffMinute = input.int(0, "Minute", minval=0, maxval=59, group=grp_session, inline="cutoff", tooltip="Minutes past the hour for cutoff\n\nEXAMPLE: Hour=11, Minute=0 = 11:00 AM cutoff")

timeExitHour = input.int(15, "Time Exit Hour", minval=12, maxval=15, group=grp_session, inline="timeexit", tooltip="Force exit open positions at this hour\n\nRECOMMENDED: 15:00 (3 PM) for Indian market\n\nWHY:\n• Gives trades 4.5 hours from 10:30 entry to hit TP\n• Exits before broker auto square-off at 15:10-15:20\n• Avoids auto square-off penalty charges (Rs 20-50/order)\n\nOPTIONS:\n• 14: Conservative (exit early, may cut winners short)\n• 15: Balanced — avoids broker charges\n• 15 (+05 min): Risky — too close to auto square-off")
timeExitMinute = input.int(0, "Minute", minval=0, maxval=59, group=grp_session, inline="timeexit", tooltip="Minutes past the hour for time exit\n\nSet to 0 (15:00) to exit before broker auto square-off at 15:10")


string tradingSession = "0915-1530:23456"  // Default: NSE/BSE hours, Mon-Fri (India)
string sessionTimezone = "Asia/Kolkata"  // Default: Indian Standard Time
var int sessionStartHour = na
var int sessionStartMinute = na
var int sessionEndHour = na
var int sessionEndMinute = na
bool useElectronicFullDay = false  // Track if E-mini futures using Electronic Full Day mode (24hr from 9:30-9:30)

if sessionMode == "Auto-Detect"
    // NSE/BSE only: the native session is always correct here, and TradingView handles
    // its hours, timezone and holidays. The upstream asset-type tree (futures/crypto/
    // forex/extended-hours) resolved to this same empty string on every Indian-equity
    // path, so it was dead weight against the compiled-token budget.
    tradingSession := ""

else if sessionMode == "Custom"
    if str.contains(customSession, ":")
        tradingSession := customSession
    else
        tradingSession := customSession + ":23456"

// Only parse session string if it's not empty (native session uses empty string)
if tradingSession != ""
    string sessionTimeOnly = str.contains(tradingSession, ":") ? str.split(tradingSession, ":").get(0) : tradingSession
    array<string> sessionParts = str.split(sessionTimeOnly, "-")

    if array.size(sessionParts) == 2
        string startTime = array.get(sessionParts, 0)
        string endTime = array.get(sessionParts, 1)

        if str.length(startTime) == 4
            sessionStartHour := int(str.tonumber(str.substring(startTime, 0, 2)))
            sessionStartMinute := int(str.tonumber(str.substring(startTime, 2, 4)))

        if str.length(endTime) == 4
            sessionEndHour := int(str.tonumber(str.substring(endTime, 0, 2)))
            sessionEndMinute := int(str.tonumber(str.substring(endTime, 2, 4)))

// ========================================================================================
// E-MINI FUTURES GLOBAL OVERRIDE (DISABLED FOR INDIAN MARKET)
// ========================================================================================
// Not applicable for Indian stock market (NSE/BSE)
// Indian market uses fixed session: 0915-1530 IST (Asia/Kolkata)
// ========================================================================================

// ========================================================================================

enableBreakout = input.bool(true, "Enable Breakout Detection", inline = "Show", group=grp_breakout)
showBreakLabels = input.bool(true, "Show Breakout Labels", group=grp_breakout, inline = "Show", tooltip="Detect and label breakouts above ORB High or below ORB Low\n\nON: Shows breakout labels when price exits ORB range\nOFF: Only displays ORB levels without signals\n\nBreakouts detected on CLOSE (no repaint)")
enableRetest = input.bool(true, "Show Retest Labels", group=grp_breakout, inline="retest", tooltip="Show labels when price returns to ORB after breakout\n\nRETEST = Price broke out, then came back to test ORB level\n\nUSEFUL FOR:\n• Re-entry opportunities\n• Confirming support/resistance\n• Failed breakout detection\n\nON: Shows retest labels\nOFF: Only shows initial breakout")
signalMode = input.string("Track Cycles", "Signal Mode", options=["First Only", "Track Cycles"], group=grp_breakout, inline="mode", tooltip="How many breakout signals to show per day\n\nFIRST ONLY:\n• Shows only the FIRST breakout in each direction\n• One UP signal, one DOWN signal max per day\n• Clean chart, less noise\n• Good for: Swing traders, position traders\n\nTRACK CYCLES:\n• Tracks Breakout → Retest → Re-breakout cycles\n• Multiple signals as price oscillates\n• Detects momentum returns\n• Good for: Active traders, scalpers\n\nRECOMMENDED: Track Cycles")
maxCycles = input.int(6, "Max Cycles", minval=1, maxval=10, group=grp_breakout, inline="mode", tooltip="Maximum cycles to track when Signal Mode = Track Cycles\n\nCYCLE = Breakout → Retest → Re-breakout sequence\n\n1-2 cycles: Clean chart, fewer signals\n4-6 cycles: Balanced (recommended)\n8-10 cycles: Very active, may clutter chart\n\nIGNORED when Signal Mode = First Only")
breakoutBuffer = input.float(0.5, "Breakout Buffer (%)", minval=0, maxval=5, step=0.1, group=grp_breakout, inline="buffer", tooltip="Extra distance required beyond ORB level for breakout\n\nPREVENTS: False breakouts from tiny penetrations\n\nHOW IT WORKS:\n• UP: Price must close ABOVE (ORB High + buffer%)\n• DOWN: Price must close BELOW (ORB Low - buffer%)\n\nRECOMMENDATIONS:\n• 0.0% = Exact level (sensitive, more signals)\n• 0.1% = Tiny buffer (recommended)\n• 0.3% = Moderate filter\n• 0.5%+ = Conservative (fewer signals)\n\nHigher = fewer but stronger breakouts")
retestBuffer = input.float(0.0, "Retest Buffer (%)", minval=0, maxval=5, step=0.1, group=grp_breakout, inline="buffer", tooltip="Tolerance for retest detection\n\nALLOWS: Price to slightly penetrate ORB during retest\n\nHOW IT WORKS:\n• After UP breakout: Retest if price returns to ORB High ± buffer\n• After DOWN breakout: Retest if price returns to ORB Low ± buffer\n\nRECOMMENDATIONS:\n• 0.0% = Must touch exact level (strict)\n• 0.1-0.2% = Slight tolerance (recommended)\n• 0.3-0.5% = Generous tolerance\n\nHigher = more retests detected")
minRetestDistancePct = input.float(0.5, "Min Distance for Retest (%)", minval=0.5, maxval=10, step=0.5, group=grp_breakout, tooltip="How far price must travel away from ORB before retest is valid\n\nPREVENTS: Labeling tiny bounces as 'retests'\n\nEXAMPLE: ORB High = $10.00, Distance = 2%\n• Price breaks to $10.20 (2% away) ✓ Valid\n• Price returns to $10.00 → RETEST LABEL\n• If only went to $10.05 (0.5% away) ✗ Not valid\n\nRECOMMENDATIONS:\n• 0.5% = Very sensitive (many retests)\n• 2.0% = Balanced (filters noise) ⭐\n• 3.0%+ = Only strong moves\n\nHigher = fewer but more meaningful retests")
minBarsOutside = input.int(2, "Min Bars Outside ORB", minval=1, maxval=10, group=grp_breakout, tooltip="How many bars price must stay outside ORB for 'committed' breakout\n\nPREVENTS: Labeling quick failures as breakouts\n\nEXAMPLE: Min Bars = 2\n• Bar 1: Price breaks above ORB High\n• Bar 2: Still above ORB High ✓\n• Bar 3: Returns inside → Now can show retest\n\nIf returned on Bar 2 → Shows 'FAILED BREAK' instead\n\nRECOMMENDATIONS:\n• 1 bar = Aggressive (more signals, more failures)\n• 2 bars = Balanced (recommended) ⭐\n• 3-4 bars = Conservative (only strong moves)\n\nHigher = fewer but stronger breakouts")
minPullbackPct = input.float(0.3, "Min Pullback for Re-break (%)", minval=0.1, maxval=2, step=0.1, group=grp_breakout, tooltip="How far price must pull back before detecting new breakout\n\nPREVENTS: Too many signals from small wiggles\n\nEXAMPLE: Last breakout at $10.00\n• Price reaches $10.50\n• Must pull back to $10.35 (0.3% = $0.15) before new breakout counted\n\nRECOMMENDED:\n• 0.3% = Balanced (recommended) ⭐\n• 0.5% = Less sensitive\n• 1.0% = Very selective")

enableFVGFilter = input.bool(false, "Enable FVG Filter  | ", group=grp_FVG, inline="fvg1")
showFVG = input.bool(true, "Show FVG Boxes", group=grp_FVG, inline="fvg1", tooltip="Fair Value Gap Filter\n\nRequires breakout through FVG for confirmation\n\nFVG = Price gap from strong momentum\nON: Only signals with FVG\nOFF: All signals")
maxFVGtoKeep = input.int(5, "Max FVG", minval=1, maxval=20, inline="fvg2", group=grp_FVG)
fvgProximity = input.float(2.0, "FVG Proximity", minval=0.5, maxval=5.0, inline="fvg2", step=0.5, group=grp_FVG, tooltip="How close to FVG?\n\n1.0 = Must be IN the FVG\n2.0 = Within 2x FVG size (recommended)\n3.0 = Within 3x FVG size (very permissive)")
fvgTransparency = input.int(90, "Transparency", minval=0, maxval=100, step=5, inline="fvgcolor", group=grp_FVG)
fvgBullColor = input.color(#2E7D32, "Bullish FVG", inline="fvgcolor", group=grp_FVG)
fvgBearColor = input.color(#C62828, "Bearish FVG", inline="fvgcolor", group=grp_FVG)

enablePullbackFilter = input.bool(false, "Enable Pullback Filter", group=grp_pullback, tooltip="Require pullback confirmation before showing breakout signal\n\nWHY: Filters weak breakouts that reverse immediately\nHOW: Waits for price to pull back slightly, then continue breakout direction\n\nWORKFLOW:\n1. Price breaks above/below ORB\n2. Wait for pullback (small dip/rise)\n3. Price continues in breakout direction\n4. NOW show signal ✅\n\nBENEFITS:\n• Better entry prices\n• Fewer false breakouts\n• Improved risk/reward\n• Confirmation of strength\n\nDRAWBACKS:\n• Misses fast runners\n• Slower signals\n• More conservative\n\nON: Wait for pullback confirmation\nOFF: Immediate signals (current behavior)\n\nRECOMMENDED: Try OFF first, enable if too many false signals")
pullbackPercent = input.float(0.3, "Pullback Required (%)", minval=0.1, maxval=2.0, step=0.1, group=grp_pullback, inline="pb", tooltip="How much pullback required for confirmation\n\nEXAMPLE: ORB High = $100, Pullback = 0.5%\n• Breaks to $100.60 (above ORB)\n• Pulls back to $100.10 (0.5% dip) ✓\n• Continues to $100.70 → SIGNAL!\n\nSMALLER % = More signals, faster\nLARGER % = Fewer signals, stronger\n\nRECOMMENDED:\n• 0.3% = Sensitive (active trading) ⭐\n• 0.5% = Balanced\n• 1.0% = Conservative (swing trading)")
pullbackTimeout = input.int(10, "Timeout (bars)", minval=3, maxval=30, group=grp_pullback, inline="pb", tooltip="Max bars to wait for pullback\n\nIf pullback doesn't happen within this time:\n→ Shows signal anyway (prevents missing strong moves)\n\nEXAMPLE: Timeout = 10 bars\n• Breakout occurs\n• Wait 10 bars for pullback\n• No pullback? → Show signal at bar 10\n• Pullback at bar 5? → Show signal when continues\n\nSHORTER = Less waiting, more immediate signals\nLONGER = More patient, better confirmation\n\nRECOMMENDED:\n• 5 bars = Quick (5min chart = 25 min)\n• 10 bars = Balanced (5min chart = 50 min) ⭐\n• 15 bars = Patient (5min chart = 75 min)")

enableVolumeFilter = input.bool(true, "Enable Volume Filter", group=grp_volume, inline="enable", tooltip="Require volume confirmation for breakout signals\n\nWHY: High volume breakouts are more reliable\nWHAT: Compares current volume to moving average\n\nON: Only shows breakouts with sufficient volume\nOFF: Shows all breakouts regardless of volume\n\nRECOMMENDED: ON for stocks, OFF for crypto")
volumeMaLength = input.int(50, "| MA Length", minval=1, group=grp_volume, inline="enable", tooltip="Volume moving average period for comparison\n\nSHORTER = More sensitive to recent volume spikes\nLONGER = Smoother average, resists gap-day distortion\n\nRECOMMENDATIONS:\n• 10 periods: Very responsive\n• 20 periods: Sensitive to opening volume spikes\n• 50 periods: Stable baseline (recommended) ⭐\n\nWHY 50: On gap days, first 3 candles have 5-10x normal volume,\ninflating a short MA unfairly. 50 bars includes previous session,\nso 1.2x threshold means the same on gap and non-gap days.\n\nCHART TIMEFRAME affects calculation:\n• 5min chart, MA=50 → Last ~4 hours (includes prev session)\n• 1hour chart, MA=50 → Last 50 hours")
volumeMultiplier = input.float(1.2, "Min Volume ×", minval=0.5, step=0.1, group=grp_volume, inline="mult", tooltip="Minimum volume multiplier required for breakout\n\nCURRENT VOLUME must be ≥ (Volume MA × Multiplier)\n\nEXAMPLE: Volume MA = 1M shares, Multiplier = 1.2\n• Breakout with 1.3M volume = Valid\n• Breakout with 1.0M volume = Rejected\n\nRECOMMENDATIONS:\n• 1.0x = Any above-average volume\n• 1.2x = Balanced for Indian stocks (recommended)\n• 1.5x = Moderate requirement\n• 2.0x+ = Very selective\n\nHigher = fewer but higher-quality signals")
strongVolumeMultiplier = input.float(1.8, "Strong ×", minval=1.0, step=0.1, group=grp_volume, inline="mult", tooltip="Strong volume override threshold\n\nSPECIAL RULE: If volume exceeds this multiplier:\n→ SKIPS retest wait, enters immediately\n\nRATIONALE: Strong volume = institutional activity, no need to wait\n\nEXAMPLE: Volume MA = 1M, Strong = 1.8×\n• Breakout with 2M volume → Enters immediately without waiting for retest\n\nRECOMMENDATIONS:\n• 1.8× = More entries (recommended) ⭐\n• 2.0× = Balanced\n• 2.5× = More selective\n\nMUST BE ≥ Min Volume Multiplier")

// Trend Filter
enableTrendFilter = input.bool(true, "Enable Trend Filter", group=grp_trend, inline = "FILTER", tooltip="Only show breakouts that align with broader trend\n\nWHY: Trend-aligned breakouts have higher success rate\nWHAT: Checks if price is above/below trend indicator\n\nRULES:\n• UP breakout: Only if price ABOVE trend\n• DOWN breakout: Only if price BELOW trend\n\nON: Filters against-trend breakouts\nOFF: Shows all breakouts\n\nRECOMMENDED: ON for conservative trading")
trendMode = input.string("VWAP", "| Trend Mode",inline = "FILTER", options=["VWAP", "EMA", "Custom EMA", "SuperTrend", "VWAP+EMA", "VWAP+SuperTrend"], group=grp_trend, tooltip="Method to determine trend direction\n\nVWAP (Volume-Weighted Average Price):\n• Accounts for volume in price calculation\n• Good for: Intraday trading\n• Above VWAP = Bullish, Below = Bearish\n\nEMA (12-period):\n• Fast exponential moving average\n• Responsive to recent price action\n• Good for: Quick trends\n\nCUSTOM EMA:\n• Your own EMA period\n• Longer = Smoother trend\n• Good for: Swing trading (50-200 period)\n\nSUPERTREND:\n• ATR-based trailing stop\n• Clear trend direction\n• Good for: Strong trends\n\nVWAP+EMA:\n• BOTH must agree\n• More conservative\n• Fewer but higher quality signals\n\nVWAP+SUPERTREND:\n• BOTH must agree\n• Most conservative\n• Best signal quality")

customEmaLength = input.int(50, "Custom EMA Length", minval=1, group=grp_trend, inline="ema", tooltip="EMA period when Trend Mode = Custom EMA\n\nSHORTER = More reactive, more signals\nLONGER = Smoother, fewer signals\n\nRECOMMENDATIONS:\n• 20-30: Intraday trading\n• 50: Swing trading (recommended) ⭐\n• 100-200: Position trading\n\nIGNORED for other trend modes")
supertrendPeriod = input.int(10, "SuperTrend Period", minval=1, group=grp_trend, inline="st", tooltip="ATR period for SuperTrend calculation\n\nSHORTER = More sensitive, tighter stops\nLONGER = Smoother, wider stops\n\nRECOMMENDATIONS:\n• 7: Aggressive\n• 10: Balanced (recommended) ⭐\n• 14: Conservative\n\nONLY USED when Trend Mode includes SuperTrend")
supertrendMult = input.float(3.0, "Mult", minval=0.1, step=0.1, group=grp_trend, inline="st", tooltip="ATR multiplier for SuperTrend bands\n\nLOWER = Tighter bands, more trend changes\nHIGHER = Wider bands, fewer changes\n\nRECOMMENDATIONS:\n• 2.0: Sensitive (more signals)\n• 3.0: Balanced (recommended) ⭐\n• 4.0+: Conservative (fewer signals)\n\nONLY USED when Trend Mode includes SuperTrend")

// ========================================= TARGETS & RISK MANAGEMENT ================================
enableTargets = input.bool(true, "Enable Targets & Stop-Loss", group=grp_targets, tooltip="Calculate and display profit targets (TP) and stop-loss (SL)\n\nWHEN ENABLED:\n• Shows TP/SL lines on chart during breakout\n• Displays values in dashboard\n• Calculates Risk/Reward ratio\n\nWHEN DISABLED:\n• Only shows ORB levels\n• No trade management\n\nRECOMMENDED: ON for active trading")

showTP1 = input.bool(true, "TP1 (1R)", group=grp_targets, inline="show")
showTP1_5 = input.bool(true, "TP1.5 (1.5R)", group=grp_targets, inline="show")
showTP2 = input.bool(true, "TP2 (2R)", group=grp_targets, inline="show")
showTP3 = input.bool(true, "TP3 (3R)", group=grp_targets, inline="show", tooltip="EXECUTION: Each TP level alert includes ExitQtyPct field — signal engine reads it directly.\n\nR = RISK UNITS (1R = distance from entry to stop-loss)\n\nTP1 (1R): 1:1 — partial exit (see tp1ExitQtyPct below)\nTP1.5 (1.5R): exit remaining position (tp1_5ExitQtyPct)\nTP2 (2R): exit remaining position\nTP3 (3R): exit remaining position")

// Exit quantity percentages per TP level — included in TP HIT alerts as ExitQtyPct field.
// Signal engine reads ExitQtyPct directly; no tp_levels config needed in signal engine.
// 50 = exit 50% of current open position at this TP level.
// 100 = exit 100% of remaining position (full close).
tp1ExitQtyPct   = input.int(50,  "TP1 Exit %",   minval=0, maxval=100, group=grp_targets, inline="exitpct", tooltip="% of open position to exit at TP1\n\n50 = partial exit (bank half, hold rest for TP1.5)\n100 = full exit at TP1 (original behavior)\n\nData: 72.3% of TP1 trades also reach TP1.5 — 50% partial exit captures both wins.")
tp1_5ExitQtyPct = input.int(100, "TP1.5 Exit %", minval=0, maxval=100, group=grp_targets, inline="exitpct", tooltip="% of remaining open position to exit at TP1.5\n\n100 = exit remaining position fully\n\nTP2/TP3 also default to 100 (exit whatever remains).")

// Adaptive R:R - Auto-switch to TP2 when trending
enableAdaptiveRR = input.bool(false, "Adaptive R:R", group=grp_targets, inline="adaptive", tooltip="Automatically extend to TP2 (2R) when market is trending\n\nHOW IT WORKS:\n• Uses ADX (trend strength indicator)\n• ADX > 25 = Trending → Target TP2\n• ADX < 25 = Ranging → Target TP1\n\nBENEFITS:\n• Best of both worlds\n• Higher win rate in choppy markets (1:1)\n• Capture big moves in trends (1:2)\n\nDEFAULT: OFF (Beginners use TP1 only)\nENABLE: When comfortable with the strategy")
adxThreshold = input.int(25, "ADX >", minval=15, maxval=40, group=grp_targets, inline="adaptive", tooltip="ADX threshold to detect trending market\n\nADX (Average Directional Index) measures trend strength:\n• < 20: Weak/No trend (ranging)\n• 20-25: Developing trend\n• 25-50: Strong trend\n• > 50: Very strong trend\n\nRECOMMENDED: 25 (balanced)")
adxLength = input.int(14, "Len", minval=7, maxval=30, group=grp_targets, inline="adaptive", tooltip="ADX calculation period\n\nSHORTER = More responsive\nLONGER = Smoother\n\nRECOMMENDED: 14 (standard)")

stopMode = input.string("ATR", "Stop Method", options=["ATR", "ORB %", "Swing", "Safer", "Scaled ATR", "% Based", "Smart Adaptive"], group=grp_targets, inline="tgt", tooltip="How to calculate Stop Loss placement\n\n🆕 ATR-BASED VOLATILITY SYSTEM:\n\nSMART ADAPTIVE (Recommended) ⭐:\n• Adjusts to ACTUAL volatility (not price)\n• ATR < 1.5% = Tight stop (0.7× ATR)\n• ATR 1.5-3% = Normal stop (1.0× ATR)\n• ATR > 3% = Wide stop (1.5× ATR)\n• Perfect for: ALL assets automatically\n\nSCALED ATR:\n• Dynamic multiplier based on volatility %\n• Very volatile (>5% ATR): 2.5× ATR\n• High volatility (3-5%): 2.0× ATR\n• Normal (1.5-3%): 1.5× ATR\n• Low (<1.5%): 1.2× ATR\n• Good for: Mixed portfolios\n\nATR:\n• Standard ATR with volatility adjustment\n• Multiplier adjusts to market conditions\n• Formula: SL = Entry ± (ATR × Multiplier × VolAdjust)\n• Good for: Traditional traders\n\n% BASED:\n• Fixed percentage from entry\n• You set the % (e.g., 1.0%)\n• Simple and consistent\n• Good for: Beginners\n\n────────────────────────\n\n🔥 NEW VOLATILITY PROTECTION:\n\nALL METHODS NOW USE ATR-BASED MINIMUMS:\n• Crypto: Min 1.0× ATR (wider for volatility)\n• Forex: Min 0.3× ATR (tighter for stability)\n• Stocks: Min 0.5-1.5× ATR (based on volatility)\n\nABSOLUTE MINIMUMS:\n• Crypto: 1.0% of price\n• Forex: 0.2% of price\n• Stocks: 0.3% of price\n\n────────────────────────\n\nORB %:\n• Fixed percentage beyond ORB level\n• Simple and predictable\n• Formula: SL = ORB_Level ± (ORB_Range × %)\n• Good for: ORB-focused trading\n\nSWING:\n• Placed at recent swing high/low\n• Technical support/resistance\n• Respects chart structure\n• May be far from entry\n• Good for: Technical traders\n\nSAFER:\n• Widest stop of all methods\n• Lowest chance of stop-out\n• Largest potential loss\n• Good for: Risk-averse traders")
atrLength = input.int(14, "ATR", minval=5, maxval=50, group=grp_targets, inline="atr2", tooltip="ATR calculation period\n\nATR = Average True Range = How much price moves\n\nSHORTER = More reactive to recent volatility\nLONGER = Smoother, stable average\n\nRECOMMENDATIONS:\n• 7-10: Day trading, responsive\n• 14: Standard, balanced (recommended) ⭐\n• 20-30: Swing trading, smooth\n\nUSED FOR: ATR-based targets and stops")
atrMultiplier = input.float(2.0, "×", minval=0.5, maxval=3, step=0.1, group=grp_targets, inline="atr2", tooltip="ATR multiplier for stop-loss distance\n\nSL = Entry ± (ATR × Multiplier)\n\nLOWER = Tighter stop, less risk, more stop-outs\nHIGHER = Wider stop, more risk, fewer stop-outs\n\nRECOMMENDATIONS:\n• 1.0×: Tight stop (aggressive)\n• 1.5×: Balanced (recommended) ⭐\n• 2.0×: Loose stop (conservative)\n• 2.5×+: Very loose (volatile stocks)\n\nONLY AFFECTS: ATR stop method")
percentBasedStop = input.float(1.0, "% Based Stop", minval=0.1, maxval=5.0, step=0.1, group=grp_targets, inline="pct", tooltip="Stop Loss percentage from entry\n\nONLY USED when Stop Method = % Based\n\nFORMULA:\n• LONG: SL = Entry × (1 - Stop%)\n• SHORT: SL = Entry × (1 + Stop%)\n\nEXAMPLE: Entry = $100, Stop = 1.0%\n• LONG SL: $99.00 (1% below)\n• SHORT SL: $101.00 (1% above)\n\nRECOMMENDATIONS:\n• 0.5%: Tight (day trading, scalping)\n• 1.0%: Balanced (recommended) ⭐\n• 1.5%: Medium (swing trading)\n• 2.0%+: Wide (position trading)\n\nPERFECT FOR:\n• High-price assets (BTC, TSLA)\n• Consistent risk management\n• Easy to understand")
stopOrbFraction = input.float(20, "ORB Stop %", minval=10, maxval=50, step=5, group=grp_targets, inline="stop", tooltip="Stop distance as percentage of ORB range\n\nONLY USED when Stop Method = ORB %\n\nFORMULA:\n• LONG: SL = ORB_Low - (ORB_Range × 20%)\n• SHORT: SL = ORB_High + (ORB_Range × 20%)\n\nEXAMPLE: ORB Range = $1.00, Fraction = 20%\n• SL placed $0.20 beyond ORB boundary\n\nRECOMMENDATIONS:\n• 10-15%: Tight (more stop-outs)\n• 20%: Balanced (recommended) ⭐\n• 30-40%: Loose (fewer stop-outs)\n• 50%: Very loose")
swingBars = input.int(3, "Swing Bars", minval=1, maxval=10, group=grp_targets, inline="stop", tooltip="Lookback period to find swing high/low\n\nONLY USED when Stop Method = Swing\n\nSWING = Local high/low point (reversal point)\n\nSHORTER = Recent swing (closer SL)\nLONGER = Deeper swing (farther SL)\n\nEXAMPLE: Swing Bars = 3\n• Looks back 3 bars\n• Finds lowest low (for LONG) or highest high (for SHORT)\n• Places SL there\n\nRECOMMENDATIONS:\n• 2: Very recent swing (aggressive)\n• 3: Recent swing (recommended) ⭐\n• 5: Moderate swing\n• 7-10: Deep swing (conservative)")
showTPSLLines = input.bool(true, "Show TP/SL Lines on Chart", group=grp_lines, tooltip="Display Entry, TP, and SL as horizontal lines on chart\n\nWHEN BREAKOUT OCCURS:\n• Lines appear instantly\n• Extend forward as chart progresses\n• Update with each new bar\n\nLINES FREEZE (stop updating) when:\n• Last TP is hit ✓\n• Stop Loss is hit ✗\n• End of Day (if enabled)\n\nCOLORS:\n• Entry: Cyan (LONG) / Orange (SHORT)\n• TP: Green when hit, cyan/orange before\n• SL: Red always\n\nON: Shows lines (recommended)\nOFF: Only dashboard display")
freezeOnEOD = input.bool(true, "Freeze Lines at End of Day", group=grp_lines, inline="freeze", tooltip="Stop updating lines when trading session ends\n\nON (Recommended):\n• Lines freeze at session close\n• Keeps intraday setup visible\n• Clean daily reset\n• Good for: ORB strategy (intraday)\n\nOFF:\n• Lines continue extending until hit\n• May cross multiple sessions\n• Good for: Swing trading, 24/7 markets\n\nNOTE: Lines also freeze when SL hit or last TP hit")

// ============================================ DASHBOARD ============================================
showDashboard = input.bool(true, "Show Info Panel", group=grp_dash, inline="theme")
dashTheme = input.string("Dark", "| Theme", options=["Dark", "Light"], group=grp_dash, inline="theme", tooltip="Dashboard color scheme\n\nDARK (Recommended):\n• Light text on dark background\n• Matches dark chart themes\n• Less eye strain\n• Professional look\n\nLIGHT:\n• Dark text on light background\n• Matches light chart themes\n• Good for presentations\n• High contrast")
dashPos = input.string("Bottom Left", "Position", options=["Top Left", "Top Right", "Bottom Left", "Bottom Right", "Middle Right"], group=grp_dash, inline="pos", tooltip="Dashboard placement on chart\n\nTOP LEFT: Good for price action top-right\nTOP RIGHT: Good for price action top-left\nBOTTOM LEFT: Classic placement (recommended) ⭐\nBOTTOM RIGHT: Avoid volume bars\nMIDDLE RIGHT: Floating position\n\nChoose based on where price usually is")
dashSize = input.string("Auto", "Text Size", options=["Auto", "Small", "Normal", "Large"], group=grp_dash, inline="pos", tooltip="Text size inside dashboard\n\nAUTO: Adapts to chart zoom (recommended) ⭐\nSMALL: Compact, more screen space\nNORMAL: Readable\nLARGE: Presentations, poor eyesight")
showStage = input.bool(true, "Show Stage", group=grp_dash, inline="rows1", tooltip="Display current ORB stage\n\nSHOWS: Which timeframe is active\nâ€¢ ORB 5 (5 minutes)\nâ€¢ ORB 15 (15 minutes)\nâ€¢ ORB 30 (30 minutes)\nâ€¢ ORB 60 (60 minutes)\n\nUseful for knowing which ORB you're trading")
showRange = input.bool(true, "Show Range", group=grp_dash, inline="rows1", tooltip="Display ORB range size\n\nSHOWS:\nâ€¢ High-Low difference (dollars)\nâ€¢ Range as percentage\n\nEXAMPLE: '$0.50 (2.5%)'\n\nUseful for assessing if range is significant")
showStatus = input.bool(true, "Show Status", group=grp_dash, inline="rows1", tooltip="Display breakout status\n\nSTATES:\nINSIDE RANGE: Price within ORB\nâ€¢ ðŸŸ¢ BREAK UP: Above ORB High\n´ BREAK DOWN: Below ORB Low\nâ€¢ ðŸŸ  RETEST: Returned to ORB after breakout\n\nQuick visual confirmation of position")
showVol = input.bool(true, "Show Volume", group=grp_dash, inline="rows2", tooltip="Display volume status\n\nONLY SHOWN when Volume Filter enabled\n\nSHOWS:\nâ€¢ Current volume vs average\nâ€¢ Multiplier (e.g., '1.8x')\nâ€¢ âœ… if above threshold\nâ€¢ âŒ if below threshold\n\nUseful for confirming breakout strength")
showTrend = input.bool(true, "Show Trend", group=grp_dash, inline="rows2", tooltip="Display trend direction\n\nONLY SHOWN when Trend Filter enabled\n\nSHOWS:\nâ€¢ Trend direction (UP/DOWN/NEUTRAL)\nâ€¢ Method used (VWAP/EMA/etc.)\nâ€¢ âœ… Aligned / âŒ Against trend\n\nUseful for context")
showRisk = input.bool(true, "Show Risk/Reward", group=grp_dash, inline="rows2", tooltip="Display Risk/Reward ratio\n\nSHOWS: Ratio of potential profit to risk\n\nFORMAT: '1:2.5' means:\n• Risk: $100\n• Reward: $250\n\nINDICATORS:\n• ✅ Ratio ≥ 2.0 (good)\n• ⚠️ Ratio 1.5-2.0 (acceptable)\n• ❌ Ratio < 1.5 (poor)\n\nBased on highest enabled TP")
showVolatilityMeter = input.bool(true, "Show Volatility Meter", group=grp_dash, inline="rows3", tooltip="Display current market volatility level\n\nMEASURES: ATR as percentage of price\n\nLEVELS:\n🔥🔥🔥 EXTREME (>3%): Very volatile, wider stops needed\n🔥🔥 HIGH (2-3%): Active movement, standard stops\n🔥 MEDIUM (1-2%): Normal trading range\n⚪ LOW (<1%): Quiet market, tight stops possible\n\nUSE FOR:\n• Adjusting position size\n• Setting appropriate stops\n• Understanding market conditions\n\nHigh volatility = Bigger potential moves but more risk")

enablePosSizing = input.bool(true, "Calculate Position Size", group=grp_dash, tooltip="Calculate shares to buy based on risk management\n\nCALCULATES:\n• Max shares to buy\n• Position dollar value\n• Risk amount\n• TP profit projections\n• TP allocation splits\n\nWHY:\n• Consistent risk per trade\n• Proper position sizing\n• Prevents over-leveraging\n\nSHOWS: Extra section in dashboard\n\nON: Shows position sizing\nOFF: Only price levels")
riskMode = input.string("% of Account", "Risk", options=["% of Account", "$ Amount"], group=grp_dash, inline="risk", tooltip="How to define your risk per trade\n\n$ AMOUNT:\n• Risk fixed dollar amount\n• Simple and direct\n• Example: '$150 per trade'\n• Good for: Consistent trading\n\n% OF ACCOUNT:\n• Risk percentage of total account\n• Scales with account size\n• Example: '1% of $25,000 = $250'\n• Good for: Account growth\n\nRECOMMENDED: % of Account")
fixedRisk = input.float(200, "INR", minval=50, maxval=100000, group=grp_dash, inline="risk", tooltip="Fixed INR amount to risk per trade\n\nONLY USED when Risk Mode = INR Amount\n\nEXAMPLE: Fixed Risk = INR 200\n• Entry: 100\n• Stop: 98 (2 risk per share)\n• Position: 100 shares (200 / 2)\n• Total position value: INR 10,000\n\nRECOMMENDATIONS:\n• INR 100-200: Small accounts (10K)\n• INR 500-1000: Medium accounts (50K)\n• INR 2000+: Large accounts (1L+)")
accountSize = input.float(10000, "Account INR", minval=1000, group=grp_dash, inline="acct", tooltip="Total trading account size in INR\n\nUSED FOR: Calculating risk percentage\n\nEXAMPLE: Account = INR 10,000, Risk = 2%\n• Risk per trade = INR 200\n\nUPDATE THIS:\n• When account grows/shrinks significantly\n• For accurate position sizing\n• Monthly review recommended")
riskPct = input.float(1.0, "Risk %", minval=0.1, maxval=5, step=0.1, group=grp_dash, inline="acct", tooltip="Percentage of account to risk per trade\n\nONLY USED when Risk Mode = % of Account\n\nRISK LEVELS:\n• 0.5-1%: Conservative\n• 1-2%: Balanced (recommended) ⭐\n• 2-3%: Aggressive\n• 3%+: Very aggressive, not recommended\n\nEXAMPLE: Account = INR 10,000, Risk = 2%\n• Risk per trade = INR 200\n• Entry: 100, Stop: 98 (2 risk per share)\n• Position: 100 shares\n\nRECOMMENDED: 1-2% for most traders")
enablePosLimit = input.bool(false, "Limit Position Size", group=grp_dash, inline="poslimit", tooltip="Enable position size cap as % of account\n\nWHEN OFF (Recommended):\n• Pure risk-based sizing\n• Your Risk % always works as intended\n• Position size determined only by risk\n\nWHEN ON:\n• Caps position to Max Position %\n• May reduce actual risk below intended\n• Use for liquidity concerns on large accounts\n\nRECOMMENDED: OFF for most traders")
maxPositionPct = input.float(100.0, "Max %", minval=5, maxval=100, step=5, group=grp_dash, inline="poslimit", tooltip="Maximum position size as % of account\n\nONLY USED when 'Limit Position Size' is ON\n\nEXAMPLE: Account = 100,000, Max = 50%\n• Maximum position value = 50,000\n• Caps shares even if risk allows more\n\nRECOMMENDED LEVELS:\n• 50-75%: Large accounts (liquidity)\n• 100%: Effectively no limit\n\nUSE THIS FOR:\n• Large accounts with liquidity concerns\n• Low-volume stocks\n• Risk of slippage on big positions")

accountCurrency = input.string("INR", "Account Currency", options=["INR", "USD", "EUR", "GBP", "JPY", "CAD", "AUD", "CHF"], group=grp_dash, inline="currency", tooltip="Currency of your trading account\n\nINR: Indian Rupee (default)\nUSD: U.S. Dollar\nEUR: Euro\nGBP: British Pound\nJPY: Japanese Yen\nCAD: Canadian Dollar\nAUD: Australian Dollar\nCHF: Swiss Franc\n\nIMPORTANT: Affects position sizing calculations\nAll risk and position values are shown in this currency")
useDynamicRates = input.bool(true, "Live Exchange Rates", group=grp_dash, inline="exchange", tooltip="Fetch live exchange rates from market data\n\nON: Uses real-time rates from TradingView (recommended)\nOFF: Use manual rate input\n\nNOTE: Live rates may not be available for all pairs")
manualRate = input.float(1.0, "/ Or set manual Rate: $1=", minval=0.001, maxval=10000, step=0.1, group=grp_dash, inline="exchange", tooltip="Fallback exchange rate when live rates unavailable\n\nFrom USD to your account currency\n\nEXAMPLES:\n• USD to INR = 83.0\n• USD to EUR = 0.92\n• USD to JPY = 150.0")

symbolCurrency = syminfo.currency

float liveRate = na
string currencyPair = ""

if useDynamicRates and accountCurrency != "USD"
    currencyPair := accountCurrency == "EUR" ? "EURUSD" :
                   accountCurrency == "GBP" ? "GBPUSD" :
                   accountCurrency == "JPY" ? "USDJPY" :
                   accountCurrency == "INR" ? "USDINR" :
                   accountCurrency == "CAD" ? "USDCAD" :
                   accountCurrency == "AUD" ? "AUDUSD" :
                   accountCurrency == "CHF" ? "USDCHF" : ""

    if currencyPair != ""
        liveRate := request.security(currencyPair, "D", close, lookahead=barmerge.lookahead_off)

float defaultRate = accountCurrency == "EUR" ? 0.92 :
                   accountCurrency == "GBP" ? 0.79 :
                   accountCurrency == "JPY" ? 150.0 :
                   accountCurrency == "INR" ? 83.0 :
                   accountCurrency == "CAD" ? 1.38 :
                   accountCurrency == "AUD" ? 1.55 :
                   accountCurrency == "CHF" ? 0.90 : 1.0
exchangeRate = accountCurrency == "USD" ? 1.0 :
               not useDynamicRates ? manualRate :
               na(liveRate) ? defaultRate :
               // Invert rates for pairs where USD is quote currency (EUR, GBP, AUD)
               (accountCurrency == "EUR" or accountCurrency == "GBP" or accountCurrency == "AUD") ? 1/liveRate :
               liveRate  // Direct rate for pairs where USD is base currency (JPY, INR, CAD, CHF)

// ======================================= HIGHER TIMEFRAME FILTER ===================================
enableHTF = input.bool(true, "Check Daily Trend", group=grp_htf, tooltip="Check higher timeframe trend before taking breakouts\n\nWHY: Breakouts WITH higher timeframe trend have higher success rate\n\nWHAT IT DOES:\n• Checks daily/4H/weekly trend\n• Shows warning if breakout against trend\n• Displays HTF bias in dashboard\n\nDOES NOT BLOCK signals - only warns you\n\nON: Shows HTF context (recommended for swing traders)\nOFF: Focuses only on intraday ORB")
htfTF = input.string("D", "Timeframe", options=["15", "30", "60", "120", "240", "D", "W", "M"], group=grp_htf, inline="htf", tooltip="Higher timeframe to analyze for trend\n\nRECOMMENDED OPTIONS:\n• 15/30/60 min: For 1-5 min charts\n• 240 (4H): For 15-60 min charts\n• D (Daily): For intraday trading ⭐\n• W (Weekly): For swing trading\n• M (Monthly): For position trading\n\nRULE: HTF should be 4-10× your chart timeframe\n\nEXAMPLES:\n• 5min chart → Use 30/60/D\n• 15min chart → Use 60/240/D\n• 1H chart → Use 240/D/W")
htfMethod = input.string("Price vs MA", "Method", options=["Price vs MA", "Candle Direction"], group=grp_htf, inline="htf", tooltip="How to determine HTF trend\n\nPRICE VS MA (Recommended):\n• Compares HTF close to moving average\n• Above MA = Bullish\n• Below MA = Bearish\n• Smooth and reliable\n• Less prone to whipsaws\n\nCANDLE DIRECTION:\n• Based on HTF candle color\n• Green candle = Bullish\n• Red candle = Bearish\n• More reactive\n• Can change quickly\n\nRECOMMENDED: Price vs MA for stability")
htfEMA = input.int(20, "MA", minval=5, maxval=200, group=grp_htf, inline="htf2", tooltip="")
htfMinStrength = input.float(2.0, "Min Distance %", minval=0.0, maxval=10.0, step=0.5, group=grp_htf, inline="htf2", tooltip="Moving average period for HTF trend\n\nONLY USED when Method = Price vs MA\n\nSHORTER = More reactive, frequent changes\nLONGER = Smoother, stable trend\n\nRECOMMENDATIONS:\n• 10-20: Responsive (short-term trend)\n• 20-50: Balanced (recommended) ⭐\n• 50-100: Smooth (intermediate trend)\n• 100-200: Very smooth (long-term trend)\n\nCOMMON CHOICES:\n• Daily TF + 20 EMA: Classic\n• Daily TF + 50 EMA: Swing trading\n• Weekly TF + 20 EMA: Position trading\n\nMinimum distance from MA to consider trend valid\n\nPrice must be at least X% away from MA\n\nLOWER = Accept weak trends\nHIGHER = Only strong trends\n\nRECOMMENDATIONS:\n• 0-1%: Very permissive\n• 1-2%: Balanced ⭐\n• 2-3%: Conservative\n• 3%+: Very selective\n\nHELPS AVOID:\n• Choppy/sideways markets\n• Weak trend signals\n• False breakouts")
blockCounterTrend = input.bool(true, "Block Counter-Trend", group=grp_htf, inline="htf3", tooltip="BLOCK entries that go against the HTF (daily) trend\n\nWHEN ENABLED:\n• LONG entries blocked when HTF is bearish\n• SHORT entries blocked when HTF is bullish\n• Significantly reduces losing trades\n\nWHEN DISABLED:\n• Shows warning only (original behavior)\n• Entries allowed against HTF trend\n\nRECOMMENDED: ON - Today's losses were all counter-trend trades")

// ======================================= INDEX DIRECTION FILTER ==================================
enableIndexFilter = input.bool(true, "Enable Index Filter", group=grp_index, inline="idx1", tooltip="Filter trades based on broad market (NIFTY 50) direction\n\nWHY: 60-80% of intraday stock movement correlates with NIFTY direction\nBlocking counter-index entries significantly reduces false breakouts\n\nIntegrates into 'both against' blocking logic:\n- Entry blocked only when MULTIPLE filters oppose the direction\n\nON: Check NIFTY direction before entry\nOFF: Ignore market direction")
indexSymbol = input.string("NSE:NIFTY", "Index Symbol", group=grp_index, inline="idx1", tooltip="Reference index for direction filter\n\nRECOMMENDED:\n• NSE:NIFTY - Best for most Indian stocks (default)\n• NSE:BANKNIFTY - Banking/finance stocks\n\nNIFTY 50 correlates with 60-80% of all NSE stocks on intraday basis\nEven non-NIFTY stocks follow broad market direction")
indexFilterMethod = input.string("Price vs VWAP", "Method", options=["Price vs VWAP", "Price vs EMA", "ORB Direction"], group=grp_index, inline="idx2", tooltip="How to determine index direction\n\nPRICE VS VWAP (Recommended):\n• NIFTY close > VWAP = Bullish\n• NIFTY close < VWAP = Bearish\n• Best for intraday (VWAP is institutional reference)\n\nPRICE VS EMA:\n• NIFTY close > EMA = Bullish\n• Smoother, less reactive\n\nORB DIRECTION:\n• NIFTY above its own ORB high = Bullish\n• NIFTY below its own ORB low = Bearish\n• Most aligned with ORB strategy logic")
indexEMALength = input.int(20, "EMA Length", minval=5, maxval=50, group=grp_index, inline="idx2", tooltip="EMA period for index direction (only used with Price vs EMA method)")

// ======================================= SMART ENTRY FILTERS =====================================
// These filters help avoid exhaustion moves in gap stocks

enableGapFilter = input.bool(true, "Enable Gap Filter", group=grp_smart, inline="gap1", tooltip="Filter trades based on opening gap size\n\nLarge gaps (>2%) often fade/reverse\nSmall gaps (<1%) more likely to continue\n\nON: Skip entries on large gap days\nOFF: Trade all gaps")
maxGapPercent = input.float(2.5, "Max Gap %", minval=0.5, maxval=5.0, step=0.5, group=grp_smart, inline="gap1", tooltip="Maximum gap size to allow trading\n\nGaps larger than this will be skipped\n\nRECOMMENDED:\n2.0-2.5% for volatile Indian stocks")

enableORBRangeFilter = input.bool(true, "Enable ORB Range Filter", group=grp_smart, inline="orbrange1", tooltip="Filter based on ORB range width\n\nWide ORB = momentum already spent in range formation\nNarrow ORB = consolidation, better breakout potential\n\nON: Skip wide ORB ranges\nOFF: Trade all ranges")
minORBRangePercent = input.float(0.4, "Min ORB Range %", minval=0.0, maxval=2.0, step=0.1, group=grp_smart, inline="orbrange1", tooltip="Minimum ORB range as % of price\n\nIf ORB range < this %, skip the trade\n\nToo narrow ORB = choppy, no clear range\n\nRECOMMENDED: 0.4% to allow more setups")
maxORBRangePercent = input.float(3.5, "Max %", minval=0.5, maxval=10.0, step=0.25, group=grp_smart, inline="orbrange1", tooltip="Maximum ORB range as % of price\n\nIf ORB High-Low > this %, skip the trade\n\nRECOMMENDED: 3.5% for volatile Indian stocks")

enableRetestEntry = input.bool(false, "Retest Entry Mode", group=grp_smart, inline="retest1", tooltip="Wait for price to retest OR consolidate near ORB level\n\nTRIGGERS ENTRY WHEN:\n1. Price pulls back to touch ORB level, OR\n2. Price consolidates near level for 3+ bars\n\nFILTERS: Exhaustion moves that don't return\nBETTER: Entry price and risk:reward\n\nON: Enter on retest/consolidation\nOFF: Enter immediately on breakout (recommended)")
retestEntryBuffer = input.float(0.6, "Retest Buffer %", minval=0.0, maxval=1.5, step=0.05, group=grp_smart, inline="retest1", tooltip="How close price must come to ORB level\n\n0.0% = Must touch exact level\n0.3% = Strict\n0.6% = Default (recommended)\n0.8%+ = Very permissive")
retestEntryTimeout = input.int(20, "Timeout (bars)", minval=3, maxval=30, group=grp_smart, inline="retest2", tooltip="Max bars to wait for retest/consolidation\n\nRECOMMENDED: 20 bars on 5-min (100 min)\n\nIf no valid entry within this time:\n- Skips trade if price ran too far\n- Enters if price consolidated near level")
consolidationBars = input.int(2, "Consolidation Bars", minval=2, maxval=6, group=grp_smart, inline="retest2", tooltip="Bars price must hold near breakout level to trigger consolidation entry\n\nIf price stays within buffer zone for this many bars, triggers entry even without touching exact level\n\nCatches strong breakouts that don't pull back")
consolidationZonePercent = input.float(1.2, "Zone %", minval=0.5, maxval=2.0, step=0.1, group=grp_smart, inline="retest2", tooltip="Consolidation zone size as % above ORB level\n\n0.8% = Tight zone (strict)\n1.2% = Default (recommended)\n1.5%+ = Wide zone (permissive)")

enableMinEntryTime = input.bool(true, "Enable Min Entry Time", group=grp_smart, inline="mintime", tooltip="Don't enter trades before this time\n\nLets initial gap volatility settle\nBreakouts after 9:45 are more reliable\n\nON: Wait for minimum time\nOFF: Enter anytime after ORB forms")
minEntryHour = input.int(9, "Hour", minval=9, maxval=12, group=grp_smart, inline="mintime")
minEntryMinute = input.int(45, "Min", minval=0, maxval=59, group=grp_smart, inline="mintime", tooltip="Minimum time before taking entries\n\nRECOMMENDED: 9:45 AM\nLets first 30 min volatility settle")

// ====================== NR FILTER (Toby Crabel narrow-range pre-filter) =====================
// Daily-timeframe regime filter: trade only when yesterday's range was the narrowest
// of the last N trading days. Academic research and Crabel's "Day Trading with Short
// Term Price Patterns" show ORB breakouts after a narrow-range day have ~70-75% follow-
// through vs 55-60% baseline. NR7 fires on roughly 14% of days per stock — intentionally rare.
//
// Two modes:
//   Prefer  — track NR state for visual / future scoring; do NOT block any entries.
//             Default-on shape lets you measure NR-day WR uplift without hurting density.
//   Require — block entries when yesterday was NOT NR. Strict; cuts daily trade count by ~85%.
//
// Default enableNRFilter=false: turning the input on with mode=Prefer is a pure no-op for
// trade execution (so backtests with feature on/off must produce identical results).
enableNRFilter = input.bool(false, "Enable NR Filter", group=grp_nrfilter, inline="nr1", tooltip="Toby Crabel narrow-range pre-filter\n\nTrade only after a narrow-range day\n\nWHY:\n• ORB breakouts after NR days have ~70-75% follow-through\n• Baseline (no NR filter): ~55-60%\n• Identifies coiled-spring setups\n\nFires on ~14% of days per stock (NR7 default)\n\nDEFAULT: OFF — turn on after Strategy-Tester validates NR uplift")
nrLookback = input.int(7, "Lookback Days", options=[4, 7, 10, 20], group=grp_nrfilter, inline="nr1", tooltip="N days for narrow-range comparison\n\n4  = NR4, fires ~25% of days, weaker edge\n7  = NR7 (Crabel classic, recommended) ⭐\n10 = NR10, fires ~10% of days, stronger edge\n20 = NR20, fires ~5%, strongest edge / very rare")
nrMode = input.string("Prefer", "Mode", options=["Prefer", "Require"], group=grp_nrfilter, inline="nr2", tooltip="How NR result affects entries\n\nPREFER (default):\n• Tracks NR state\n• Does NOT block any entries\n• Use to A/B measure NR-day WR uplift before promoting\n\nREQUIRE:\n• Blocks entries when yesterday was NOT NR\n• Strict — cuts daily trade count by ~85%\n• Use only after Prefer-mode data confirms uplift")

// ============================================ GOD MODE =============================================
// Ported from the upstream Luxy indicator. Grades the ORB breakout itself 0-100 (A+..D),
// widens the breakout buffer on volatile tickers, and flags chop days. Distinct from the
// key-level score below: that one grades VA/PD/IB setups, this one grades the ORB break.
// Rebuilt on this file's existing state (cachedVolumeMA, cachedHTF*, klATRDaily, todayOpen,
// prevDayClose, sessionBreakouts*) rather than re-deriving it — no new request.security.
godModeEnabled = input.bool(true, "Enable GOD MODE", group=grp_god, tooltip="Breakout-quality intelligence layer for the ORB signal\n\nADDS:\n• Quality Score 0-100 graded A+ to D on breakout labels and the dashboard\n• Adaptive breakout buffer scaled by ATR\n• Chop-Day Guard after repeated failed breaks\n\nScoring inputs: volume strength, HTF bias alignment, ORB width vs daily ATR (narrow is better), gap direction, PDH/PDL confluence, and how many breaks already failed today.\n\nOFF = classic behaviour, exactly as before.")
godAdaptiveBuffer = input.bool(true, "Adaptive Buffer", group=grp_god, inline="god1", tooltip="Effective buffer = max(Breakout Buffer %, 10% of ATR).\n\nA FLOOR, never a reduction: volatile tickers get a wider buffer, quiet ones keep the fixed %.\n\nThis is what makes a LOW Breakout Buffer % safe — set 0.1-0.2% and let ATR widen it per ticker.")
godChopGuard = input.bool(true, "Chop-Day Guard", group=grp_god, inline="god1", tooltip="2+ failed breaks in a session = CHOP DAY: dashboard warning, quality score capped at 40.\n\nGuards ORB's most common failure mode — range-day whipsaws.")

// ================================= KEY-LEVEL BREAKOUT (VP / PD / IB) ===============================
// ORB is one key level among several. This section adds the other levels a breakout
// trader watches — previous-session Value Area (VAH/POC/VAL), Previous Day High/Low,
// and the Initial Balance (09:15-10:15) — as ADDITIONAL, independently toggleable
// breakout triggers that run through the same entry/SL/TP/alert pipeline as ORB.
//
// SAFETY POSTURE: alert-only by default. `enableKeyLevelExecution` is OFF, so these
// setups draw arrows, score, and fire a decision-packet alert but never call
// strategy.entry. With every toggle at its default, backtest results are identical
// to orb.pine — that inertness is the regression gate for this whole feature.
//
// Merged from pinescripts/intraday/volume-profile/volume-profile-decision-assist.pine

// ─── Value Area source ──────────────────────────────────────────────────────
// AUTO   — reconstruct the previous session's profile from 1-min data inside this
//          script. Self-contained but approximate; tune ticksPerRow to match TV.
// MANUAL — type the three numbers off TradingView's native Session Volume Profile.
//          Exact, ~30s each morning. Pine cannot read another indicator's values.
klAutoProfile  = input.bool(true, "Auto-reconstruct profile", group=grp_vp, inline="src", tooltip="Where VAH/POC/VAL come from\n\nON (Auto):\n• Builds the previous session's volume-at-price histogram from 1-min data\n• No dependency on any other indicator\n• APPROXIMATE — tune 'Ticks per row' to match TradingView\n\nOFF (Manual):\n• Uses the Manual VAH/POC/VAL inputs below\n• Read them off TradingView's native Session Volume Profile (previous day)\n• Exact, but needs ~30 seconds of typing each morning\n\nUse Manual whenever exact levels matter.")
klTicksPerRow  = input.int(5, "| Ticks per row", minval=1, maxval=100, group=grp_vp, inline="src", tooltip="Profile row height = symbol mintick × this value\n\nSMALLER = finer profile, more precise POC, slower\nLARGER  = coarser profile, faster\n\nTune until the auto POC matches TradingView's Session\nVolume Profile POC on the same symbol.\n\nRECOMMENDED: 5 for most NSE cash stocks")
klValueAreaPct = input.float(70, "Value area %", minval=50, maxval=90, step=5, group=grp_vp, tooltip="Percentage of session volume enclosed by the value area\n\n70% is the Market Profile standard (one standard deviation)\n\nThe area grows outward from POC until it holds this share\nof total session volume. VAH/VAL are its edges.")
klManualVAH    = input.float(0.0, "Manual VAH", minval=0, group=grp_vp, inline="man", tooltip="Used ONLY when 'Auto-reconstruct profile' is OFF\n\nRead from TradingView's Session Volume Profile (previous day)\n\n0 = disabled")
klManualPOC    = input.float(0.0, "POC", minval=0, group=grp_vp, inline="man", tooltip="Manual Point of Control. Used only when Auto is OFF. 0 = disabled")
klManualVAL    = input.float(0.0, "VAL", minval=0, group=grp_vp, inline="man", tooltip="Manual Value Area Low. Used only when Auto is OFF. 0 = disabled")

// ─── Trigger families ───────────────────────────────────────────────────────
enableKeyLevels    = input.bool(true, "Enable Key-Level Engine", group=grp_keylevel, tooltip="Master switch for the whole key-level layer\n\nOFF: no levels resolved, no profile accumulation, no scoring,\nno drawing, no key-level alerts. The script behaves exactly\nlike the original ORB strategy.\n\nON: levels are computed, drawn and scored. Whether they can\nOPEN A TRADE is controlled separately by 'Execute key-level\nsetups' below (default OFF).")
enableVATriggers   = input.bool(true, "| VAH / VAL setups", group=grp_keylevel, inline="fam1", tooltip="Value-Area setups from the volume-profile model\n\n• VAH rejection      — poke above VAH, close back inside → SHORT\n• VAL rejection      — poke below VAL, close back inside → LONG\n• VAH acceptance     — two consecutive closes above VAH   → LONG\n• VAL breakdown      — two consecutive closes below VAL   → SHORT\n• VAH/VAL retest     — break, pull back, hold the level")
enablePDTriggers   = input.bool(true, "| PDH / PDL setups", group=grp_keylevel, inline="fam1", tooltip="Previous Day High / Low breakout + retest\n\nPDH/PDL are the most widely watched intraday levels.\nA clean break with volume tends to run; a failed break\nreverses hard.")
enableIBTriggers   = input.bool(true, "| IBH / IBL setups", group=grp_keylevel, inline="fam2", tooltip="Initial Balance (09:15-10:15) High / Low breakout + retest\n\nIB extension is the classic Market Profile trend-day tell.\nBreaking IB after 10:15 on expanding volume is a strong\ncontinuation signal.")
klIBSession        = input.session("0915-1015", "| IB window", group=grp_keylevel, inline="fam2", tooltip="Initial Balance window (IST)\n\nMarket Profile defines IB as the first hour of trade.\nFor NSE that is 09:15-10:15.")
klRetestMaxBars    = input.int(6, "Retest window (bars)", minval=1, maxval=30, group=grp_keylevel, inline="tune", tooltip="How many bars after a level break a pullback still counts as a retest\n\nSHORTER = only immediate retests qualify\nLONGER  = late pullbacks still count, more signals\n\nRECOMMENDED: 6 bars")
klCooldownBars     = input.int(3, "| Cooldown", minval=0, maxval=50, group=grp_keylevel, inline="tune", tooltip="Minimum bars between two key-level alerts\n\nPrevents a single level from spamming alerts while price\nchops around it.\n\n0 = no cooldown")
enableKeyLevelExecution = input.bool(false, "⚠ Execute key-level setups", group=grp_keylevel, tooltip="Let key-level setups OPEN REAL TRADES\n\nOFF (default) ⭐:\n• Setups draw arrows, score, and fire alerts\n• strategy.entry is NEVER called for them\n• Backtest is identical to the plain ORB strategy\n• Use this to observe and validate first\n\nON:\n• A qualifying key-level setup enters through the SAME\n  pipeline as an ORB breakout (next-bar fill, same SL/TP,\n  same Telegram entry alert)\n• Still bound by the one-trade-per-session cap and the\n  entry cutoff time\n\nTurn this on only after the Strategy Tester and live alert\nlog confirm the setups are worth trading.")

// ─── Scoring ────────────────────────────────────────────────────────────────
klScoreThreshold = input.int(7, "Alert score threshold", minval=1, maxval=20, group=grp_score, tooltip="Minimum weighted score for a key-level setup to fire\n\nSCORE COMPONENTS:\n+2  major level interaction\n+1  per confluent structural level (max +3)\n+2  two or more confluent levels\n+2  breakout-and-retest structure\n+1  VWAP aligned with direction\n+1  EMA9 aligned + sloping with direction\n+1/+2 RVOL at min / strong threshold\n+1  strong candle close (CLV)\n+1  delta proxy agrees\n\nLOWER = more signals, more noise\nHIGHER = rare, high-conviction only\n\nRECOMMENDED: 7")
// RVOL tiers reuse volumeMultiplier / strongVolumeMultiplier from the VOLUME FILTER
// group — one definition of "strong volume" for the whole script, not two.
klClvLongMin     = input.float(0.65, "CLV long ≥", minval=0, maxval=1, step=0.05, group=grp_score, inline="clv", tooltip="Close Location Value threshold for a bullish candle\n\nCLV = (close - low) / (high - low)\n\n0.65 means the bar closed in the top 35% of its range —\nbuyers held the close. Used for rejection/retest quality.")
klClvShortMax    = input.float(0.35, "| short ≤", minval=0, maxval=1, step=0.05, group=grp_score, inline="clv", tooltip="Close Location Value threshold for a bearish candle\n\n0.35 means the bar closed in the bottom 35% of its range —\nsellers held the close.")
klConfAtrMult    = input.float(0.25, "Confluence band (× ATR)", minval=0.01, maxval=2, step=0.05, group=grp_score, tooltip="Two levels within this many ATRs are treated as confluent\n\nAlso used as the retest tolerance band.\n\nTIGHTER = fewer confluence hits, stricter retests\nWIDER   = more confluence hits, looser retests\n\nRECOMMENDED: 0.25 × ATR")
klSlBufferMult   = input.float(0.15, "SL buffer (× ATR beyond level)", minval=0, maxval=2, step=0.05, group=grp_score, tooltip="How far beyond the triggering level the stop sits\n\nA level-based stop goes just past the level that was defended,\nplus this ATR cushion to survive normal noise and stop hunts.\n\nUsed only for key-level setups. ORB entries keep their own\nstop-loss mode from the TARGETS & RISK group.")

// ─── Key-level display ──────────────────────────────────────────────────────
klShowVA        = input.bool(true,  "Show value area (VAH/POC/VAL)", group=grp_keylevel, tooltip="Draw VAH, POC and VAL as dotted day-anchored lines plus a shaded value-area box")
klShowSecondary = input.bool(true,  "Show PDH/PDL/IB levels",        group=grp_keylevel, tooltip="Draw the secondary structure levels, muted.\n\nTurn off for a value-area-only view when the chart gets noisy.\n\nORB levels are drawn by the ORB COLORS group, not here.")
klShowTags      = input.bool(true,  "Show level price tags",         group=grp_keylevel, inline="tag", tooltip="Print 'VAH 2345.60' style text tags at the right edge of each level line")
klTagMaxATR     = input.float(6.0,  "| within ATR", minval=0, maxval=50, step=0.5, group=grp_keylevel, inline="tag", tooltip="Only tag levels within this many ATRs of the current price.\n\nWith ORB, VA, IB and PD all drawn there are up to nine tags competing for the right edge; levels far from price are context, not decisions, so their prices do not need to be readable.\n\nThe LINE is always drawn — this hides only the price tag.\n\n0 = tag every level regardless of distance.")
klShowSignals   = input.bool(true,  "Show key-level signal arrows",  group=grp_keylevel, tooltip="Green up / red down triangle when a key-level setup fires, with a compact\n'CODE score RVOL' tag offset from the candle.\n\nORB breakouts keep their own labels from the BREAKOUT DETECTION group.")

// ============================================= ALERTS ==============================================
bool enableAlerts = true

// Telegram Configuration
grp_telegram = "Telegram Alerts"
telegram_chat_id = input.string("-1003518225740", "Telegram Chat ID", group=grp_telegram, tooltip="Your Telegram channel/group chat ID\n\nHOW TO GET:\n1. Add @userinfobot to your channel\n2. Forward any message to the bot\n3. Copy the chat ID (starts with -)")
sendTestAlert = input.bool(false, "Send Test Alert", group=grp_telegram, tooltip="Enable to send a test alert message.\n\nSTEPS:\n1. Enable this option\n2. Create alert: 'Any alert() function call'\n3. Webhook: https://api.telegram.org/bot<TOKEN>/sendMessage\n4. Alert triggers on last bar\n5. Disable after testing")
testAlertType = input.string("Entry", "Test Alert Type", options=["Entry", "Exit", "Both"], group=grp_telegram, tooltip="Type of test alert to send")

// ========================================= INPUT VALIDATION ========================================
if breakoutBuffer < 0 or breakoutBuffer > 5
    runtime.error("❌ Breakout Buffer must be between 0-5%. Current value: " + str.tostring(breakoutBuffer))
if minRetestDistancePct < 0.5
    runtime.error("❌ Min Retest Distance too low. Must be >= 0.5% to prevent false signals. Current: " + str.tostring(minRetestDistancePct))
if minBarsOutside < 1
    runtime.error("❌ Min Bars Outside must be >= 1. Current: " + str.tostring(minBarsOutside))
if maxCycles < 1 or maxCycles > 10
    runtime.error("❌ Max Cycles must be between 1-10. Current: " + str.tostring(maxCycles))
if enableVolumeFilter
    if volumeMultiplier < 0.5
        runtime.error("❌ Volume Multiplier too low. Must be >= 0.5x. Current: " + str.tostring(volumeMultiplier))
    if strongVolumeMultiplier < volumeMultiplier
        runtime.error("❌ Strong Volume Multiplier must be >= Min Volume Multiplier. Strong: " + str.tostring(strongVolumeMultiplier) + ", Min: " + str.tostring(volumeMultiplier))
    if volumeMaLength < 1
        runtime.error("❌ Volume MA Length must be >= 1. Current: " + str.tostring(volumeMaLength))
if enableTargets
    if atrLength < 5 or atrLength > 50
        runtime.error("❌ ATR Length must be between 5-50. Current: " + str.tostring(atrLength))
    if atrMultiplier < 0.5 or atrMultiplier > 5
        runtime.error("❌ ATR Multiplier must be between 0.5-5. Current: " + str.tostring(atrMultiplier))
    if stopOrbFraction < 10 or stopOrbFraction > 100
        runtime.error("❌ ORB Stop % must be between 10-100%. Current: " + str.tostring(stopOrbFraction))
    if swingBars < 1 or swingBars > 20
        runtime.error("❌ Swing Bars must be between 1-20. Current: " + str.tostring(swingBars))
if enablePosSizing
    if riskMode == "$ Amount" and fixedRisk < 10
        runtime.error("❌ Fixed Risk too low. Must be >= INR 100. Current: INR " + str.tostring(fixedRisk))
    if riskMode == "% of Account"
        if riskPct < 0.1 or riskPct > 10
            runtime.error("❌ Risk % must be between 0.1-10%. Current: " + str.tostring(riskPct) + "%")
        if accountSize < 100
            runtime.error("❌ Account Size too low. Must be >= INR 10000. Current: INR " + str.tostring(accountSize))
if fillTransparency < 0 or fillTransparency > 100
    runtime.error("❌ Fill Transparency must be between 0-100%. Current: " + str.tostring(fillTransparency))
if enableHTF
    if htfEMA < 5 or htfEMA > 200
        runtime.error("❌ HTF EMA period must be between 5-200. Current: " + str.tostring(htfEMA))
if enableTrendFilter
    if customEmaLength < 1 or customEmaLength > 500
        runtime.error("❌ Custom EMA Length must be between 1-500. Current: " + str.tostring(customEmaLength))

    if supertrendPeriod < 1 or supertrendPeriod > 50
        runtime.error("❌ SuperTrend Period must be between 1-50. Current: " + str.tostring(supertrendPeriod))

    if supertrendMult < 0.1 or supertrendMult > 10
        runtime.error("❌ SuperTrend Multiplier must be between 0.1-10. Current: " + str.tostring(supertrendMult))
// TP validation removed - allowing all TPs to be disabled while keeping ORB functionality

// ========================================= SESSION DETECTION =======================================
// Fix for crypto session handling - credit to Crucialblockchain (Reddit credit: u/Crucialblockchain)
// Issue: Crypto was always inSession=true, ignoring custom session times (e.g., London 08:00-16:30)
// Solution: Check if 24/7 mode first, otherwise respect session hours

// Detect if using native session (empty tradingSession string)
bool useNativeSession = tradingSession == ""

// 24/7 market detection: crypto with native session OR explicit 24/7 string
bool is24_7Market = false  // NSE equities only; crypto 24/7 handling removed

inSession = false
if useNativeSession
    // Use TradingView's native session detection (no session parameter)
    // This automatically handles timezone conversions!
    inSession := not na(time(timeframe.period))
else
    // Use custom session string (Extended Hours, timezone modes, Custom mode) with timezone support
    if syminfo.type == "stock" or syminfo.type == "fund" or syminfo.type == "index" or syminfo.type == "dr" or syminfo.type == "etf" or syminfo.type == "futures"
        inSession := not na(time(timeframe.period, tradingSession, sessionTimezone))
    else if syminfo.type == "crypto"
        if is24_7Market
            inSession := true  // 24/7 trading - always in session
        else
            inSession := not na(time(timeframe.period, tradingSession, sessionTimezone))  // Respect custom session hours
    else if syminfo.type == "forex"
        inSession := not na(time(timeframe.period, tradingSession, sessionTimezone))
    else
        inSession := not na(time(timeframe.period, tradingSession, sessionTimezone))

// ============================================== VARIABLES ==========================================
var label labH = na
var label labL = na
var color cachedLineColor = na
var float lastLabelH = na
var float lastLabelL = na
var string cachedStageName = na
var bool hadSessionToday = false
var bool hadBreakUp = false
var bool hadBreakDown = false
var int breakUpBar = na
var int breakDownBar = na
var bool shownBreakUpLabel = false
var bool shownBreakDownLabel = false
var bool everHadBreakUp = false
var bool everHadBreakDown = false
var float breakoutEntryPrice = na

// Diagnostic: why breakout was not registered (for dashboard "No Trade" reason)
var bool priceCrossedUp = false      // Price crossed ORB high + buffer
var bool priceCrossedDown = false    // Price crossed ORB low - buffer
