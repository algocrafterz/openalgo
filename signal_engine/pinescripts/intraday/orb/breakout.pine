// ========================================== VALIDATION FUNCTIONS ===================================
// ─── Time-of-day volume baseline ────────────────────────────────────────────
// Replaces the old ta.sma(volume, 50) denominator, which was time-of-day BLIND: a 50-bar
// average on a 5-min chart spans ~4 hours, so at 09:20 the denominator was mostly the
// previous session's dead close bars while the numerator was an opening bar running 5-10x
// normal. The 1.2x test was therefore near-inert in exactly the window this strategy
// trades most, and over-strict around lunch.
//
// This compares like with like: each bar is measured against the SAME slot of the session
// on previous days. Zarattini/Barbon/Aziz (SFI 2024) found across 7,000+ US stocks that
// plain ORB was weak and selection by opening RELATIVE volume did almost all the work;
// their measure is first-5-min volume over the mean first-5-min volume of 14 prior days,
// which is the `slot 0` case of this function.
//
// Returns BOTH reads, because they answer different questions:
//   vf   - cumulative session volume vs the same point of day. "Is this stock in play?"
//   base - mean bar volume at THIS slot. Denominator for per-bar breakout confirmation.
//
// STATEFUL: holds its own vars, so it MUST be called unconditionally with `en` passed in.
// Accumulation advances on CONFIRMED bars only; the forming bar is added for the live read
// without mutating state, so a realtime bar cannot freeze a partial volume into history.
klVolFactor(bool en, bool reset, bool inSess, bool confirmed, int days, int slots) =>
    // Allocated at the INPUT MAXIMA rather than at the configured size: Pine can reject a
    // series/simple int as a matrix dimension, and 30 x 400 floats is cheap enough that
    // taking the compile risk to save the allocation would be a bad trade. days/slots are
    // used only to bound the indices actually touched.
    var matrix<float> hist = matrix.new<float>(30, 400, na)
    var int   vRow    = 0
    var int   slot    = -1
    var float cumPrev = 0.0
    float vf   = na
    float base = na
    if en
        if reset
            // Yesterday's row is complete. Advance; the oldest session is overwritten.
            if slot > 0
                vRow := (vRow + 1) % days
            slot := 0
            cumPrev := 0.0
        if inSess and slot >= 0 and slot < slots
            float cumNow = cumPrev + nz(volume)
            matrix.set(hist, vRow, slot, cumNow)
            // Mean cumulative volume at this slot, and at the previous slot, across the
            // other sessions held. Their difference is the mean BAR volume for this slot,
            // so one pass yields both the session factor and the per-bar denominator.
            float sNow  = 0.0
            float sPrev = 0.0
            int   n     = 0
            for r = 0 to days - 1
                if r != vRow
                    float c = matrix.get(hist, r, slot)
                    if not na(c) and c > 0
                        sNow  += c
                        sPrev += slot > 0 ? nz(matrix.get(hist, r, slot - 1)) : 0.0
                        n     += 1
            // Minimum history before the reading is trusted. With a single prior session
            // the denominator is just yesterday, so one heavy day would suppress the factor
            // all through the next. Below this the function reports na and the volume filter
            // fails OPEN, matching how it behaves before any history exists.
            if n >= math.min(3, days - 1)
                float baseCum = sNow / n
                float baseBar = (sNow - sPrev) / n
                vf   := baseCum > 0 ? cumNow / baseCum : na
                base := baseBar > 0 ? baseBar : na
            if confirmed
                cumPrev := cumNow
                slot    += 1
    [vf, base]

hasVolumeConfirmation(volMA, mult, strongMult) =>
    if na(volMA) or volMA == 0
        true
    else
        // Volume is measured ON THE BREAKING BAR, not as a 3-bar max. The old max() let a
        // spike two bars BEFORE a weak breaking candle satisfy the filter. Breakout research
        // is consistent that what matters is expansion AT the level, in the candle doing the
        // breaking -- volume arriving after the break is the crowd, by which point the
        // risk/reward has already deteriorated. The old 3-bar window was a workaround for a
        // time-of-day-blind denominator; with a per-slot baseline it is no longer needed.
        isStrongVolume = strongMult > 0 and volume >= volMA * strongMult
        isNormalVolume = volume >= volMA * mult
        isStrongVolume or isNormalVolume

// =========================================== TARGET & STOP FUNCTIONS ================================
calculateTargets(entry, sl, isBullish, orbH, orbL) =>
    float risk    = math.abs(entry - sl)
    float orbWidth = orbH - orbL

    // TP anchored to ORB measured move (natural breakout target).
    // Floor at 0.8R prevents R:R collapse on tight-ORB / wide-ATR-SL days.
    float tp1_dist = math.max(orbWidth, risk * 0.8)

    float tp1   = isBullish ? entry + tp1_dist * 1.0 : entry - tp1_dist * 1.0
    float tp1_5 = isBullish ? entry + tp1_dist * 1.5 : entry - tp1_dist * 1.5
    float tp2   = isBullish ? entry + tp1_dist * 2.0 : entry - tp1_dist * 2.0
    float tp3   = isBullish ? entry + tp1_dist * 3.0 : entry - tp1_dist * 3.0

    [tp1, tp1_5, tp2, tp3]

// Targets for a KEY-LEVEL entry. calculateTargets() anchors to ORB width, which is
// meaningless for an IB or value-area trade -- the structure that matters is the next level
// in the trade's direction. Same 1x/1.5x/2x/3x shape, so the alert and TP tracking downstream
// need no changes. Falls back to 1.5R when no structural level lies ahead.
klCalcTargets(float entry, float sl, bool isBullish, float t1) =>
    float risk = math.abs(entry - sl)
    float d = na(t1) ? risk * 1.5 : math.max(math.abs(t1 - entry), risk * 1.0)
    [isBullish ? entry + d : entry - d, isBullish ? entry + d * 1.5 : entry - d * 1.5, isBullish ? entry + d * 2.0 : entry - d * 2.0, isBullish ? entry + d * 3.0 : entry - d * 3.0]

calculateStopLoss(entry, orbHigh, orbLow, orbRange, atr, mode, isBullish) =>
    float sl = na
    float orbFraction = stopOrbFraction / 100

    float validATR = na(atr) or atr == 0 ? orbRange * 0.5 : atr

    float atrPercent = (validATR / entry) * 100

    float minStopMultiplier = syminfo.type == "crypto" ? 1.0 :      // Crypto needs wider stops
                              syminfo.type == "forex" ? 0.3 :       // Forex needs tighter stops
                              atrPercent > 5 ? 1.5 :                // Very volatile (>5% ATR)
                              atrPercent > 3 ? 1.0 :                // High volatility (3-5% ATR)
                              atrPercent > 1.5 ? 0.7 :              // Normal volatility (1.5-3% ATR)
                              0.5                                   // Low volatility (<1.5% ATR)

    float minStopDistance = validATR * minStopMultiplier

    float absoluteMin = syminfo.type == "crypto" ? entry * 0.01 :   // 1% min for crypto
                       syminfo.type == "forex" ? entry * 0.002 :    // 0.2% min for forex
                       entry * 0.003                                // 0.3% min for stocks

    minStopDistance := math.max(minStopDistance, absoluteMin)

    if isBullish
        if mode == "ATR"
            float priceAdjust = entry < 1000 ? 1.0 :   // Standard for normal prices
                               entry < 5000 ? 0.7 :    // Reduce for high price
                               0.5                     // Further reduce for very high price
            sl := entry - (validATR * atrMultiplier * priceAdjust)
            // ORB floor: keep SL below ORB Low so first-bar wick-backs don't trigger SL hunt
            float wickBuf = math.max(validATR * 0.3, orbRange * 0.15)
            sl := math.min(sl, orbLow - wickBuf)
        else if mode == "ORB %"
            sl := orbLow - (orbRange * orbFraction)
        else if mode == "Swing"
            sl := ta.lowest(low, swingBars)
        else if mode == "Safer"
            float atrSL = entry - (validATR * atrMultiplier * 2)  // Wider for safer
            float swingSL = ta.lowest(low, swingBars)
            float orbSL = orbLow - (orbRange * orbFraction * 1.5)  // 150% of normal ORB fraction
            sl := math.min(swingSL, math.min(atrSL, orbSL))  // Most conservative
        else if mode == "% Based"
            sl := entry * (1 - percentBasedStop / 100)  // Simple % from entry
        else if mode == "Smart Adaptive"
            float smartMultiplier = atrPercent > 3 ? 1.5 : atrPercent > 1.5 ? 1.0 : 0.7
            float atrStop = entry - (validATR * smartMultiplier)
            float orbStop = orbLow - (orbRange * 0.3)  // 30% of ORB range
            // Use ATR-based stop primarily, ORB as fallback
            sl := math.min(atrStop, orbStop)  // More conservative (farther from entry)
        else if mode == "Scaled ATR"
            float scaledMult = atrPercent > 5 ? 2.5 :     // Very volatile - wider stop
                              atrPercent > 3 ? 2.0 :      // High volatility
                              atrPercent > 1.5 ? 1.5 :    // Normal volatility
                              1.2                         // Low volatility - tighter stop
            sl := entry - (validATR * scaledMult)
            // ORB floor: keep SL below ORB Low so first-bar wick-backs don't trigger SL hunt
            float wickBuf = math.max(validATR * 0.3, orbRange * 0.15)
            sl := math.min(sl, orbLow - wickBuf)
    else
        if mode == "ATR"
            float volAdjust = atrPercent > 3 ? 1.2 : atrPercent > 1.5 ? 1.0 : 0.8
            sl := entry + (validATR * atrMultiplier * volAdjust)
            // ORB ceiling: keep SL above ORB High so first-bar wick-backs don't trigger SL hunt
            float wickBuf = math.max(validATR * 0.3, orbRange * 0.15)
            sl := math.max(sl, orbHigh + wickBuf)
        else if mode == "ORB %"
            sl := orbHigh + (orbRange * orbFraction)
        else if mode == "Swing"
            sl := ta.highest(high, swingBars)
        else if mode == "Safer"
            float atrSL = entry + (validATR * atrMultiplier * 2)
            float swingSL = ta.highest(high, swingBars)
            float orbSL = orbHigh + (orbRange * orbFraction * 1.5)
            sl := math.max(swingSL, math.max(atrSL, orbSL))
        else if mode == "% Based"
            sl := entry * (1 + percentBasedStop / 100)
        else if mode == "Smart Adaptive"
            // Same volatility-based logic for bearish
            float smartMultiplier = atrPercent > 3 ? 1.5 : atrPercent > 1.5 ? 1.0 : 0.7
            float atrStop = entry + (validATR * smartMultiplier)
            float orbStop = orbHigh + (orbRange * 0.3)
            sl := math.max(atrStop, orbStop)  // More conservative
        else if mode == "Scaled ATR"
            // Same volatility scaling for bearish
            float scaledMult = atrPercent > 5 ? 2.5 :
                              atrPercent > 3 ? 2.0 :
                              atrPercent > 1.5 ? 1.5 :
                              1.2
            sl := entry + (validATR * scaledMult)
            // ORB ceiling: keep SL above ORB High so first-bar wick-backs don't trigger SL hunt
            float wickBuf = math.max(validATR * 0.3, orbRange * 0.15)
            sl := math.max(sl, orbHigh + wickBuf)

    sl := isBullish ? math.min(sl, entry - minStopDistance) : math.max(sl, entry + minStopDistance)

    sl

calculatePositionSize(entry, sl) =>
    float riskAmount = 0.0

    if riskMode == "% of Account"
        riskAmount := accountSize * (riskPct / 100)
    else
        riskAmount := fixedRisk

    float riskPerShare = math.abs(entry - sl)
    float sharesFromRisk = riskPerShare > 0 ? math.floor(riskAmount / riskPerShare) : 0

    float shares = sharesFromRisk

    // Only apply position limit if enabled
    if enablePosLimit
        float maxPositionValue = accountSize * (maxPositionPct / 100)
        float maxSharesFromLimit = entry > 0 ? math.floor(maxPositionValue / entry) : 0
        shares := math.min(sharesFromRisk, maxSharesFromLimit)
    float posValue = shares * entry
    shares := math.floor(shares)
    float maxLossCalc = shares * riskPerShare

    [shares, posValue, maxLossCalc, riskAmount]

calculateTPSplits(show1, show1_5, show2, show3) =>
    int activeCount = 0
    if show1
        activeCount += 1
    if show1_5
        activeCount += 1
    if show2
        activeCount += 1
    if show3
        activeCount += 1

    float split1 = 0.0
    float split1_5 = 0.0
    float split2 = 0.0
    float split3 = 0.0

    if activeCount == 1
        if show1
            split1 := 1.0
        else if show1_5
            split1_5 := 1.0
        else if show2
            split2 := 1.0
        else if show3
            split3 := 1.0
    else if activeCount == 2
        float half = 0.5
        if show1
            split1 := half
            if show1_5
                split1_5 := half
            else if show2
                split2 := half
            else if show3
                split3 := half
        else if show1_5
            split1_5 := half
            if show2
                split2 := half
            else if show3
                split3 := half
        else if show2
            split2 := half
            if show3
                split3 := half
        else if show3
            split3 := half
    else if activeCount >= 3
        float remaining = 0.5
        float remainder = remaining / (activeCount - 1)

        bool firstAssigned = false
        if show1
            split1 := firstAssigned ? remainder : 0.5
            firstAssigned := true
        if show1_5
            split1_5 := firstAssigned ? remainder : 0.5
            firstAssigned := true
        if show2
            split2 := firstAssigned ? remainder : 0.5
            firstAssigned := true
        if show3
            split3 := firstAssigned ? remainder : 0.5
            firstAssigned := true

    [split1, split1_5, split2, split3]

checkHTFBias() =>
    bool bullish = false
    bool bearish = false
    string biasText = ""
    float strength = 0.0

    if enableHTF
        [htfClose, htfOpen, htfMA] = request.security(syminfo.tickerid, htfTF, [close, open, ta.ema(close, htfEMA)], barmerge.gaps_off, barmerge.lookahead_off)

        if htfMethod == "Price vs MA"
            float distancePct = htfMA > 0 ? ((htfClose - htfMA) / htfMA) * 100 : 0
            strength := math.abs(distancePct)

            bool strongEnough = enableHTF ? strength >= htfMinStrength : false

            bullish := htfClose > htfMA and strongEnough
            bearish := htfClose < htfMA and strongEnough

        else if htfMethod == "Candle Direction"
            float bodySize = math.abs(htfClose - htfOpen)
            float candleRange = htfClose > 0 ? (bodySize / htfClose) * 100 : 0
            strength := candleRange

            bullish := htfClose > htfOpen
            bearish := htfClose < htfOpen

        if bullish
            biasText := strength > htfMinStrength * 2 ? "Strong Bullish" : "Bullish"
        else if bearish
            biasText := strength > htfMinStrength * 2 ? "Strong Bearish" : "Bearish"
        else
            biasText := "Neutral"

    [bullish, bearish, biasText, strength]

// ============================================== FUNCTIONS ==========================================
getBodyHigh() => math.max(open, close)
getBodyLow() => math.min(open, close)
bodyClosedAbove(level) => getBodyLow() > level
bodyClosedBelow(level) => getBodyHigh() < level

float currentTF_minutes = timeframe.in_seconds() / 60
needsConfirmation = currentTF_minutes <= 5

getBuffer(level, pct) =>
    level * (pct / 100)
priceRetestFromAbove(level, buffer) =>
    getBodyLow() < level + buffer
priceRetestFromBelow(level, buffer) =>
    getBodyHigh() > level - buffer
getLabelSize(sizeStr) =>
    sizeStr == "Tiny" ? size.tiny : sizeStr == "Small" ? size.small : sizeStr == "Normal" ? size.normal : sizeStr == "Large" ? size.large : size.huge
calcSuperTrend(atrPeriod, multiplier) =>
    atr = ta.atr(atrPeriod)
    hl2Val = hl2

    basicUpperBand = hl2Val + multiplier * atr
    basicLowerBand = hl2Val - multiplier * atr

    var float finalUpperBand = na
    var float finalLowerBand = na
    var int trendDir = 1

    finalUpperBand := na(finalUpperBand[1]) or basicUpperBand < finalUpperBand[1] or close[1] > finalUpperBand[1] ? basicUpperBand : finalUpperBand[1]
    finalLowerBand := na(finalLowerBand[1]) or basicLowerBand > finalLowerBand[1] or close[1] < finalLowerBand[1] ? basicLowerBand : finalLowerBand[1]

    trendDir := na(trendDir[1]) ? 1 : close > finalUpperBand[1] ? 1 : close < finalLowerBand[1] ? -1 : trendDir[1]

    [finalLowerBand, finalUpperBand, trendDir]

isTrendUp(mode, closePrice, vwapVal, ema12Val, emaCustomVal, stDir) =>
    switch mode
        "VWAP" => closePrice > vwapVal
        "EMA" => closePrice > ema12Val
        "Custom EMA" => closePrice > emaCustomVal
        "SuperTrend" => stDir == 1
        "VWAP+EMA" => closePrice > vwapVal and closePrice > ema12Val
        "VWAP+SuperTrend" => closePrice > vwapVal and stDir == 1
        => true

isTrendDown(mode, closePrice, vwapVal, ema12Val, emaCustomVal, stDir) =>
    switch mode
        "VWAP" => closePrice < vwapVal
        "EMA" => closePrice < ema12Val
        "Custom EMA" => closePrice < emaCustomVal
        "SuperTrend" => stDir == -1
        "VWAP+EMA" => closePrice < vwapVal and closePrice < ema12Val
        "VWAP+SuperTrend" => closePrice < vwapVal and stDir == -1
        => true

isTradingDay() =>
    bool isTrading = true

    if syminfo.type == "stock" or syminfo.type == "fund" or syminfo.type == "index" or syminfo.type == "dr" or syminfo.type == "etf" or syminfo.type == "futures"
        int currentDayOfWeek = dayofweek(timenow)
        // 1=Sunday, 2=Monday, ..., 7=Saturday
        // Trading days: Monday(2) to Friday(6)
        isTrading := currentDayOfWeek >= 2 and currentDayOfWeek <= 6
    else if syminfo.type == "crypto"
        isTrading := true  // 24/7
    else if syminfo.type == "forex"
        int currentDayOfWeek = dayofweek(timenow)
        // Forex: Sunday evening to Friday evening
        isTrading := currentDayOfWeek >= 1 and currentDayOfWeek <= 6
    else
        isTrading := true

    isTrading

isReplayMode() =>
    bool isReplay = false

    if barstate.islast
        int timeDiffMinutes = int((timenow - time_close) / 60000)

        int currentDayOfWeek = dayofweek(timenow)
        int barDayOfWeek = dayofweek(time_close)

        bool isWeekendNow = currentDayOfWeek == 7 or currentDayOfWeek == 1  // Saturday or Sunday
        bool barWasFriday = barDayOfWeek == 6  // Last bar was Friday

        if isWeekendNow and barWasFriday
            isReplay := false  // LIVE on weekend - don't show dashboard

        else if currentDayOfWeek == 2 and barDayOfWeek == 6
            isReplay := false  // LIVE on Monday pre-market

        else
            isReplay := timeDiffMinutes > 1440

    isReplay

isWithinSessionHours() =>
    bool withinHours = false

    // If using native session, use TradingView's inSession variable
    if useNativeSession
        withinHours := inSession
    else
        bool useReplayTime = isReplayMode()
        int timeToCheck = useReplayTime ? time : timenow

        int currentDayOfWeek = dayofweek(timeToCheck)
        bool isTradingDay = syminfo.type == "stock" ? (currentDayOfWeek >= 2 and currentDayOfWeek <= 6) : true

        if not isTradingDay and syminfo.type == "stock"
            withinHours := false
        else if not na(sessionStartHour) and not na(sessionEndHour)
            // Get time components from appropriate source
            int currentHour = hour(timeToCheck)
            int currentMinute = minute(timeToCheck)

            int currentMinutesFromMidnight = currentHour * 60 + currentMinute
            int sessionStartMinutes = sessionStartHour * 60 + sessionStartMinute
            int sessionEndMinutes = sessionEndHour * 60 + sessionEndMinute

            withinHours := currentMinutesFromMidnight >= sessionStartMinutes and currentMinutesFromMidnight <= sessionEndMinutes

    withinHours

// ====================================== ORB HELPER FUNCTIONS =======================================
getPreviousEnabledORB(ORBData currentOrb) =>
    ORBData prevOrb = na
    for orb in allORBs
        if orb.isEnabled and orb.minutes < currentOrb.minutes
            if na(prevOrb) or orb.minutes > prevOrb.minutes
                prevOrb := orb
    prevOrb

getNextEnabledORB(ORBData currentOrb) =>
    ORBData nextOrb = na
    for orb in allORBs
        if orb.isEnabled and orb.minutes > currentOrb.minutes
            if na(nextOrb) or orb.minutes < nextOrb.minutes
                nextOrb := orb
    nextOrb

// ====================================== ORB PLOT HELPER ===========================================
// Returns [high, low, mid] for an ORB stage's plot visibility window
getORBPlotValues(ORBData orbObj, float minsOpen, float minsOpenToEnd, float tfMinutes, bool isFirstORB) =>
    float h = na, float l = na, float m = na
    if orbObj.isEnabled and orbObj.minutes >= tfMinutes
        ORBData prevOrb = isFirstORB ? na : getPreviousEnabledORB(orbObj)
        ORBData nextOrb = isFirstORB ? array.get(cachedNextORBs, 0) : getNextEnabledORB(orbObj)
        bool prevOrbVisible = na(prevOrb) ? false : prevOrb.minutes >= tfMinutes
        float startMin = isFirstORB ? -1.0 : (na(prevOrb) or not prevOrbVisible ? 0.0 : prevOrb.minutes - 1)
        float endMin = isFirstORB ? (na(nextOrb) ? 9999.0 : orbObj.minutes - 1) : (na(nextOrb) ? 9999.0 : orbObj.minutes)
        bool inWindow = isFirstORB ? (minsOpen > startMin and minsOpen <= endMin) : (minsOpen < endMin and minsOpenToEnd > startMin)
        bool hasData = not na(orbObj.high) and not na(orbObj.low)
        if inWindow and hasData
            h := orbObj.high
            l := orbObj.low
            m := orbObj.mid
    [h, l, m]

// ====================================== UNIFIED FILTER STATUS =====================================
// Single section: ✅/❌ per filter, one-line reason. Replaces separate Smart Filters/Volume/Trend/HTF/Index/ORB Status
// mode: 0=live (before cutoff), 1=no-trade diagnostic (after cutoff), 2=trade taken
// curVolRatio/curTrendLbl/curHTFLbl/curIdxLbl = live values for "→" arrow when changed since attempt
renderFilterStatus(table dashTable, int startRow, string txtSize, color txtColor, bool gapEnabled, bool gapOK, float gapPct, float maxGapPct, bool widthEnabled, bool widthOK, float widthPct, float minW, float maxW, bool crossedUp, bool crossedDown, bool volEnabled, bool volOK, float volRatio, float volMult, float strongVolMult, bool trendEnabled, bool trendAligned, string trendLbl, bool htfEnabled, bool htfAligned, string htfLbl, bool idxEnabled, bool idxAligned, string idxLbl, float curVolRatio, string curTrendLbl, string curHTFLbl, string curIdxLbl, bool showCutoff, int cutHour, int cutMin, int mode) =>
    int row = startRow
    string hdr = mode == 1 ? "── No Trade" : mode == 2 ? "── Entry Filters" : "── Filters"
    color hdrColor = mode == 1 ? color.new(color.orange, 0) : mode == 2 ? color.new(color.teal, 0) : color.new(color.orange, 0)
    table.cell(dashTable, 0, row, hdr, text_color=hdrColor, text_size=txtSize, text_halign=text.align_left)
    table.cell(dashTable, 1, row, "──────", text_color=hdrColor, text_size=txtSize, text_halign=text.align_right)
    row += 1
    // Gap (session-level, no arrow needed)
    if gapEnabled
        string ic = gapOK ? "✅" : "❌"
        string val = not na(gapPct) ? str.tostring(gapPct, "#.#") + "%" : "N/A"
        table.cell(dashTable, 0, row, "Gap:", text_color=txtColor, text_size=txtSize, text_halign=text.align_left)
        table.cell(dashTable, 1, row, ic + " " + val, text_color=gapOK ? txtColor : color.red, text_size=txtSize, text_halign=text.align_right)
        row += 1
    // Width (session-level, no arrow needed)
    if widthEnabled and not na(widthPct)
        string ic = widthOK ? "✅" : "❌"
        table.cell(dashTable, 0, row, "Width:", text_color=txtColor, text_size=txtSize, text_halign=text.align_left)
        table.cell(dashTable, 1, row, ic + " " + str.tostring(widthPct, "#.##") + "%", text_color=widthOK ? txtColor : color.red, text_size=txtSize, text_halign=text.align_right)
        row += 1
    // Price Cross
    bool crossed = crossedUp or crossedDown
    string crossIc = crossed ? "✅" : "❌"
    string crossDir = crossedUp and crossedDown ? "Both" : crossedUp ? "Up" : crossedDown ? "Down" : "None"
    table.cell(dashTable, 0, row, "Cross:", text_color=txtColor, text_size=txtSize, text_halign=text.align_left)
    table.cell(dashTable, 1, row, crossIc + " " + crossDir, text_color=crossed ? txtColor : color.red, text_size=txtSize, text_halign=text.align_right)
    row += 1
    // Volume with quality tag + arrow when quality changed
    if crossed and volEnabled
        string ic = volOK ? "✅" : "❌"
        string vt = not na(volRatio) ? str.tostring(volRatio, "#.#") + "x" : "N/A"
        string attQ = not na(volRatio) ? (volRatio >= strongVolMult ? "Strong" : volRatio >= volMult ? "Good" : "Weak") : ""
        string curQ = not na(curVolRatio) ? (curVolRatio >= strongVolMult ? "Strong" : curVolRatio >= volMult ? "Good" : "Weak") : ""
        string arrow = mode > 0 and attQ != curQ and curQ != "" ? " → " + str.tostring(curVolRatio, "#.#") + "x " + curQ : ""
        string ex = not volOK and arrow == "" ? " (need " + str.tostring(volMult, "#.#") + "x)" : ""
        table.cell(dashTable, 0, row, "Volume:", text_color=txtColor, text_size=txtSize, text_halign=text.align_left)
        table.cell(dashTable, 1, row, ic + " " + vt + " " + attQ + ex + arrow, text_color=volOK ? txtColor : color.red, text_size=txtSize, text_halign=text.align_right)
        row += 1
    // Trend — ✅/❌ + arrow when label changed since attempt
    if trendEnabled
        if mode > 0
            string ic = trendAligned ? "✅" : "❌"
            string arrow = trendLbl != curTrendLbl ? " → " + curTrendLbl : ""
            table.cell(dashTable, 0, row, "Trend:", text_color=txtColor, text_size=txtSize, text_halign=text.align_left)
            table.cell(dashTable, 1, row, ic + " " + trendLbl + arrow, text_color=trendAligned ? txtColor : color.red, text_size=txtSize, text_halign=text.align_right)
        else
            table.cell(dashTable, 0, row, "Trend:", text_color=txtColor, text_size=txtSize, text_halign=text.align_left)
            table.cell(dashTable, 1, row, trendLbl, text_color=txtColor, text_size=txtSize, text_halign=text.align_right)
        row += 1
    // HTF Bias — ✅/❌ + arrow when label changed
    if htfEnabled
        if mode > 0
            string ic = htfAligned ? "✅" : "❌"
            string arrow = htfLbl != curHTFLbl ? " → " + curHTFLbl : ""
            table.cell(dashTable, 0, row, "HTF:", text_color=txtColor, text_size=txtSize, text_halign=text.align_left)
            table.cell(dashTable, 1, row, ic + " " + htfLbl + arrow, text_color=htfAligned ? txtColor : color.red, text_size=txtSize, text_halign=text.align_right)
        else
            table.cell(dashTable, 0, row, "HTF:", text_color=txtColor, text_size=txtSize, text_halign=text.align_left)
            table.cell(dashTable, 1, row, htfLbl, text_color=txtColor, text_size=txtSize, text_halign=text.align_right)
        row += 1
    // Index Direction — ✅/❌ + arrow when label changed
    if idxEnabled
        if mode > 0
            string ic = idxAligned ? "✅" : "❌"
            string arrow = idxLbl != curIdxLbl ? " → " + curIdxLbl : ""
            table.cell(dashTable, 0, row, "Index:", text_color=txtColor, text_size=txtSize, text_halign=text.align_left)
            table.cell(dashTable, 1, row, ic + " " + idxLbl + arrow, text_color=idxAligned ? txtColor : color.red, text_size=txtSize, text_halign=text.align_right)
        else
            table.cell(dashTable, 0, row, "Index:", text_color=txtColor, text_size=txtSize, text_halign=text.align_left)
            table.cell(dashTable, 1, row, idxLbl, text_color=txtColor, text_size=txtSize, text_halign=text.align_right)
        row += 1
    // Cutoff (only for no-trade diagnostic)
    if showCutoff and mode == 1
        table.cell(dashTable, 0, row, "Cutoff:", text_color=txtColor, text_size=txtSize, text_halign=text.align_left)
        table.cell(dashTable, 1, row, "❌ After " + str.tostring(cutHour) + ":" + (cutMin < 10 ? "0" : "") + str.tostring(cutMin), text_color=color.red, text_size=txtSize, text_halign=text.align_right)
        row += 1
    // One-line reason (only in no-trade diagnostic mode)
    if mode == 1
        string reason = ""
        if gapEnabled and not gapOK
            reason := "❌ Gap " + str.tostring(gapPct, "#.#") + "% exceeds " + str.tostring(maxGapPct, "#.#") + "%"
        else if widthEnabled and not na(widthPct) and not widthOK
            reason := "❌ Width outside " + str.tostring(minW, "#.#") + "-" + str.tostring(maxW, "#.#") + "% range"
        else if not crossed
            reason := "❌ Price stayed within ORB range"
        else if volEnabled and not volOK
            reason := "❌ Volume " + str.tostring(volRatio, "#.#") + "x < " + str.tostring(volMult, "#.#") + "x threshold"
        else if (trendEnabled and not trendAligned) or (htfEnabled and not htfAligned) or (idxEnabled and not idxAligned)
            reason := "❌ 2+ directional filters opposed"
        else if showCutoff
            reason := "❌ Breakout after " + str.tostring(cutHour) + ":" + (cutMin < 10 ? "0" : "") + str.tostring(cutMin) + " cutoff"
        else
            reason := "❌ No valid breakout signal"
        table.cell(dashTable, 0, row, reason, text_color=color.new(color.red, 20), text_size=txtSize, text_halign=text.align_left)
        table.cell(dashTable, 1, row, "", text_size=txtSize)
        table.merge_cells(dashTable, 0, row, 1, row)
        row += 1
    row

// Chop-day warning row. The 0-100 quality SCORE that used to live here was removed: it
// was referenced only in label text and table cells -- never in any breakout or entry
// condition -- so ~90% of GOD MODE's token cost bought no change in trade selection. The
// chop guard, the adaptive buffer and the both-pending-due fix are the pieces that do
// something, and they are near-free. Removed to fund the volume-factor engine.
renderGodRow(table dashTable, int startRow, string txtSize, color txtColor, bool chop, int fails) =>
    int row = startRow
    if chop
        table.cell(dashTable, 0, row, "Chop Day:", text_color=txtColor, text_size=txtSize, text_halign=text.align_left, tooltip="2+ breakouts already failed this session - range-day whipsaw.\n\nORB's most common failure mode. Treat further breaks in either direction with suspicion.")
        table.cell(dashTable, 1, row, "⚠ " + str.tostring(fails) + " failed breaks", text_color=color.orange, text_size=txtSize, text_halign=text.align_right)
        row += 1
    row

// ====================================== KEY-LEVEL DASHBOARD ROWS ==================================
// Same shape as renderFilterStatus above: takes the table and the current row, writes its
// rows, returns the next free row. Wrapped in a function (rather than inlined in the
// dashboard block) to keep the script's global scope under Pine's main-body size limit.
// Values are passed in rather than read from globals so this can sit here, ahead of the
// key-level engine that computes them.
renderKeyLevels(table dashTable, int startRow, string txtSize, color txtColor, float vf, bool autoProfile, float vah, float poc, float val, string auction, string openPos, float ibPct, float ibAdrPct, string ibType, float pdh, float pdl, float ibh, float ibl, float adr, float dayHigh, float dayLow, float headroom, float atrVal, float slMult, int dir, string setupCode, int score, int threshold, int confCnt, string confNames, bool executing, bool htfOK, bool isLive, int lastT, bool full, string openT, string dayT, string bias) =>
    int row = startRow
    color okC = color.lime
    color noC = color.new(color.gray, 20)

    table.cell(dashTable, 0, row, "── Key Levels", text_color=color.new(color.aqua, 0), text_size=txtSize, text_halign=text.align_left)
    table.cell(dashTable, 1, row, autoProfile ? "AUTO" : "MANUAL", text_color=color.new(color.aqua, 0), text_size=txtSize, text_halign=text.align_right)
    row += 1

    // Session volume factor. Bands are the BreakingTrade cheat sheet's, including its rule
    // that >=3x is a WARNING (block deal / news) rather than a green light.
    string vfTxt = na(vf) ? "-" : str.tostring(vf, "0.00") + "x " + (vf >= 3.0 ? "⚠ extreme" : vf >= 1.5 ? "strong" : vf >= 1.2 ? "elevated" : vf >= 0.8 ? "normal" : vf >= 0.5 ? "thin" : "dead")
    color vfCol = na(vf) ? noC : vf >= 3.0 ? color.orange : vf >= 1.5 ? okC : vf >= 1.2 ? color.new(color.lime, 40) : vf >= 0.8 ? txtColor : color.new(color.gray, 20)
    table.cell(dashTable, 0, row, "Vol Factor:", text_color=txtColor, text_size=txtSize, text_halign=text.align_left, tooltip="Session volume so far divided by the mean volume to the SAME point of day over the previous N sessions.\n\nTime-of-day normalised, so it means the same thing at 09:20 as at 14:00 -- unlike a rolling bar average, which is inflated at the open and depressed at lunch.\n\n>=3.0  extreme -- CHECK NEWS before trading; block deals and news spikes live here\n1.5-3.0 strong\n1.2-1.5 elevated\n0.8-1.2 normal\n0.5-0.8 thin\n<0.5   dead -- stand aside\n\nThe live session reads low early and fills in as the day runs; judge by pace, not face value. Blank until enough sessions of history are loaded.")
    table.cell(dashTable, 1, row, vfTxt, text_color=vfCol, text_size=txtSize, text_halign=text.align_right)
    row += 1

    if full
        table.cell(dashTable, 0, row, "VAH/POC/VAL:", text_color=txtColor, text_size=txtSize, text_halign=text.align_left, tooltip="Previous session's value area.\n\nVAH = upper edge of the 70% volume zone\nPOC = most-traded price (acts as a magnet)\nVAL = lower edge\n\nPrice above VAH or below VAL means today is auctioning outside yesterday's accepted value — the precondition for a trend day.")
        table.cell(dashTable, 1, row, na(vah) ? "-" : str.tostring(vah, "#.##") + " / " + str.tostring(poc, "#.##") + " / " + str.tostring(val, "#.##"), text_color=na(vah) ? noC : txtColor, text_size=txtSize, text_halign=text.align_right)
        row += 1

    table.cell(dashTable, 0, row, "Auction:", text_color=txtColor, text_size=txtSize, text_halign=text.align_left, tooltip="Where price trades NOW vs the previous value area, then where today OPENED.\n\nAbove VAH / Inside Value / Below VAL.\n\nOpening outside prior value is the classic trend-day tell — the market gapped out of value and is unlikely to return.")
    table.cell(dashTable, 1, row, auction + "  (open " + openPos + ")", text_color=auction == "n/a" ? noC : color.aqua, text_size=txtSize, text_halign=text.align_right)
    row += 1

    table.cell(dashTable, 0, row, "Open type:", text_color=txtColor, text_size=txtSize, text_halign=text.align_left, tooltip="How the session opened, in the cheat sheet's four categories. LATCHED after the first 30 minutes — an open type that kept revising itself would be worthless.\n\nOpen Drive — one-way from the first tick. Highest conviction; expect a TREND day, enter on the first pullback in the direction of the drive.\nOpen Test Drive — tested one side, rejected, drove the other way. Expect NORMAL VARIATION; trade the reversal.\nOpen Rejection Reverse — ran one way then reversed back through the open. Expect a NORMAL day; trade the gap fill toward yesterday's POC.\nOpen Auction — rotation with no net progress. No edge yet; wait for the IB to complete, then trade the break or fade it.")
    table.cell(dashTable, 1, row, openT, text_color=openT == "-" ? noC : openT == "Open Drive" ? color.lime : txtColor, text_size=txtSize, text_halign=text.align_right)
    row += 1

    table.cell(dashTable, 0, row, "Day type:", text_color=txtColor, text_size=txtSize, text_halign=text.align_left, tooltip="The session's character, in the cheat sheet's six categories. Derived from how far price has extended beyond the Initial Balance on each side, plus the IB's own width.\n\nPROVISIONAL — it updates all day. A day only truly types at the close, so read it as the current best guess, not a verdict.\n\nTrend — narrow IB, one-way extension. NEVER fade it.\nDouble Distribution — a second range forms away from the first. Trade the new one.\nNormal Variation — average IB, one-side extension. Trade the break, take profit early.\nNormal — wide IB, both sides tested. Fade the IB extremes.\nNeutral — extension on BOTH sides. Fade the extremes.\nNon-Trend — very narrow IB, no follow-through. Do not trade.")
    table.cell(dashTable, 1, row, dayT, text_color=dayT == "-" ? noC : dayT == "Trend" ? color.lime : dayT == "Non-Trend" ? color.red : txtColor, text_size=txtSize, text_halign=text.align_right)
    row += 1

    table.cell(dashTable, 0, row, "Bias:", text_color=txtColor, text_size=txtSize, text_halign=text.align_left, tooltip="Which way to lean today, if either — the one line the two rows above exist to produce.\n\nThis is DIRECTIONAL CONTEXT, not a trade signal. It says which side the odds favour; the Setup row says whether an actual entry exists. A LONG bias with no setup is not a trade.\n\nSTAND ASIDE — Non-Trend day, no follow-through to be had\nTWO-WAY — Normal or Neutral day; the extremes hold, so fade them rather than chase breaks\nLONG / SHORT — the day is extending one way; hold winners in that direction and do not fade it")
    table.cell(dashTable, 1, row, bias, text_color=str.startswith(bias, "LONG") ? color.lime : str.startswith(bias, "SHORT") ? color.red : str.startswith(bias, "STAND") ? color.orange : txtColor, text_size=txtSize, text_halign=text.align_right)
    row += 1


    if full
        table.cell(dashTable, 0, row, "PDH/PDL:", text_color=txtColor, text_size=txtSize, text_halign=text.align_left, tooltip="Previous Day High / Low — the most widely watched intraday levels.\n\nA clean break with volume tends to run; a failed break reverses hard.")
        table.cell(dashTable, 1, row, na(pdh) ? "-" : str.tostring(pdh, "#.##") + " / " + str.tostring(pdl, "#.##"), text_color=na(pdh) ? noC : txtColor, text_size=txtSize, text_halign=text.align_right)
        row += 1

    table.cell(dashTable, 0, row, "IB H/L:", text_color=txtColor, text_size=txtSize, text_halign=text.align_left, tooltip="Initial Balance high/low (09:15-10:15) and its width as a % of average daily range.\n\nBreaking IB after 10:15 on expanding volume is the classic trend-day continuation; rotating inside it all day is a range day.\n\n<35% narrow — coiled, trend-day potential\n35-60% normal\n>60% wide — range day, IB likely holds")
    table.cell(dashTable, 1, row, na(ibh) ? "-" : str.tostring(ibh, "#.##") + "/" + str.tostring(ibl, "#.##") + (na(ibPct) ? "" : "  " + str.tostring(ibPct, "#") + "%IB" + (na(ibAdrPct) ? "" : "/" + str.tostring(ibAdrPct, "#") + "%ADR") + " " + ibType), text_color=na(ibh) ? noC : #FFEB3B, text_size=txtSize, text_halign=text.align_right)
    row += 1

    // ADR consumed — the single most useful "is there room left?" read on the panel.
    // A breakout signal that arrives after the stock has already travelled its whole
    // average daily range is a materially worse trade than the same signal at 40%.
    float dayRange = na(dayHigh) or na(dayLow) ? na : dayHigh - dayLow
    float adrUsed  = na(dayRange) or na(adr) or adr <= 0 ? na : dayRange / adr * 100.0
    string adrTxt  = na(adr) ? "-" : (na(adrUsed) ? "-" : str.tostring(adrUsed, "#") + "% used") + (na(headroom) ? "" : "  |  " + str.tostring(headroom, "0.0") + "R room")
    color adrCol   = na(adrUsed) ? noC : adrUsed >= 100 ? color.red : adrUsed >= 80 ? color.orange : adrUsed >= 50 ? txtColor : okC
    table.cell(dashTable, 0, row, "ADR / used:", text_color=txtColor, text_size=txtSize, text_halign=text.align_left, tooltip="Average Daily Range (14 sessions, high-low) and how much of it today has already travelled.\n\n<50%   room left — breakouts have somewhere to go\n50-80% normal\n80-100% stretched — expect chop, take partials earlier\n>100%  today is already an outlier move; late entries are poor risk\n\nUses high-low, not ATR, so overnight gaps do not inflate the reading.")
    table.cell(dashTable, 1, row, adrTxt, text_color=adrCol, text_size=txtSize, text_halign=text.align_right)
    row += 1

    // ATR-based stop guidance. Shown as a DISTANCE, because that is what the trader has
    // to convert into a level; the multiplier comes from the TARGETS & RISK group so this
    // row always agrees with what the strategy would actually place.
    float slDist = na(atrVal) ? na : atrVal * slMult
    string atrTxt = na(atrVal) ? "-" : str.tostring(atrVal, "#.##") + " | SL " + str.tostring(slMult, "#.#") + "x = " + str.tostring(slDist, "#.##")
    if full
        table.cell(dashTable, 0, row, "ATR / SL:", text_color=txtColor, text_size=txtSize, text_halign=text.align_left, tooltip="ATR(14) on this timeframe, and the stop DISTANCE it implies at the ATR multiplier configured in TARGETS & RISK.\n\nUse it as a sanity check: if the level-based stop for a setup is much tighter than this, the stop is inside the noise and will be taken out; much wider, and the position size has to come down.\n\nSL distance / entry gives the % risk per share.")
        table.cell(dashTable, 1, row, atrTxt, text_color=na(atrVal) ? noC : txtColor, text_size=txtSize, text_halign=text.align_right)
        row += 1

    table.cell(dashTable, 0, row, "Setup:", text_color=txtColor, text_size=txtSize, text_halign=text.align_left, tooltip="Key-level setup, direction, and weighted score against the alert threshold.\n\nBright = firing on THIS bar. Dimmed with a time = the last one that fired, kept so the row still tells you something between signals. ⏳HTF = scored, waiting on the higher-timeframe close.\n\n\"-\" means nothing has fired yet today. Retests outrank rejections, which outrank plain breaks. Confluence and retest structure carry the most score weight, then RVOL.")
    string stTxt = dir == 0 ? "-" : (dir == 1 ? "LONG " : "SHORT ") + setupCode + "  " + str.tostring(score) + "/" + str.tostring(threshold) + (confCnt > 0 ? " +" + str.tostring(confCnt) + "lvl" : "") + (isLive ? (score >= threshold ? (htfOK ? " ✅" : " ⏳HTF") : "") : (na(lastT) ? "" : "  " + str.format_time(lastT, "HH:mm", syminfo.timezone)))
    // Live setups keep the direction colour; a latched one is dimmed, so "firing now" and
    // "last fired at 11:05" can never be confused at a glance.
    color stCol = dir == 0 ? noC : not isLive ? color.new(color.gray, 10) : score >= threshold ? (htfOK ? (dir == 1 ? okC : color.red) : color.orange) : color.orange
    table.cell(dashTable, 1, row, stTxt, text_color=stCol, text_size=txtSize, text_halign=text.align_right)
    row += 1

    if full
        table.cell(dashTable, 0, row, "Confluence:", text_color=txtColor, text_size=txtSize, text_halign=text.align_left, tooltip="Which other structural levels sit within the confluence band of the triggering level.\n\nTwo or more stacked levels is the strongest quality signal in this model. The count is also appended to the Setup row as \"+2lvl\".")
        table.cell(dashTable, 1, row, confCnt == 0 ? "-" : (str.tostring(confCnt) + " " + confNames), text_color=confCnt >= 2 ? okC : noC, text_size=txtSize, text_halign=text.align_right)
        row += 1

    table.cell(dashTable, 0, row, "KL Mode:", text_color=txtColor, text_size=txtSize, text_halign=text.align_left, tooltip="Whether key-level setups can open trades.\n\nOBSERVE = alerts and arrows only, strategy.entry is never called for them (default)\nEXECUTE = they enter through the same pipeline as an ORB breakout")
    table.cell(dashTable, 1, row, executing ? "⚠ EXECUTE" : "OBSERVE", text_color=executing ? color.orange : noC, text_size=txtSize, text_halign=text.align_right)
    row += 1
    row

// ====================================== VERDICT ROW ===============================================
// The single line this panel exists for. Every filter, gate and setup collapses into one
// answer plus the reason behind it, because during a live session there is no time to read
// twelve rows and synthesise them -- and with trades placed automatically off the alerts,
// the trader's real question is "what is the system doing and why", not "what should I do".
// Priority order matters: the FIRST blocking condition is the one reported, so the detail
// line always names the thing that actually has to change.
renderVerdict(table dashTable, int startRow, string txtSize, bool inTrade, bool taken, bool beforeCut, bool afterMin, bool gapOK, bool widthOK, bool volOK, float volRatio, float volMult, bool nrOK, bool chop, int dir, int score, int thr, bool htfOK, float vf, bool roomOK, float headroom, bool pmWin, int pmH, int pmM) =>
    int row = startRow
    string verdict = ""
    string detail = ""
    color vcol = color.new(color.gray, 0)
    if inTrade
        verdict := "✅ IN TRADE"
        detail := "position open — managing exits"
        vcol := color.aqua
    else if taken
        verdict := "🏁 SLOT USED"
        detail := pmWin ? "afternoon entry already taken" : "morning entry taken — afternoon window reopens at " + str.tostring(pmH) + ":" + (pmM < 10 ? "0" : "") + str.tostring(pmM)
    else if not beforeCut
        verdict := "🏁 CUTOFF"
        detail := "past entry cutoff — no new trades"
    else if not afterMin
        verdict := "⏰ TOO EARLY"
        detail := "before minimum entry time"
    else if not gapOK
        verdict := "⛔ NO TRADE"
        detail := "gap too large — prior-day levels unreliable"
        vcol := color.red
    else if not widthOK
        verdict := "⛔ NO TRADE"
        detail := "ORB width outside range"
        vcol := color.red
    else if not volOK
        verdict := "⛔ NO TRADE"
        detail := "volume " + str.tostring(volRatio, "0.0") + "x < " + str.tostring(volMult, "0.0") + "x needed"
        vcol := color.red
    else if not nrOK
        verdict := "⛔ NO TRADE"
        detail := "NR gate — yesterday was not a narrow range"
        vcol := color.red
    else if dir != 0 and score >= thr and not roomOK
        verdict := "⛔ NO ROOM"
        detail := "setup valid but only " + str.tostring(headroom, "0.0") + "R to a normal day's extension"
        vcol := color.red
    else if dir != 0 and score >= thr and htfOK
        verdict := dir == 1 ? "🟢 SIGNAL — LONG" : "🔴 SIGNAL — SHORT"
        detail := "score " + str.tostring(score) + "/" + str.tostring(thr) + " — alert fires this bar"
        vcol := dir == 1 ? color.lime : color.red
    else if dir != 0 and score >= thr
        verdict := "⏳ WAITING"
        detail := "scored " + str.tostring(score) + "/" + str.tostring(thr) + " — needs the HTF close to confirm"
        vcol := color.orange
    else
        verdict := "🟡 ARMED"
        detail := chop ? "filters pass — but CHOP DAY, be selective" : (not na(vf) and vf < 0.8 ? "filters pass — session volume thin (" + str.tostring(vf, "0.00") + "x)" : "filters pass — waiting for a setup")
        vcol := chop ? color.orange : color.yellow
    table.cell(dashTable, 0, row, verdict, text_color=vcol, text_size=txtSize, text_halign=text.align_center, bgcolor=color.new(vcol, 85), tooltip="What the system will do RIGHT NOW, and why.\n\n⛔ NO TRADE — a filter is blocking; the line below names which one\n⏰ TOO EARLY / 🏁 CUTOFF / 🏁 DONE — outside the trading window, or the session slot is spent\n🟡 ARMED — every filter passes, waiting for a setup to appear\n⏳ WAITING — a setup has scored, but the higher-timeframe close has not confirmed it yet\n🟢/🔴 SIGNAL — the alert fires on this bar\n✅ IN TRADE — a position is open\n\nOnly the FIRST blocking condition is shown, so the reason line is always the thing that actually has to change.")
    table.cell(dashTable, 1, row, "", bgcolor=color.new(vcol, 85))
    table.merge_cells(dashTable, 0, row, 1, row)
    row += 1
    table.cell(dashTable, 0, row, detail, text_color=color.new(color.silver, 0), text_size=txtSize, text_halign=text.align_center)
    table.cell(dashTable, 1, row, "")
    table.merge_cells(dashTable, 0, row, 1, row)
    row += 1
    row

// ====================================== CLEANUP FUNCTIONS ==========================================
cleanupLine(lineObject) =>
    if not na(lineObject)
        array.push(tpslLines, lineObject)
        if array.size(tpslLines) > MAX_LINES_TO_KEEP
            oldLine = array.shift(tpslLines)
            if not na(oldLine)
                line.delete(oldLine)

cleanupLabel(labelObject) =>
    if not na(labelObject)
        array.push(breakoutLabels, labelObject)
        if array.size(breakoutLabels) > MAX_LABELS_TO_KEEP
            oldLabel = array.shift(breakoutLabels)
            if not na(oldLabel)
                label.delete(oldLabel)

// Clean up old boxes to prevent memory issues
cleanupBox(boxObject) =>
    if not na(boxObject)
        array.push(orbBoxes, boxObject)
        if array.size(orbBoxes) > MAX_BOXES_TO_KEEP
            oldBox = array.shift(orbBoxes)
            if not na(oldBox)
                box.delete(oldBox)

// ===================================== TRADE LINE MANAGEMENT FUNCTIONS =============================
// Delete all trade lines and labels (Entry, SL, TP1, TP1.5, TP2, TP3)
deleteAllTradeLines() =>
    if not na(orbEntryLine)
        line.delete(orbEntryLine)
    if not na(orbEntryLabel)
        label.delete(orbEntryLabel)
    if not na(orbSLLine)
        line.delete(orbSLLine)
    if not na(orbSLLabel)
        label.delete(orbSLLabel)
    if not na(orbTP1Line)
        line.delete(orbTP1Line)
    if not na(orbTP1Label)
        label.delete(orbTP1Label)
    if not na(orbTP1_5Line)
        line.delete(orbTP1_5Line)
    if not na(orbTP1_5Label)
        label.delete(orbTP1_5Label)
    if not na(orbTP2Line)
        line.delete(orbTP2Line)
    if not na(orbTP2Label)
        label.delete(orbTP2Label)
    if not na(orbTP3Line)
        line.delete(orbTP3Line)
    if not na(orbTP3Label)
        label.delete(orbTP3Label)
    true

// Delete ORB visual elements (box, lines, label)
deleteOrbVisuals(ORBData orbObj) =>
    if not na(orbObj.orbBox)
        box.delete(orbObj.orbBox)
    if not na(orbObj.highLine)
        line.delete(orbObj.highLine)
    if not na(orbObj.lowLine)
        line.delete(orbObj.lowLine)
    if not na(orbObj.midLine)
        line.delete(orbObj.midLine)
    if not na(orbObj.edgeLabel)
        label.delete(orbObj.edgeLabel)
    true

// Reset ORB object state for new session
resetOrbState(ORBData orbObj, bool is5Min) =>
    if is5Min
        orbObj.high := high
        orbObj.low := low
        orbObj.mid := hl2
        orbObj.orbRange := 0
    else
        orbObj.high := na
        orbObj.low := na
        orbObj.mid := na
        orbObj.orbRange := 0
    orbObj.isBuilding := true
    orbObj.isComplete := false
    orbObj.completionBar := 0
    orbObj.breakoutUp := false
    orbObj.breakoutDown := false
    orbObj.breakoutBar := 0
    orbObj.breakoutLevel := na
    orbObj.cyclesUp := 0
    orbObj.cyclesDown := 0
    orbObj.orbBox := na
    orbObj.highLine := na
    orbObj.lowLine := na
    orbObj.midLine := na
    orbObj.edgeLabel := na
    true

// Create a TP/SL line with label and return both
// isLong: true for long trades, false for short (affects % calculation)
// tpName: "TP1", "TP1.5", "TP2", "TP3", or "SL"
// lineColor: color for the line and label
createTradeLine(int startBar, float price, float entryPrice, bool isLong, string tpName, color lineColor) =>
    newLine = line.new(startBar, price, bar_index, price, xloc=xloc.bar_index, extend=extend.none, color=lineColor, width=1, style=line.style_solid)
    cleanupLine(newLine)
    float pct = isLong ? ((price - entryPrice) / entryPrice) * 100 : ((entryPrice - price) / entryPrice) * 100
    string pctSign = pct >= 0 ? "+" : ""
    string labelText = labelFormat == "Simple" ? tpName : str.format("{0}: {1} {2}{3}%", tpName, str.tostring(price, "#.##"), pctSign, str.tostring(pct, "#.#"))
    newLabel = label.new(startBar, price, labelText, xloc=xloc.bar_index, style=label.style_label_left, textcolor=color.white, color=lineColor, size=getLabelSize(labelSize))
    [newLine, newLabel]

// ================================ SESSION STATUS DETECTION FUNCTIONS ===============================
isWithinDisplayHours() =>
    bool withinDisplay = false

    bool useReplayTime = isReplayMode()
    int timeToCheck = useReplayTime ? time : timenow

    if syminfo.type == "stock" or syminfo.type == "fund" or syminfo.type == "index" or syminfo.type == "dr" or syminfo.type == "etf" or syminfo.type == "futures"
        int currentDayOfWeek = dayofweek(timeToCheck)
        bool isTradingDay = currentDayOfWeek >= 2 and currentDayOfWeek <= 6

        if not isTradingDay
            withinDisplay := false
        else
            int currentHour = hour(timeToCheck)
            int currentMinute = minute(timeToCheck)
            int currentMinutesFromMidnight = currentHour * 60 + currentMinute

            int displayStartMinutes = 4 * 60  // 240 minutes = 04:00
            int displayEndMinutes = 20 * 60   // 1200 minutes = 20:00

            withinDisplay := currentMinutesFromMidnight >= displayStartMinutes and currentMinutesFromMidnight < displayEndMinutes
    else if syminfo.type == "crypto"
        withinDisplay := true  // 24/7 display
    else if syminfo.type == "forex"
        withinDisplay := true  // Display when forex session active
    else
        withinDisplay := true  // Default: always display

    withinDisplay

isInRegularHours() =>
    bool inRegular = false

    bool useReplayTime = isReplayMode()
    int timeToCheck = useReplayTime ? time : timenow

    if syminfo.type == "stock" or syminfo.type == "fund" or syminfo.type == "index" or syminfo.type == "dr" or syminfo.type == "etf" or syminfo.type == "futures"
        int currentDayOfWeek = dayofweek(timeToCheck)
        bool isTradingDay = currentDayOfWeek >= 2 and currentDayOfWeek <= 6

        if not isTradingDay
            inRegular := false
        else
            int currentHour = hour(timeToCheck)
            int currentMinute = minute(timeToCheck)
            int currentMinutesFromMidnight = currentHour * 60 + currentMinute

            int regularStartMinutes = 9 * 60 + 30  // Default: 09:30
            int regularEndMinutes = 16 * 60        // Default: 16:00

            // Only use custom session hours when NOT in native session mode
            if not useNativeSession and not na(sessionStartHour) and not na(sessionEndHour)
                regularStartMinutes := sessionStartHour * 60 + sessionStartMinute
                regularEndMinutes := sessionEndHour * 60 + sessionEndMinute

            inRegular := currentMinutesFromMidnight >= regularStartMinutes and currentMinutesFromMidnight <= regularEndMinutes
    else if syminfo.type == "crypto"
        inRegular := true  // Crypto is always "regular" (24/7)
    else
        inRegular := true

    inRegular

// ========================================= NEW DAY/SESSION RESET ===================================
isNewSession = false
isNewDay = false

// Special reset logic for E-mini Electronic Full Day mode
// ORB resets daily at 9:30 AM ET, even though trading is 24/7
if useElectronicFullDay
    // Get current and previous bar times in sessionTimezone (America/New_York for E-minis)
    int currentHour = hour(time, sessionTimezone)
    int currentMinute = minute(time, sessionTimezone)
    int prevHour = hour(time[1], sessionTimezone)
    int prevMinute = minute(time[1], sessionTimezone)

    // Calculate minutes from midnight for easier comparison
    int currentMinutesFromMidnight = currentHour * 60 + currentMinute
    int prevMinutesFromMidnight = prevHour * 60 + prevMinute
    int resetTimeMinutes = 9 * 60 + 30  // 9:30 AM = 570 minutes

    // Check if we crossed the 9:30 AM threshold
    // Current bar is at or after 9:30, previous bar was before 9:30
    bool nowAfter930 = currentMinutesFromMidnight >= resetTimeMinutes
    bool prevBefore930 = prevMinutesFromMidnight < resetTimeMinutes

    isNewSession := nowAfter930 and prevBefore930
    isNewDay := false  // Don't use day change logic for Electronic Full Day
else if is24_7Market
    currentDay = dayofmonth(time)
    prevDay = dayofmonth(time[1])
    isNewDay := currentDay != prevDay
    isNewSession := false
else
    isNewSession := inSession and not inSession[1]
    isNewDay := ta.change(dayofweek) != 0

shouldReset = isNewSession or isNewDay

if shouldReset

    hadSessionToday := false

    orbNavigationCached := false
    godFailedBreaks := 0
    if shouldReset
        hadSessionToday := false
        orbNavigationCached := false
        wentFarEnoughUp := false
        wentFarEnoughDown := false

    for i = 0 to array.size(allORBs) - 1
        orbObj = array.get(allORBs, i)
        deleteOrbVisuals(orbObj)
        resetOrbState(orbObj, orbObj.minutes == 5)

    activeORB := na
    actH := na
    actL := na
    actM := na

    tradeOrbHigh := na
    tradeOrbLow := na

    tradeOrbHigh := na
    tradeOrbLow := na
    haveRange := false
    haveDisplayRange := false
    stage := 0
    displayH := na
    displayL := na
    breakUpBarIndex := 0
    breakDownBarIndex := 0

    cyclesUp := 0
    cyclesDown := 0
    retestCyclesUp := 0
    retestCyclesDown := 0
    barsOutsideAfterBreakUp := 0
    barsOutsideAfterBreakDown := 0
    wentFarEnoughUp := false
    wentFarEnoughDown := false

    sessionBreakoutsUp := 0
    sessionBreakoutsDown := 0
    sessionRetestsUp := 0
    sessionRetestsDown := 0

    // daily counters reset removed

    session_wins := 0
    session_losses := 0
    session_total_rr := 0.0
    session_trades := 0
    session_best_r := 0.0
    session_worst_r := 0.0
    trade_closed := false
    last_trade_result := ""

    current_trade_r := 0.0
    tp1_counted := false
    tp1_5_counted := false
    tp2_counted := false
    tp3_counted := false

    prevOrbEntryBar := na

    sessionStartBar := na
    sessionStartTime := na

    cachedLineColor := na
    cachedStageName := na

    lastLabelH := na
    lastLabelL := na
    lastLabelStage := na

    if not na(labH)
        label.delete(labH)
        labH := na
    if not na(labL)
        label.delete(labL)
        labL := na

    hadBreakUp := false
    hadBreakDown := false
    breakUpBar := na
    breakDownBar := na
    shownBreakUpLabel := false
    shownBreakDownLabel := false
    everHadBreakUp := false
    everHadBreakDown := false
    breakoutEntryPrice := na
    priceCrossedUp := false
    priceCrossedDown := false
    volumeBlockedUp := false
    volumeBlockedDown := false
    trendBlockedUp := false
    trendBlockedDown := false
    attemptVolRatio := na
    attemptVolOK := false
    attemptTrendOK := false
    attemptFiltersAgainst := 0
    attemptDirection := ""
    hadRetestUp := false
    hadRetestDown := false
    retestUpBar := na
    retestDownBar := na
    lastLabelStage := na

    pendingLongEntry := false
    pendingShortEntry := false
    pendingLongBar := na
    pendingShortBar := na
    sessionEntryTaken := false  // Reset for new session
    amEntryTaken := false
    pmEntryTaken := false

    deleteAllTradeLines()
    orbEntryLine := na
    orbEntryLabel := na
    orbSLLine := na
    orbSLLabel := na
    orbTP1Line := na
    orbTP1Label := na
    orbTP1_5Line := na
    orbTP1_5Label := na
    orbTP2Line := na
    orbTP2Label := na
    orbTP3Line := na
    orbTP3Label := na

    orbEntryPrice := na
    orbEntryBar := na
    orbLineColor := na
    orbSLPrice := na
    orbTP1Price := na
    orbTP1_5Price := na
    orbTP2Price := na
    orbTP3Price := na
    orbLinesFrozen := false
    orbTP1Hit := false
    orbTP1_5Hit := false
    orbTP2Hit := false
    orbTP3Hit := false
    orbSLHit := false
    orbTradeDirection := 0

    current_trade_r := 0.0
    tp1_counted := false
    tp1_5_counted := false
    tp2_counted := false
    tp3_counted := false

    maxShares := na
    positionValue := na
    maxLoss := na

    lastDashUpdateBar := bar_index - 100

// ========================================= TIME CALCULATION ========================================
var float sessionFirstBarTime = na

if inSession and na(sessionStartTime)
    sessionStartBar := bar_index
    sessionStartTime := time
    sessionFirstBarTime := time
    hadSessionToday := true// Track session start time and bar when new session is detected
if isNewSession
    sessionStartBar := bar_index
    sessionStartTime := time
    sessionFirstBarTime := time  // Reset first bar time for new session
    hadSessionToday := true  // Mark that session started today

    // Smart Entry: Calculate gap at session start
    todayOpen := open
    if not na(prevDayClose) and prevDayClose > 0
        gapPercent := math.abs((todayOpen - prevDayClose) / prevDayClose * 100)
        gapFilterPassed := not enableGapFilter or gapPercent <= maxGapPercent
    else
        gapPercent := 0
        gapFilterPassed := true

    // Reset retest entry tracking
    awaitingRetestLong := false
    awaitingRetestShort := false
    retestWaitBarLong := na
    retestWaitBarShort := na
    retestTargetLevelLong := na
    retestTargetLevelShort := na
    consolidationCountLong := 0
    consolidationCountShort := 0

// Track previous day close at end of session
if not inSession and inSession[1]
    prevDayClose := close[1]

float minsFromOpen = -1.0

if not na(sessionFirstBarTime) and inSession
    minsFromOpen := (time - sessionFirstBarTime) / 60000
    if minsFromOpen > 480
        minsFromOpen := 480
    if minsFromOpen < 0
        minsFromOpen := 0

// ===================================== GLOBAL CACHE (PERFORMANCE) ==================================
if barstate.isconfirmed or barstate.islast
    bool needATR = everHadBreakUp or everHadBreakDown or showDashboard or not na(activeORB)
    if needATR and bar_index != cachedATRBar
        cachedATR := ta.atr(atrLength)
        cachedATRBar := bar_index

    // Time-of-day volume baseline + session volume factor. klVolFactor is STATEFUL, so it
    // is called on every pass rather than behind the bar_index guard the old ta.sma used --
    // its accumulator advances only on confirmed bars, which is the guard that matters.
    [vfNow, vbNow] = klVolFactor(true, shouldReset, inSession, barstate.isconfirmed, volBaseDays, volSlotCount)
    cachedVolBaseline := vbNow
    cachedSessionVF := vfNow
    cachedVolBaselineBar := bar_index

    // Key-level scoring needs VWAP regardless of the trend-filter configuration
    if enableKeyLevels and bar_index != sessionVWAPBar
        sessionVWAP := ta.vwap(close)
        sessionVWAPBar := bar_index

    // ADX calculation for Adaptive R:R
    if enableAdaptiveRR and bar_index != cachedADXBar
        // Calculate ADX components
        float trueRange = math.max(high - low, math.max(math.abs(high - close[1]), math.abs(low - close[1])))
        float plusDM = high - high[1] > low[1] - low ? math.max(high - high[1], 0) : 0
        float minusDM = low[1] - low > high - high[1] ? math.max(low[1] - low, 0) : 0

        float smoothedTR = ta.rma(trueRange, adxLength)
        float smoothedPlusDM = ta.rma(plusDM, adxLength)
        float smoothedMinusDM = ta.rma(minusDM, adxLength)

        float plusDI = smoothedTR > 0 ? 100 * smoothedPlusDM / smoothedTR : 0
        float minusDI = smoothedTR > 0 ? 100 * smoothedMinusDM / smoothedTR : 0
        float dx = (plusDI + minusDI) > 0 ? 100 * math.abs(plusDI - minusDI) / (plusDI + minusDI) : 0

        cachedADX := ta.rma(dx, adxLength)
        cachedADXBar := bar_index
        isTrendingMarket := cachedADX >= adxThreshold

// ================================ KEY-LEVEL ENGINE: LEVEL CONSTRUCTION =============================
// Non-ORB key levels: prev-session VAH/POC/VAL, PDH/PDL, Initial Balance. Sits after the
// global cache (cachedATR/volBaseline/sessionVWAP ready) and before ORB level building.
// Ported from volume-profile-decision-assist.pine; kl-prefixed to avoid collisions, and
// reuses this file's cachedATR/volBaseline/sessionVWAP/shouldReset rather than recomputing.

// ─── Previous Day High/Low ──────────────────────────────────────────────────
// lookahead_on + [1] is the canonical NON-repainting idiom: [1] guarantees a closed day,
// lookahead_on makes it available from the session's first bar. (The NR filter uses
// lookahead_off because it compares a series of daily ranges, where a day of lag is fine.)
// klADR = mean daily high-low over 14 sessions, NOT daily ATR: ATR is true range and
// folds overnight gaps in. ATR sizes the stop; ADR sizes the remaining opportunity.
[klPDH, klPDL, klATRDaily, klADR] = request.security(syminfo.tickerid, "D", [high[1], low[1], ta.atr(14)[1], ta.sma(high - low, 14)[1]], lookahead=barmerge.lookahead_on)

// ─── Volume-at-price histogram helpers ──────────────────────────────────────
// Spread each bar's volume evenly across the price rows it spans, as TV's Session Volume
// Profile does. Dumping it at one price drags POC onto spike bars (was ~26pts off on TCS).
klAddBar(map<int, float> m, float lo, float hi, float vol, float step) =>
    if not na(lo) and not na(hi) and not na(vol) and vol > 0 and step > 0
        int b0 = int(math.floor(lo / step))
        int b1 = int(math.floor(hi / step))
        int span = b1 - b0 + 1
        if span <= 1
            map.put(m, b0, (map.contains(m, b0) ? map.get(m, b0) : 0.0) + vol)
        else if span > 1000
            // Pathological range (halt/gap bar). Dump at midpoint rather than run a
            // multi-thousand-iteration loop that would blow the execution budget.
            int bm = int(math.floor(((lo + hi) / 2) / step))
            map.put(m, bm, (map.contains(m, bm) ? map.get(m, bm) : 0.0) + vol)
        else
            float per = vol / span
            for b = b0 to b1
                map.put(m, b, (map.contains(m, b) ? map.get(m, b) : 0.0) + per)

// Collapse one histogram into [VAH, POC, VAL].
//   POC = highest-volume row (always inside the value area by construction)
//   VAH/VAL = grow outward from POC, always taking the fatter neighbouring row,
//             until the accumulated volume reaches vaFrac of the session total.
klFinalize(map<int, float> m, float vaFrac, float step) =>
    int[] keys = map.keys(m)
    int n = array.size(keys)
    float rVAH = na
    float rPOC = na
    float rVAL = na
    if n > 0
        float total  = 0.0
        int   pocKey = 0
        float pocVol = -1.0
        int   minKey = na
        int   maxKey = na
        for i = 0 to n - 1
            int k = array.get(keys, i)
            float v = map.get(m, k)
            total += v
            if v > pocVol
                pocVol := v
                pocKey := k
            minKey := na(minKey) or k < minKey ? k : minKey
            maxKey := na(maxKey) or k > maxKey ? k : maxKey
        float target = total * vaFrac
        float acc = pocVol
        int up = pocKey
        int dn = pocKey
        int guard = 0
        int maxIter = (maxKey - minKey) + 2
        while acc < target and guard < maxIter
            bool canUp = up + 1 <= maxKey
            bool canDn = dn - 1 >= minKey
            if not canUp and not canDn
                break
            float volUp = canUp and map.contains(m, up + 1) ? map.get(m, up + 1) : 0.0
            float volDn = canDn and map.contains(m, dn - 1) ? map.get(m, dn - 1) : 0.0
            if canUp and (not canDn or volUp >= volDn)
                up += 1
                acc += volUp
            else
                dn -= 1
                acc += volDn
            guard += 1
        rPOC := (pocKey + 0.5) * step
        rVAH := (up + 0.5) * step
        rVAL := (dn + 0.5) * step
    [rVAH, rPOC, rVAL]

// ─── Profile accumulation (state lives inside the function) ─────────────────
// Stateful blocks are functions holding their own `var`s — Pine caps global-scope size and
// this file was already near it. CRITICAL: call these UNCONDITIONALLY. A `var` inside a
// function only advances when the call is reached, so enable flags are parameters checked
// inside, never used to skip the call. Returns the RESOLVED value area (auto or manual).
klProfile(bool en, bool auto, bool reset, bool inSess, float[] loArr, float[] hiArr, float[] volArr, float step, float vaPct, float mVAH, float mPOC, float mVAL) =>
    var map<int, float> m = map.new<int, float>()
    var float pVAH = na
    var float pPOC = na
    var float pVAL = na
    if en and auto
        // Session rollover: freeze the just-completed day's profile, then start fresh.
        if reset
            [fVAH, fPOC, fVAL] = klFinalize(m, vaPct / 100.0, step)
            if not na(fVAH)
                pVAH := fVAH
                pPOC := fPOC
                pVAL := fVAL
            map.clear(m)
        if inSess and array.size(volArr) > 0
            for i = 0 to array.size(volArr) - 1
                klAddBar(m, array.get(loArr, i), array.get(hiArr, i), array.get(volArr, i), step)
    float rVAH = not en ? na : auto ? pVAH : (mVAH > 0 ? mVAH : na)
    float rPOC = not en ? na : auto ? pPOC : (mPOC > 0 ? mPOC : na)
    float rVAL = not en ? na : auto ? pVAL : (mVAL > 0 ? mVAL : na)
    [rVAH, rPOC, rVAL]

// Initial Balance accumulator. Also reports the session's first bar index, which anchors
// the level drawings to today rather than to the whole chart history.
// Also tracks the running SESSION high/low (not just the IB window) — that is what the
// ADR-consumed reading needs, and keeping it here avoids another request.security call.
klInitialBalance(bool en, bool reset, bool inIB, bool inSess) =>
    var float h  = na
    var float l  = na
    var float o  = na
    var int   sb = na
    var float dh = na
    var float dl = na
    if en
        if reset
            h := na
            l := na
            o := open
            sb := bar_index
            dh := high
            dl := low
        if inIB
            h := na(h) ? high : math.max(h, high)
            l := na(l) ? low  : math.min(l, low)
        if inSess
            dh := na(dh) ? high : math.max(dh, high)
            dl := na(dl) ? low  : math.min(dl, low)
    [h, l, o, sb, dh, dl]

// Rolling average IB RANGE. Market Profile grades an IB narrow or wide against the AVERAGE
// IB, not against daily ATR -- different quantities, different answers. The old reading
// divided by klATRDaily, so "47%" meant "IB is 47% of a daily ATR", which has no threshold
// in the literature. STATEFUL: must be called unconditionally.
klIBAverage(bool en, bool reset, float ibRange, int days) =>
    var float[] hist = array.new_float()
    var float pending = na
    float avg = na
    if en
        // On rollover `pending` holds yesterday's FINAL IB range, so bank it before clearing.
        if reset
            if not na(pending)
                array.push(hist, pending)
                if array.size(hist) > days
                    array.shift(hist)
            pending := na
        if not na(ibRange)
            pending := ibRange
        if array.size(hist) > 0
            avg := array.avg(hist)
    avg

// Room left in the day's range, in units of THIS trade's risk. A breakout arriving with less
// than ~1R of headroom to a normal day's extension has nowhere to go, however good it looks.
// Built on ADR (high-low), so it measures RANGE remaining, not directional conviction -- a
// genuine trend day exceeds the projection, which is why the gate default stays permissive.
klHeadroomR(int d, float px, float dayH, float dayL, float adr, float riskPts) =>
    float r = na
    if d != 0 and not na(adr) and adr > 0 and not na(riskPts) and riskPts > 0 and not na(dayH) and not na(dayL)
        float proj = d == 1 ? dayL + adr : dayH - adr
        r := (d == 1 ? proj - px : px - proj) / riskPts
    r

// Opening type, per the cheat sheet's four categories. Classified over the first
// `bars` bars and then LATCHED -- an open type that kept revising itself all day would be
// worthless. Measured as excursion each way from the open vs the net move:
//   almost no counter-move            -> Open Drive        (expect a trend day)
//   tested one way, rejected, drove    -> Open Test Drive   (expect normal variation)
//   ran one way then reversed through  -> Open Rejection Reverse (expect gap fill toward POC)
//   rotation with no net progress      -> Open Auction      (wait for IB, then trade the break)
// STATEFUL: call unconditionally.
klOpenType(bool en, bool reset, bool inSess, float dayOpen, int bars) =>
    var string t = "-"
    var int n = 0
    var float hi = na
    var float lo = na
    var bool done = false
    if en
        if reset
            t := "-"
            n := 0
            hi := na
            lo := na
            done := false
        if inSess and not done and not na(dayOpen)
            hi := na(hi) ? high : math.max(hi, high)
            lo := na(lo) ? low : math.min(lo, low)
            n += 1
            if n >= bars
                float up = math.max(hi - dayOpen, 0.0)
                float dn = math.max(dayOpen - lo, 0.0)
                float tot = up + dn
                float net = close - dayOpen
                if tot > 0
                    float opp = net >= 0 ? dn : up
                    float oppFrac = opp / tot
                    float netFrac = math.abs(net) / tot
                    t := oppFrac < 0.20 ? "Open Drive" : oppFrac < 0.45 ? "Open Test Drive" : netFrac > 0.35 ? "Open Rejection Reverse" : "Open Auction"
                done := true
    t

// Day type, per the cheat sheet's six categories. Tracks how far price has extended beyond
// the Initial Balance on each side, as a % of the IB range, and names the day from that plus
// the IB's own width. PROVISIONAL and it updates all day -- a day only truly types at the
// close, so treat it as the current best read, not a verdict.
klDayType(bool en, bool reset, bool ibDone, float ibh, float ibl, float ibAdrPct) =>
    var float extUp = 0.0
    var float extDn = 0.0
    string t = "-"
    if en
        if reset
            extUp := 0.0
            extDn := 0.0
        if ibDone and not na(ibh) and not na(ibl) and ibh > ibl
            float ibR = ibh - ibl
            extUp := math.max(extUp, (high - ibh) / ibR * 100.0)
            extDn := math.max(extDn, (ibl - low) / ibR * 100.0)
            float mx = math.max(extUp, extDn)
            bool both = extUp > 15 and extDn > 15
            bool narrow = not na(ibAdrPct) and ibAdrPct < 35
            bool wide = not na(ibAdrPct) and ibAdrPct > 60
            t := both ? "Neutral" : mx > 100 ? (narrow ? "Trend" : "Double Distribution") : mx > 50 ? "Normal Variation" : mx < 10 ? (narrow ? "Non-Trend" : "Normal") : wide ? "Normal" : "Normal Variation"
    [t, extUp, extDn]

// The one line the other two exist to produce: which way to lean today, if either.
klBias(string dayT, string openT, float extUp, float extDn, string auction) =>
    string b = "-"
    if dayT == "Non-Trend"
        b := "STAND ASIDE — no follow-through"
    else if dayT == "Neutral" or dayT == "Normal"
        b := "TWO-WAY — fade the extremes"
    else if dayT == "Trend" or dayT == "Double Distribution" or dayT == "Normal Variation"
        b := extUp > extDn ? "LONG — hold, do not fade" : extDn > extUp ? "SHORT — hold, do not fade" : "TWO-WAY"
    else if openT == "Open Drive"
        b := auction == "Above VAH" ? "LONG — drive from the open" : auction == "Below VAL" ? "SHORT — drive from the open" : "Wait for IB"
    else
        b := "Wait for IB"
    b

// Stateless context read: where price and today's open sit relative to prior value, and
// how wide the Initial Balance came out relative to a normal day.
klContext(float vah, float val, float dayOpen, float ibH, float ibL, float ibAvg, float adr) =>
    // Auction state: price above VAH / below VAL is trading outside yesterday's accepted
    // value — the precondition for a trend day.
    string auction = na(vah) or na(val) ? "n/a" : close > vah ? "Above VAH" : close < val ? "Below VAL" : "Inside Value"
    // Opening position: a gap that opens outside prior value is the classic trend-day tell.
    string openPos = na(vah) or na(val) or na(dayOpen) ? "n/a" : dayOpen > vah ? "Above VAH" : dayOpen < val ? "Below VAL" : "In VA"
    // IB vs the AVERAGE IB, with the cheat sheet's own thresholds: <80% narrow (coiled,
    // trend-day candidate), >120% wide (balanced/rotational, IB extremes tend to hold).
    float ibRange = na(ibH) or na(ibL) ? na : ibH - ibL
    float ibPct   = na(ibRange) or na(ibAvg) or ibAvg <= 0 ? na : ibRange / ibAvg * 100.0
    string ibType = na(ibPct) ? "-" : ibPct < 80 ? "narrow/trend?" : ibPct > 120 ? "wide/range?" : "normal"
    // Second reading, different question: how much of a NORMAL DAY'S RANGE the first hour
    // already consumed. ADR (high-low) is the right denominator for that -- daily ATR is TRUE
    // range and folds the overnight gap in, inflating it and making the IB look falsely narrow
    // on exactly the gap days where the reading matters most.
    float ibAdrPct = na(ibRange) or na(adr) or adr <= 0 ? na : ibRange / adr * 100.0
    // The MODEL DOC's day-type call is IB / average daily range, <35 narrow / >60 wide, so that
    // is what NAMES the day. IB-vs-average-IB rides alongside as a second read: "is this IB
    // unusual for this stock" and "how much of a normal day's range did the first hour eat"
    // are different questions, and both are worth seeing.
    string ibTypeAdr = na(ibAdrPct) ? ibType : ibAdrPct < 35 ? "narrow/trend?" : ibAdrPct > 60 ? "wide/range?" : "normal"
    [auction, openPos, ibPct, ibTypeAdr, ibAdrPct]

// ─── Main-body wiring (kept deliberately thin) ──────────────────────────────
float klVPStep = syminfo.mintick * klTicksPerRow

// 1-min sub-bars of the current chart bar. Must sit at global scope: this keeps the
// profile resolution independent of the chart timeframe, so a 5-min and a 15-min chart
// produce the same VAH/POC/VAL.
float[] klLoLTF  = request.security_lower_tf(syminfo.tickerid, "1", low)
float[] klHiLTF  = request.security_lower_tf(syminfo.tickerid, "1", high)
float[] klVolLTF = request.security_lower_tf(syminfo.tickerid, "1", volume)

bool klInIB = enableKeyLevels and not na(time(timeframe.period, klIBSession, sessionTimezone))

[klVAH, klPOC, klVAL] = klProfile(enableKeyLevels, klAutoProfile, shouldReset, not na(time(timeframe.period, "0915-1530", sessionTimezone)), klLoLTF, klHiLTF, klVolLTF, klVPStep, klValueAreaPct, klManualVAH, klManualPOC, klManualVAL)
[klIBH, klIBL, klDayOpen, klDayStartBar, klDayHigh, klDayLow] = klInitialBalance(enableKeyLevels, shouldReset, klInIB, inSession)
string klOpenTypeS = klOpenType(enableKeyLevels, shouldReset, inSession, klDayOpen, 6)
float klIBAvg = klIBAverage(enableKeyLevels, shouldReset, na(klIBH) or na(klIBL) ? na : klIBH - klIBL, volBaseDays)
[klAuction, klOpenPos, klIBPct, klIBType, klIBAdrPct] = klContext(klVAH, klVAL, klDayOpen, klIBH, klIBL, klIBAvg, klADR)

// Cleared on session rollover so a stale trigger tag cannot leak into the next day.
[klDayTypeS, klExtUp, klExtDn] = klDayType(enableKeyLevels, shouldReset, enableKeyLevels and not na(klIBH) and not na(klIBL) and not klInIB, klIBH, klIBL, klIBAdrPct)
string klBiasS = klBias(klDayTypeS, klOpenTypeS, klExtUp, klExtDn, klAuction)

klPendingSource := shouldReset ? "" : klPendingSource
klArmedSL := shouldReset ? na : klArmedSL
klArmedT1 := shouldReset ? na : klArmedT1

// ======================================= ORB LEVEL BUILDING ========================================
currentTF_seconds = timeframe.in_seconds()
isHTF = currentTF_seconds >= 86400


// ============================== NEW ARCHITECTURE: INDEPENDENT ORB BUILDING =========================
if not isHTF and minsFromOpen >= 0 and (barstate.isconfirmed or barstate.islast) and inSession
    for i = 0 to array.size(allORBs) - 1
        orbObj = array.get(allORBs, i)

        if orbObj.isEnabled and orbObj.isBuilding
            if minsFromOpen > orbObj.minutes
                orbObj.isBuilding := false
                orbObj.isComplete := true
                orbObj.completionBar := bar_index

                if na(activeORB) or orbObj.minutes > activeORB.minutes
                    activeORB := orbObj
                    actH := orbObj.high
                    actL := orbObj.low
                    actM := orbObj.mid
                    haveRange := true
                    haveDisplayRange := true
                    stage := orbObj.minutes
                    displayH := orbObj.high
                    displayL := orbObj.low
                    cachedStageName := orbObj.name
                    cachedLineColor := orbObj.orbColor

                    // Smart Entry: Calculate ORB range % filter
                    if orbObj.orbRange > 0 and orbObj.mid > 0
                        orbRangePercent := (orbObj.orbRange / orbObj.mid) * 100
                        orbRangeFilterPassed := not enableORBRangeFilter or (orbRangePercent >= minORBRangePercent and orbRangePercent <= maxORBRangePercent)

            else

                if na(orbObj.high)
                    prevOrb = getPreviousEnabledORB(orbObj)
                    if not na(prevOrb) and prevOrb.isComplete
                        orbObj.high := prevOrb.high
                        orbObj.low := prevOrb.low
                        orbObj.mid := prevOrb.mid
                        orbObj.orbRange := prevOrb.orbRange

                if minsFromOpen < orbObj.minutes
                    orbObj.high := math.max(nz(orbObj.high, high), high)
                    orbObj.low := math.min(nz(orbObj.low, low), low)
                    orbObj.mid := (orbObj.high + orbObj.low) / 2
                    orbObj.orbRange := orbObj.high - orbObj.low

                    if minsFromOpen >= orbObj.minutes - 1 and not orbObj.isComplete
                        orbObj.isBuilding := false
                        orbObj.isComplete := true
                        orbObj.completionBar := bar_index

                        activeORB := orbObj

                        actH := orbObj.high
                        actL := orbObj.low
                        actM := orbObj.mid
                        haveRange := true
                        haveDisplayRange := true

                        stage := orbObj.minutes
                        displayH := orbObj.high
                        displayL := orbObj.low
                        cachedStageName := orbObj.name
                        cachedLineColor := orbObj.orbColor

                        // Smart Entry: Calculate ORB range % filter
                        if orbObj.orbRange > 0 and orbObj.mid > 0
                            orbRangePercent := (orbObj.orbRange / orbObj.mid) * 100
                            orbRangeFilterPassed := not enableORBRangeFilter or (orbRangePercent >= minORBRangePercent and orbRangePercent <= maxORBRangePercent)

// ================================== CACHE ORB NAVIGATION (PERFORMANCE) =============================
if not orbNavigationCached and not isHTF
    for i = 0 to array.size(allORBs) - 1
        orbObj = array.get(allORBs, i)

        ORBData prevOrb = na
        for j = 0 to array.size(allORBs) - 1
            checkOrb = array.get(allORBs, j)
            if checkOrb.isEnabled and checkOrb.minutes < orbObj.minutes
                if na(prevOrb) or checkOrb.minutes > prevOrb.minutes
                    prevOrb := checkOrb
        array.set(cachedPrevORBs, i, prevOrb)

        ORBData nextOrb = na
        for j = 0 to array.size(allORBs) - 1
            checkOrb = array.get(allORBs, j)
            if checkOrb.isEnabled and checkOrb.minutes > orbObj.minutes
                if na(nextOrb) or checkOrb.minutes < nextOrb.minutes
                    nextOrb := checkOrb
        array.set(cachedNextORBs, i, nextOrb)

    orbNavigationCached := true

// ======================================= TREND CALCULATION ========================================
if enableTrendFilter
    if str.contains(trendMode, "VWAP")
        trendVWAP := ta.vwap(close)

    if trendMode == "EMA" or trendMode == "VWAP+EMA"
        trendEMA12 := ta.ema(close, 12)

    if trendMode == "Custom EMA"
        trendEMACustom := ta.ema(close, customEmaLength)

    if str.contains(trendMode, "SuperTrend")
        if barstate.isnew or na(trendSTUp)
            [stLower, stUpper, stDir] = calcSuperTrend(supertrendPeriod, supertrendMult)
            trendSTUp := stLower
            trendSTDown := stUpper
            trendSTDirection := stDir

// ====================================== HTF BIAS CALCULATION (for blocking) ======================
// Calculate HTF bias before entry processing to enable counter-trend blocking
if enableHTF and blockCounterTrend and barstate.isconfirmed
    [htfBullishCalc, htfBearishCalc, htfBiasTextTemp, htfStrengthTemp] = checkHTFBias()
    cachedHTFBullish := htfBullishCalc
    cachedHTFBearish := htfBearishCalc
    cachedHTFBiasText := htfBiasTextTemp
    cachedHTFStrength := htfStrengthTemp

// ====================================== INDEX DIRECTION CALCULATION ================================
if enableIndexFilter and barstate.isconfirmed and bar_index != cachedIndexBar
    if indexFilterMethod == "Price vs VWAP"
        [idxClose, idxVWAP] = request.security(indexSymbol, timeframe.period, [close, ta.vwap(close)], barmerge.gaps_off, barmerge.lookahead_off)
        cachedIndexBullish := not na(idxClose) and not na(idxVWAP) and idxClose > idxVWAP
        cachedIndexBearish := not na(idxClose) and not na(idxVWAP) and idxClose < idxVWAP
        cachedIndexBiasText := cachedIndexBullish ? "Bullish" : cachedIndexBearish ? "Bearish" : "Neutral"
    else if indexFilterMethod == "Price vs EMA"
        [idxClose, idxEMA] = request.security(indexSymbol, timeframe.period, [close, ta.ema(close, indexEMALength)], barmerge.gaps_off, barmerge.lookahead_off)
        cachedIndexBullish := not na(idxClose) and not na(idxEMA) and idxClose > idxEMA
        cachedIndexBearish := not na(idxClose) and not na(idxEMA) and idxClose < idxEMA
        cachedIndexBiasText := cachedIndexBullish ? "Bullish" : cachedIndexBearish ? "Bearish" : "Neutral"
    else if indexFilterMethod == "ORB Direction"
        // Use session high/low as proxy for index ORB
        [idxClose, idxSessionHigh, idxSessionLow] = request.security(indexSymbol, timeframe.period, [close, ta.highest(high, 3), ta.lowest(low, 3)], barmerge.gaps_off, barmerge.lookahead_off)
        cachedIndexBullish := not na(idxClose) and not na(idxSessionHigh) and idxClose > idxSessionHigh[1]
        cachedIndexBearish := not na(idxClose) and not na(idxSessionLow) and idxClose < idxSessionLow[1]
        cachedIndexBiasText := cachedIndexBullish ? "Bullish" : cachedIndexBearish ? "Bearish" : "Neutral"
    cachedIndexBar := bar_index

// ====================================== NR FILTER CALCULATION ======================================
// Daily timeframe lookup for narrow-range detection. Computed once per intraday bar
// and cached. CRITICAL: lookahead=barmerge.lookahead_off prevents repainting — yesterday's
// range value would otherwise be visible "early" during today's session in backtest.
//
// `(high - low)[1]` is yesterday's range on the DAILY timeframe (security context).
// `ta.lowest((high - low)[1], nrLookback)` is the lowest of (yesterday + nrLookback-1 prior days).
// If yesterday's range == that lowest value, yesterday IS the narrowest of the last N days.
if enableNRFilter and barstate.isconfirmed and bar_index != cachedNRBar
    [nrYesterdayRange, nrMinRange] = request.security(syminfo.tickerid, "D", [(high - low)[1], ta.lowest((high - low)[1], nrLookback)], barmerge.gaps_off, barmerge.lookahead_off)
    cachedNRYesterdayRange := nrYesterdayRange
    cachedNRMinPrev := nrMinRange
    cachedNRPreferHit := not na(nrYesterdayRange) and not na(nrMinRange) and nrYesterdayRange <= nrMinRange
    cachedNRBar := bar_index

// In Require mode, an entry is gated unless yesterday was an NR day.
// In Prefer mode (default), the gate is always open — NR state is observed only.
// When enableNRFilter is false, the gate is always open (zero impact on backtest).
bool nrRequireGate = not enableNRFilter or nrMode != "Require" or cachedNRPreferHit

// ========================================== GOD MODE SCORING =======================================
bool godChopDay = godModeEnabled and godChopGuard and godFailedBreaks >= 2

// ====================================== BREAKOUT DETECTION =========================================
canDetectBreakout = not isHTF and enableBreakout and not na(activeORB) and barstate.isconfirmed
volBaseline := cachedVolBaseline
// Session volume factor: cumulative volume vs the same point of day over volBaseDays
// prior sessions. Distinct from the per-bar ratio -- this asks whether the STOCK is in
// play today, the bar ratio asks whether THIS break carries participation.
float klSessionVF = cachedSessionVF

// ============================= ENTRY CUTOFF TIME CHECK ==========================================
int currentHourNow = hour(time, sessionTimezone)
int currentMinuteNow = minute(time, sessionTimezone)
bool isBeforeMorningCutoff = (currentHourNow < entryCutoffHour) or (currentHourNow == entryCutoffHour and currentMinuteNow < entryCutoffMinute)
// Afternoon window, gated on session VOLUME as well as the clock: the PM wave is a volume
// phenomenon, and without the volume it is a thin tape with less runway than the morning.
int nowMins = currentHourNow * 60 + currentMinuteNow
bool inPMWindow = enableAfternoonWindow and nowMins >= pmStartHour * 60 + pmStartMinute and nowMins < pmEndHour * 60 + pmEndMinute and (pmMinSessionVF <= 0 or (not na(cachedSessionVF) and cachedSessionVF >= pmMinSessionVF))
bool isBeforeCutoff = isBeforeMorningCutoff or inPMWindow

// Smart Entry: Minimum entry time filter (e.g., 9:45 AM - let gap volatility settle)
bool isAfterMinTime = not enableMinEntryTime or (currentHourNow > minEntryHour) or (currentHourNow == minEntryHour and currentMinuteNow >= minEntryMinute)

// Smart Entry: Combined filter check
bool smartFiltersPass = gapFilterPassed and orbRangeFilterPassed and isAfterMinTime

// nrRequireGate is always true unless: enableNRFilter=true AND nrMode="Require" AND yesterday was not NR.
// In Prefer mode (default-on shape), this is a no-op — NR state is tracked only via cachedNRPreferHit.
// The slot belongs to the window price is currently in, so the day can produce at most one
// morning entry and one afternoon entry -- never two of either.
bool slotAvailable = inPMWindow ? not pmEntryTaken : not amEntryTaken
bool canTakeEntry = isBeforeCutoff and slotAvailable and smartFiltersPass and nrRequireGate

// Key-level entries deliberately DROP orbRangeFilterPassed. That filter asks whether the
// OPENING RANGE was a tradeable width -- a property of the ORB and of nothing else. Applying
// it to an IB extension or a value-area setup rejected them for a reason with no bearing on
// their validity. Gap, min-entry-time and the NR gate are genuinely universal and are kept.
bool canTakeKeyLevelEntry = isBeforeCutoff and slotAvailable and gapFilterPassed and isAfterMinTime and nrRequireGate

// Entry conditions - Trend/HTF filtering is now handled at breakout detection time
// using the "both against" logic (only blocks when BOTH filters are against the direction)
bool canTakeLongEntry = canTakeEntry
bool canTakeShortEntry = canTakeEntry

// ============================= PENDING ENTRY PROCESSING (NEXT BAR AFTER BREAKOUT) ================
// Upstream fix: when BOTH pending entries come due on the same bar, the long block used to
// run first and then be overwritten by the short block, leaving strategy state and the
// trade lines describing different trades. Short wins, matching upstream's resolution.
if pendingLongEntry and bar_index > pendingLongBar and canTakeLongEntry and not (pendingShortEntry and bar_index > pendingShortBar)
    if enableTargets
        // Get active ORB levels
        float activeHigh = not na(activeORB) ? activeORB.high : na
        float activeLow = not na(activeORB) ? activeORB.low : na

        if not na(activeHigh) and not na(activeLow)
            // Delete old lines first
            deleteAllTradeLines()
            orbEntryLine := na
            orbEntryLabel := na
            orbSLLine := na
            orbSLLabel := na
            orbTP1Line := na
            orbTP1Label := na
            orbTP1_5Line := na
            orbTP1_5Label := na
            orbTP2Line := na
            orbTP2Label := na
            orbTP3Line := na
            orbTP3Label := na

            float entry = open
            float atr = cachedATR
            // A key-level entry uses the stop and target measured from the level that actually
            // triggered it -- NOT the ORB geometry. Without this the executed trade would not
            // match the Ref SL / Ref T1 the observation alert reported.
            bool fromKL = klPendingSource != "" and not na(klArmedSL)
            float sl = fromKL ? klArmedSL : calculateStopLoss(entry, activeHigh, activeLow, activeHigh - activeLow, atr, stopMode, true)
            [tp1, tp1_5, tp2, tp3] = if fromKL
                klCalcTargets(entry, sl, true, klArmedT1)
            else
                calculateTargets(entry, sl, true, activeHigh, activeLow)

            [shares, posValue, maxLossCalc, riskAmount] = calculatePositionSize(entry, sl)

            orbEntryPrice := entry
            breakoutEntryPrice := entry  // Sync with global entry price
            orbEntryBar := bar_index
            orbLineColor := color.new(color.aqua, 0)
            orbSLPrice := sl
            orbTP1Price := tp1
            orbTP1_5Price := tp1_5
            orbTP2Price := tp2
            orbTP3Price := tp3
            orbLinesFrozen := false
            orbTP1Hit := false
            orbTP1_5Hit := false
            orbTP2Hit := false
            orbTP3Hit := false
            orbSLHit := false
            orbTradeDirection := 1

            maxShares := shares
            positionValue := posValue
            maxLoss := maxLossCalc

            // === STRATEGY ENTRY - LONG ===
            strategy.entry("Long", strategy.long)
            sessionEntryTaken := true  // Mark entry taken for this session
            if inPMWindow
                pmEntryTaken := true
            else
                amEntryTaken := true

            // Send Entry Alert - ALWAYS use TP1 for signal engine execution
            // TP1.5/TP2/TP3 are observation-only (alerts sent on hit, no execution change)
            float tpForAlert = tp1
            alert(buildEntryAlert(true, entry, sl, tpForAlert, tp1_5, tp2, tp3, maxLossCalc, math.abs(tpForAlert - entry) * shares, klPendingSource), alert.freq_once_per_bar)
            klPendingSource := ""  // consumed — next entry defaults back to plain ORB
            klArmedSL := na
            klArmedT1 := na

            // Set exits with TP and SL
            // EXECUTION: Always TP1 only (full position exit at 1R)
            // TP1.5/TP2/TP3 are display-only on chart for observation
            strategy.exit("TP1_L", "Long", limit=tp1, stop=sl)

            // Entry line - ALWAYS shown
            orbEntryLine := line.new(orbEntryBar, orbEntryPrice, bar_index, orbEntryPrice, xloc=xloc.bar_index, extend=extend.none, color=orbLineColor, width=1, style=line.style_solid)
            cleanupLine(orbEntryLine)
            string entryText = labelFormat == "Simple" ? "ENTRY" : str.format("ENTRY: {0}", str.tostring(orbEntryPrice, "#.##"))
            orbEntryLabel := label.new(orbEntryBar, orbEntryPrice, entryText, xloc=xloc.bar_index, style=label.style_label_left, textcolor=color.white, color=orbLineColor, size=getLabelSize(labelSize))

            // SL and TP lines - only if showTPSLLines is enabled
            if showTPSLLines
                [slLine, slLabel] = createTradeLine(orbEntryBar, orbSLPrice, entry, true, "SL", color.new(color.red, 0))
                orbSLLine := slLine
                orbSLLabel := slLabel

                if showTP1
                    [tp1Line, tp1Label] = createTradeLine(orbEntryBar, orbTP1Price, entry, true, "TP1", color.new(color.green, 0))
                    orbTP1Line := tp1Line
                    orbTP1Label := tp1Label

                if showTP1_5
                    [tp1_5Line, tp1_5Label] = createTradeLine(orbEntryBar, orbTP1_5Price, entry, true, "TP1.5", color.new(color.green, 0))
                    orbTP1_5Line := tp1_5Line
                    orbTP1_5Label := tp1_5Label

                if showTP2
                    [tp2Line, tp2Label] = createTradeLine(orbEntryBar, orbTP2Price, entry, true, "TP2", color.new(color.green, 0))
                    orbTP2Line := tp2Line
                    orbTP2Label := tp2Label

                if showTP3
                    [tp3Line, tp3Label] = createTradeLine(orbEntryBar, orbTP3Price, entry, true, "TP3", color.new(color.green, 0))
                    orbTP3Line := tp3Line
                    orbTP3Label := tp3Label

    // Trigger entry alert for long position
    alertEntryTriggered := true

    pendingLongEntry := false
    pendingLongBar := na

if pendingShortEntry and bar_index > pendingShortBar and canTakeShortEntry
    if enableTargets
        float activeHigh = not na(activeORB) ? activeORB.high : na
        float activeLow = not na(activeORB) ? activeORB.low : na

        if not na(activeHigh) and not na(activeLow)
            // Delete old lines first
            deleteAllTradeLines()
            orbEntryLine := na
            orbEntryLabel := na
            orbSLLine := na
            orbSLLabel := na
            orbTP1Line := na
            orbTP1Label := na
            orbTP1_5Line := na
            orbTP1_5Label := na
            orbTP2Line := na
            orbTP2Label := na
            orbTP3Line := na
            orbTP3Label := na

            float entry = open
            float atr = cachedATR
            // A key-level entry uses the stop and target measured from the level that actually
            // triggered it -- NOT the ORB geometry. Without this the executed trade would not
            // match the Ref SL / Ref T1 the observation alert reported.
            bool fromKL = klPendingSource != "" and not na(klArmedSL)
            float sl = fromKL ? klArmedSL : calculateStopLoss(entry, activeHigh, activeLow, activeHigh - activeLow, atr, stopMode, false)
            [tp1, tp1_5, tp2, tp3] = if fromKL
                klCalcTargets(entry, sl, false, klArmedT1)
            else
                calculateTargets(entry, sl, false, activeHigh, activeLow)

            [shares, posValue, maxLossCalc, riskAmount] = calculatePositionSize(entry, sl)

            orbEntryPrice := entry
            breakoutEntryPrice := entry  // Sync with global entry price
            orbEntryBar := bar_index
            orbLineColor := color.new(color.orange, 0)
            orbSLPrice := sl
            orbTP1Price := tp1
            orbTP1_5Price := tp1_5
            orbTP2Price := tp2
            orbTP3Price := tp3
            orbLinesFrozen := false
            orbTP1Hit := false
            orbTP1_5Hit := false
            orbTP2Hit := false
            orbTP3Hit := false
            orbSLHit := false
            orbTradeDirection := -1

            maxShares := shares
            positionValue := posValue
            maxLoss := maxLossCalc

            // === STRATEGY ENTRY - SHORT ===
            strategy.entry("Short", strategy.short)
            sessionEntryTaken := true  // Mark entry taken for this session
            if inPMWindow
                pmEntryTaken := true
            else
                amEntryTaken := true

            // Send Entry Alert - ALWAYS use TP1 for signal engine execution
            // TP1.5/TP2/TP3 are observation-only (alerts sent on hit, no execution change)
            float tpForAlert = tp1
            alert(buildEntryAlert(false, entry, sl, tpForAlert, tp1_5, tp2, tp3, maxLossCalc, math.abs(entry - tpForAlert) * shares, klPendingSource), alert.freq_once_per_bar)
            klPendingSource := ""  // consumed — next entry defaults back to plain ORB
            klArmedSL := na
            klArmedT1 := na

            // Set exits with TP and SL
            // EXECUTION: Always TP1 only (full position exit at 1R)
            // TP1.5/TP2/TP3 are display-only on chart for observation
            strategy.exit("TP1_S", "Short", limit=tp1, stop=sl)

            // Entry line - ALWAYS shown
            orbEntryLine := line.new(orbEntryBar, orbEntryPrice, bar_index, orbEntryPrice, xloc=xloc.bar_index, extend=extend.none, color=orbLineColor, width=1, style=line.style_solid)
            cleanupLine(orbEntryLine)
            string entryText = labelFormat == "Simple" ? "ENTRY" : str.format("ENTRY: {0}", str.tostring(orbEntryPrice, "#.##"))
            orbEntryLabel := label.new(orbEntryBar, orbEntryPrice, entryText, xloc=xloc.bar_index, style=label.style_label_left, textcolor=color.white, color=orbLineColor, size=getLabelSize(labelSize))

            // SL and TP lines - only if showTPSLLines is enabled
            if showTPSLLines
                [slLine, slLabel] = createTradeLine(orbEntryBar, orbSLPrice, entry, false, "SL", color.new(color.red, 0))
                orbSLLine := slLine
                orbSLLabel := slLabel

                if showTP1
                    [tp1Line, tp1Label] = createTradeLine(orbEntryBar, orbTP1Price, entry, false, "TP1", color.new(color.green, 0))
                    orbTP1Line := tp1Line
                    orbTP1Label := tp1Label

                if showTP1_5
                    [tp1_5Line, tp1_5Label] = createTradeLine(orbEntryBar, orbTP1_5Price, entry, false, "TP1.5", color.new(color.green, 0))
                    orbTP1_5Line := tp1_5Line
                    orbTP1_5Label := tp1_5Label

                if showTP2
                    [tp2Line, tp2Label] = createTradeLine(orbEntryBar, orbTP2Price, entry, false, "TP2", color.new(color.green, 0))
                    orbTP2Line := tp2Line
                    orbTP2Label := tp2Label

                if showTP3
                    [tp3Line, tp3Label] = createTradeLine(orbEntryBar, orbTP3Price, entry, false, "TP3", color.new(color.green, 0))
                    orbTP3Line := tp3Line
                    orbTP3Label := tp3Label

    // Trigger entry alert for short position
    alertEntryTriggered := true

    pendingShortEntry := false
    pendingShortBar := na

// Clear pending entries if cutoff passed, entry already taken, or HTF blocks direction
// klPendingSource is cleared alongside: a cancelled key-level pending must not leave its
// trigger tag behind for a later ORB breakout to inherit and mislabel.
if not canTakeLongEntry and pendingLongEntry
    pendingLongEntry := false
    pendingLongBar := na
    klPendingSource := ""
    klArmedSL := na
    klArmedT1 := na
if not canTakeShortEntry and pendingShortEntry
    pendingShortEntry := false
    pendingShortBar := na
    klPendingSource := ""
    klArmedSL := na
    klArmedT1 := na

// ======================= NEW ARCHITECTURE: BREAKOUT DETECTION WITH activeORB =======================
if not na(activeORB) and activeORB.isComplete and inSession and enableBreakout and barstate.isconfirmed

    activeHigh = activeORB.high
    activeLow = activeORB.low
    activeMid = activeORB.mid

    // Adaptive buffer: a FLOOR of 10% of ATR expressed as a % of price, never a reduction.
    // Lets Breakout Buffer % be set low without exposing volatile tickers to false breaks.
    float effBreakoutBuffer = godModeEnabled and godAdaptiveBuffer and nz(cachedATR) > 0 and close > 0 ? math.max(breakoutBuffer, cachedATR * 0.10 / close * 100) : breakoutBuffer
    activeBufferUp = getBuffer(activeHigh, effBreakoutBuffer)
    activeBufferDown = getBuffer(activeLow, effBreakoutBuffer)
    volumeOK = not enableVolumeFilter or hasVolumeConfirmation(volBaseline, volumeMultiplier, strongVolumeMultiplier)

    // BLOCKING LOGIC: Count how many directional filters are against the trade
    // Block entry when 2 or more filters oppose the direction
    // Filters: Trend (intraday), HTF (daily), Index (NIFTY)
    bool trendBullish = isTrendUp(trendMode, close, trendVWAP, trendEMA12, trendEMACustom, trendSTDirection)
    bool trendBearish = isTrendDown(trendMode, close, trendVWAP, trendEMA12, trendEMACustom, trendSTDirection)

    // Count filters against LONG
    int filtersAgainstLong = 0
    if enableTrendFilter and not trendBullish
        filtersAgainstLong += 1
    if enableHTF and blockCounterTrend and cachedHTFBearish
        filtersAgainstLong += 1
    if enableIndexFilter and cachedIndexBearish
        filtersAgainstLong += 1
    trendOK_Up = filtersAgainstLong < 2  // Block when 2+ filters oppose

    // Count filters against SHORT
    int filtersAgainstShort = 0
    if enableTrendFilter and not trendBearish
        filtersAgainstShort += 1
    if enableHTF and blockCounterTrend and cachedHTFBullish
        filtersAgainstShort += 1
    if enableIndexFilter and cachedIndexBullish
        filtersAgainstShort += 1
    trendOK_Down = filtersAgainstShort < 2  // Block when 2+ filters oppose

    crossedAbove = close > activeHigh + activeBufferUp and close[1] <= activeHigh + activeBufferUp
    // Diagnostic: track why breakout was rejected + store filter values at attempt time
    if crossedAbove and not activeORB.breakoutUp
        priceCrossedUp := true
        float volRatioNow = volBaseline > 0 ? volume / volBaseline : 0
        attemptVolRatio := volRatioNow
        attemptVolOK := volumeOK
        attemptTrendOK := trendOK_Up
        attemptFiltersAgainst := filtersAgainstLong
        attemptDirection := "UP"
        attemptTrendAligned := not enableTrendFilter or trendBullish
        attemptHTFAligned := not (enableHTF and blockCounterTrend) or not cachedHTFBearish
        attemptIdxAligned := not enableIndexFilter or not cachedIndexBearish
        attemptTrendLabel := trendBullish ? "Bullish" : trendBearish ? "Bearish" : "Neutral"
        attemptHTFLabel := cachedHTFBiasText
        attemptIdxLabel := cachedIndexBiasText
        if not volumeOK
            volumeBlockedUp := true
        if not trendOK_Up
            trendBlockedUp := true
    if crossedAbove and volumeOK and trendOK_Up and not activeORB.breakoutUp
        activeORB.breakoutUp := true
        activeORB.breakoutBar := bar_index
        activeORB.breakoutLevel := activeHigh
        activeORB.cyclesUp := activeORB.cyclesUp + 1

        sessionBreakoutsUp := sessionBreakoutsUp + 1


        everHadBreakUp := true
        hadBreakUp := true
        breakUpBar := bar_index
        breakUpBarIndex := bar_index

        tradeOrbHigh := activeORB.high
        tradeOrbLow := activeORB.low

        if showBreakLabels
            string breakText = ""
            if labelFormat == "Simple"
                breakText := "🔼 BREAKOUT UP #" + str.tostring(sessionBreakoutsUp)
            else  // Detailed
                float volRatio = volBaseline > 0 ? volume / volBaseline : 0
                string volText = volRatio >= strongVolumeMultiplier ? str.tostring(volRatio, "#.#") + "x ⚡" : volRatio >= volumeMultiplier ? str.tostring(volRatio, "#.#") + "x" : str.tostring(volRatio, "#.#") + "x ⚠️"
                breakText := "🔼 BREAKOUT UP\n" + activeORB.name + " #" + str.tostring(sessionBreakoutsUp) + "\nVol: " + volText

            float labelOffset = cachedATR * LABEL_OFFSET_ATR_MULTIPLIER
            float labelY = high + labelOffset

            breakLabel = label.new(bar_index, labelY, breakText, color = color.new(color.green, 0), textalign = text.align_center, style = label.style_label_down, textcolor = color.white, size = getLabelSize(labelSize))
            cleanupLabel(breakLabel)

    // ========== MARK PENDING LONG ENTRY (TP/SL created on NEXT bar) ==========
        float breakoutVolRatio = volBaseline > 0 ? volume / volBaseline : 0
        bool isStrongVolumeBreakout = breakoutVolRatio >= strongVolumeMultiplier

        if enableRetestEntry and not isStrongVolumeBreakout
            // Smart Entry: Wait for retest of ORB high before entering
            awaitingRetestLong := true
            retestWaitBarLong := bar_index
            retestTargetLevelLong := activeHigh
        else
            // Enter immediately: Strong volume breakout OR retest disabled
            pendingLongEntry := true
            pendingLongBar := bar_index

    // === BREAKOUT DOWN (NEW) ===
    crossedBelow = close < activeLow - activeBufferDown and close[1] >= activeLow - activeBufferDown
    // Diagnostic: track why breakout was rejected + store filter values at attempt time
    if crossedBelow and not activeORB.breakoutDown
        priceCrossedDown := true
        float volRatioNow = volBaseline > 0 ? volume / volBaseline : 0
        attemptVolRatio := volRatioNow
        attemptVolOK := volumeOK
        attemptTrendOK := trendOK_Down
        attemptFiltersAgainst := filtersAgainstShort
        attemptDirection := "DOWN"
        attemptTrendAligned := not enableTrendFilter or trendBearish
        attemptHTFAligned := not (enableHTF and blockCounterTrend) or not cachedHTFBullish
        attemptIdxAligned := not enableIndexFilter or not cachedIndexBullish
        attemptTrendLabel := trendBearish ? "Bearish" : trendBullish ? "Bullish" : "Neutral"
        attemptHTFLabel := cachedHTFBiasText
        attemptIdxLabel := cachedIndexBiasText
        if not volumeOK
            volumeBlockedDown := true
        if not trendOK_Down
            trendBlockedDown := true

    if crossedBelow and volumeOK and trendOK_Down and not activeORB.breakoutDown
        activeORB.breakoutDown := true
        activeORB.breakoutBar := bar_index
        activeORB.breakoutLevel := activeLow
        activeORB.cyclesDown := activeORB.cyclesDown + 1

        sessionBreakoutsDown := sessionBreakoutsDown + 1


        everHadBreakDown := true
        hadBreakDown := true
        breakDownBar := bar_index
        breakDownBarIndex := bar_index

        tradeOrbHigh := activeORB.high
        tradeOrbLow := activeORB.low

        if showBreakLabels
            string breakText = ""
            if labelFormat == "Simple"
                breakText := "🔽 BREAKOUT DOWN #" + str.tostring(sessionBreakoutsDown)
            else  // Detailed
                float volRatio = volBaseline > 0 ? volume / volBaseline : 0
                string volText = volRatio >= strongVolumeMultiplier ? str.tostring(volRatio, "#.#") + "x ⚡" : volRatio >= volumeMultiplier ? str.tostring(volRatio, "#.#") + "x" : str.tostring(volRatio, "#.#") + "x ⚠️"
                breakText := "🔽 BREAKOUT DOWN\n" + activeORB.name + " | #" + str.tostring(sessionBreakoutsDown) + "\nVol: " + volText

            float labelOffset = cachedATR * LABEL_OFFSET_ATR_MULTIPLIER
            float labelY = low - labelOffset

            breakLabel = label.new(bar_index, labelY, breakText, color = color.new(color.red, 0), style = label.style_label_up, textalign = text.align_center, textcolor = color.white, size = getLabelSize(labelSize))
            cleanupLabel(breakLabel)

        float breakoutVolRatioShort = volBaseline > 0 ? volume / volBaseline : 0
        bool isStrongVolumeBreakoutShort = breakoutVolRatioShort >= strongVolumeMultiplier

        if enableRetestEntry and not isStrongVolumeBreakoutShort
            // Smart Entry: Wait for retest of ORB low before entering
            awaitingRetestShort := true
            retestWaitBarShort := bar_index
            retestTargetLevelShort := activeLow
        else
            // Enter immediately: Strong volume breakout OR retest disabled
            pendingShortEntry := true
            pendingShortBar := bar_index


// ====================================== SMART ENTRY: RETEST ENTRY DETECTION =======================
// Check if price has pulled back to ORB level OR consolidated near it
if enableRetestEntry and barstate.isconfirmed and canTakeEntry

    // Long retest/consolidation entry check
    if awaitingRetestLong and not na(retestTargetLevelLong)
        int barsSinceBreakout = bar_index - retestWaitBarLong
        float retestBufferAmount = retestTargetLevelLong * (retestEntryBuffer / 100)
        float consolidationZone = retestTargetLevelLong * (consolidationZonePercent / 100)

        // Check if price pulled back to ORB high level (within buffer)
        bool priceAtRetestLevel = low <= retestTargetLevelLong + retestBufferAmount

        // Check if price is holding above ORB (not failed breakout)
        bool priceHolding = close > retestTargetLevelLong - retestBufferAmount

        // Check if price is consolidating near breakout level (strong hold pattern)
        bool inConsolidationZone = close > retestTargetLevelLong and close <= retestTargetLevelLong + consolidationZone

        if inConsolidationZone
            consolidationCountLong += 1
        else if close > retestTargetLevelLong + consolidationZone
            // Price moved too far up, reset consolidation count
            consolidationCountLong := 0

        // Entry trigger 1: Classic retest (price touches level and holds)
        bool retestTriggered = priceAtRetestLevel and priceHolding and barsSinceBreakout >= 1

        // Entry trigger 2: Consolidation (price holds near level for X bars)
        bool consolidationTriggered = consolidationCountLong >= consolidationBars and barsSinceBreakout >= 2

        if retestTriggered or consolidationTriggered
            // Entry confirmed - trigger
            pendingLongEntry := true
            pendingLongBar := bar_index
            awaitingRetestLong := false
            retestWaitBarLong := na
            consolidationCountLong := 0
        else if barsSinceBreakout >= retestEntryTimeout
            // Timeout - no valid entry pattern, skip this trade
            awaitingRetestLong := false
            retestWaitBarLong := na
            retestTargetLevelLong := na
            consolidationCountLong := 0

    // Short retest/consolidation entry check
    if awaitingRetestShort and not na(retestTargetLevelShort)
        int barsSinceBreakout = bar_index - retestWaitBarShort
        float retestBufferAmount = retestTargetLevelShort * (retestEntryBuffer / 100)
        float consolidationZone = retestTargetLevelShort * (consolidationZonePercent / 100)

        // Check if price pulled back to ORB low level (within buffer)
        bool priceAtRetestLevel = high >= retestTargetLevelShort - retestBufferAmount

        // Check if price is holding below ORB (not failed breakout)
        bool priceHolding = close < retestTargetLevelShort + retestBufferAmount

        // Check if price is consolidating near breakout level (strong hold pattern)
        bool inConsolidationZone = close < retestTargetLevelShort and close >= retestTargetLevelShort - consolidationZone

        if inConsolidationZone
            consolidationCountShort += 1
        else if close < retestTargetLevelShort - consolidationZone
            // Price moved too far down, reset consolidation count
            consolidationCountShort := 0

        // Entry trigger 1: Classic retest (price touches level and holds)
        bool retestTriggered = priceAtRetestLevel and priceHolding and barsSinceBreakout >= 1

        // Entry trigger 2: Consolidation (price holds near level for X bars)
        bool consolidationTriggered = consolidationCountShort >= consolidationBars and barsSinceBreakout >= 2

        if retestTriggered or consolidationTriggered
            // Entry confirmed - trigger
            pendingShortEntry := true
            pendingShortBar := bar_index
            awaitingRetestShort := false
            retestWaitBarShort := na
            consolidationCountShort := 0
        else if barsSinceBreakout >= retestEntryTimeout
            // Timeout - no valid entry pattern, skip this trade
            awaitingRetestShort := false
            retestWaitBarShort := na
            retestTargetLevelShort := na
            consolidationCountShort := 0

// ================================ KEY-LEVEL ENGINE: SETUP + SCORE =================================
// Runs AFTER ORB breakout detection so the confluence registry sees today's ORB levels and
// an ORB breakout that already claimed the session's single entry slot wins the race.
// Pending entries set here fill on the NEXT bar via the shared processor, as ORB does.
// Nearly everything is function-wrapped for the global-scope size cap; the exceptions are
// the ta.* calls, plotshape's booleans, and the pending-entry assignment (Pine functions
// cannot assign to file-level variables).

// ─── Candle / volume quality ────────────────────────────────────────────────
klCandle(float volMA, float clvLong, float clvShort) =>
    float rng = high - low
    float clv = rng > 0 ? (close - low) / rng : 0.5
    float rvol = not na(volMA) and volMA > 0 ? volume / volMA : 0.0
    // Delta PROXY only — Pine has no footprint/orderflow data. Close location within
    // the bar is a crude stand-in for whether buyers or sellers won the bar.
    string deltaProxy = clv > 0.55 ? "buy" : clv < 0.45 ? "sell" : "neutral"
    [clv, rvol, clv >= clvLong, clv <= clvShort, deltaProxy]

// ─── Unified level registry (ORB + VA + PD + IB) ────────────────────────────
// Built imperatively rather than with a loop: Pine counts DOWN when a for-loop's start
// exceeds its end, so an empty-array loop would silently run backwards.
klBuildRegistry(bool en, float poc, float vah, float val, float pdh, float pdl, float ibh, float ibl, ORBData orb) =>
    // Parallel arrays: levels + their names. Built once here so klConfluence and klFindT1
    // can both loop instead of repeating a per-level if-chain. Built imperatively because
    // Pine counts DOWN when a for-loop's start exceeds its end.
    var float[]  a = array.new_float()
    var string[] n = array.new_string()
    array.clear(a)
    array.clear(n)
    if en
        if not na(poc)
            array.push(a, poc)
            array.push(n, "POC")
        if not na(vah)
            array.push(a, vah)
            array.push(n, "VAH")
        if not na(val)
            array.push(a, val)
            array.push(n, "VAL")
        if not na(pdh)
            array.push(a, pdh)
            array.push(n, "PDH")
        if not na(pdl)
            array.push(a, pdl)
            array.push(n, "PDL")
        if not na(ibh)
            array.push(a, ibh)
            array.push(n, "IBH")
        if not na(ibl)
            array.push(a, ibl)
            array.push(n, "IBL")
        if not na(orb)
            if not na(orb.high)
                array.push(a, orb.high)
                array.push(n, "ORBH")
            if not na(orb.low)
                array.push(a, orb.low)
                array.push(n, "ORBL")
    [a, n]

// Confluence: how many OTHER structural levels sit within one ATR band of a price, and
// their names. Two levels stacking is the single strongest quality tell in the model.
klConfluence(float px, float band, float[] lv, string[] nm) =>
    // Counts OTHER structural levels near px. The `d > eps` test is load-bearing: without
    // it a VAH setup counted VAH as its own confluence, adding a phantom +1 to every VA,
    // PD and IB setup and sometimes tipping the >=2 multi-level bonus on a single level.
    float eps = syminfo.mintick * 0.5
    int cnt = 0
    string names = ""
    if not na(px) and band > 0 and array.size(lv) > 0
        for i = 0 to array.size(lv) - 1
            float d = math.abs(px - array.get(lv, i))
            if d <= band and d > eps
                cnt += 1
                names += array.get(nm, i) + " "
    [cnt, names]

// ─── Break-bar tracking (feeds the breakout+retest setups) ──────────────────
// State lives in the function's own vars, so this MUST be called unconditionally.
klTrackBreaks(bool en, bool confirmed, float vah, float val, float pdh, float pdl, float ibh, float ibl) =>
    var int vahBB = na
    var int valBB = na
    var int pdhBB = na
    var int pdlBB = na
    var int ibhBB = na
    var int iblBB = na
    if en and confirmed
        if not na(vah) and close > vah and close[1] <= vah
            vahBB := bar_index
        if not na(val) and close < val and close[1] >= val
            valBB := bar_index
        if not na(pdh) and close > pdh and close[1] <= pdh
            pdhBB := bar_index
        if not na(pdl) and close < pdl and close[1] >= pdl
            pdlBB := bar_index
        if not na(ibh) and close > ibh and close[1] <= ibh
            ibhBB := bar_index
        if not na(ibl) and close < ibl and close[1] >= ibl
            iblBB := bar_index
    [vahBB, valBB, pdhBB, pdlBB, ibhBB, iblBB]

// ─── Setup detection + priority resolution ──────────────────────────────────
// Detection and resolution live in one function because every detector feeds the same
// priority chain; splitting them would mean returning ~16 booleans just to consume them
// one line later.
//
// Priority: retest > rejection > break/acceptance, and within each tier VA > PD > IB.
// Retests rank highest because a level that was broken and then successfully defended
// has proven itself; a first touch has not.
klResolveSetup(bool en, bool vaOn, bool vaAcc, float accRvolMin, float rvolNow, bool pdOn, bool ibOn, float vah, float val, float pdh, float pdl, float ibh, float ibl, bool ibDone, bool bull, bool bear, float band, int maxBars, int vahBB, int valBB, int pdhBB, int pdlBB, int ibhBB, int iblBB) =>
    // Detection + priority in one function: every detector feeds the same chain, so
    // splitting them would mean returning ~16 booleans to consume them one line later.
    // Priority retest > rejection > break, and VA > PD > IB inside each tier. A level
    // broken then successfully defended has proven itself; a first touch has not.
    // Each branch sets only code/dir/level — isRetest and rejectionFamily are derived
    // from the code suffix afterwards rather than repeated 14 times.
    bool vaEn = en and vaOn
    bool pdEn = en and pdOn
    bool ibEn = en and ibOn and ibDone
    // Value-Area family (the 8-scenario model)
    bool vahRejShort = vaEn and not na(vah) and high > vah and close < vah and bear
    bool valRejLong  = vaEn and not na(val) and low  < val and close > val and bull
    // Acceptance carries its own volume bar: the thesis is price HOLDING beyond value with
    // participation, and two closes past a level on thin volume is drift, not acceptance.
    bool accVol      = accRvolMin <= 0 or (not na(rvolNow) and rvolNow >= accRvolMin)
    bool vahAccLong  = vaEn and vaAcc and accVol and not na(vah) and close > vah and close[1] > vah
    bool valAccShort = vaEn and vaAcc and accVol and not na(val) and close < val and close[1] < val
    bool vahRt = vaEn and not na(vah) and not na(vahBB) and (bar_index - vahBB <= maxBars) and low  <= vah + band and close > vah and bull
    bool valRt = vaEn and not na(val) and not na(valBB) and (bar_index - valBB <= maxBars) and high >= val - band and close < val and bear
    // Previous-Day family: break + retest only. A PDH/PDL "rejection" is just yesterday's
    // range holding, far weaker than a value-area rejection, so it is not traded.
    bool pdhRt  = pdEn and not na(pdh) and not na(pdhBB) and (bar_index - pdhBB <= maxBars) and low  <= pdh + band and close > pdh and bull
    bool pdlRt  = pdEn and not na(pdl) and not na(pdlBB) and (bar_index - pdlBB <= maxBars) and high >= pdl - band and close < pdl and bear
    bool pdhBrk = pdEn and not na(pdh) and close > pdh and close[1] <= pdh and bull
    bool pdlBrk = pdEn and not na(pdl) and close < pdl and close[1] >= pdl and bear
    // Initial-Balance family: IB extension, only meaningful once IB has closed.
    bool ibhRt  = ibEn and not na(ibhBB) and (bar_index - ibhBB <= maxBars) and low  <= ibh + band and close > ibh and bull
    bool iblRt  = ibEn and not na(iblBB) and (bar_index - iblBB <= maxBars) and high >= ibl - band and close < ibl and bear
    bool ibhBrk = ibEn and close > ibh and close[1] <= ibh and bull
    bool iblBrk = ibEn and close < ibl and close[1] >= ibl and bear

    string cd = ""
    int    d  = 0
    float  lv = na
    if vahRt
        cd := "VAH-RT"
        d := 1
        lv := vah
    else if valRt
        cd := "VAL-RT"
        d := -1
        lv := val
    else if pdhRt
        cd := "PDH-RT"
        d := 1
        lv := pdh
    else if pdlRt
        cd := "PDL-RT"
        d := -1
        lv := pdl
    else if ibhRt
        cd := "IBH-RT"
        d := 1
        lv := ibh
    else if iblRt
        cd := "IBL-RT"
        d := -1
        lv := ibl
    else if valRejLong
        cd := "VAL-REJ"
        d := 1
        lv := val
    else if vahRejShort
        cd := "VAH-REJ"
        d := -1
        lv := vah
    else if vahAccLong
        cd := "VAH-ACC"
        d := 1
        lv := vah
    else if valAccShort
        cd := "VAL-ACC"
        d := -1
        lv := val
    else if pdhBrk
        cd := "PDH-BRK"
        d := 1
        lv := pdh
    else if pdlBrk
        cd := "PDL-BRK"
        d := -1
        lv := pdl
    else if ibhBrk
        cd := "IBH-BRK"
        d := 1
        lv := ibh
    else if iblBrk
        cd := "IBL-BRK"
        d := -1
        lv := ibl
    bool rt  = str.endswith(cd, "-RT")
    bool rej = rt or str.endswith(cd, "-REJ")
    [cd, d, lv, rt, rej]

// ─── Weighted score ─────────────────────────────────────────────────────────
klComputeScore(int d, int confCnt, bool isRetest, float vwap, float ema9, float emaSlope, float rvol, bool bull, bool bear, float rvolMin, float rvolStrong, float sessVF) =>
    int s = 0
    if d != 0
        s += 2                                    // interacted with a major level
        s += confCnt > 3 ? 3 : confCnt            // per confluent level, capped
        if confCnt >= 2
            s += 2                                // multi-level confluence bonus
        if isRetest
            s += 2                                // break-and-hold structure
        if not na(vwap) and ((d == 1 and close > vwap) or (d == -1 and close < vwap))
            s += 1
        if not na(ema9) and ((d == 1 and close > ema9 and emaSlope > 0) or (d == -1 and close < ema9 and emaSlope < 0))
            s += 1
        if rvol >= rvolStrong
            s += 2
        else if rvol >= rvolMin
            s += 1
        // CLV is scored ONCE. The old build also awarded +1 for deltaProxy, which is
        // itself derived from clv (>0.55 = "buy"), so one strong close collected +2 of a
        // 7-point threshold for a single piece of information -- and the weakest one,
        // since Pine has no orderflow and CLV is only a proxy for it.
        if (d == 1 and bull) or (d == -1 and bear)
            s += 1
        // Session participation, scored separately from the bar ratio above: a break can
        // carry a big single bar on a stock nobody is trading today, and that is the case
        // the relative-volume research says to avoid. Not a double count -- different
        // question, different denominator.
        if not na(sessVF) and sessVF >= rvolMin
            s += 1
    s

// ─── Level-based execution map ──────────────────────────────────────────────
// First target = nearest structural level in the trade direction. Structure, not a
// fixed R multiple, decides where this trade is likely to stall.
klFindT1(float[] levels, int d, float ref, float pad) =>
    float t1 = na
    if d != 0 and array.size(levels) > 0
        for i = 0 to array.size(levels) - 1
            float lv = array.get(levels, i)
            if d == 1 and lv > ref + syminfo.mintick
                t1 := na(t1) ? lv : math.min(t1, lv)
            if d == -1 and lv < ref - syminfo.mintick
                t1 := na(t1) ? lv : math.max(t1, lv)
    // Park the target just SHORT of the level, never ON it. The level is where the
    // crowd's resting limit orders sit, so price routinely stalls a few ticks before
    // reaching it and rolls over. Stops go BEYOND the crowd; targets go IN FRONT of it.
    // If the pad would leave the target inside the noise band around entry there is no
    // workable structural target -- report na rather than one that cannot be filled.
    float p = na(t1) ? na : d == 1 ? t1 - pad : t1 + pad
    na(p) ? na : d == 1 ? (p > ref + pad ? p : na) : (p < ref - pad ? p : na)

klExecMap(int d, float lvl, float atrVal, float slMult, float acct, float rPct) =>
    float ref   = close
    float slBuf = nz(atrVal) * slMult
    float raw   = d == 1 ? lvl - slBuf : d == -1 ? lvl + slBuf : na
    // Minimum distance from ENTRY, mirroring the floor calculateStopLoss() applies to ORB stops.
    // Without it a level sitting close to price yields a stop inside the noise band -- the live
    // TCS entry printed 0.2%, which is sweep bait. The stop may only move FURTHER from entry,
    // never nearer, so the level still governs whenever it is already wide enough.
    float minDist = math.max(nz(atrVal) * 0.5, ref * 0.003)
    float sl    = d == 1 ? math.min(raw, ref - minDist) : d == -1 ? math.max(raw, ref + minDist) : na
    float risk  = na(sl) ? na : math.abs(ref - sl)
    float qty   = na(risk) or risk <= 0 ? na : math.floor(acct * (rPct / 100) / risk)
    [ref, sl, risk, qty]

// ─── Main-body wiring (kept deliberately thin) ──────────────────────────────
// klEMA9 is computed here, unconditionally: a ta.* call reached on only some bars loses
// its internal series state, so gating an EMA behind an input is a correctness bug.
float klEMA9 = ta.ema(close, 9)
// HTF confirmation series. close[1] + lookahead_off is the canonical NON-repainting
// pair: it can never see inside the forming HTF bar, at the cost of up to one HTF bar
// of lag. Requesting plain `close` here would just return current price between HTF
// boundaries, which would make the confirmation test meaningless rather than strict.
float klHTFClose = request.security(syminfo.tickerid, klConfirmTF, close[1], lookahead=barmerge.lookahead_off)
float klEMASlope = klEMA9 - nz(klEMA9[1], klEMA9)

[klCLV, klRVOL, klBullCandle, klBearCandle, klDeltaProxy] = klCandle(volBaseline, klClvLongMin, klClvShortMax)
[klAllLevels, klLevelNames] = klBuildRegistry(enableKeyLevels, klPOC, klVAH, klVAL, klPDH, klPDL, klIBH, klIBL, activeORB)
[klVAHBreakBar, klVALBreakBar, klPDHBreakBar, klPDLBreakBar, klIBHBreakBar, klIBLBreakBar] = klTrackBreaks(enableKeyLevels, barstate.isconfirmed, klVAH, klVAL, klPDH, klPDL, klIBH, klIBL)

// Retest setups are scored on the highest RVOL in the retest window, not on the confirming
// bar alone. The break is where participation shows up; by the time price pulls back and
// closes back through the level, volume has usually dried up. Scoring only the confirming
// bar systematically under-rates exactly the setups this model rates highest.
float klWindowRvol = ta.highest(klRVOL, klRetestMaxBars)

float klBand = nz(cachedATR) * klConfAtrMult

[klSetupCode, klDir, klSetupLevel, klIsRetest, klRejectionFamily] = klResolveSetup(enableKeyLevels, enableVATriggers, enableVAAcceptance, klAccMinRvol, klRVOL, enablePDTriggers, enableIBTriggers, klVAH, klVAL, klPDH, klPDL, klIBH, klIBL, enableKeyLevels and not na(klIBH) and not na(klIBL) and not klInIB, klBullCandle, klBearCandle, klBand, klRetestMaxBars, klVAHBreakBar, klVALBreakBar, klPDHBreakBar, klPDLBreakBar, klIBHBreakBar, klIBLBreakBar)
[klConfCnt, klConfNames] = klConfluence(klSetupLevel, klBand, klAllLevels, klLevelNames)
int klScore = klComputeScore(klDir, klConfCnt, klIsRetest, sessionVWAP, klEMA9, klEMASlope, klIsRetest ? math.max(klRVOL, klWindowRvol) : klRVOL, klBullCandle, klBearCandle, volumeMultiplier, strongVolumeMultiplier, klSessionVF)
[klEntryRef, klSLLevel, klRiskPts, klQtyEst] = klExecMap(klDir, klSetupLevel, cachedATR, klSlBufferMult, accountSize, riskPct)
float klT1 = klFindT1(klAllLevels, klDir, klEntryRef, nz(cachedATR) * klT1PadMult)

// Direction-uniform HTF test: longs need the HTF close ABOVE the level, shorts BELOW it.
// One expression serves every family -- a VAH rejection short wants the HTF close back
// under VAH, which is this same test at d == -1, so rejections are not inverted by it.
// Exceptional volume bypasses the wait: a break carrying >= Strong x RVOL is order flow
// arriving rather than a stop run, and holding it a full HTF bar gives back most of the move.
float klHeadroom = klHeadroomR(klDir, klEntryRef, klDayHigh, klDayLow, klADR, klRiskPts)
bool klRoomOK = klMinHeadroomR <= 0 or na(klHeadroom) or klHeadroom >= klMinHeadroomR
// Distance already travelled from the level, in ATRs. Entry quality, not direction quality.
float klChase = na(klSetupLevel) or nz(cachedATR) <= 0 ? na : math.abs(close - klSetupLevel) / cachedATR
bool klChaseOK = klMaxChaseATR <= 0 or na(klChase) or klChase <= klMaxChaseATR

bool klHTFOK = not klRequireHTFClose or na(klHTFClose) or na(klSetupLevel) or klRVOL >= strongVolumeMultiplier or (klDir == 1 and klHTFClose > klSetupLevel) or (klDir == -1 and klHTFClose < klSetupLevel)

// ─── Decision-packet alert ──────────────────────────────────────────────────
// Declared here, not with the other builders, because it reads ~15 key-level globals that
// do not exist yet up there (Pine resolves in source order).
// DELIBERATELY NOT PARSEABLE AS A TRADE SIGNAL: parser.py keys off "Symbol:/Entry:/SL:/TP:"
// prefixes; this uses "Ref Entry"/"Ref SL"/"Ref T1", which ^(\w+)\s*:\s*(.+)$ cannot match
// across the space. Real entries go out via buildEntryAlert on the shared pending path.
// Code -> readable phrase, for the alert text only. Cheaper than carrying a long name
// string through 14 branches of klResolveSetup.
klSetupPhrase(string cd) =>
    str.substring(cd, 0, 3) + (str.endswith(cd, "-RT") ? " breakout-retest" : str.endswith(cd, "-REJ") ? " rejection" : str.endswith(cd, "-ACC") ? " acceptance" : " breakout")

klFootprintCue(int d, bool rejFamily, string lvlName) =>
    d == 0 ? "" : d == 1 ? (rejFamily ? "Sellers absorbed near " + lvlName + "? Buy imbalance? Delta flips up?" : "Buyers stacked above " + lvlName + "? No absorption? Delta up?") : (rejFamily ? "Buyers absorbed near " + lvlName + "? Sell imbalance? Delta flips down?" : "Sellers stacked below " + lvlName + "? No absorption? Delta down?")

buildKeyLevelAlert() =>
    // lvlName = the family prefix (VAH/VAL/PDH/PDL/IBH/IBL) without the -RT/-REJ/-ACC/-BRK
    // suffix; substring is cheaper than four chained str.replace_all calls.
    string lvlName = str.substring(klSetupCode, 0, 3)
    string sep = "------------------------\\n"
    string msg = (klDir == 1 ? "🟢 KEYLEVEL LONG | " : "🔴 KEYLEVEL SHORT | ") + syminfo.ticker + "\\n" + sep
    msg += "Setup: " + klSetupPhrase(klSetupCode) + " | Score " + str.tostring(klScore) + "\\n"
    msg += "Level: " + lvlName + " " + str.tostring(klSetupLevel, format.mintick) + (klConfCnt > 0 ? "  (+" + klConfNames + ")" : "") + "\\n" + sep
    msg += "Ref Entry " + str.tostring(klEntryRef, format.mintick) + " | Ref SL " + str.tostring(klSLLevel, format.mintick) + "\\n"
    msg += "Ref T1 " + (na(klT1) ? "-" : str.tostring(klT1, format.mintick)) + " | Ref Qty " + (na(klQtyEst) ? "-" : str.tostring(klQtyEst)) + "\\n"
    msg += "Risk " + str.tostring(klRiskPts, format.mintick) + " pts\\n" + sep
    msg += "VF " + (na(klSessionVF) ? "-" : str.tostring(klSessionVF, "0.00") + "x") + " | RVOL " + str.tostring(klRVOL, "0.0") + " | CLV " + str.tostring(klCLV, "0.00") + " | d-proxy " + klDeltaProxy + "\\n"
    msg += "Trend " + (not na(sessionVWAP) and close > sessionVWAP ? "vwap+ " : "vwap- ") + (close > klEMA9 ? "ema+ " : "ema- ") + (klEMASlope > 0 ? "slope+" : "slope-") + "\\n"
    msg += "Auction: " + klAuction + " | Open " + klOpenPos + " | ADR " + (na(klADR) or klADR <= 0 or na(klDayHigh) ? "-" : str.tostring((klDayHigh - klDayLow) / klADR * 100, "#") + "% used") + "\\n" + sep
    msg += "FOOTPRINT: " + klFootprintCue(klDir, klRejectionFamily, lvlName) + "\\n"
    msg += (enableKeyLevelExecution ? "MODE: EXECUTING\\n" : "MODE: OBSERVE ONLY\\n") + sep + getTimeIST() + "\\n" + getChartUrl()
    '{"chat_id": "' + telegram_chat_id + '", "text": "' + msg + '", "parse_mode": "Markdown"}'

// ─── Fire ───────────────────────────────────────────────────────────────────
// Cooldown state lives inside the gate, so this must be called unconditionally.
// beforeCutoff/inSess keep key-level setups inside the same trading window as ORB
// entries — an observation alert must never suggest a trade the strategy would refuse.
klFireGate(bool en, int d, int score, int threshold, int cooldown, bool confirmed, bool beforeCutoff, bool inSess, bool htfOK, bool roomOK, bool chaseOK) =>
    var int lastBar = na
    bool candidate = en and d != 0 and score >= threshold and htfOK and roomOK and chaseOK
    bool fresh = na(lastBar) or (bar_index - lastBar > cooldown)
    bool f = confirmed and candidate and fresh and beforeCutoff and inSess
    if f
        lastBar := bar_index
    f

bool klFire = klFireGate(enableKeyLevels, klDir, klScore, klScoreThreshold, klCooldownBars, barstate.isconfirmed, isBeforeCutoff, inSession, klHTFOK, klRoomOK, klChaseOK)

// Latched last setup. The live row is blank on all but the single bar a setup fires, so
// without this the panel reads 'nothing here' during the 99% of bars between signals --
// which is indistinguishable from 'this engine produces nothing'.
var string klLastCode  = ""
var int    klLastDir   = 0
var int    klLastScore = 0
var int    klLastConf  = 0
var string klLastConfN = ""
var int    klLastTime  = na
if klFire
    klLastCode  := klSetupCode
    klLastDir   := klDir
    klLastScore := klScore
    klLastConf  := klConfCnt
    klLastConfN := klConfNames
    klLastTime  := time


if klFire
    alert(buildKeyLevelAlert(), alert.freq_once_per_bar_close)

// Optional named-alert hook, mirroring the existing "TEST Alert Triggered" condition at
// the foot of this file. Lets you create a TradingView alert on the key-level packet
// alone; the alert() call above still covers the "Any alert() function call" setup that
// the ORB entry/TP/SL alerts use.
alertcondition(klFire, title="Key-Level Decision Packet", message="Key-level breakout candidate - check footprint")

// ─── Execution (OFF by default) ─────────────────────────────────────────────
// Reuses the ORB pendingLong/ShortEntry machinery, so fill, SL/TP, Telegram alert, trade
// lines and the 1-trade-per-session cap are shared — no second execution path.
// canTakeEntry already covers cutoff, sessionEntryTaken, smart filters and the NR gate.
if klFire and enableKeyLevelExecution and canTakeKeyLevelEntry
    if klDir == 1 and not pendingLongEntry and not awaitingRetestLong
        pendingLongEntry := true
        pendingLongBar := bar_index
        klPendingSource := klSetupCode
        klArmedSL := klSLLevel
        klArmedT1 := klT1
    else if klDir == -1 and not pendingShortEntry and not awaitingRetestShort
        pendingShortEntry := true
        pendingShortBar := bar_index
        klPendingSource := klSetupCode
        klArmedSL := klSLLevel
        klArmedT1 := klT1

// ====================================== BARS OUTSIDE TRACKING ======================================
if not isHTF and barstate.isconfirmed

    if hadBreakUp and bar_index > breakUpBarIndex
        if close > tradeOrbHigh
            barsOutsideAfterBreakUp += 1

            minRetestDistance = tradeOrbHigh * (minRetestDistancePct / 100)
            if close > tradeOrbHigh + minRetestDistance
                wentFarEnoughUp := true
        else
            barsOutsideAfterBreakUp := 0

    if hadBreakDown and bar_index > breakDownBarIndex
        if close < tradeOrbLow
            barsOutsideAfterBreakDown += 1

            minRetestDistance = tradeOrbLow * (minRetestDistancePct / 100)
            if close < tradeOrbLow - minRetestDistance
                wentFarEnoughDown := true
        else
            barsOutsideAfterBreakDown := 0

// ======================================= RETEST DETECTION ==========================================
if not isHTF and enableRetest and haveRange and barstate.isconfirmed

    retestBufferCalc = getBuffer(actH, retestBuffer)

    if hadBreakUp and not hadRetestUp
        wentFarEnough = wentFarEnoughUp

        isCommittedBreakout = barsOutsideAfterBreakUp >= minBarsOutside

        priceBackInside = close < tradeOrbHigh + retestBufferCalc and close > tradeOrbLow - retestBufferCalc

        barsSinceBreak = bar_index - breakUpBarIndex
        isFailedBreak = everHadBreakUp and barsSinceBreak > 0 and barsSinceBreak <= MAX_BARS_FAILED_BREAK and priceBackInside and not isCommittedBreakout
        if isFailedBreak
            if not na(lastBreakUpLabel)
                label.set_text(lastBreakUpLabel, "FAILED BREAK")
                label.set_color(lastBreakUpLabel, color.new(color.orange, 0))

            if cyclesUp > 0
                cyclesUp -= 1
            godFailedBreaks += 1

            hadBreakUp := false
            barsOutsideAfterBreakUp := 0
            if not na(activeORB)
                activeORB.breakoutUp := false

        else if wentFarEnough and priceBackInside and isCommittedBreakout
            hadRetestUp := true
            retestUpBar := bar_index
            barsOutsideAfterBreakUp := 0

            if signalMode == "Track Cycles"
                hadBreakUp := false
                if not na(activeORB)
                    activeORB.breakoutUp := false

            showRetestLabel = true
            if signalMode == "Track Cycles"
                totalCyclesUp = cyclesUp + retestCyclesUp
                showRetestLabel := totalCyclesUp < maxCycles

            if showRetestLabel
                retestCyclesUp += 1
                sessionRetestsUp += 1

                retestText = str.format("🔁 RETEST UP #{0}", str.tostring(sessionRetestsUp))
                float labelOffset = cachedATR * LABEL_OFFSET_ATR_MULTIPLIER
                float labelY = high + labelOffset
                retestLabel = label.new(bar_index, labelY, retestText,
                          style=label.style_label_down,
                          color=color.new(color.orange, 20),
                          textcolor=color.white,
                          size=getLabelSize(labelSize))
                cleanupLabel(retestLabel)

    if hadBreakDown and not hadRetestDown
        wentLowEnough = wentFarEnoughDown
        isCommittedBreakout = barsOutsideAfterBreakDown >= minBarsOutside
        priceBackInside = close > tradeOrbLow - retestBufferCalc and close < tradeOrbHigh + retestBufferCalc

        barsSinceBreak = bar_index - breakDownBarIndex
        isFailedBreak = everHadBreakDown and barsSinceBreak > 0 and barsSinceBreak <= MAX_BARS_FAILED_BREAK and priceBackInside and not isCommittedBreakout
        if isFailedBreak
            if not na(lastBreakDownLabel)
                label.set_text(lastBreakDownLabel, "FAILED BREAK")
                label.set_color(lastBreakDownLabel, color.new(color.orange, 0))

            if cyclesDown > 0
                cyclesDown -= 1
            godFailedBreaks += 1

            hadBreakDown := false
            barsOutsideAfterBreakDown := 0
            if not na(activeORB)
                activeORB.breakoutDown := false

        else if wentLowEnough and priceBackInside and isCommittedBreakout
            hadRetestDown := true
            retestDownBar := bar_index
            barsOutsideAfterBreakDown := 0

            if signalMode == "Track Cycles"
                hadBreakDown := false
                if not na(activeORB)
                    activeORB.breakoutDown := false

            showRetestLabel = true
            if signalMode == "Track Cycles"
                totalCyclesDown = cyclesDown + retestCyclesDown
                showRetestLabel := totalCyclesDown < maxCycles

            if showRetestLabel
                retestCyclesDown += 1
                sessionRetestsDown += 1

                retestText = str.format("🔁 RETEST DOWN #{0}", str.tostring(sessionRetestsDown))

                float labelOffset = cachedATR * LABEL_OFFSET_ATR_MULTIPLIER
                float labelY = low - labelOffset
                retestLabel = label.new(bar_index, labelY, retestText,
                          style=label.style_label_up,
                          color=color.new(color.orange, 20),
                          textcolor=color.white,
                          size=getLabelSize(labelSize))
                cleanupLabel(retestLabel)

isBullish = orbTradeDirection == 1
entry = orbEntryPrice
sl = orbSLPrice
tp1 = orbTP1Price
tp1_5 = orbTP1_5Price
tp2 = orbTP2Price
tp3 = orbTP3Price
atr = cachedATR

// ========================================== EDGE LABELS ============================================
if not isHTF and showEdgeLabels and haveDisplayRange

    stageChanged = stage != lastLabelStage
    priceChangedH = displayH != lastLabelH
    priceChangedL = displayL != lastLabelL
    labelsExist = not na(labH) and not na(labL)
    needsUpdate = stageChanged or priceChangedH or priceChangedL or not labelsExist

    if needsUpdate
        labelColor = color.new(cachedLineColor, 0)

        if na(labH)
            labH := label.new(bar_index + LABEL_OFFSET_BARS, displayH, cachedStageName, xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_left, color=labelColor, textcolor=color.white, size=getLabelSize(labelSize))
        else
            label.set_y(labH, displayH)
            if stageChanged
                label.set_text(labH, cachedStageName)
                label.set_color(labH, labelColor)

        if na(labL)
            labL := label.new(bar_index + LABEL_OFFSET_BARS, displayL, cachedStageName, xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_left, color=labelColor, textcolor=color.white, size=getLabelSize(labelSize))
        else
            label.set_y(labL, displayL)
            if stageChanged
                label.set_text(labL, cachedStageName)
                label.set_color(labL, labelColor)

        lastLabelH := displayH
        lastLabelL := displayL
        lastLabelStage := stage

    if barstate.islast and not isHTF and haveDisplayRange
        if not na(labH)
            label.set_x(labH, bar_index + LABEL_OFFSET_BARS)
        if not na(labL)
            label.set_x(labL, bar_index + LABEL_OFFSET_BARS)


// ================================ TP/SL LINES UPDATE LOOP ==========================================
if not orbLinesFrozen and not na(orbEntryBar) and bar_index >= orbEntryBar
    if not na(orbEntryLine)
        line.set_x2(orbEntryLine, bar_index)
    if not na(orbEntryLabel)
        label.set_x(orbEntryLabel, bar_index)

    if not na(orbSLLine)
        line.set_x2(orbSLLine, bar_index)
    if not na(orbSLLabel)
        label.set_x(orbSLLabel, bar_index)

    if not na(orbTP1Line)
        line.set_x2(orbTP1Line, bar_index)
    if not na(orbTP1Label)
        label.set_x(orbTP1Label, bar_index)

    if not na(orbTP1_5Line)
        line.set_x2(orbTP1_5Line, bar_index)
    if not na(orbTP1_5Label)
        label.set_x(orbTP1_5Label, bar_index)

    if not na(orbTP2Line)
        line.set_x2(orbTP2Line, bar_index)
    if not na(orbTP2Label)
        label.set_x(orbTP2Label, bar_index)

    if not na(orbTP3Line)
        line.set_x2(orbTP3Line, bar_index)
    if not na(orbTP3Label)
        label.set_x(orbTP3Label, bar_index)

if not orbLinesFrozen and not na(orbEntryPrice) and (barstate.isconfirmed or barstate.islast)

    if orbTradeDirection == 1  // LONG

        if not orbTP1Hit and not na(orbTP1Price) and showTP1 and bar_index > orbEntryBar and high >= orbTP1Price
            orbTP1Hit := true
            alertTP1Triggered := true  // Trigger TP1 alert
            // Send TP1 Hit Alert (LONG)
            alert(buildTPAlert(true, orbEntryPrice, orbSLPrice, orbTP1Price, orbTP1Price, "TP1", tp1ExitQtyPct), alert.freq_once_per_bar)
            if not na(orbTP1Label)
                string tp1Text = labelFormat == "Simple" ? "✅ TP1" : str.format("✅ TP1: {0}", str.tostring(orbTP1Price, "#.##"))
                label.set_text(orbTP1Label, tp1Text)
                label.set_color(orbTP1Label, color.new(color.green, 0))
            if not na(orbTP1Line)
                line.set_color(orbTP1Line, color.new(color.green, 0))

        if not orbTP1_5Hit and not na(orbTP1_5Price) and showTP1_5 and bar_index > orbEntryBar and high >= orbTP1_5Price
            orbTP1_5Hit := true
            // Send TP1.5 Hit Alert (LONG)
            alert(buildTPAlert(true, orbEntryPrice, orbSLPrice, orbTP1_5Price, orbTP1_5Price, "TP1.5", tp1_5ExitQtyPct), alert.freq_once_per_bar)
            if not na(orbTP1_5Label)
                string tp1_5Text = labelFormat == "Simple" ? "✅ TP1.5" : str.format("✅ TP1.5: {0}", str.tostring(orbTP1_5Price, "#.##"))
                label.set_text(orbTP1_5Label, tp1_5Text)
                label.set_color(orbTP1_5Label, color.new(color.green, 0))
            if not na(orbTP1_5Line)
                line.set_color(orbTP1_5Line, color.new(color.green, 0))

        if not orbTP2Hit and not na(orbTP2Price) and showTP2 and bar_index > orbEntryBar and high >= orbTP2Price
            orbTP2Hit := true
            alertTP2Triggered := true  // Trigger TP2 alert
            // Send TP2 Hit Alert (LONG)
            alert(buildTPAlert(true, orbEntryPrice, orbSLPrice, orbTP2Price, orbTP2Price, "TP2", 100), alert.freq_once_per_bar)
            if not na(orbTP2Label)
                string tp2Text = labelFormat == "Simple" ? "✅ TP2" : str.format("✅ TP2: {0}", str.tostring(orbTP2Price, "#.##"))
                label.set_text(orbTP2Label, tp2Text)
                label.set_color(orbTP2Label, color.new(color.green, 0))
            if not na(orbTP2Line)
                line.set_color(orbTP2Line, color.new(color.green, 0))

        if not orbTP3Hit and not na(orbTP3Price) and showTP3 and bar_index > orbEntryBar and high >= orbTP3Price
            orbTP3Hit := true
            // Send TP3 Hit Alert (LONG)
            alert(buildTPAlert(true, orbEntryPrice, orbSLPrice, orbTP3Price, orbTP3Price, "TP3", 100), alert.freq_once_per_bar)
            if not na(orbTP3Label)
                string tp3Text = labelFormat == "Simple" ? "✅ TP3" : str.format("✅ TP3: {0}", str.tostring(orbTP3Price, "#.##"))
                label.set_text(orbTP3Label, tp3Text)
                label.set_color(orbTP3Label, color.new(color.green, 0))
            if not na(orbTP3Line)
                line.set_color(orbTP3Line, color.new(color.green, 0))

        lastTPHit = false
        if showTP3 and orbTP3Hit
            lastTPHit := true
        else if not showTP3 and showTP2 and orbTP2Hit
            lastTPHit := true
        else if not showTP3 and not showTP2 and showTP1_5 and orbTP1_5Hit
            lastTPHit := true
        else if not showTP3 and not showTP2 and not showTP1_5 and showTP1 and orbTP1Hit
            lastTPHit := true

        if lastTPHit
            orbLinesFrozen := true

        if not orbSLHit and not na(orbSLPrice) and bar_index > orbEntryBar and low <= orbSLPrice
            orbSLHit := true
            alertSLTriggered := true  // Trigger SL alert
            orbLinesFrozen := true

            // Send SL Hit Alert (LONG) — always reference TP1 for R:R consistency with entry alert
            alert(buildSLAlert(true, orbEntryPrice, orbSLPrice, orbTP1Price, orbSLPrice), alert.freq_once_per_bar)

            // Reset breakout flag to allow new breakouts after SL hit
            if not na(activeORB)
                activeORB.breakoutUp := false
            if not na(orbSLLabel)
                string slText = labelFormat == "Simple" ? "❌ SL" : str.format("❌ SL: {0}", str.tostring(orbSLPrice, "#.##"))
                label.set_text(orbSLLabel, slText)

    else if orbTradeDirection == -1  // SHORT

        if not orbTP1Hit and not na(orbTP1Price) and showTP1 and bar_index > orbEntryBar and low <= orbTP1Price
            orbTP1Hit := true
            alertTP1Triggered := true  // Trigger TP1 alert for short
            // Send TP1 Hit Alert (SHORT)
            alert(buildTPAlert(false, orbEntryPrice, orbSLPrice, orbTP1Price, orbTP1Price, "TP1", tp1ExitQtyPct), alert.freq_once_per_bar)
            if not na(orbTP1Label)
                string tp1Text = labelFormat == "Simple" ? "✅ TP1" : str.format("✅ TP1: {0}", str.tostring(orbTP1Price, "#.##"))
                label.set_text(orbTP1Label, tp1Text)
                label.set_color(orbTP1Label, color.new(color.green, 0))
            if not na(orbTP1Line)
                line.set_color(orbTP1Line, color.new(color.green, 0))

        if not orbTP1_5Hit and not na(orbTP1_5Price) and showTP1_5 and bar_index > orbEntryBar and low <= orbTP1_5Price
            orbTP1_5Hit := true
            // Send TP1.5 Hit Alert (SHORT)
            alert(buildTPAlert(false, orbEntryPrice, orbSLPrice, orbTP1_5Price, orbTP1_5Price, "TP1.5", tp1_5ExitQtyPct), alert.freq_once_per_bar)
            if not na(orbTP1_5Label)
                string tp1_5Text = labelFormat == "Simple" ? "✅ TP1.5" : str.format("✅ TP1.5: {0}", str.tostring(orbTP1_5Price, "#.##"))
                label.set_text(orbTP1_5Label, tp1_5Text)
                label.set_color(orbTP1_5Label, color.new(color.green, 0))
            if not na(orbTP1_5Line)
                line.set_color(orbTP1_5Line, color.new(color.green, 0))

        if not orbTP2Hit and not na(orbTP2Price) and showTP2 and bar_index > orbEntryBar and low <= orbTP2Price
            orbTP2Hit := true
            alertTP2Triggered := true  // Trigger TP2 alert for short
            // Send TP2 Hit Alert (SHORT)
            alert(buildTPAlert(false, orbEntryPrice, orbSLPrice, orbTP2Price, orbTP2Price, "TP2", 100), alert.freq_once_per_bar)
            if not na(orbTP2Label)
                string tp2Text = labelFormat == "Simple" ? "✅ TP2" : str.format("✅ TP2: {0}", str.tostring(orbTP2Price, "#.##"))
                label.set_text(orbTP2Label, tp2Text)
                label.set_color(orbTP2Label, color.new(color.green, 0))
            if not na(orbTP2Line)
                line.set_color(orbTP2Line, color.new(color.green, 0))

        if not orbTP3Hit and not na(orbTP3Price) and showTP3 and bar_index > orbEntryBar and low <= orbTP3Price
            orbTP3Hit := true
            // Send TP3 Hit Alert (SHORT)
            alert(buildTPAlert(false, orbEntryPrice, orbSLPrice, orbTP3Price, orbTP3Price, "TP3", 100), alert.freq_once_per_bar)
            if not na(orbTP3Label)
                string tp3Text = labelFormat == "Simple" ? "✅ TP3" : str.format("✅ TP3: {0}", str.tostring(orbTP3Price, "#.##"))
                label.set_text(orbTP3Label, tp3Text)
                label.set_color(orbTP3Label, color.new(color.green, 0))
            if not na(orbTP3Line)
                line.set_color(orbTP3Line, color.new(color.green, 0))

        lastTPHit = false
        if showTP3 and orbTP3Hit
            lastTPHit := true
        else if not showTP3 and showTP2 and orbTP2Hit
            lastTPHit := true
        else if not showTP3 and not showTP2 and showTP1_5 and orbTP1_5Hit
            lastTPHit := true
        else if not showTP3 and not showTP2 and not showTP1_5 and showTP1 and orbTP1Hit
            lastTPHit := true

        if lastTPHit
            orbLinesFrozen := true

        if not orbSLHit and not na(orbSLPrice) and bar_index > orbEntryBar and high >= orbSLPrice
            orbSLHit := true
            alertSLTriggered := true  // Trigger SL alert for short
            orbLinesFrozen := true

            // Send SL Hit Alert (SHORT) — always reference TP1 for R:R consistency with entry alert
            alert(buildSLAlert(false, orbEntryPrice, orbSLPrice, orbTP1Price, orbSLPrice), alert.freq_once_per_bar)

            // Reset breakout flag to allow new breakouts after SL hit
            if not na(activeORB)
                activeORB.breakoutDown := false
            if not na(orbSLLabel)
                string slText = labelFormat == "Simple" ? "❌ SL" : str.format("❌ SL: {0}", str.tostring(orbSLPrice, "#.##"))
                label.set_text(orbSLLabel, slText)

    if freezeOnEOD and not inSession and inSession[1]
        orbLinesFrozen := true

// === STRATEGY: Time Exit (separate from entry cutoff) ===
var bool timeExitTriggered = false
bool isAtTimeExit = currentHourNow == timeExitHour and currentMinuteNow >= timeExitMinute and currentMinuteNow < timeExitMinute + 5
bool isPastTimeExit = currentHourNow > timeExitHour or (currentHourNow == timeExitHour and currentMinuteNow >= timeExitMinute)

// Reset time exit flag at start of session
if inSession and not inSession[1]
    timeExitTriggered := false

// Time exit: Close position at time exit hour + send Telegram alert.
// strategy.close_all simulates the exit for backtest accuracy.
// Signal engine handles actual exit independently via its own time exit logic.
// strategy.position_size != 0 ensures we only fire if position is still open
if isPastTimeExit and not timeExitTriggered and strategy.position_size != 0
    bool isLongPos = strategy.position_size > 0
    // Send Time Exit Alert — always reference TP1 for R:R consistency with entry alert
    alert(buildTimeExitAlert(isLongPos, orbEntryPrice, orbSLPrice, orbTP1Price, close), alert.freq_once_per_bar)

    strategy.close_all(comment="Time Exit")
    timeExitTriggered := true
    orbLinesFrozen := true

// === STRATEGY: Close all positions at end of session ===
if not inSession and inSession[1] and strategy.position_size != 0
    strategy.close_all(comment="EOD Close")

// ===================== REAL-TIME TP TRACKING & TRADE CLOSE DETECTION ==============================
bool cyclesChanged = (cyclesUp != prevCyclesUp) or (cyclesDown != prevCyclesDown)
bool newBreakoutDetected = not na(orbEntryBar) and (na(prevOrbEntryBar) or orbEntryBar != prevOrbEntryBar or cyclesChanged)

if newBreakoutDetected
    trade_closed := false
    prevOrbEntryBar := orbEntryBar
    prevCyclesUp := cyclesUp
    prevCyclesDown := cyclesDown
    current_trade_r := 0.0
    tp1_counted := false
    tp1_5_counted := false
    tp2_counted := false
    tp3_counted := false

bool hasActiveBreakout = orbTradeDirection != 0 and not na(orbEntryBar)

if hasActiveBreakout and not trade_closed

    // STEP 1: CALCULATE CURRENT TRADE R (Real-time)
    current_trade_r := 0.0

    if orbTP3Hit and showTP3
        current_trade_r := 3.0
    else if orbTP2Hit and showTP2
        current_trade_r := 2.0
    else if orbTP1_5Hit and showTP1_5
        current_trade_r := 1.5
    else if orbTP1Hit and showTP1
        current_trade_r := 1.0

    // STEP 2: CHECK TRADE CLOSE CONDITIONS
    bool lastTPisTP3 = showTP3
    bool lastTPisTP2 = showTP2 and not showTP3
    bool lastTPisTP1_5 = showTP1_5 and not showTP2 and not showTP3
    bool lastTPisTP1 = showTP1 and not showTP1_5 and not showTP2 and not showTP3

    bool shouldClose = false
    string resultText = ""
    bool isWin = false

    if orbSLHit
        shouldClose := true
        isWin := false
        current_trade_r := -1.0
        resultText := "❌ SL Hit (-1R)"

    else if (orbTP3Hit and lastTPisTP3) or (orbTP2Hit and lastTPisTP2) or (orbTP1_5Hit and lastTPisTP1_5) or (orbTP1Hit and lastTPisTP1)
        shouldClose := true
        isWin := true

        if orbTP3Hit and lastTPisTP3
            resultText := "✅ TP3 Hit (+3R)"
        else if orbTP2Hit and lastTPisTP2
            resultText := "✅ TP2 Hit (+2R)"
        else if orbTP1_5Hit and lastTPisTP1_5
            resultText := "✅ TP1.5 Hit (+1.5R)"
        else if orbTP1Hit and lastTPisTP1
            resultText := "✅ TP1 Hit (+1R)"

    else if freezeOnEOD and not inSession and inSession[1]
        shouldClose := true

        if orbTradeDirection == 1  // LONG
            float riskDist = entry - sl
            float profitDist = close - entry
            current_trade_r := riskDist > 0 ? profitDist / riskDist : 0.0
        else if orbTradeDirection == -1  // SHORT
            float riskDist = sl - entry
            float profitDist = entry - close
            current_trade_r := riskDist > 0 ? profitDist / riskDist : 0.0

        isWin := current_trade_r > 0

        string eodIcon = current_trade_r > 0 ? "✅" : current_trade_r < 0 ? "❌" : "⚖️"
        resultText := str.format("{0} EOD Close: {1}R", eodIcon, str.tostring(current_trade_r, "#.#"))

    // STEP 3: CLOSE TRADE & UPDATE SESSION STATS
    if shouldClose and not trade_closed
        trade_closed := true
        session_trades += 1

        session_total_rr += current_trade_r

        if isWin
            session_wins += 1
            session_best_r := math.max(session_best_r, current_trade_r)
        else
            session_losses += 1
            session_worst_r := math.min(session_worst_r, current_trade_r)

        last_trade_result := resultText

// ====================== DYNAMIC ORB VISUALIZATION (BUILDING PHASE) ================================
float plotORB15High = na
float plotORB15Low = na
float plotORB15Mid = na

ORBData lastEnabledORB = na
for orbObj in allORBs
    if orbObj.isEnabled
        if na(lastEnabledORB) or orbObj.minutes > lastEnabledORB.minutes
            lastEnabledORB := orbObj

if not isHTF and inSession
    float barEndTime = time + (currentTF_seconds * 1000)
    float minsFromOpenToEndOfBar = not na(sessionFirstBarTime) ? (barEndTime - sessionFirstBarTime) / 60000 : -1
    [h15, l15, m15] = getORBPlotValues(orb15Obj, minsFromOpen, minsFromOpenToEndOfBar, currentTF_minutes, false)
    plotORB15High := h15, plotORB15Low := l15, plotORB15Mid := m15


// ORB15 Plots (during building only)
p_orb15_high = plot(plotORB15High, title="ORB15 High", color=color.new(orb15LineColor, 0), linewidth=1, style=plot.style_linebr, display=display.pane)
p_orb15_low = plot(plotORB15Low, title="ORB15 Low", color=color.new(orb15LineColor, 0), linewidth=1, style=plot.style_linebr, display=display.pane)
fill(p_orb15_high, p_orb15_low, color=color.new(orb15LineColor, showBG ? fillTransparency : 100), title="ORB15 Fill")
plot(showMidLine ? plotORB15Mid : na, title="ORB15 Mid", color=color.new(orb15LineColor, 30), linewidth=1, style=plot.style_linebr, display=display.pane)



// ============================================ DASHBOARD ============================================
var int lastHTFCheckBar = -1
var bool shouldCheckHTF = false

var int lastDashStage = -1
var bool lastDashBreakUp = false
var bool lastDashBreakDown = false
var float lastDashOrbHigh = na
var float lastDashOrbLow = na
var bool lastDashTP1Hit = false
var bool lastDashTP1_5Hit = false
var bool lastDashTP2Hit = false
var bool lastDashTP3Hit = false
var bool lastDashSLHit = false

if showDashboard and enableHTF
    [htfTimeChanged] = request.security(syminfo.tickerid, htfTF, [ta.change(time) != 0], barmerge.gaps_off, barmerge.lookahead_off)

    if barstate.islast and (htfTimeChanged or cachedHTFBiasText == "")
        [htfBullishCalc, htfBearishCalc, htfBiasTextTemp, htfStrengthTemp] = checkHTFBias()
        cachedHTFBiasText := htfBiasTextTemp
        cachedHTFBullish := htfBullishCalc
        cachedHTFBearish := htfBearishCalc
        cachedHTFStrength := htfStrengthTemp
        lastHTFCheckBar := bar_index

    htfBullish := cachedHTFBullish
    htfBearish := cachedHTFBearish
    htfBiasText := cachedHTFBiasText

    bool stageChanged = stage != lastDashStage
    bool breakStateChanged = hadBreakUp != lastDashBreakUp or hadBreakDown != lastDashBreakDown
    bool orbLevelsChanged = not na(activeORB) and (activeORB.high != lastDashOrbHigh or activeORB.low != lastDashOrbLow)
    bool targetHitStateChanged = orbTP1Hit != lastDashTP1Hit or orbTP1_5Hit != lastDashTP1_5Hit or orbTP2Hit != lastDashTP2Hit or orbTP3Hit != lastDashTP3Hit or orbSLHit != lastDashSLHit
    bool forceUpdate = (bar_index - lastDashUpdateBar) >= 20
    bool dashDataChanged = barstate.islast and (stageChanged or breakStateChanged or orbLevelsChanged or targetHitStateChanged or forceUpdate)

    bool isDarkTheme = dashTheme == "Dark"
    color bgColor = isDarkTheme ? color.new(color.black, 0) : color.new(color.white, 10)
    color txtColor = isDarkTheme ? color.white : color.black
    color headerColor = isDarkTheme ? color.new(color.aqua, 30) : color.new(color.silver, 30)
    tablePos = dashPos == "Top Left" ? position.top_left : dashPos == "Top Right" ? position.top_right : dashPos == "Bottom Left" ? position.bottom_left : dashPos == "Bottom Right" ? position.bottom_right : position.middle_right
    txtSize = dashSize == "Small" ? size.small : dashSize == "Normal" ? size.normal : dashSize == "Large" ? size.large : size.small

    if showDashboard and na(dashTable)
        // 54 rows: the ORB dashboard reaches ~30 in its widest configuration and the
        // key-level block adds 13. Pine silently drops cells written past
        // the declared row count rather than erroring, so this must lead the additions.
        dashTable := table.new(tablePos, 2, 54, bgcolor=bgColor, border_width=0, frame_width=1)
        table.clear(dashTable, 0, 0, 1, 53)
        table.set_position(dashTable, tablePos)
        lastDashUpdateBar := bar_index

    if showDashboard and not na(dashTable)
        lastDashUpdateBar := bar_index
        lastDashStage := stage
        lastDashBreakUp := hadBreakUp
        lastDashBreakDown := hadBreakDown
        if not na(activeORB)
            lastDashOrbHigh := activeORB.high
            lastDashOrbLow := activeORB.low
        lastDashTP1Hit := orbTP1Hit
        lastDashTP1_5Hit := orbTP1_5Hit
        lastDashTP2Hit := orbTP2Hit
        lastDashTP3Hit := orbTP3Hit
        lastDashSLHit := orbSLHit

        table.clear(dashTable, 0, 0, 1, 53)
        table.set_position(dashTable, tablePos)

    int row = 0

    bool showFullDashboard = false
    string sessionIcon = ""
    string sessionStatusText = ""

    bool isMarketOpen = isTradingDay() and isWithinSessionHours()
    bool isDisplayWindow = isWithinDisplayHours()

    bool hasValidOrbData = not na(activeORB) or everHadBreakUp or everHadBreakDown or not na(orbEntryPrice)

    if isHTF
        sessionIcon := "⚠️"
        sessionStatusText := "HTF MODE - Use 5-60min timeframe"
        showFullDashboard := false
    else if isMarketOpen
        bool isRegularHours = isInRegularHours()
        sessionIcon := isRegularHours ? "☀️" : "💤"
        sessionStatusText := isRegularHours ? "MARKET OPEN" : "EXTENDED HOURS"
        showFullDashboard := true
    else if hadSessionToday and hasValidOrbData and not isMarketOpen
        // Show last session data when market is closed (regardless of display window)
        sessionIcon := "🌙"

        bool useReplayTime = isReplayMode()
        int timeToCheck = useReplayTime ? time : timenow

        string sessionDate = not na(sessionStartTime) ? str.format_time(int(sessionStartTime), "MM/dd", syminfo.timezone) : "N/A"
        string currentDate = str.format_time(timeToCheck, "MM/dd", syminfo.timezone)

        if sessionDate == currentDate
            sessionStatusText := "AFTER HOURS - Today's Data (" + sessionDate + ")"
        else
            sessionStatusText := "AFTER HOURS - Last Session (" + sessionDate + ")"

        showFullDashboard := true
    else if hasValidOrbData and not isMarketOpen
        // Show last session data even if hadSessionToday is false (e.g., weekend viewing)
        sessionIcon := "🌙"
        string sessionDate = not na(sessionStartTime) ? str.format_time(int(sessionStartTime), "MM/dd", syminfo.timezone) : "N/A"
        sessionStatusText := "MARKET CLOSED - Last Session (" + sessionDate + ")"
        showFullDashboard := true
    else
        sessionIcon := "🌙"
        sessionStatusText := "MARKET CLOSED"
        showFullDashboard := false

    // BUILD DASHBOARD
    if not showFullDashboard and not na(dashTable) and (dashDataChanged or forceUpdate)
        // Clear the full table range (table has 54 rows: 0..53)
        table.clear(dashTable, 0, 0, 1, 53)
        table.set_position(dashTable, tablePos)

        string statusTitle = sessionIcon + " " + sessionStatusText
        color statusBgColor = isDarkTheme ? color.new(color.gray, 20) : color.new(color.gray, 80)

        string statusTooltip = ""
        if isHTF
            statusTooltip := "ORB works only on timeframes 1-60 minutes.\n\nPlease switch to a lower timeframe to use ORB."
        else
            statusTooltip := "Market is closed.\n\nORB will activate during market hours."

        table.cell(dashTable, 0, 0, statusTitle, text_color=txtColor, text_size=txtSize, text_halign=text.align_center, bgcolor=statusBgColor, tooltip=statusTooltip)
        table.cell(dashTable, 1, 0, "", bgcolor=statusBgColor)
        table.merge_cells(dashTable, 0, 0, 1, 0)

        lastDashUpdateBar := bar_index

    else if showFullDashboard and not na(dashTable)

        float entry = na
        float sl = na
        float tp1 = na
        float tp1_5 = na
        float tp2 = na
        float tp3 = na
        float atr = na
        bool isBullish = false
        int shares = na
        float posValue = na
        float maxLossCalc = na
        float riskAmount = na
        float riskPctOfAcct = na

        // HEADER - With Session Status Icon
        string headerTitle = sessionIcon + " DASHBOARD"
        color headerBgColor = headerColor
        string headerTooltip = "Dashboard - " + sessionStatusText + "\n\n"

        if isWithinDisplayHours() and isInRegularHours()
            headerTooltip += "☀️ REGULAR HOURS (09:30-16:00)\n"
            headerTooltip += "Market is open for trading.\n\n"
        else if isWithinDisplayHours() and not isInRegularHours()
            headerTooltip += "🌙 EXTENDED HOURS\n"
            headerTooltip += "Pre-market (04:00-09:30) or After-hours (16:00-20:00)\n"
            headerTooltip += "Showing data from extended session.\n\n"

        if orbTradeDirection == 1
            headerTitle += " ⬆️"
            headerBgColor := color.new(color.green, 10)
            headerTooltip += "⬆️ BREAKOUT UP active\n"
        else if orbTradeDirection == -1
            headerTitle += " ⬇️"
            headerBgColor := color.new(color.red, 10)
            headerTooltip += "⬇️ BREAKOUT DOWN active\n"

        headerTooltip += "\n━━━━━━━━━━━━━━━━━━━━━\n"
        headerTooltip += "Shows Opening Range Breakout status and trade setup.\n"
        headerTooltip += "The dashboard displays active breakout trade parameters including entry, targets, and stop loss."

        if not na(dashTable)
            table.cell(dashTable, 0, row, headerTitle, text_color=txtColor, text_size=txtSize, text_halign=text.align_center, bgcolor=headerBgColor, tooltip=headerTooltip)
            table.cell(dashTable, 1, row, "", text_halign=text.align_center, bgcolor=headerBgColor)
            table.merge_cells(dashTable, 0, row, 1, row)
        row += 1

        // VERDICT — first thing under the header, in both Focus and Full.
        if not isHTF
            row := renderVerdict(dashTable, row, txtSize, enableTargets and not na(orbEntryBar) and not (orbTP1Hit or orbSLHit), not slotAvailable, isBeforeCutoff, isAfterMinTime, gapFilterPassed, orbRangeFilterPassed, not enableVolumeFilter or hasVolumeConfirmation(volBaseline, volumeMultiplier, strongVolumeMultiplier), nz(volBaseline) > 0 ? volume / volBaseline : 0, volumeMultiplier, nrRequireGate, godChopDay, klDir != 0 ? klDir : klLastDir, klDir != 0 ? klScore : klLastScore, klScoreThreshold, klHTFOK, klSessionVF, klRoomOK, klHeadroom, inPMWindow, pmStartHour, pmStartMinute)

        if showStage and not na(activeORB)
            bool isMarketNow = isTradingDay() and isWithinSessionHours()
            bool showingPastData = hadSessionToday and not isMarketNow

            activeOrbText = showingPastData ? "📊 Last: " + activeORB.name : "🎯 Active: " + activeORB.name

            // ENHANCED TOOLTIP: Time, Session, Market & ORB Details
            bool useReplayTime = isReplayMode()
            int timeToCheck = useReplayTime ? time : timenow
            string modeIndicator = useReplayTime ? " [REPLAY]" : " [LIVE]"

            string currentTime = str.format_time(timeToCheck, "HH:mm:ss", syminfo.timezone) + modeIndicator
            string currentDate = str.format_time(timeToCheck, "yyyy-MM-dd", syminfo.timezone)
            string barTime = str.format_time(time, "HH:mm:ss", syminfo.timezone)

            string chartTimezoneDisplay = "Unknown - Check: Right-click → Settings → Timezone"

            string timezoneHint = "\n\nℹ️ If time seems wrong:\n" +
                                  "Your chart may be set to UTC, EST, or another timezone.\n" +
                                  "To change: Right-click chart → Settings → Timezone\n\n" +
                                  "Common settings:\n" +
                                  "• Asia/Jerusalem (Israel time)\n" +
                                  "• America/New_York (NYSE time)\n" +
                                  "• UTC (Universal time - neutral)\n"

            string sessionDescription = ""
            if sessionMode == "New-York"
                sessionDescription := "NYSE Hours (09:30-16:00 EST/EDT)"
            else if sessionMode == "London"
                sessionDescription := "LSE Hours (08:00-16:30 GMT/BST)"
            else if sessionMode == "Tokyo"
                sessionDescription := "TSE Hours (09:00-15:00 JST)"
            else if sessionMode == "Sydney"
                sessionDescription := "ASX Hours (10:00-16:00 AEST)"
            else if sessionMode == "Frankfurt"
                sessionDescription := "XETRA Hours (09:00-17:30 CET/CEST)"
            else if sessionMode == "Auto-Detect"
                if syminfo.type == "stock" or syminfo.type == "fund" or syminfo.type == "index" or syminfo.type == "dr" or syminfo.type == "etf" or syminfo.type == "futures"
                    sessionDescription := "Exchange Hours (Auto-detected for " + syminfo.ticker + ")"
                else if syminfo.type == "crypto"
                    sessionDescription := "24/7 Trading"
                else
                    sessionDescription := "Auto-detected Session"
            else if sessionMode == "Custom"
                sessionDescription := "Custom Session (" + str.replace(tradingSession, ":23456", "") + ")"

            // === SESSION STATUS ===
            bool withinSessionHours = isWithinSessionHours()
            string sessionStatus = withinSessionHours ? "✅ OPEN" : "❌ CLOSED"

            string timeFromOpen = "N/A"

            if withinSessionHours and not na(sessionStartTime)
                int minutesElapsed = int((time - sessionStartTime) / 60000)
                int hours = int(minutesElapsed / 60)
                int mins = minutesElapsed % 60
                timeFromOpen := str.format("{0}h {1}m (OPEN)", hours, mins)
            else if not na(sessionStartTime)
                timeFromOpen := "Session Closed"

            // === ACTIVE ORB DETAILS ===
            string orbHighStr = str.tostring(activeORB.high, "#.####")
            string orbLowStr = str.tostring(activeORB.low, "#.####")
            string orbRangeStr = str.tostring(activeORB.orbRange, "#.####")
            string orbRangePct = str.tostring((activeORB.orbRange / activeORB.low) * 100, "#.##")

            // === BREAKOUT STATISTICS ===
            string breakoutStats = str.format("{0}↑ / {1}↓", activeORB.cyclesUp, activeORB.cyclesDown)
            int totalBreakouts = activeORB.cyclesUp + activeORB.cyclesDown

            // === MARKET DETECTION ===
            marketType = syminfo.type == "stock" ? "Stock" : syminfo.type == "crypto" ? "Crypto" : syminfo.type == "forex" ? "Forex" : syminfo.type
            resetTiming = is24_7Market ? "Midnight UTC (24/7 mode)" : "Session start: " + str.replace(tradingSession, ":23456", "") + " (" + sessionMode + ")"

            // === BUILD TOOLTIP ===
            if sessionMode == "New-York"
                sessionDescription := "NYSE Hours (09:30-16:00 EST/EDT)"
            else if sessionMode == "London"
                sessionDescription := "LSE Hours (08:00-16:30 GMT/BST)"
            else if sessionMode == "Tokyo"
                sessionDescription := "TSE Hours (09:00-15:00 JST)"
            else if sessionMode == "Sydney"
                sessionDescription := "ASX Hours (10:00-16:00 AEST)"
            else if sessionMode == "Frankfurt"
                sessionDescription := "XETRA Hours (09:00-17:30 CET/CEST)"
            else if sessionMode == "Auto-Detect"
                if syminfo.type == "stock" or syminfo.type == "fund" or syminfo.type == "index" or syminfo.type == "dr" or syminfo.type == "etf" or syminfo.type == "futures"
                    sessionDescription := "Exchange Hours (Auto-detected for " + syminfo.ticker + ")"
                else if syminfo.type == "crypto"
                    sessionDescription := "24/7 Trading"
                else
                    sessionDescription := "Auto-detected Session"
            else if sessionMode == "Custom"
                sessionDescription := "Custom Session (" + str.replace(tradingSession, ":23456", "") + ")"

            // === BUILD TOOLTIP ===
            bool is24_7 = syminfo.type == "crypto" or str.contains(tradingSession, "0000-2359")

            string sessionInfoSection = ""
            if not is24_7
                sessionInfoSection := "Time from session open: " + timeFromOpen + "\n\n" + "Session Definition: " + sessionDescription + "\n" + "Raw Session String: " + tradingSession + "\n\n"

            activeOrbTooltip = "Currently Active ORB\n\n" +
                              "This is the ORB period being used for breakout detection.\n\n" +
                              "• Breakouts are checked against THIS ORB only\n" +
                              "• When a new ORB completes, it becomes active\n" +
                              "• Stage: ORB15 (09:15-09:30)\n\n" +

                              "─────────────────\n" +
                              "⏰ CHART TIME DISPLAY\n" +
                              "─────────────────\n" +
                              "Date: " + currentDate + "\n" +
                              "Current Bar: " + currentTime + "\n" +
                              "Bar Open: " + barTime + "\n\n" +

                              "ℹ️ If time seems wrong:\n" +
                              "Your chart may be set to UTC, EST, or another timezone.\n" +
                              "To change: Right-click chart → Settings → Timezone\n\n" +

                              "─────────────────\n" +
                              "📊 SESSION STATUS\n" +
                              "─────────────────\n" +
                              "Status: " + sessionStatus + "\n" +
                              (is24_7 ? "" : "Time from session open: " + timeFromOpen + "\n\n" +
                                             "Session Definition: " + sessionDescription + "\n" +
                                             "Raw Session String: " + tradingSession + "\n\n")

            table.cell(dashTable, 0, row, activeOrbText, text_color=color.new(color.yellow, 0), text_size=txtSize, text_halign=text.align_center, bgcolor=color.new(color.blue, 20), tooltip=activeOrbTooltip)
            table.cell(dashTable, 1, row, "", bgcolor=color.new(color.blue, 20))
            table.merge_cells(dashTable, 0, row, 1, row)
            row += 1

        // Range info
        if showRange and not isHTF and not na(activeORB)
            orbRange = activeORB.high - activeORB.low
            rangePct = activeORB.low > 0 ? (orbRange / activeORB.low) * 100 : 0
            rangeTooltip = "ORB Range Size\n\nShows the width of the Opening Range in both dollars and percentage.\n\n• Large range (>1.5%) = High volatility\n• Medium range (0.5-1.5%) = Normal volatility\n• Small range (<0.5%) = Low volatility\n\nLarger ranges may require wider stops and smaller position sizes."

            table.cell(dashTable, 0, row, "Range:", text_color=txtColor, text_size=txtSize, text_halign=text.align_left, tooltip=rangeTooltip)
            table.cell(dashTable, 1, row, str.format("{0} ({1}% width)", str.tostring(orbRange, "#.##"), str.tostring(rangePct, "#.#")), text_color=txtColor, text_size=txtSize, text_halign=text.align_right)
            row += 1

        // Volatility Meter
        if showVolatilityMeter and not isHTF
            float atrPct = cachedATR > 0 and close > 0 ? (cachedATR / close) * 100 : 0
            string volIcon = atrPct > 3.0 ? "🔥🔥🔥" : atrPct > 2.0 ? "🔥🔥" : atrPct > 1.0 ? "🔥" : "⚪"
            string volText = atrPct > 3.0 ? "Extreme" : atrPct > 2.0 ? "High" : atrPct > 1.0 ? "Medium" : "Low"
            string volFull = volIcon + " " + volText

            volTooltip = "Market Volatility Level\n\nMeasures current volatility using ATR percentage of price.\n\nCurrent ATR: " + str.tostring(atrPct, "#.##") + "%\n\nLEVELS:\n🔥🔥🔥 EXTREME (>3%)\n• Very volatile conditions\n• Wider stops recommended\n• Smaller position sizes\n• Larger potential moves\n\n🔥🔥 HIGH (2-3%)\n• Active price movement\n• Standard stops work well\n• Normal position sizing\n• Good trading conditions\n\n🔥 MEDIUM (1-2%)\n• Normal trading range\n• Standard risk management\n• Typical daily movement\n\n⚪ LOW (<1%)\n• Quiet market\n• Tighter stops possible\n• Limited movement expected\n• May have smaller ORB ranges\n\nIMPLICATIONS:\nHigher volatility = Bigger potential profit BUT more risk of stop-out"

            table.cell(dashTable, 0, row, "📊 Volatility:", text_color=txtColor, text_size=txtSize, text_halign=text.align_left, tooltip=volTooltip)
            table.cell(dashTable, 1, row, volFull, text_color=txtColor, text_size=txtSize, text_halign=text.align_right)
            row += 1



        // Unified Entry Filters — shown for ALL scenarios: live, no-trade, trade-taken
        if not isHTF
            bool hasTrade = enableTargets and not na(orbEntryBar)
            // mode: 0=live (before cutoff), 1=no-trade (after cutoff), 2=trade taken
            int filterMode = hasTrade ? 2 : (not isBeforeCutoff ? 1 : 0)
            bool hasCross = priceCrossedUp or priceCrossedDown
            bool useAttempt = filterMode > 0 and hasCross
            // Live trend labels (for mode 0)
            bool trendBull = isTrendUp(trendMode, close, trendVWAP, trendEMA12, trendEMACustom, trendSTDirection)
            bool trendBear = isTrendDown(trendMode, close, trendVWAP, trendEMA12, trendEMACustom, trendSTDirection)
            string liveTrendLbl = trendBull ? "Bullish" : trendBear ? "Bearish" : "Neutral"
            // Display values: attempt-time for modes 1&2 (have direction), live for mode 0
            float dispVolRatio = useAttempt ? attemptVolRatio : (volBaseline > 0 ? volume / volBaseline : 0)
            bool dispVolOK = useAttempt ? attemptVolOK : true
            bool dispTrendAligned = useAttempt ? attemptTrendAligned : true
            bool dispHTFAligned = useAttempt ? attemptHTFAligned : true
            bool dispIdxAligned = useAttempt ? attemptIdxAligned : true
            // Labels: actual bias text (Bullish/Bearish/Strong Bearish etc.)
            string dispTrendLbl = useAttempt ? attemptTrendLabel : liveTrendLbl
            string dispHTFLbl = useAttempt ? attemptHTFLabel : cachedHTFBiasText
            string dispIdxLbl = useAttempt ? attemptIdxLabel : cachedIndexBiasText
            // Live values for "→" arrow comparison (shows drift since attempt)
            float liveVolRatio = volBaseline > 0 ? volume / volBaseline : 0
            bool brokeOutLate = (sessionBreakoutsUp > 0 or sessionBreakoutsDown > 0) and not (everHadBreakUp or everHadBreakDown)
            if dashMode == "Full"
                row := renderFilterStatus(dashTable, row, txtSize, txtColor, enableGapFilter, gapFilterPassed, gapPercent, maxGapPercent, enableORBRangeFilter, orbRangeFilterPassed, orbRangePercent, minORBRangePercent, maxORBRangePercent, priceCrossedUp, priceCrossedDown, enableVolumeFilter, dispVolOK, dispVolRatio, volumeMultiplier, strongVolumeMultiplier, enableTrendFilter, dispTrendAligned, dispTrendLbl, enableHTF and blockCounterTrend, dispHTFAligned, dispHTFLbl, enableIndexFilter, dispIdxAligned, dispIdxLbl, liveVolRatio, liveTrendLbl, cachedHTFBiasText, cachedIndexBiasText, brokeOutLate, entryCutoffHour, entryCutoffMinute, filterMode)
            // Retest status (not shown for trade-taken)
            if enableRetestEntry and not hasTrade
                string retestSt = awaitingRetestLong ? (consolidationCountLong > 0 ? "Long (" + str.tostring(consolidationCountLong) + "/" + str.tostring(consolidationBars) + ")" : "Waiting Long") : awaitingRetestShort ? (consolidationCountShort > 0 ? "Short (" + str.tostring(consolidationCountShort) + "/" + str.tostring(consolidationBars) + ")" : "Waiting Short") : "Ready"
                string retestIc = awaitingRetestLong ? (consolidationCountLong > 0 ? "🔄" : "⏳") : awaitingRetestShort ? (consolidationCountShort > 0 ? "🔄" : "⏳") : "✅"
                table.cell(dashTable, 0, row, "Retest:", text_color=txtColor, text_size=txtSize, text_halign=text.align_left)
                table.cell(dashTable, 1, row, retestIc + " " + retestSt, text_color=txtColor, text_size=txtSize, text_halign=text.align_right)
                row += 1

        if godModeEnabled
            row := renderGodRow(dashTable, row, txtSize, txtColor, godChopDay, godFailedBreaks)

        /// Key-level section — the objective picture from the volume-profile model.
        /// Rows are rendered by renderKeyLevels(); hover any row label for what it means.
        if enableKeyLevels
            row := renderKeyLevels(dashTable, row, txtSize, txtColor, klSessionVF, klAutoProfile, klVAH, klPOC, klVAL, klAuction, klOpenPos, klIBPct, klIBAdrPct, klIBType, klPDH, klPDL, klIBH, klIBL, klADR, klDayHigh, klDayLow, klHeadroom, cachedATR, atrMultiplier, klDir != 0 ? klDir : klLastDir, klDir != 0 ? klSetupCode : klLastCode, klDir != 0 ? klScore : klLastScore, klScoreThreshold, klDir != 0 ? klConfCnt : klLastConf, klDir != 0 ? klConfNames : klLastConfN, enableKeyLevelExecution, klHTFOK, klDir != 0, klLastTime, dashMode == "Full", klOpenTypeS, klDayTypeS, klBiasS)

        /// Trade info section (only if ENTRY occurred AND targets enabled)
        /// Position sizing remains visible even after trade closes (SL/TP hit)
        if enableTargets and not na(orbEntryBar)

            table.cell(dashTable, 0, row, "", text_color=txtColor, text_size=size.tiny)
            table.cell(dashTable, 1, row, "", text_color=txtColor, text_size=size.tiny)
            table.cell_set_height(dashTable, 0, row, 0.1)
            table.cell_set_height(dashTable, 1, row, 0.1)
            row += 1

            isBullish := orbTradeDirection == 1
            entry := orbEntryPrice
            sl := orbSLPrice
            tp1 := orbTP1Price
            tp1_5 := orbTP1_5Price
            tp2 := orbTP2Price
            tp3 := orbTP3Price
            atr := cachedATR

            if enablePosSizing
                float displayShares = maxShares
                float displayPosValue = positionValue
                float displayRiskAmount = maxLoss

                if na(maxShares) or na(positionValue) or na(maxLoss)
                    // Show error state
                    table.cell(dashTable, 0, row, "⚠️ Position Error:", text_color=txtColor, text_size=txtSize, text_halign=text.align_left, tooltip="Position size calculation failed. Check Entry/SL values.")
                    table.cell(dashTable, 1, row, "Invalid Data", text_color=color.new(color.red, 0), text_size=txtSize, text_halign=text.align_right)
                    row += 1
                else

                    string tradeDir = isBullish ? "LONG" : "SHORT"
                    color tradeDirColor = isBullish ? color.green : color.red
                    table.cell(dashTable, 0, row, "Position Size:", text_color=txtColor, text_size=txtSize, text_halign=text.align_center, bgcolor=headerColor)
                    table.cell(dashTable, 1, row, tradeDir, text_color=tradeDirColor, text_size=txtSize, text_halign=text.align_right, bgcolor=headerColor)
                    row += 1

                    string currencySymbol = "₹"

                    sharesTooltip = "Maximum Position Size (INR)" + "\n\nNumber of shares you can buy while staying within your risk limits.\n\nCALCULATED BY:\nRisk Amount ÷ Distance to Stop Loss\n\nEXAMPLE:\n• Risk: " + currencySymbol + "150\n• Entry: " + currencySymbol + "10.00\n• Stop: " + currencySymbol + "9.50 (50¢ distance)\n• Max Shares: 300 shares (" + currencySymbol + "150 ÷ " + currencySymbol + "0.50)\n• Position Value: " + currencySymbol + "3,000\n\nThis ensures consistent risk management across all trades.\n\n⚠️ FIXED at breakout - does not change with price!"
                    table.cell(dashTable, 0, row, "Max Shares:", text_color=txtColor, text_size=txtSize, text_halign=text.align_left, tooltip=sharesTooltip)
                    string sharesText = na(displayShares) ? "N/A" : str.tostring(displayShares, "#")
                    float displayPosValueInAcctCurr = na(displayPosValue) ? na : displayPosValue
                    string posValueText = na(displayPosValueInAcctCurr) ? "N/A" : str.tostring(displayPosValueInAcctCurr, "#,###")
                    table.cell(dashTable, 1, row, sharesText + " (" + currencySymbol + posValueText + ")", text_color=txtColor, text_size=txtSize, text_halign=text.align_right)
                    row += 1

                    // Risk amount
                    riskPctOfAcct := (displayRiskAmount / accountSize) * 100
                    riskTooltip = "Risk Amount (INR)" + "\n\nTotal amount you'll lose if stop loss is hit.\n\nSHOWS:\n• " + "INR" + " amount at risk\n• Percentage of total account\n\nRECOMMENDED RISK LEVELS:\n• 0.5-1% of account (conservative)\n• 1-2% of account (balanced)\n• 2-3% of account (aggressive)\n\nNEVER risk more than 3% on a single trade.\n\nThis is your MAXIMUM LOSS - stick to it!\n\n⚠️ FIXED at breakout - does not change!"
                    table.cell(dashTable, 0, row, "Risk:", text_color=txtColor, text_size=txtSize, text_halign=text.align_left, tooltip=riskTooltip)
                    table.cell(dashTable, 1, row, str.format("{0}{1} ({2}%)", currencySymbol, str.tostring(displayRiskAmount, "#"), str.tostring(riskPctOfAcct, "#.#")), text_color=color.new(color.orange, 0), text_size=txtSize, text_halign=text.align_right)
                    row += 1

                    // Reward amount (based on TP1 = execution target, matches telegram)
                    float rewardTP = showTP1 ? tp1 : na
                    if not na(rewardTP) and not na(entry) and displayShares > 0
                        float rewardPerShare = math.abs(rewardTP - entry)
                        float rewardAmount = displayShares * rewardPerShare
                        float rewardInAcctCurr = rewardAmount
                        float rewardPctOfAcct = (rewardAmount / accountSize) * 100
                        string tpLabel = "TP1"
                        string rewardTooltip = "Potential Reward (INR)" + "\n\nProfit if highest target (" + tpLabel + ") is hit.\n\nCALCULATED BY:\nShares x Distance to " + tpLabel + "\n\nThis is your POTENTIAL GAIN at " + tpLabel + "."
                        table.cell(dashTable, 0, row, "Reward:", text_color=txtColor, text_size=txtSize, text_halign=text.align_left, tooltip=rewardTooltip)
                        table.cell(dashTable, 1, row, str.format("{0}{1} ({2}%)", currencySymbol, str.tostring(rewardInAcctCurr, "#"), str.tostring(rewardPctOfAcct, "#.#")), text_color=color.new(color.green, 0), text_size=txtSize, text_halign=text.align_right)
                        row += 1

                    // Blank row after position size
                    table.cell(dashTable, 0, row, "", text_color=txtColor, text_size=size.tiny, height=0.5)
                    table.cell(dashTable, 1, row, "", text_color=txtColor, text_size=size.tiny, height=0.5)
                    row += 1

            // Entry - with validation
            bool validTrade = not na(entry) and not na(sl) and entry > 0 and sl > 0

            if validTrade
                entryTooltip = "Entry Price\n\nYour suggested entry point for the trade.\n\nFOR LONG: ORB High level (where breakout occurred)\nFOR SHORT: ORB Low level (where breakdown occurred)\n\nThis is where you would buy/sell to enter the position.\n\nNOTE: Market entry may differ slightly due to slippage."
                table.cell(dashTable, 0, row, "Entry:", text_color=txtColor, text_size=txtSize, text_halign=text.align_left, tooltip=entryTooltip)
                table.cell(dashTable, 1, row, str.format("{0}", str.tostring(entry, "#.##")), text_color=txtColor, text_size=txtSize, text_halign=text.align_right)
                row += 1
            else
                table.cell(dashTable, 0, row, "⚠️ Trade Data:", text_color=txtColor, text_size=txtSize, text_halign=text.align_left)
                table.cell(dashTable, 1, row, "Calculating...", text_color=color.new(color.orange, 0), text_size=txtSize, text_halign=text.align_right)
                row += 1

            // Stop Loss
            slDist = math.abs(entry - sl)
            slPct = (slDist / entry) * 100
            stopTooltip = "Stop Loss\n\nYour exit price if trade goes against you. Limits maximum loss per trade.\n\nCALCULATED BY: " + stopMode + " method\n\nDISTANCE: Shows $ distance and % from entry\n\nIMPORTANT: Always use a stop loss to protect your capital. Never hold a losing position hoping it will recover."
            table.cell(dashTable, 0, row, "Stop:", text_color=txtColor, text_size=txtSize, text_halign=text.align_left, tooltip=stopTooltip)
            table.cell(dashTable, 1, row, str.format("{0} ({1}%)", str.tostring(sl, "#.##"), str.tostring(slPct, "#.#")), text_color=txtColor, text_size=txtSize, text_halign=text.align_right)
            row += 1

            // Targets (only enabled ones)
            if showTP1
                tp1Dist = math.abs(tp1 - entry)
                tp1Pct = (tp1Dist / entry) * 100
                tp1Label = orbTP1Hit ? "✅ TP1:" : "TP1:"
                tp1Tooltip = "Take Profit 1 (1R)\n\nFirst profit target at 1× Risk distance.\n\n1R = Risk/Reward ratio of 1:1\n\nIf you risk $100, TP1 gives you $100 profit.\n\nSTRATEGY:\n• Conservative: Exit full position at TP1\n• Balanced: Take 50% profit, hold rest for TP2\n• Aggressive: Hold through for higher targets\n\n✅ = Target hit"
                table.cell(dashTable, 0, row, tp1Label, text_color=txtColor, text_size=txtSize, text_halign=text.align_left, tooltip=tp1Tooltip)
                table.cell(dashTable, 1, row, str.format("{0} (+{1}%)", str.tostring(tp1, "#.##"), str.tostring(tp1Pct, "#.#")), text_color=txtColor, text_size=txtSize, text_halign=text.align_right)
                row += 1

            if showTP1_5
                tp1_5Dist = math.abs(tp1_5 - entry)
                tp1_5Pct = (tp1_5Dist / entry) * 100
                tp1_5Label = orbTP1_5Hit ? "✅ TP1.5:" : "TP1.5:"
                tp1_5Tooltip = "Take Profit 1.5 (1.5R)\n\nIntermediate target at 1.5× Risk distance.\n\n1.5R = Risk/Reward ratio of 1:1.5\n\nIf you risk $100, TP1.5 gives you $150 profit.\n\nUSEFUL FOR:\n• Scaling out of positions gradually\n• Capturing middle-ground profits\n• Adjusting to market volatility\n\n✅ = Target hit"
                table.cell(dashTable, 0, row, tp1_5Label, text_color=txtColor, text_size=txtSize, text_halign=text.align_left, tooltip=tp1_5Tooltip)
                table.cell(dashTable, 1, row, str.format("{0} (+{1}%)", str.tostring(tp1_5, "#.##"), str.tostring(tp1_5Pct, "#.#")), text_color=txtColor, text_size=txtSize, text_halign=text.align_right)
                row += 1

            if showTP2
                tp2Dist = math.abs(tp2 - entry)
                tp2Pct = (tp2Dist / entry) * 100
                tp2Label = orbTP2Hit ? "✅ TP2:" : "TP2:"
                tp2Tooltip = "Take Profit 2 (2R)\n\nMain profit target at 2× Risk distance.\n\n2R = Risk/Reward ratio of 1:2\n\nIf you risk $100, TP2 gives you $200 profit.\n\nThis is the STANDARD target for most ORB traders.\n\nSTRATEGY:\n• Exit remaining position at TP2\n• Move stop to breakeven after TP1 hit\n• Let runners go to TP3 if strong momentum\n\n✅ = Target hit"
                table.cell(dashTable, 0, row, tp2Label, text_color=txtColor, text_size=txtSize, text_halign=text.align_left, tooltip=tp2Tooltip)
                table.cell(dashTable, 1, row, str.format("{0} (+{1}%)", str.tostring(tp2, "#.##"), str.tostring(tp2Pct, "#.#")), text_color=txtColor, text_size=txtSize, text_halign=text.align_right)
                row += 1

            if showTP3
                tp3Dist = math.abs(tp3 - entry)
                tp3Pct = (tp3Dist / entry) * 100
                tp3Label = orbTP3Hit ? "✅ TP3:" : "TP3:"
                tp3Tooltip = "Take Profit 3 (3R)\n\nExtended profit target at 3× Risk distance.\n\n3R = Risk/Reward ratio of 1:3\n\nIf you risk $100, TP3 gives you $300 profit.\n\nONLY FOR:\n• Strong trending days\n• High momentum breakouts\n• Extended runners\n\nMOST TRADES won't reach TP3.\n\nSTRATEGY: Trail stop or use for 'lottery tickets'\n\n✅ = Target hit"
                table.cell(dashTable, 0, row, tp3Label, text_color=txtColor, text_size=txtSize, text_halign=text.align_left, tooltip=tp3Tooltip)
                table.cell(dashTable, 1, row, str.format("{0} (+{1}%)", str.tostring(tp3, "#.##"), str.tostring(tp3Pct, "#.#")), text_color=txtColor, text_size=txtSize, text_halign=text.align_right)
                row += 1

            // Risk/Reward - Smart logic with caching
            if showRisk
                riskDist = math.abs(entry - sl)

                // Determine if adaptive R:R extends to TP2
                bool adaptiveExtended = enableAdaptiveRR and isTrendingMarket and showTP1

                // R:R always based on TP1 (execution target) to match telegram signal
                float rrTarget = tp1
                bool anyHit = orbTP3Hit or orbTP2Hit or orbTP1_5Hit or orbTP1Hit

                rewardDist = math.abs(rrTarget - entry)
                rrRatio = riskDist > 0 ? rewardDist / riskDist : 0
                rrStatus = anyHit ? "✅" : rrRatio >= 2.0 ? "⭐" : rrRatio >= 1.5 ? "⚠️" : "❌"

                // Show adaptive indicator if enabled
                string adaptiveLabel = enableAdaptiveRR ? (adaptiveExtended ? " [A:2R]" : " [A:1R]") : ""

                table.cell(dashTable, 0, row, "R/R Ratio:", text_color=txtColor, text_size=txtSize, text_halign=text.align_left)
                table.cell(dashTable, 1, row, str.format("1:{0} {1}{2}", str.tostring(rrRatio, "#.#"), rrStatus, adaptiveLabel), text_color=txtColor, text_size=txtSize, text_halign=text.align_right)
                row += 1

            // Show ADX/Trend status when Adaptive R:R is enabled
            if enableAdaptiveRR
                string adxStatus = isTrendingMarket ? "TREND" : "RANGE"
                color adxColor = isTrendingMarket ? color.green : color.orange
                string adxTooltip = "Adaptive R:R Status\n\nADX measures trend strength:\n• TREND (ADX > " + str.tostring(adxThreshold) + "): Using TP2 (1:2)\n• RANGE (ADX < " + str.tostring(adxThreshold) + "): Using TP1 (1:1)\n\nCurrent ADX: " + str.tostring(cachedADX, "#.#")

                table.cell(dashTable, 0, row, "Market:", text_color=txtColor, text_size=txtSize, text_halign=text.align_left, tooltip=adxTooltip)
                table.cell(dashTable, 1, row, adxStatus + " (ADX:" + str.tostring(cachedADX, "#") + ")", text_color=adxColor, text_size=txtSize, text_halign=text.align_right)
                row += 1

        // Show last trade result when trade closed
        if enableTargets and (everHadBreakUp or everHadBreakDown) and trade_closed and last_trade_result != ""
            table.cell(dashTable, 0, row, "", text_color=txtColor, text_size=size.tiny)
            table.cell(dashTable, 1, row, "", text_color=txtColor, text_size=size.tiny)
            table.cell_set_height(dashTable, 0, row, 0.1)
            table.cell_set_height(dashTable, 1, row, 0.1)
            row += 1

            // Last trade result
            string lastTradeTooltip = "Last Trade Result\n\nShows the outcome of the most recent trade.\n\n✅ = Target hit (profit)\n❌ = Stop loss hit (loss)\n\nR = Risk/Reward ratio\n+2R means you made 2x your risk\n-1R means you lost your risk amount"
            if not na(dashTable)
                table.clear(dashTable, 0, row, 1, row)

            table.cell(dashTable, 0, row, "Last Trade:", text_color=txtColor, text_size=txtSize, text_halign=text.align_left, tooltip=lastTradeTooltip)
            table.cell(dashTable, 1, row, last_trade_result, text_color=txtColor, text_size=txtSize, text_halign=text.align_right)
            row += 1

    else if not na(dashTable)

        // Clear first: this branch runs on bars where the full dashboard did NOT redraw,
        // so without it the two closed-market rows print on top of the previous full
        // panel and the header appears twice.
        table.clear(dashTable, 0, 0, 1, 53)

        bool isDarkTheme = dashTheme == "Dark"
        color bgColor = isDarkTheme ? color.new(color.black, 0) : color.new(color.white, 10)
        color txtColor = isDarkTheme ? color.white : color.black
        color headerColor = isDarkTheme ? color.new(color.aqua, 30) : color.new(color.silver, 30)

        string headerTitle = sessionIcon + " DASHBOARD"
        string headerTooltip = "Dashboard\n\n" + sessionStatusText + "\n\nMarket is currently closed.\n\nDisplay hours: 04:00-20:00\nCurrent time is outside this window.\n\nThe indicator will resume when the next session begins."

        table.cell(dashTable, 0, row, headerTitle, text_color=txtColor, text_size=txtSize, text_halign=text.align_center, bgcolor=headerColor, tooltip=headerTooltip)
        table.cell(dashTable, 1, row, "", bgcolor=headerColor)
        table.merge_cells(dashTable, 0, row, 1, row)
        row += 1

        // NOT IN SESSION message
        string notInSessionMsg = sessionStatusText
        string notInSessionTooltip = sessionStatusText == "PRE-MARKET - Waiting for ORB" ? "Pre-Market Session\n\n📍 Trading day has started\n⏰ ORB will begin building at 09:30\n\nCurrent status:\n• Pre-market trading active (04:00-09:30)\n• Regular session starts at 09:30\n• ORB periods will track first 5, 15, 30, 60 minutes\n\nThe dashboard will show full data once ORB begins." : "Market Closed\n\nCurrent time is outside display hours (04:00-20:00).\n\nORB tracking will resume at next session open.\n\nTo see data from the last session, scroll back to regular or extended trading hours on the chart."
        table.cell(dashTable, 0, row, notInSessionMsg, text_color=txtColor, text_size=txtSize, text_halign=text.align_center, bgcolor=color.new(color.gray, 90), tooltip=notInSessionTooltip)
        table.cell(dashTable, 1, row, "", bgcolor=color.new(color.gray, 90))
        table.merge_cells(dashTable, 0, row, 1, row)
        row += 1

    // SESSION STATISTICS ROW (Always visible when there are trades)
    if session_trades > 0 and showFullDashboard and not na(dashTable)
        float winRate = (session_wins / session_trades) * 100

        string statsText = str.format("Stats: {0}✅ | {1}❌ | {2}R | WR: {3}%",
                                      str.tostring(session_wins),
                                      str.tostring(session_losses),
                                      str.tostring(session_total_rr, "#.#"),
                                      str.tostring(winRate, "#"))

        // Build detailed tooltip
        string statsTooltip = "══════════════════════════════\n"
        statsTooltip += "📊 SESSION STATISTICS - Detailed View\n"
        statsTooltip += "══════════════════════════════\n\n"
        statsTooltip += "TRADES TODAY: " + str.tostring(session_trades) + "\n"
        statsTooltip += "├─ ✅ Wins: " + str.tostring(session_wins) + " (" + str.tostring(winRate, "#.#") + "%)\n"
        statsTooltip += "├─ ❌ Losses: " + str.tostring(session_losses) + " (" + str.tostring(100 - winRate, "#.#") + "%)\n"
        statsTooltip += "└─ ⚖️ Win Rate: " + str.tostring(winRate, "#.#") + "%\n\n"
        statsTooltip += "══════════════════════════════\n"
        statsTooltip += "R PERFORMANCE:\n"
        statsTooltip += "├─ 💰 Total R: " + str.tostring(session_total_rr, "#.##") + "R\n"

        if session_wins > 0
            float avgWin = session_total_rr > 0 ? (session_total_rr + session_losses) / session_wins : 0.0
            if avgWin > 0
                statsTooltip += "├─ 📈 Avg Win: " + str.tostring(avgWin, "#.##") + "R\n"

        if session_losses > 0
            float avgLoss = -1.0
            statsTooltip += "├─ 📉 Avg Loss: " + str.tostring(avgLoss, "#.##") + "R\n"

        statsTooltip += "├─ 🏆 Best Trade: " + str.tostring(session_best_r, "#.##") + "R\n"

        if session_worst_r < 0
            statsTooltip += "└─ 💀 Worst Trade: " + str.tostring(session_worst_r, "#.##") + "R\n"

        statsTooltip += "\══════════════════════════════\n"
        statsTooltip += "💡 TIP: Target 2:1 R/R minimum\n"

        if session_total_rr > 0
            statsTooltip += "    Current session: PROFITABLE ⭐\n"
        else if session_total_rr == 0
            statsTooltip += "    Current session: BREAKEVEN ⚖️\n"
        else
            statsTooltip += "    Current session: NEGATIVE ⚠️\n"

        // Display the stats row (merged across both columns)
        color statsRowColor = session_total_rr > 0 ? color.new(color.green, 92) : session_total_rr < 0 ? color.new(color.red, 92) : color.new(color.gray, 92)

        table.cell(dashTable, 0, row, statsText,
                   text_color=color.new(color.white, 0),
                   text_size=txtSize,
                   text_halign=text.align_center,
                   bgcolor=statsRowColor,
                   tooltip=statsTooltip)
        table.cell(dashTable, 1, row, "", bgcolor=statsRowColor)
        table.merge_cells(dashTable, 0, row, 1, row)
        row += 1


// ================================ KEY-LEVEL ENGINE: VISUALS =======================================
// Every key level carries its price as an on-chart tag, so nothing has to be read off the
// price scale. The ORB plots are display.pane for the same reason — their old price-scale
// badges ("intraday-orb:ORB15 High") obstructed the panel.
// Palette for dark backgrounds: VAH light green · POC purple (thicker, the magnet) ·
// VAL red · IB yellow · PDH/PDL gray (context, not triggers) · ORB its own orange.

klClearLines(line[] arr) =>
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            line.delete(array.get(arr, i))
        array.clear(arr)

klClearTags(label[] arr) =>
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            label.delete(array.get(arr, i))
        array.clear(arr)

klClearBoxes(box[] arr) =>
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            box.delete(array.get(arr, i))
        array.clear(arr)

// One level: optional dotted line + a price tag. Two anti-collision rules:
//  1. tags start right of LABEL_OFFSET_BARS so they clear the ORB edge labels.
//  2. `taken` holds prices already tagged this pass; a tag inside the collision band is
//     pushed another step right until clear, and its line extends to meet it.
// drawLine=false tags a level whose line is already drawn elsewhere (the ORB plots).
klDrawLevel(line[] larr, label[] tarr, float[] taken, float price, string name, color c, int x1, int xBase, int w, bool drawLine, bool tagsIn, float band, float maxDist) =>
    if not na(price)
        // Distant levels keep their line but drop their tag — they are context, not a
        // decision, and nine tags stacked at the right edge is unreadable.
        bool tags = tagsIn and (maxDist <= 0 or math.abs(price - close) <= maxDist)
        int slot = 0
        if tags and array.size(taken) > 0
            for i = 0 to array.size(taken) - 1
                if math.abs(price - array.get(taken, i)) <= band
                    slot += 1
        int xTag = xBase + slot * KL_TAG_STEP_BARS
        if drawLine
            array.push(larr, line.new(x1, price, tags ? xTag : xBase, price, xloc=xloc.bar_index, color=c, style=line.style_dotted, width=w))
        if tags
            array.push(tarr, label.new(xTag, price, name + " " + str.tostring(price, format.mintick), style=label.style_none, textcolor=c, size=size.small))
            array.push(taken, price)

// Redrawn on the last bar only, clearing first — keeps line/label usage flat so the
// existing 500/500/300 caps still hold.
klDrawLevels(bool en, bool showVA, bool showSec, bool tags, float vah, float poc, float val, float pdh, float pdl, float ibh, float ibl, int dayStart, float atrVal, ORBData orb, bool showMid, float tagMaxATR) =>
    var line[]  lvlLines = array.new<line>()
    var label[] lvlTags  = array.new<label>()
    var box[]   vaBoxes  = array.new<box>()
    var float[] taken    = array.new_float()
    color cVAH = #90EE90
    color cPOC = #BA68C8
    color cVAL = #EF5350
    color cPD  = #9E9E9E
    color cIB  = #FFEB3B
    if en and barstate.islast
        klClearLines(lvlLines)
        klClearTags(lvlTags)
        klClearBoxes(vaBoxes)
        array.clear(taken)
        int x1 = na(dayStart) ? bar_index - 30 : dayStart
        int xBase = bar_index + KL_TAG_OFFSET_BARS
        // Collision band scaled by ATR so it adapts to the symbol and the vertical zoom.
        float band = nz(atrVal) * 0.35
        float maxDist = tagMaxATR <= 0 ? 0.0 : nz(atrVal) * tagMaxATR
        // ORB first: its levels are the strategy's primary reference, so they claim the
        // innermost tag slots. Lines come from the plot() series, so tag only.
        if not na(orb)
            color cORB = orb.orbColor
            klDrawLevel(lvlLines, lvlTags, taken, orb.high, "ORB-H", cORB, x1, xBase, 1, false, tags, band, maxDist)
            if showMid
                klDrawLevel(lvlLines, lvlTags, taken, orb.mid, "ORB-M", cORB, x1, xBase, 1, false, tags, band, maxDist)
            klDrawLevel(lvlLines, lvlTags, taken, orb.low, "ORB-L", cORB, x1, xBase, 1, false, tags, band, maxDist)
        if showVA
            if not na(vah) and not na(val)
                array.push(vaBoxes, box.new(x1, vah, bar_index + 2, val, xloc=xloc.bar_index, border_width=0, bgcolor=color.new(#90EE90, 94)))
            klDrawLevel(lvlLines, lvlTags, taken, poc, "POC", cPOC, x1, xBase, 2, true, tags, band, maxDist)
            klDrawLevel(lvlLines, lvlTags, taken, vah, "VAH", cVAH, x1, xBase, 1, true, tags, band, maxDist)
            klDrawLevel(lvlLines, lvlTags, taken, val, "VAL", cVAL, x1, xBase, 1, true, tags, band, maxDist)
        if showSec
            klDrawLevel(lvlLines, lvlTags, taken, ibh, "IB-H", cIB, x1, xBase, 1, true, tags, band, maxDist)
            // IB mid derived here rather than carried through the tuple — it is display-only.
            if showMid and not na(ibh) and not na(ibl)
                klDrawLevel(lvlLines, lvlTags, taken, (ibh + ibl) / 2, "IB-M", cIB, x1, xBase, 1, true, tags, band, maxDist)
            klDrawLevel(lvlLines, lvlTags, taken, ibl, "IB-L", cIB, x1, xBase, 1, true, tags, band, maxDist)
            klDrawLevel(lvlLines, lvlTags, taken, pdh, "PDH", cPD, x1, xBase, 1, true, tags, band, maxDist)
            klDrawLevel(lvlLines, lvlTags, taken, pdl, "PDL", cPD, x1, xBase, 1, true, tags, band, maxDist)

// Breakout marker: a triangle carrying the FULL detail as a hover tooltip, plus a very
// short code beside it. Label-based rather than plotshape() because plotshape cannot take
// a tooltip and its `text` argument must be a compile-time constant, so it could never
// name the setup that actually fired. The triangle always prints; the code text is
// throttled to one per KL_LABEL_MIN_GAP bars, otherwise clustered setups (PDH-RT,
// VAH-ACC, PDH-RT on consecutive bars) print three overlapping strings.
klDrawSignal(bool isLong, bool isShort, string code, int score, int threshold, float rvol, int confCnt, string confNames, float lvl, float slLvl, float t1, float clv, float atrVal, float vf, float entryRef, float rvolStrong, float rvolMin, float headroom) =>
    var int lastTextBar = na
    if isLong or isShort
        color c = isLong ? #26A69A : #EF5350
        float yOff = nz(atrVal) * 0.35
        float yTri = isLong ? low - yOff : high + yOff
        // Plain-language, labelled columns. The old one-line form used bare abbreviations
        // ("d-proxy", "CLV") that meant nothing without reading the source.
        string volWord = na(vf) ? "n/a" : vf >= 3.0 ? "EXTREME - check news" : vf >= 1.5 ? "strong" : vf >= 1.2 ? "elevated" : vf >= 0.8 ? "normal" : vf >= 0.5 ? "thin" : "dead"
        string brkWord = rvol >= rvolStrong ? "strong" : rvol >= rvolMin ? "adequate" : "WEAK - below threshold"
        string clvWord = clv >= 0.65 ? "closed strong into the break" : clv <= 0.35 ? "closed weak against it" : "closed mid-bar, indecisive"
        float riskPts = na(slLvl) or na(entryRef) ? na : math.abs(entryRef - slLvl)
        string tip = (isLong ? "LONG" : "SHORT") + "  |  " + klSetupPhrase(code) + "\n" + (score >= threshold ? "Score " + str.tostring(score) + "/" + str.tostring(threshold) + "  - fires" : "Score " + str.tostring(score) + "/" + str.tostring(threshold) + "  - below threshold") + "\n\n" + "LEVEL       " + str.tostring(lvl, format.mintick) + "\n" + "STACKED     " + (confCnt > 0 ? str.tostring(confCnt) + " more: " + confNames : "none - single level") + "\n\n" + "Entry ref   " + str.tostring(entryRef, format.mintick) + "\n" + "Stop ref    " + str.tostring(slLvl, format.mintick) + (na(riskPts) ? "" : "   (risk " + str.tostring(riskPts, format.mintick) + ")") + "\n" + "Target 1    " + (na(t1) ? "none - no room to the next level" : str.tostring(t1, format.mintick)) + "\n" + "Room left   " + (na(headroom) ? "-" : str.tostring(headroom, "0.0") + "R to a normal day's extension") + "\n\n" + "VOLUME\n" + "  Session   " + (na(vf) ? "-" : str.tostring(vf, "0.00") + "x") + "  " + volWord + "\n" + "  This bar  " + str.tostring(rvol, "0.0") + "x  " + brkWord + "\n" + "  Bar close " + str.tostring(clv, "0.00") + "  " + clvWord
        cleanupLabel(label.new(bar_index, yTri, "", style=isLong ? label.style_triangleup : label.style_triangledown, color=c, size=size.tiny, tooltip=tip))
        // Text label carries no tooltip of its own — the triangle is the hover target.
        if na(lastTextBar) or (bar_index - lastTextBar >= KL_LABEL_MIN_GAP)
            lastTextBar := bar_index
            cleanupLabel(label.new(bar_index, isLong ? low - yOff * 3 : high + yOff * 3, code + (na(vf) ? "" : "  " + str.tostring(vf, "0.0") + "x"), style=label.style_none, textcolor=c, size=size.tiny))

klDrawLevels(enableKeyLevels, klShowVA, klShowSecondary, klShowTags, klVAH, klPOC, klVAL, klPDH, klPDL, klIBH, klIBL, klDayStartBar, cachedATR, activeORB, showMidLine, klTagMaxATR)

// Gated on a CHANGE of setup so a level that stays broken for ten bars does not stack ten
// identical markers.
bool klNewSetup = klDir != 0 and (klSetupCode != klSetupCode[1] or klDir != klDir[1])
bool klSigLong  = klShowSignals and klFire and klNewSetup and klDir == 1
bool klSigShort = klShowSignals and klFire and klNewSetup and klDir == -1
klDrawSignal(klSigLong, klSigShort, klSetupCode, klScore, klScoreThreshold, klRVOL, klConfCnt, klConfNames, klSetupLevel, klSLLevel, klT1, klCLV, cachedATR, klSessionVF, klEntryRef, strongVolumeMultiplier, volumeMultiplier, klHeadroom)
// ====================================== TRADE ALERTS ==========================================
alertcondition(alertEntryTriggered and enableAlerts and enableTargets,
               title="ENTRY Triggered",
               message="{{ticker}} - ENTRY @ {{close}} | Trade setup activated")

alertcondition(alertSLTriggered and enableAlerts and enableTargets,
               title="STOP LOSS Hit",
               message="{{ticker}} - STOP LOSS HIT @ {{close}} | Trade closed with loss")

alertcondition(alertTP1Triggered and enableAlerts and enableTargets and showTP1,
               title="TP1 Hit (1R)",
               message="{{ticker}} - TP1 HIT @ {{close}} | 1R profit target reached")

alertcondition(alertTP2Triggered and enableAlerts and enableTargets and showTP2,
               title="TP2 Hit (2R)",
               message="{{ticker}} - TP2 HIT @ {{close}} | 2R profit target reached")

// ═════════════════════════════════════════════════════════════════════════════
// TEST ALERTS SECTION
// ═════════════════════════════════════════════════════════════════════════════
// TEST ALERTS SECTION
// ═════════════════════════════════════════════════════════════════════════════
// IMPORTANT: TradingView only fires webhook alerts on REAL-TIME bars.
// During non-market hours, webhooks will NOT fire (TradingView limitation).
//
// TO TEST ALERTS:
// Option 1: Test during market hours (alerts will fire normally)
// Option 2: Use a 24/7 symbol like BTCUSD (crypto) to test anytime
// Option 3: Use the alertcondition below with "Once Per Bar Close" trigger
//
// SETUP:
// 1. Create TradingView alert: Condition = "Any alert() function call"
// 2. Set webhook URL: https://api.telegram.org/bot<YOUR_TOKEN>/sendMessage
// 3. Enable "Send Test Alert" in indicator settings
// ═════════════════════════════════════════════════════════════════════════════

var bool testAlertSent = false
var string lastTestAlertType = ""
var bool testAlertTriggered = false

// Reset when test alert type changes
if testAlertType != lastTestAlertType
    testAlertSent := false
    lastTestAlertType := testAlertType

// Determine if test alert should fire
testAlertTriggered := sendTestAlert and barstate.islast and not testAlertSent

// Fire test alert
if testAlertTriggered
    testStock = syminfo.ticker
    testChartLink = "https://www.tradingview.com/chart/?symbol=" + syminfo.tickerid + "&interval=" + timeframe.period
    string currentTime = str.tostring(hour) + ":" + str.format("{0,number,00}", minute)

    // Test Entry Alert
    if testAlertType == "Entry" or testAlertType == "Both"
        testEntry = close
        testSL = close * 0.98
        testTP = close * 1.02

        testAlertMessage = '{"chat_id": "' + telegram_chat_id + '", "text": "TEST ORB Entry Alert\\nMode: Intraday\\nSymbol: ' + testStock + '\\nEntry: ' + str.tostring(testEntry, format.mintick) + '\\nStop Loss: ' + str.tostring(testSL, format.mintick) + '\\nTarget: ' + str.tostring(testTP, format.mintick) + '\\nTime: ' + currentTime + ' IST\\n\\nThis is a TEST alert\\nChart: ' + testChartLink + '", "parse_mode": "Markdown"}'
        alert(testAlertMessage, alert.freq_all)

    // Test Exit Alert
    if testAlertType == "Exit" or testAlertType == "Both"
        testExitPrice = close
        testPnL = 125.50

        testAlertMessage = '{"chat_id": "' + telegram_chat_id + '", "text": "TEST ORB Exit Alert\\nMode: Intraday\\nSymbol: ' + testStock + '\\nTarget Hit\\nExit Price: ' + str.tostring(testExitPrice, format.mintick) + '\\nP&L: ' + str.tostring(testPnL, "#.##") + '\\nTime: ' + currentTime + ' IST\\n\\nThis is a TEST alert\\nChart: ' + testChartLink + '", "parse_mode": "Markdown"}'
        alert(testAlertMessage, alert.freq_all)

    testAlertSent := true

// Visual indicator: Show label when test alert is armed (helps debug during non-market hours)
if sendTestAlert and barstate.islast
    testStatusText = testAlertSent ? "Test Alert Sent (check Telegram)" : "Test Alert Armed - Waiting..."
    testStatusColor = testAlertSent ? color.green : color.orange
    var label testLabel = na
    if not na(testLabel)
        label.delete(testLabel)
    testLabel := label.new(bar_index, high * 1.001, testStatusText, style=label.style_label_down, color=testStatusColor, textcolor=color.white, size=size.small)

// Alertcondition for test - can be used to create a separate alert
alertcondition(testAlertTriggered, title="TEST Alert Triggered", message="Test alert triggered - check webhook")

