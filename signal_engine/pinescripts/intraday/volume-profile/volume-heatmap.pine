//@version=5
indicator("Volcano Heatmap Volume v2", overlay=false)

// ─── INPUTS ───────────────────────────────────────────────────────────────────
int   lookbackDays = input.int(20, "Lookback (sessions)", minval=5, maxval=60,
      tooltip="Number of prior sessions used to build the same-time-of-day average")
float t1 = input.float(1.5, "Threshold 1 (Gold)",   step=0.1)
float t2 = input.float(2.0, "Threshold 2 (Orange)", step=0.1)
float t3 = input.float(2.5, "Threshold 3 (Red)",    step=0.1)
bool  normalizeRvol = input.bool(true, "Normalize to RVOL",
      tooltip="Plot volume/MA ratio instead of raw volume. Keeps Gold/Orange bars visible in multi-pane layouts regardless of occasional extreme spikes.")

// ─── SESSION-AWARE RVOL ───────────────────────────────────────────────────────
// For 5-min charts: bars per session = 75 (09:15 to 15:30)
// Same-time-of-day means: compare this bar to the same bar-index
// within the session across the past N sessions.
// Approximation: use a lookback of N * barsPerSession bars at the same offset.
// This is the cleanest approach available without tick data.

int barsPerSession = 75  // 09:15–15:30 IST = 75 five-min bars

// Rolling SMA over last 20 bars (fallback for mid-session, same as before)
float volMA_rolling = ta.sma(volume, 20)

// Same-time-of-day average: average the volume at the same bar-slot
// across the past lookbackDays sessions.
// We look back at offsets: 1*75, 2*75, 3*75 ... N*75 bars
float sumVol = 0.0
int   validCount = 0
for i = 1 to lookbackDays
    int offset = i * barsPerSession
    if bar_index >= offset
        sumVol     += nz(volume[offset])
        validCount += 1

float volMA_sameTime = validCount > 0 ? sumVol / validCount : volMA_rolling

// ─── USE SAME-TIME-OF-DAY FOR OPENING WINDOW, ROLLING FOR REST ───────────────
// Opening window = first 3 bars of session (09:15, 09:20, 09:25, 09:30)
bool isOpeningWindow = (hour(time, "Asia/Kolkata") == 9) and
                       (minute(time, "Asia/Kolkata") <= 30)

float volMA = isOpeningWindow ? volMA_sameTime : volMA_rolling

// ─── COLOUR TIERS ─────────────────────────────────────────────────────────────
bool is_t3 = volume > volMA * t3
bool is_t2 = volume > volMA * t2
bool is_t1 = volume > volMA * t1

color volColor = color.rgb(120, 123, 134, 60)  // Grey — normal
if is_t3
    volColor := #e74c3c   // Red    — extreme (≥2.5×)
else if is_t2
    volColor := #e67e22   // Orange — heavy   (≥2.0×)
else if is_t1
    volColor := #f1c40f   // Gold   — alert   (≥1.5×)

// ─── PLOTS ────────────────────────────────────────────────────────────────────
float rvol = volMA > 0 ? volume / volMA : na

// RVOL mode: bars are multiples of the session-aware baseline.
// Threshold hlines act as permanent visual guides — Gold/Orange bars are
// always proportionally tall regardless of extreme spikes elsewhere.
// Raw mode: original raw volume + MA line.
plot(normalizeRvol ? rvol   : volume,
     style=plot.style_columns, color=volColor,
     title="Volume")
plot(normalizeRvol ? na     : volMA,
     color=color.white, linewidth=2,
     title="Baseline (raw mode)")

// hline() requires compile-time constants; use plot() for conditional reference lines.
plot(normalizeRvol ? 1.0 : na, "Average",     color=color.new(color.white, 55), linewidth=1, style=plot.style_line)
plot(normalizeRvol ? t1  : na, "Gold tier",   color=color.new(#f1c40f, 45),    linewidth=1, style=plot.style_line)
plot(normalizeRvol ? t2  : na, "Orange tier", color=color.new(#e67e22, 45),    linewidth=1, style=plot.style_line)
plot(normalizeRvol ? t3  : na, "Red tier",    color=color.new(#e74c3c, 45),    linewidth=1, style=plot.style_line)
