indicator("Opening Range Breakout (Current Session)", overlay=true)

// Opening Range Breakout for NSE intraday charts, current session only.
// Default window is 09:15-09:30 IST (first 15 minutes of the regular session).
// Tracks the running high/low inside the window, locks them when it closes,
// then plots High, Low and Mid for the rest of the session, with breakout
// alerts on the first cross of either level.
//
// LipiScript has no barstate.islast, timenow or bar_index, so a script cannot
// detect "today" on its own - there is no forward-looking or last-bar signal,
// only the verified dayofmonth built-in. So this gates everything (capture,
// lock, plot, breakout alerts) to a single reference day: bump "Reference Day
// of Month" to today's date every trading morning, and no session but that
// one draws. Without the gate, every session ever loaded on the chart draws
// its own ORB box, which is what made the chart noisy.
//
// hour and minute follow the CHART timezone, not the exchange. If the chart is
// not on Asia/Kolkata, change the start hour/minute inputs, not the code.
//
// Use an interval that divides the window evenly: 1, 3, 5 or 15 minutes.

// ==== CURRENT SESSION GATE ====
refDay = input.int(22, "Reference Day of Month (set to today, every morning)")
isRefDay = dayofmonth == refDay

// ==== ORB WINDOW INPUTS ====
startHour = input.int(9, "ORB Start Hour")
startMin = input.int(15, "ORB Start Minute")
orbMinutes = input.int(15, "ORB Duration Minutes")

// ==== SESSION END INPUTS ====
sessionEndHour = input.int(15, "Session End Hour")
sessionEndMin = input.int(0, "Session End Minute")

// ==== DISPLAY INPUTS ====
stampMode = input.int(0, "Bar Timestamp (0=open time, 1=close time)")
showMid = input.int(1, "Show Midpoint (0=no, 1=yes)")

// ==== MINUTE OF DAY BOUNDS ====
minuteOfDay = hour * 60 + minute
windowOpen = startHour * 60 + startMin
windowClose = windowOpen + orbMinutes
sessionEnd = sessionEndHour * 60 + sessionEndMin

// ==== WINDOW AND SESSION CONDITIONS ====
// An open-stamped 5m bar printed at 09:25 is the last ORB bar; one printed at
// 09:30 is not. A close-stamped feed shifts both comparisons by one bar.
inWindow = isRefDay and (stampMode == 1 ? minuteOfDay > windowOpen and minuteOfDay <= windowClose : minuteOfDay >= windowOpen and minuteOfDay < windowClose)
inSession = isRefDay and (stampMode == 1 ? minuteOfDay > windowOpen and minuteOfDay <= sessionEnd : minuteOfDay >= windowOpen and minuteOfDay < sessionEnd)

// ==== PERSISTENT VARIABLES ====
static float orbHigh = na
static float orbLow = na
static float orbMid = na
static bool orbLocked = false
static bool longTaken = false
static bool shortTaken = false

// ==== RESET AT THE START OF EACH TRADING DAY ====
isNewDay = na(dayofmonth[1]) or dayofmonth != dayofmonth[1]

if isNewDay {
    orbHigh := na
    orbLow := na
    orbMid := na
    orbLocked := false
    longTaken := false
    shortTaken := false
}

// ==== CAPTURE ORB HIGH AND LOW ====
if inWindow {
    orbHigh := na(orbHigh) ? high : math.max(orbHigh, high)
    orbLow := na(orbLow) ? low : math.min(orbLow, low)
}

// ==== LOCK THE RANGE WHEN THE WINDOW CLOSES ====
if not inWindow and inSession and not orbLocked and not na(orbHigh) {
    orbLocked := true
    orbMid := (orbHigh + orbLow) / 2
}

// ==== PLOT LEVELS ONLY DURING THE SESSION ====
// color.new(color.orange, 50) keeps orange's RGB untouched and sets alpha to
// 50 - already confirmed compiling as color.new(color.yellow, 50) in
// initial_balance_current_session.lipi. No dashed/dotted plot() line style is
// documented or verified - only hline() has hlineStyle.dotted, and it needs a
// compile-time constant price, which orbMid is not - so Mid stays a plain
// line rather than an invented style.
//
// plot()'s title= does not produce a right-axis price badge like "pHigh"/
// "pwLow" in GoCharting - confirmed on-chart for both this script and
// initial_balance_current_session.lipi. That is a platform limitation, not a
// script bug; not retrying with hline()/label.new() for the reason above.
plot(inSession and orbLocked ? orbHigh : na, color=color.new(color.orange, 50), linewidth=2, title="ORB High")
plot(inSession and orbLocked ? orbLow : na, color=color.new(color.orange, 50), linewidth=2, title="ORB Low")
plot(inSession and orbLocked and showMid == 1 ? orbMid : na, color=color.new(color.orange, 50), linewidth=1, title="ORB Mid")

// ==== BREAKOUT CONDITIONS (FIRST OCCURRENCE ONLY) ====
longBreak = inSession and orbLocked and not longTaken and talib.crossover(close, orbHigh)
shortBreak = inSession and orbLocked and not shortTaken and talib.crossunder(close, orbLow)

// ==== MARK SIGNALS AS TAKEN ====
if longBreak {
    longTaken := true
}

if shortBreak {
    shortTaken := true
}

// ==== PLOT BREAKOUT SIGNALS ====
plotshape(longBreak, shape=shape.triangleup, location=location.belowbar, color=color.orange, size=size.small, title="ORB Breakout Up")
plotshape(shortBreak, shape=shape.triangledown, location=location.abovebar, color=color.orange, size=size.small, title="ORB Breakdown")

// ==== ALERTS ====
alertcondition(longBreak, title="ORB Breakout Up", message="ORB breakout up")
alertcondition(shortBreak, title="ORB Breakdown", message="ORB breakdown")
