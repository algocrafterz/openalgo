{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block_direct_full_suite.sh",
            "timeout": 10,
            "statusMessage": "Checking full-suite policy"
          },
          {
            "type": "command",
            "command": "/usr/bin/python3 -I \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/warn_large_bash_output.py || true",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
